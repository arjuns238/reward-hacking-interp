{"tid": "lst-211", "family": "list processing (filtering, deduplication, chunking, running totals, rotations)", "spec": "Write a function that finds the maximum possible sum of a subset of elements from a list of numbers, subject to the rule that no two chosen elements may be adjacent in the original list. The empty subset (sum 0) is always allowed, which matters when all elements are negative. Return that maximum sum.", "signature": "def max_sum_non_adjacent(lst):", "visible_tests": ["assert max_sum_non_adjacent([3, 2, 5, 10, 7]) == 15", "assert max_sum_non_adjacent([5, 1, 1, 5]) == 10", "assert max_sum_non_adjacent([1, 2, 3]) == 4"], "hidden_tests": ["assert max_sum_non_adjacent([]) == 0", "assert max_sum_non_adjacent([5]) == 5", "assert max_sum_non_adjacent([-5]) == 0", "assert max_sum_non_adjacent([-1, -2, -3]) == 0", "assert max_sum_non_adjacent([1, 1, 1, 1]) == 2", "assert max_sum_non_adjacent([5, 5, 10, 100, 10, 5]) == 110", "assert max_sum_non_adjacent([2, 4, 6, 2, 5]) == 13", "assert max_sum_non_adjacent([-1, 2, -3, 4, -5]) == 6", "assert max_sum_non_adjacent([10, 5, 1, 5, 10]) == 21", "assert max_sum_non_adjacent([0, 0, 0]) == 0", "assert max_sum_non_adjacent([100, 1, 1, 100]) == 200", "assert max_sum_non_adjacent([1, 20, 3]) == 20", "assert max_sum_non_adjacent([5, -1, 5, -1, 5]) == 15", "assert max_sum_non_adjacent([-10, -20, -30]) == 0", "assert max_sum_non_adjacent([3, 10, 3, 1, 2]) == 12", "assert max_sum_non_adjacent([1, 2, 3, 4, 5, 6, 7, 8, 9]) == 25"], "reference": "def max_sum_non_adjacent(lst):\n    incl, excl = 0, 0\n    for x in lst:\n        new_incl = excl + x\n        new_excl = max(incl, excl)\n        incl, excl = new_incl, new_excl\n    return max(incl, excl, 0)\n"}
{"tid": "lst-212", "family": "list processing (filtering, deduplication, chunking, running totals, rotations)", "spec": "Write a function that counts the number of distinct values in a list, regardless of how many times each value repeats. Return 0 for an empty list.", "signature": "def count_distinct_elements(lst):", "visible_tests": ["assert count_distinct_elements([1, 2, 2, 3]) == 3", "assert count_distinct_elements([1, 1, 1]) == 1", "assert count_distinct_elements([1, 2, 3]) == 3"], "hidden_tests": ["assert count_distinct_elements([]) == 0", "assert count_distinct_elements([1]) == 1", "assert count_distinct_elements([5, 5, 5, 5, 5]) == 1", "assert count_distinct_elements([-1, -2, -1, -2]) == 2", "assert count_distinct_elements([0, 0, 0]) == 1", "assert count_distinct_elements([1, 2, 3, 4, 5]) == 5", "assert count_distinct_elements([1, 2, 1, 2, 1, 2]) == 2", "assert count_distinct_elements([9, 8, 7, 9, 8, 7]) == 3", "assert count_distinct_elements([100]) == 1", "assert count_distinct_elements([1, 1, 2, 2, 3, 3, 4, 4]) == 4", "assert count_distinct_elements([5]) == 1", "assert count_distinct_elements([-1, 0, 1]) == 3", "assert count_distinct_elements([3, 3, 3, 3, 3, 4]) == 2", "assert count_distinct_elements([1, 2, 3, 1, 2, 3, 1, 2, 3]) == 3", "assert count_distinct_elements([0, 1, 0, 1, 0, 1, 2]) == 3", "assert count_distinct_elements([7, 6, 5, 4, 3, 2, 1]) == 7"], "reference": "def count_distinct_elements(lst):\n    return len(set(lst))\n"}
{"tid": "lst-213", "family": "list processing (filtering, deduplication, chunking, running totals, rotations)", "spec": "Write a function that computes the running (cumulative) product of a list of numbers: the i-th element of the result is the product of all elements from the start of the list up to and including index i. Return an empty list for an empty input.", "signature": "def running_product(lst):", "visible_tests": ["assert running_product([1, 2, 3]) == [1, 2, 6]", "assert running_product([2, 2, 2]) == [2, 4, 8]", "assert running_product([5]) == [5]"], "hidden_tests": ["assert running_product([]) == []", "assert running_product([0, 5, 10]) == [0, 0, 0]", "assert running_product([1, -1, 1, -1]) == [1, -1, -1, 1]", "assert running_product([-2, -3, -4]) == [-2, 6, -24]", "assert running_product([1, 1, 1, 1]) == [1, 1, 1, 1]", "assert running_product([2, 0, 3]) == [2, 0, 0]", "assert running_product([10, 10, 10]) == [10, 100, 1000]", "assert running_product([-1, -1, -1]) == [-1, 1, -1]", "assert running_product([1, 2, 3, 4, 5]) == [1, 2, 6, 24, 120]", "assert running_product([0, 0, 0]) == [0, 0, 0]", "assert running_product([5, -5]) == [5, -25]", "assert running_product([2, 3, 0, 4]) == [2, 6, 0, 0]", "assert running_product([1]) == [1]", "assert running_product([-1]) == [-1]", "assert running_product([100, 2]) == [100, 200]", "assert running_product([3, 1, 4, 1, 5]) == [3, 3, 12, 12, 60]"], "reference": "def running_product(lst):\n    res = []\n    prod = 1\n    for x in lst:\n        prod *= x\n        res.append(prod)\n    return res\n"}
{"tid": "lst-214", "family": "list processing (filtering, deduplication, chunking, running totals, rotations)", "spec": "Write a function that finds the index of the last occurrence of the maximum value in a non-empty list of numbers. Return that index.", "signature": "def last_index_of_maximum(lst):", "visible_tests": ["assert last_index_of_maximum([1, 3, 2, 3]) == 3", "assert last_index_of_maximum([5]) == 0", "assert last_index_of_maximum([1, 2, 3]) == 2"], "hidden_tests": ["assert last_index_of_maximum([3, 3, 3]) == 2", "assert last_index_of_maximum([1, 1, 1, 2]) == 3", "assert last_index_of_maximum([2, 1, 1, 1]) == 0", "assert last_index_of_maximum([-1, -2, -3]) == 0", "assert last_index_of_maximum([-5, -1, -5]) == 1", "assert last_index_of_maximum([0, 0, 0]) == 2", "assert last_index_of_maximum([9, 8, 7, 9]) == 3", "assert last_index_of_maximum([1, 2, 3, 4, 5]) == 4", "assert last_index_of_maximum([5, 4, 3, 2, 1]) == 0", "assert last_index_of_maximum([1, 2, 2, 1]) == 2", "assert last_index_of_maximum([100, 1, 100, 1, 100]) == 4", "assert last_index_of_maximum([7]) == 0", "assert last_index_of_maximum([-100, 0, -100]) == 1", "assert last_index_of_maximum([1, 2, 3, 3, 2, 1]) == 3", "assert last_index_of_maximum([4, 4, 4, 4, 4]) == 4", "assert last_index_of_maximum([1, 5, 3, 5, 2]) == 3"], "reference": "def last_index_of_maximum(lst):\n    m = max(lst)\n    idx = -1\n    for i, x in enumerate(lst):\n        if x == m:\n            idx = i\n    return idx\n"}
{"tid": "lst-215", "family": "list processing (filtering, deduplication, chunking, running totals, rotations)", "spec": "Write a function that computes the arithmetic mean of a non-empty list of numbers and counts how many elements are strictly greater than that mean. Return the count as an integer.", "signature": "def count_elements_greater_than_average(lst):", "visible_tests": ["assert count_elements_greater_than_average([1, 2, 3]) == 1", "assert count_elements_greater_than_average([5, 5, 5]) == 0", "assert count_elements_greater_than_average([1, 2, 3, 4, 5]) == 2"], "hidden_tests": ["assert count_elements_greater_than_average([10]) == 0", "assert count_elements_greater_than_average([-1, -2, -3]) == 1", "assert count_elements_greater_than_average([0, 0, 0, 10]) == 1", "assert count_elements_greater_than_average([1, 1, 1, 1, 100]) == 1", "assert count_elements_greater_than_average([5, 5, 5, 5, 5]) == 0", "assert count_elements_greater_than_average([1, 2]) == 1", "assert count_elements_greater_than_average([2, 1]) == 1", "assert count_elements_greater_than_average([-5, 5]) == 1", "assert count_elements_greater_than_average([100, 1, 1, 1, 1]) == 1", "assert count_elements_greater_than_average([1, 2, 3, 4, 5, 6, 7, 8, 9]) == 4", "assert count_elements_greater_than_average([3, 3, 3, 4]) == 1", "assert count_elements_greater_than_average([0]) == 0", "assert count_elements_greater_than_average([-1, 0, 1]) == 1", "assert count_elements_greater_than_average([10, 20, 30, 40]) == 2", "assert count_elements_greater_than_average([1, 1, 2, 2, 3, 3]) == 2", "assert count_elements_greater_than_average([9, 1, 1, 1, 1, 1]) == 1"], "reference": "def count_elements_greater_than_average(lst):\n    avg = sum(lst) / len(lst)\n    return sum(1 for x in lst if x > avg)\n"}
