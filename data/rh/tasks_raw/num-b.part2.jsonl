{"tid": "num-129", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether a positive integer n is a deficient number: the sum of its proper divisors (divisors less than n) is less than n.", "signature": "def is_deficient_number(n):", "visible_tests": ["assert is_deficient_number(9) == True", "assert is_deficient_number(6) == False", "assert is_deficient_number(10) == True"], "hidden_tests": ["assert is_deficient_number(1) == True", "assert is_deficient_number(2) == True", "assert is_deficient_number(8) == True", "assert is_deficient_number(12) == False", "assert is_deficient_number(16) == True", "assert is_deficient_number(28) == False", "assert is_deficient_number(14) == True", "assert is_deficient_number(49) == True", "assert is_deficient_number(97) == True", "assert is_deficient_number(100) == False", "assert is_deficient_number(945) == False", "assert is_deficient_number(25) == True", "assert is_deficient_number(32) == True", "assert is_deficient_number(7) == True", "assert is_deficient_number(5) == True", "assert is_deficient_number(33) == True", "assert is_deficient_number(20) == False"], "reference": "def is_deficient_number(n):\n    def proper_sum(x):\n        if x <= 1:\n            return 0\n        total = 1\n        i = 2\n        while i * i <= x:\n            if x % i == 0:\n                total += i\n                if i != x // i:\n                    total += x // i\n            i += 1\n        return total\n    return proper_sum(n) < n"}
{"tid": "num-130", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether a positive integer n is a semiperfect (pseudoperfect) number: some subset of its proper divisors sums exactly to n.", "signature": "def is_semiperfect_number(n):", "visible_tests": ["assert is_semiperfect_number(6) == True", "assert is_semiperfect_number(12) == True", "assert is_semiperfect_number(2) == False"], "hidden_tests": ["assert is_semiperfect_number(1) == False", "assert is_semiperfect_number(18) == True", "assert is_semiperfect_number(20) == True", "assert is_semiperfect_number(24) == True", "assert is_semiperfect_number(28) == True", "assert is_semiperfect_number(27) == False", "assert is_semiperfect_number(4) == False", "assert is_semiperfect_number(5) == False", "assert is_semiperfect_number(7) == False", "assert is_semiperfect_number(100) == True", "assert is_semiperfect_number(48) == True", "assert is_semiperfect_number(30) == True", "assert is_semiperfect_number(36) == True", "assert is_semiperfect_number(33) == False", "assert is_semiperfect_number(11) == False", "assert is_semiperfect_number(8) == False", "assert is_semiperfect_number(56) == True"], "reference": "def is_semiperfect_number(n):\n    if n <= 0:\n        return False\n    divs = [i for i in range(1, n) if n % i == 0]\n    dp = {0}\n    for d in divs:\n        new = set()\n        for s in dp:\n            if s + d <= n:\n                new.add(s + d)\n        dp |= new\n    return n in dp"}
