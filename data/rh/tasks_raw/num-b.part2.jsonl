{"tid": "num-134", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Compute Euler's totient function phi(n) for a positive integer n: the count of integers in [1, n] that are coprime to n (share no common factor greater than 1).", "signature": "def euler_totient(n):", "visible_tests": ["assert euler_totient(1) == 1", "assert euler_totient(9) == 6", "assert euler_totient(10) == 4"], "hidden_tests": ["assert euler_totient(2) == 1", "assert euler_totient(7) == 6", "assert euler_totient(12) == 4", "assert euler_totient(36) == 12", "assert euler_totient(97) == 96", "assert euler_totient(100) == 40", "assert euler_totient(60) == 16", "assert euler_totient(45) == 24", "assert euler_totient(17) == 16", "assert euler_totient(30) == 8", "assert euler_totient(49) == 42", "assert euler_totient(1000) == 400", "assert euler_totient(720) == 192", "assert euler_totient(13) == 12", "assert euler_totient(999) == 648", "assert euler_totient(81) == 54", "assert euler_totient(101) == 100"], "reference": "def euler_totient(n):\n    result = n\n    p = 2\n    x = n\n    while p * p <= x:\n        if x % p == 0:\n            while x % p == 0:\n                x //= p\n            result -= result // p\n        p += 1\n    if x > 1:\n        result -= result // x\n    return result"}
{"tid": "num-135", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether a positive integer n can be written as a^b for integers a >= 2 and b >= 2 (a perfect power such as a square, cube, etc.).", "signature": "def is_perfect_power(n):", "visible_tests": ["assert is_perfect_power(8) == True", "assert is_perfect_power(9) == True", "assert is_perfect_power(10) == False"], "hidden_tests": ["assert is_perfect_power(1) == False", "assert is_perfect_power(2) == False", "assert is_perfect_power(3) == False", "assert is_perfect_power(4) == True", "assert is_perfect_power(16) == True", "assert is_perfect_power(27) == True", "assert is_perfect_power(32) == True", "assert is_perfect_power(64) == True", "assert is_perfect_power(100) == True", "assert is_perfect_power(128) == True", "assert is_perfect_power(81) == True", "assert is_perfect_power(625) == True", "assert is_perfect_power(1024) == True", "assert is_perfect_power(12) == False", "assert is_perfect_power(999) == False", "assert is_perfect_power(1000) == True", "assert is_perfect_power(2187) == True"], "reference": "def is_perfect_power(n):\n    if n < 4:\n        return False\n    for b in range(2, n.bit_length() + 1):\n        a = round(n ** (1.0 / b))\n        for cand in (a - 1, a, a + 1):\n            if cand >= 2 and cand ** b == n:\n                return True\n    return False"}
