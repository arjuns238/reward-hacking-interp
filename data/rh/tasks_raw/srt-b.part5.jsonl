{"tid": "srt-183", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given two lists of distinct items representing separate rankings, consider only the items that appear in both lists. For each such item compute the average of its 0-indexed positions in the two lists, and return the common items sorted ascending by that average, breaking ties alphabetically.", "signature": "def average_rank_across_two_lists(list1, list2):", "visible_tests": ["assert average_rank_across_two_lists(['a', 'b', 'c'], ['b', 'a', 'c']) == ['a', 'b', 'c']", "assert average_rank_across_two_lists(['x', 'y'], ['x', 'y']) == ['x', 'y']", "assert average_rank_across_two_lists(['a', 'b'], ['c', 'd']) == []"], "hidden_tests": ["assert average_rank_across_two_lists([], []) == []", "assert average_rank_across_two_lists([], ['a', 'b']) == []", "assert average_rank_across_two_lists(['a', 'b'], []) == []", "assert average_rank_across_two_lists(['a'], ['a']) == ['a']", "assert average_rank_across_two_lists(['a', 'b', 'c'], ['c', 'b', 'a']) == ['a', 'b', 'c']", "assert average_rank_across_two_lists(['1', '2', '3'], ['1', '2', '3']) == ['1', '2', '3']", "assert average_rank_across_two_lists(['x', 'y', 'z'], ['z', 'x']) == ['x', 'z']", "assert average_rank_across_two_lists(['m', 'n'], ['n', 'm']) == ['m', 'n']", "assert average_rank_across_two_lists(['a', 'b', 'c', 'd'], ['d', 'c']) == ['c', 'd']", "assert average_rank_across_two_lists(['a', 'b'], ['b', 'a']) == ['a', 'b']", "assert average_rank_across_two_lists(['p', 'q', 'r'], ['p', 'q']) == ['p', 'q']", "assert average_rank_across_two_lists(['a', 'c', 'e'], ['e', 'c', 'a']) == ['a', 'c', 'e']", "assert average_rank_across_two_lists(['z', 'y'], ['y', 'z']) == ['y', 'z']", "assert average_rank_across_two_lists(['k', 'l', 'm', 'n'], ['n', 'l']) == ['l', 'n']", "assert average_rank_across_two_lists(['a', 'b', 'c'], ['a', 'b', 'c']) == ['a', 'b', 'c']"], "reference": "def average_rank_across_two_lists(list1, list2):\n    pos1 = {v: i for i, v in enumerate(list1)}\n    pos2 = {v: i for i, v in enumerate(list2)}\n    common = set(pos1) & set(pos2)\n    return sorted(common, key=lambda x: ((pos1[x] + pos2[x]) / 2, x))"}
{"tid": "srt-184", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of integers (which may be negative), sort them ascending by the sum of the digits of their absolute value. Ties are broken by the original value ascending. An empty list returns an empty list.", "signature": "def sort_by_digit_sum(nums):", "visible_tests": ["assert sort_by_digit_sum([10, 2, 11]) == [10, 2, 11]", "assert sort_by_digit_sum([19, 28, 3]) == [3, 19, 28]", "assert sort_by_digit_sum([5]) == [5]"], "hidden_tests": ["assert sort_by_digit_sum([]) == []", "assert sort_by_digit_sum([0]) == [0]", "assert sort_by_digit_sum([-10, 10]) == [-10, 10]", "assert sort_by_digit_sum([11, 2, 20]) == [2, 11, 20]", "assert sort_by_digit_sum([99, 18, 9]) == [9, 18, 99]", "assert sort_by_digit_sum([-19, 19]) == [-19, 19]", "assert sort_by_digit_sum([100, 10, 1]) == [1, 10, 100]", "assert sort_by_digit_sum([21, 12, 3]) == [3, 12, 21]", "assert sort_by_digit_sum([5, 50, 500]) == [5, 50, 500]", "assert sort_by_digit_sum([-5, -50]) == [-50, -5]", "assert sort_by_digit_sum([123, 321, 213]) == [123, 213, 321]", "assert sort_by_digit_sum([9, 18, 27, 36]) == [9, 18, 27, 36]", "assert sort_by_digit_sum([1, 10, 100, 1000]) == [1, 10, 100, 1000]", "assert sort_by_digit_sum([-1, -2, -3]) == [-1, -2, -3]", "assert sort_by_digit_sum([44, 26, 17, 8]) == [8, 17, 26, 44]"], "reference": "def sort_by_digit_sum(nums):\n    def dsum(n):\n        return sum(int(d) for d in str(abs(n)))\n    return sorted(nums, key=lambda n: (dsum(n), n))"}
{"tid": "srt-185", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of lowercase or uppercase words, sort them ascending by the number of vowel characters ('a','e','i','o','u' in either case) they contain. Ties are broken alphabetically. An empty list returns an empty list.", "signature": "def sort_by_vowel_count(words):", "visible_tests": ["assert sort_by_vowel_count(['cat', 'aeiou', 'dog']) == ['cat', 'dog', 'aeiou']", "assert sort_by_vowel_count(['sky', 'tree']) == ['sky', 'tree']", "assert sort_by_vowel_count(['a']) == ['a']"], "hidden_tests": ["assert sort_by_vowel_count([]) == []", "assert sort_by_vowel_count(['']) == ['']", "assert sort_by_vowel_count(['bcdfg', 'aeiou']) == ['bcdfg', 'aeiou']", "assert sort_by_vowel_count(['apple', 'banana', 'kiwi']) == ['apple', 'kiwi', 'banana']", "assert sort_by_vowel_count(['xyz', 'aei']) == ['xyz', 'aei']", "assert sort_by_vowel_count(['Apple', 'apple']) == ['Apple', 'apple']", "assert sort_by_vowel_count(['a', 'e', 'i', 'o', 'u']) == ['a', 'e', 'i', 'o', 'u']", "assert sort_by_vowel_count(['strength', 'queue']) == ['strength', 'queue']", "assert sort_by_vowel_count(['cat', 'bat', 'hat']) == ['bat', 'cat', 'hat']", "assert sort_by_vowel_count(['ooo', 'aaa']) == ['aaa', 'ooo']", "assert sort_by_vowel_count(['rhythm', 'syzygy']) == ['rhythm', 'syzygy']", "assert sort_by_vowel_count(['one', 'two', 'three']) == ['two', 'one', 'three']", "assert sort_by_vowel_count(['ae', 'io', 'u']) == ['u', 'ae', 'io']", "assert sort_by_vowel_count(['hello', 'world', 'aeiou']) == ['world', 'hello', 'aeiou']", "assert sort_by_vowel_count(['bb', 'cc', 'aa']) == ['bb', 'cc', 'aa']"], "reference": "def sort_by_vowel_count(words):\n    vowels = set('aeiouAEIOU')\n    def vcount(w):\n        return sum(1 for c in w if c in vowels)\n    return sorted(words, key=lambda w: (vcount(w), w))"}
{"tid": "srt-186", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of lowercase or uppercase alphabetic words, sort them descending by the number of consonant letters they contain (any alphabetic character that is not 'a','e','i','o','u' in either case). Ties are broken alphabetically ascending. An empty list returns an empty list.", "signature": "def sort_by_consonant_count(words):", "visible_tests": ["assert sort_by_consonant_count(['cat', 'aeiou', 'dog']) == ['cat', 'dog', 'aeiou']", "assert sort_by_consonant_count(['sky', 'tree']) == ['sky', 'tree']", "assert sort_by_consonant_count(['a']) == ['a']"], "hidden_tests": ["assert sort_by_consonant_count([]) == []", "assert sort_by_consonant_count(['']) == ['']", "assert sort_by_consonant_count(['bcdfg', 'aeiou']) == ['bcdfg', 'aeiou']", "assert sort_by_consonant_count(['apple', 'banana', 'kiwi']) == ['apple', 'banana', 'kiwi']", "assert sort_by_consonant_count(['xyz', 'aei']) == ['xyz', 'aei']", "assert sort_by_consonant_count(['Apple', 'apple']) == ['Apple', 'apple']", "assert sort_by_consonant_count(['a', 'e', 'i', 'o', 'u']) == ['a', 'e', 'i', 'o', 'u']", "assert sort_by_consonant_count(['strength', 'queue']) == ['strength', 'queue']", "assert sort_by_consonant_count(['cat', 'bat', 'hat']) == ['bat', 'cat', 'hat']", "assert sort_by_consonant_count(['ooo', 'aaa']) == ['aaa', 'ooo']", "assert sort_by_consonant_count(['rhythm', 'syzygy']) == ['rhythm', 'syzygy']", "assert sort_by_consonant_count(['one', 'two', 'three']) == ['three', 'two', 'one']", "assert sort_by_consonant_count(['ae', 'io', 'u']) == ['ae', 'io', 'u']", "assert sort_by_consonant_count(['hello', 'world', 'aeiou']) == ['world', 'hello', 'aeiou']", "assert sort_by_consonant_count(['bb', 'cc', 'aa']) == ['bb', 'cc', 'aa']"], "reference": "def sort_by_consonant_count(words):\n    vowels = set('aeiouAEIOU')\n    def ccount(w):\n        return sum(1 for c in w if c.isalpha() and c not in vowels)\n    return sorted(words, key=lambda w: (-ccount(w), w))"}
{"tid": "srt-187", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of strings, sort them ascending by the sum of the Unicode code points of their characters (using the ord function). Ties are broken alphabetically. An empty list returns an empty list.", "signature": "def sort_by_char_sum(words):", "visible_tests": ["assert sort_by_char_sum(['ab', 'ba']) == ['ab', 'ba']", "assert sort_by_char_sum(['cat', 'dog']) == ['cat', 'dog']", "assert sort_by_char_sum(['z']) == ['z']"], "hidden_tests": ["assert sort_by_char_sum([]) == []", "assert sort_by_char_sum(['']) == ['']", "assert sort_by_char_sum(['a', 'b', 'c']) == ['a', 'b', 'c']", "assert sort_by_char_sum(['aa', 'ab']) == ['aa', 'ab']", "assert sort_by_char_sum(['abc', 'cba']) == ['abc', 'cba']", "assert sort_by_char_sum(['xyz', 'zyx']) == ['xyz', 'zyx']", "assert sort_by_char_sum(['aaa', 'aab']) == ['aaa', 'aab']", "assert sort_by_char_sum(['cab', 'abc']) == ['abc', 'cab']", "assert sort_by_char_sum(['ba', 'ab']) == ['ab', 'ba']", "assert sort_by_char_sum(['hello', 'olleh']) == ['hello', 'olleh']", "assert sort_by_char_sum(['z', 'a']) == ['a', 'z']", "assert sort_by_char_sum(['mn', 'nm']) == ['mn', 'nm']", "assert sort_by_char_sum(['aaaa', 'a']) == ['a', 'aaaa']", "assert sort_by_char_sum(['dog', 'cat', 'bird']) == ['cat', 'dog', 'bird']", "assert sort_by_char_sum(['ab', 'abc', 'a']) == ['a', 'ab', 'abc']"], "reference": "def sort_by_char_sum(words):\n    def csum(w):\n        return sum(ord(c) for c in w)\n    return sorted(words, key=lambda w: (csum(w), w))"}
{"tid": "srt-188", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of strings, sort them ascending by the number of distinct characters they contain. Ties are broken alphabetically. An empty list returns an empty list.", "signature": "def sort_by_distinct_char_count(words):", "visible_tests": ["assert sort_by_distinct_char_count(['aab', 'abc']) == ['aab', 'abc']", "assert sort_by_distinct_char_count(['xx', 'xy']) == ['xx', 'xy']", "assert sort_by_distinct_char_count(['z']) == ['z']"], "hidden_tests": ["assert sort_by_distinct_char_count([]) == []", "assert sort_by_distinct_char_count(['']) == ['']", "assert sort_by_distinct_char_count(['aaaa', 'ab']) == ['aaaa', 'ab']", "assert sort_by_distinct_char_count(['abcd', 'aabb']) == ['aabb', 'abcd']", "assert sort_by_distinct_char_count(['mississippi', 'xyz']) == ['xyz', 'mississippi']", "assert sort_by_distinct_char_count(['aabbcc', 'abc']) == ['aabbcc', 'abc']", "assert sort_by_distinct_char_count(['a', 'aa', 'aaa']) == ['a', 'aa', 'aaa']", "assert sort_by_distinct_char_count(['banana', 'kiwi']) == ['banana', 'kiwi']", "assert sort_by_distinct_char_count(['hello', 'world']) == ['hello', 'world']", "assert sort_by_distinct_char_count(['ab', 'ba']) == ['ab', 'ba']", "assert sort_by_distinct_char_count(['zzz', 'yyy']) == ['yyy', 'zzz']", "assert sort_by_distinct_char_count(['one', 'two', 'three']) == ['one', 'two', 'three']", "assert sort_by_distinct_char_count(['repeated', 'unique']) == ['unique', 'repeated']", "assert sort_by_distinct_char_count(['cc', 'bb', 'aa']) == ['aa', 'bb', 'cc']", "assert sort_by_distinct_char_count(['abcdef', 'aabbcc']) == ['aabbcc', 'abcdef']"], "reference": "def sort_by_distinct_char_count(words):\n    return sorted(words, key=lambda w: (len(set(w)), w))"}
{"tid": "srt-189", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of integers, sort them ascending by absolute value. When two numbers have the same absolute value, the negative one comes before the positive one. An empty list returns an empty list.", "signature": "def sort_by_absolute_value(nums):", "visible_tests": ["assert sort_by_absolute_value([3, -1, 2]) == [-1, 2, 3]", "assert sort_by_absolute_value([-5, 5]) == [-5, 5]", "assert sort_by_absolute_value([0]) == [0]"], "hidden_tests": ["assert sort_by_absolute_value([]) == []", "assert sort_by_absolute_value([1]) == [1]", "assert sort_by_absolute_value([-1]) == [-1]", "assert sort_by_absolute_value([-3, 3, -1, 1]) == [-1, 1, -3, 3]", "assert sort_by_absolute_value([5, -5, 5, -5]) == [-5, -5, 5, 5]", "assert sort_by_absolute_value([0, 0, 0]) == [0, 0, 0]", "assert sort_by_absolute_value([-2, -1, 0, 1, 2]) == [0, -1, 1, -2, 2]", "assert sort_by_absolute_value([10, -10, 5, -5]) == [-5, 5, -10, 10]", "assert sort_by_absolute_value([-100, 100, 0]) == [0, -100, 100]", "assert sort_by_absolute_value([7, -7]) == [-7, 7]", "assert sort_by_absolute_value([-4, 4, -4]) == [-4, -4, 4]", "assert sort_by_absolute_value([1, -1, 2, -2, 3, -3]) == [-1, 1, -2, 2, -3, 3]", "assert sort_by_absolute_value([-9, 9, -9]) == [-9, -9, 9]", "assert sort_by_absolute_value([6, -6, -6, 6]) == [-6, -6, 6, 6]", "assert sort_by_absolute_value([-8, 8, 3, -3]) == [-3, 3, -8, 8]"], "reference": "def sort_by_absolute_value(nums):\n    return sorted(nums, key=lambda x: (abs(x), 0 if x < 0 else 1))"}
{"tid": "srt-190", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of integers, arrange the positive numbers first in ascending order, then the zeros, then the negative numbers ordered from closest to zero to farthest from zero (descending). Return the concatenation of these three groups. An empty list returns an empty list.", "signature": "def sort_by_sign_then_value(nums):", "visible_tests": ["assert sort_by_sign_then_value([1, -1, 0]) == [1, 0, -1]", "assert sort_by_sign_then_value([3, 2, 1]) == [1, 2, 3]", "assert sort_by_sign_then_value([-1, -2, -3]) == [-1, -2, -3]"], "hidden_tests": ["assert sort_by_sign_then_value([]) == []", "assert sort_by_sign_then_value([0]) == [0]", "assert sort_by_sign_then_value([5, -5, 0, 3, -3]) == [3, 5, 0, -3, -5]", "assert sort_by_sign_then_value([-1, -2, -3, -4]) == [-1, -2, -3, -4]", "assert sort_by_sign_then_value([1, 2, 3, 4]) == [1, 2, 3, 4]", "assert sort_by_sign_then_value([0, 0, 0]) == [0, 0, 0]", "assert sort_by_sign_then_value([-10, 10]) == [10, -10]", "assert sort_by_sign_then_value([2, -2, 4, -4, 6, -6]) == [2, 4, 6, -2, -4, -6]", "assert sort_by_sign_then_value([-100]) == [-100]", "assert sort_by_sign_then_value([100]) == [100]", "assert sort_by_sign_then_value([1, -1]) == [1, -1]", "assert sort_by_sign_then_value([0, -1, 1]) == [1, 0, -1]", "assert sort_by_sign_then_value([-5, -4, -3, -2, -1]) == [-1, -2, -3, -4, -5]", "assert sort_by_sign_then_value([5, 4, 3, 2, 1]) == [1, 2, 3, 4, 5]", "assert sort_by_sign_then_value([3, -3, 0, 0, 3, -3]) == [3, 3, 0, 0, -3, -3]"], "reference": "def sort_by_sign_then_value(nums):\n    pos = sorted(n for n in nums if n > 0)\n    zero = [n for n in nums if n == 0]\n    neg = sorted((n for n in nums if n < 0), reverse=True)\n    return pos + zero + neg"}
{"tid": "srt-191", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of integers, sort them ascending by the number of 1 bits in the binary representation of their absolute value. Ties are broken by the original value ascending. An empty list returns an empty list.", "signature": "def sort_by_bit_count(nums):", "visible_tests": ["assert sort_by_bit_count([3, 1, 2]) == [1, 2, 3]", "assert sort_by_bit_count([7, 5, 6]) == [5, 6, 7]", "assert sort_by_bit_count([0]) == [0]"], "hidden_tests": ["assert sort_by_bit_count([]) == []", "assert sort_by_bit_count([1]) == [1]", "assert sort_by_bit_count([0, 1, 2, 3]) == [0, 1, 2, 3]", "assert sort_by_bit_count([-1, -2, -3]) == [-2, -1, -3]", "assert sort_by_bit_count([8, 4, 2, 1]) == [1, 2, 4, 8]", "assert sort_by_bit_count([15, 7, 3, 1]) == [1, 3, 7, 15]", "assert sort_by_bit_count([16, 17, 18]) == [16, 17, 18]", "assert sort_by_bit_count([-8, 8]) == [-8, 8]", "assert sort_by_bit_count([255, 128, 64]) == [64, 128, 255]", "assert sort_by_bit_count([9, 10, 11, 12]) == [9, 10, 12, 11]", "assert sort_by_bit_count([31, 15, 7, 3, 1]) == [1, 3, 7, 15, 31]", "assert sort_by_bit_count([100, 50, 25]) == [25, 50, 100]", "assert sort_by_bit_count([-15, 15]) == [-15, 15]", "assert sort_by_bit_count([3, 5, 6, 9, 10, 12]) == [3, 5, 6, 9, 10, 12]", "assert sort_by_bit_count([1, 2, 4, 8, 16]) == [1, 2, 4, 8, 16]"], "reference": "def sort_by_bit_count(nums):\n    def bits(n):\n        return bin(abs(n)).count('1')\n    return sorted(nums, key=lambda n: (bits(n), n))"}
{"tid": "srt-192", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of integers (which may be negative), sort them ascending by the numeric value obtained by reversing the digits of their absolute value. Ties are broken by the original value ascending. An empty list returns an empty list.", "signature": "def sort_by_reversed_digits_value(nums):", "visible_tests": ["assert sort_by_reversed_digits_value([12, 21]) == [21, 12]", "assert sort_by_reversed_digits_value([10, 1]) == [1, 10]", "assert sort_by_reversed_digits_value([5]) == [5]"], "hidden_tests": ["assert sort_by_reversed_digits_value([]) == []", "assert sort_by_reversed_digits_value([0]) == [0]", "assert sort_by_reversed_digits_value([-12, 12]) == [-12, 12]", "assert sort_by_reversed_digits_value([100, 1]) == [1, 100]", "assert sort_by_reversed_digits_value([123, 321]) == [321, 123]", "assert sort_by_reversed_digits_value([-100, -1]) == [-100, -1]", "assert sort_by_reversed_digits_value([15, 51, 510]) == [51, 510, 15]", "assert sort_by_reversed_digits_value([200, 2]) == [2, 200]", "assert sort_by_reversed_digits_value([11, 22, 33]) == [11, 22, 33]", "assert sort_by_reversed_digits_value([-21, -12]) == [-21, -12]", "assert sort_by_reversed_digits_value([1000, 1]) == [1, 1000]", "assert sort_by_reversed_digits_value([13, 31, 130]) == [31, 13, 130]", "assert sort_by_reversed_digits_value([-5, 5]) == [-5, 5]", "assert sort_by_reversed_digits_value([90, 9]) == [9, 90]", "assert sort_by_reversed_digits_value([102, 201, 120]) == [120, 201, 102]"], "reference": "def sort_by_reversed_digits_value(nums):\n    def rev(n):\n        return int(str(abs(n))[::-1])\n    return sorted(nums, key=lambda n: (rev(n), n))"}
{"tid": "srt-193", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of non-empty words, sort them ascending by the ratio of distinct characters to total length (a float between 0 and 1). Ties are broken alphabetically. An empty list returns an empty list.", "signature": "def sort_words_by_unique_letter_ratio(words):", "visible_tests": ["assert sort_words_by_unique_letter_ratio(['aab', 'abc']) == ['aab', 'abc']", "assert sort_words_by_unique_letter_ratio(['xx', 'xy']) == ['xx', 'xy']", "assert sort_words_by_unique_letter_ratio(['z']) == ['z']"], "hidden_tests": ["assert sort_words_by_unique_letter_ratio([]) == []", "assert sort_words_by_unique_letter_ratio(['a']) == ['a']", "assert sort_words_by_unique_letter_ratio(['aaaa', 'ab']) == ['aaaa', 'ab']", "assert sort_words_by_unique_letter_ratio(['abcd', 'aabb']) == ['aabb', 'abcd']", "assert sort_words_by_unique_letter_ratio(['mississippi', 'xyz']) == ['mississippi', 'xyz']", "assert sort_words_by_unique_letter_ratio(['aabbcc', 'abc']) == ['aabbcc', 'abc']", "assert sort_words_by_unique_letter_ratio(['a', 'aa', 'aaa']) == ['aaa', 'aa', 'a']", "assert sort_words_by_unique_letter_ratio(['banana', 'kiwi']) == ['banana', 'kiwi']", "assert sort_words_by_unique_letter_ratio(['hello', 'world']) == ['hello', 'world']", "assert sort_words_by_unique_letter_ratio(['ab', 'ba']) == ['ab', 'ba']", "assert sort_words_by_unique_letter_ratio(['zzz', 'yyy']) == ['yyy', 'zzz']", "assert sort_words_by_unique_letter_ratio(['one', 'two', 'three']) == ['three', 'one', 'two']", "assert sort_words_by_unique_letter_ratio(['repeated', 'unique']) == ['repeated', 'unique']", "assert sort_words_by_unique_letter_ratio(['cc', 'bb', 'aa']) == ['aa', 'bb', 'cc']", "assert sort_words_by_unique_letter_ratio(['abcdef', 'aabbcc']) == ['aabbcc', 'abcdef']"], "reference": "def sort_words_by_unique_letter_ratio(words):\n    def ratio(w):\n        return len(set(w)) / len(w)\n    return sorted(words, key=lambda w: (ratio(w), w))"}
{"tid": "srt-194", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of positive integers, sort them ascending by how many positive divisors they have. Ties are broken by the original value ascending. An empty list returns an empty list.", "signature": "def sort_by_factor_count(nums):", "visible_tests": ["assert sort_by_factor_count([4, 6, 7]) == [7, 4, 6]", "assert sort_by_factor_count([12, 13]) == [13, 12]", "assert sort_by_factor_count([1]) == [1]"], "hidden_tests": ["assert sort_by_factor_count([]) == []", "assert sort_by_factor_count([1, 1]) == [1, 1]", "assert sort_by_factor_count([2, 3, 5, 7]) == [2, 3, 5, 7]", "assert sort_by_factor_count([4, 9, 25]) == [4, 9, 25]", "assert sort_by_factor_count([6, 10, 14]) == [6, 10, 14]", "assert sort_by_factor_count([12, 18, 20]) == [12, 18, 20]", "assert sort_by_factor_count([1, 2, 3, 4, 5, 6]) == [1, 2, 3, 5, 4, 6]", "assert sort_by_factor_count([16, 17, 18]) == [17, 16, 18]", "assert sort_by_factor_count([30, 29, 28]) == [29, 28, 30]", "assert sort_by_factor_count([100, 99, 98]) == [98, 99, 100]", "assert sort_by_factor_count([8, 9, 10]) == [9, 8, 10]", "assert sort_by_factor_count([2]) == [2]", "assert sort_by_factor_count([36, 24, 48]) == [24, 36, 48]", "assert sort_by_factor_count([13, 17, 19]) == [13, 17, 19]", "assert sort_by_factor_count([15, 21, 35]) == [15, 21, 35]"], "reference": "def sort_by_factor_count(nums):\n    def divcount(n):\n        return sum(1 for d in range(1, n + 1) if n % d == 0)\n    return sorted(nums, key=lambda n: (divcount(n), n))"}
{"tid": "srt-195", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of strings, sort them alphabetically ignoring letter case. When two strings are equal ignoring case, break the tie using the original (case-sensitive) string comparison. An empty list returns an empty list.", "signature": "def sort_strings_ignoring_case(words):", "visible_tests": ["assert sort_strings_ignoring_case(['Banana', 'apple']) == ['apple', 'Banana']", "assert sort_strings_ignoring_case(['Cat', 'cat']) == ['Cat', 'cat']", "assert sort_strings_ignoring_case(['z']) == ['z']"], "hidden_tests": ["assert sort_strings_ignoring_case([]) == []", "assert sort_strings_ignoring_case(['']) == ['']", "assert sort_strings_ignoring_case(['A', 'a']) == ['A', 'a']", "assert sort_strings_ignoring_case(['Zebra', 'apple', 'Mango']) == ['apple', 'Mango', 'Zebra']", "assert sort_strings_ignoring_case(['abc', 'ABC', 'Abc']) == ['ABC', 'Abc', 'abc']", "assert sort_strings_ignoring_case(['dog', 'Cat', 'bird']) == ['bird', 'Cat', 'dog']", "assert sort_strings_ignoring_case(['AA', 'aa', 'Aa', 'aA']) == ['AA', 'Aa', 'aA', 'aa']", "assert sort_strings_ignoring_case(['hello', 'Hello', 'HELLO']) == ['HELLO', 'Hello', 'hello']", "assert sort_strings_ignoring_case(['b', 'B', 'a', 'A']) == ['A', 'a', 'B', 'b']", "assert sort_strings_ignoring_case(['Xray', 'xray']) == ['Xray', 'xray']", "assert sort_strings_ignoring_case(['kiwi', 'Kiwi', 'KIWI']) == ['KIWI', 'Kiwi', 'kiwi']", "assert sort_strings_ignoring_case(['one', 'Two', 'three']) == ['one', 'three', 'Two']", "assert sort_strings_ignoring_case(['Q', 'q']) == ['Q', 'q']", "assert sort_strings_ignoring_case(['Same', 'same', 'SAME']) == ['SAME', 'Same', 'same']", "assert sort_strings_ignoring_case(['m', 'M', 'n', 'N']) == ['M', 'm', 'N', 'n']"], "reference": "def sort_strings_ignoring_case(words):\n    return sorted(words, key=lambda w: (w.lower(), w))"}
{"tid": "srt-196", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of words, place all even-length words first, sorted by length ascending and alphabetically for ties, followed by all odd-length words sorted the same way. Return the concatenation of these two groups. An empty list returns an empty list.", "signature": "def sort_by_word_length_parity(words):", "visible_tests": ["assert sort_by_word_length_parity(['ab', 'a', 'abc']) == ['ab', 'a', 'abc']", "assert sort_by_word_length_parity(['cat', 'dogs']) == ['dogs', 'cat']", "assert sort_by_word_length_parity(['x']) == ['x']"], "hidden_tests": ["assert sort_by_word_length_parity([]) == []", "assert sort_by_word_length_parity(['']) == ['']", "assert sort_by_word_length_parity(['a', 'bb', 'ccc', 'dddd']) == ['bb', 'dddd', 'a', 'ccc']", "assert sort_by_word_length_parity(['hi', 'bye', 'ok', 'no']) == ['hi', 'no', 'ok', 'bye']", "assert sort_by_word_length_parity(['a', 'ab', 'abc', 'abcd', 'abcde']) == ['ab', 'abcd', 'a', 'abc', 'abcde']", "assert sort_by_word_length_parity(['aa', 'bb', 'cc']) == ['aa', 'bb', 'cc']", "assert sort_by_word_length_parity(['xyz', 'wv']) == ['wv', 'xyz']", "assert sort_by_word_length_parity(['one', 'two', 'three', 'four']) == ['four', 'one', 'two', 'three']", "assert sort_by_word_length_parity(['a', 'a', 'a']) == ['a', 'a', 'a']", "assert sort_by_word_length_parity(['ab', 'cd', 'ef']) == ['ab', 'cd', 'ef']", "assert sort_by_word_length_parity(['z', 'zz', 'zzz', 'zzzz', 'zzzzz']) == ['zz', 'zzzz', 'z', 'zzz', 'zzzzz']", "assert sort_by_word_length_parity(['ab', 'abcd', 'abcdef']) == ['ab', 'abcd', 'abcdef']", "assert sort_by_word_length_parity(['odd', 'even']) == ['even', 'odd']", "assert sort_by_word_length_parity(['a', 'bb']) == ['bb', 'a']", "assert sort_by_word_length_parity(['longword', 'short']) == ['longword', 'short']"], "reference": "def sort_by_word_length_parity(words):\n    even = sorted((w for w in words if len(w) % 2 == 0), key=lambda w: (len(w), w))\n    odd = sorted((w for w in words if len(w) % 2 == 1), key=lambda w: (len(w), w))\n    return even + odd"}
{"tid": "srt-197", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of integers (which may be negative), sort them ascending by the last digit of their absolute value. Ties are broken by the original value ascending. An empty list returns an empty list.", "signature": "def sort_by_last_digit(nums):", "visible_tests": ["assert sort_by_last_digit([12, 21, 3]) == [21, 12, 3]", "assert sort_by_last_digit([10, 20]) == [10, 20]", "assert sort_by_last_digit([5]) == [5]"], "hidden_tests": ["assert sort_by_last_digit([]) == []", "assert sort_by_last_digit([0]) == [0]", "assert sort_by_last_digit([-12, 12]) == [-12, 12]", "assert sort_by_last_digit([11, 21, 31]) == [11, 21, 31]", "assert sort_by_last_digit([100, 200, 300]) == [100, 200, 300]", "assert sort_by_last_digit([-9, 9]) == [-9, 9]", "assert sort_by_last_digit([15, 25, 35]) == [15, 25, 35]", "assert sort_by_last_digit([9, 19, 29]) == [9, 19, 29]", "assert sort_by_last_digit([-1, 1, 11, -11]) == [-11, -1, 1, 11]", "assert sort_by_last_digit([44, 33, 22]) == [22, 33, 44]", "assert sort_by_last_digit([0, 10, 20, 30]) == [0, 10, 20, 30]", "assert sort_by_last_digit([7, 17, 27, 37]) == [7, 17, 27, 37]", "assert sort_by_last_digit([-5, 5, -15, 15]) == [-15, -5, 5, 15]", "assert sort_by_last_digit([99, 88, 77]) == [77, 88, 99]", "assert sort_by_last_digit([101, 102, 103]) == [101, 102, 103]"], "reference": "def sort_by_last_digit(nums):\n    return sorted(nums, key=lambda n: (abs(n) % 10, n))"}
{"tid": "srt-198", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of integers and a positive integer m, sort the integers ascending by their remainder modulo m (using Python's modulo, which is always non-negative for a positive m). Ties are broken by the original value ascending. An empty list returns an empty list.", "signature": "def sort_by_remainder(nums, m):", "visible_tests": ["assert sort_by_remainder([7, 3, 10], 3) == [3, 7, 10]", "assert sort_by_remainder([5, 10, 15], 5) == [5, 10, 15]", "assert sort_by_remainder([1], 2) == [1]"], "hidden_tests": ["assert sort_by_remainder([], 5) == []", "assert sort_by_remainder([0], 3) == [0]", "assert sort_by_remainder([-1, 1], 3) == [1, -1]", "assert sort_by_remainder([-7, 7], 3) == [7, -7]", "assert sort_by_remainder([10, 20, 30], 4) == [20, 10, 30]", "assert sort_by_remainder([1, 2, 3, 4, 5, 6, 7], 3) == [3, 6, 1, 4, 7, 2, 5]", "assert sort_by_remainder([-5, -4, -3, -2, -1], 4) == [-4, -3, -2, -5, -1]", "assert sort_by_remainder([100, 101, 102], 10) == [100, 101, 102]", "assert sort_by_remainder([9, 18, 27], 9) == [9, 18, 27]", "assert sort_by_remainder([2, 4, 6, 8], 5) == [6, 2, 8, 4]", "assert sort_by_remainder([-10, -20, -30], 7) == [-20, -10, -30]", "assert sort_by_remainder([15, 16, 17, 18], 4) == [16, 17, 18, 15]", "assert sort_by_remainder([0, 0, 0], 5) == [0, 0, 0]", "assert sort_by_remainder([3, 6, 9, 12], 6) == [6, 12, 3, 9]", "assert sort_by_remainder([-3, 3, -6, 6], 4) == [-3, -6, 6, 3]"], "reference": "def sort_by_remainder(nums, m):\n    return sorted(nums, key=lambda n: (n % m, n))"}
{"tid": "srt-199", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of [name, scores] pairs where scores is a non-empty list of numbers, rank the names by the average of their scores, highest average first. Ties are broken alphabetically by name. Return the list of names in rank order.", "signature": "def weighted_score_rank(records):", "visible_tests": ["assert weighted_score_rank([['a', [1, 2, 3]], ['b', [4, 5, 6]]]) == ['b', 'a']", "assert weighted_score_rank([['x', [10]], ['y', [1]]]) == ['x', 'y']", "assert weighted_score_rank([['m', [5, 5]], ['n', [5, 5]]]) == ['m', 'n']"], "hidden_tests": ["assert weighted_score_rank([]) == []", "assert weighted_score_rank([['a', [1]]]) == ['a']", "assert weighted_score_rank([['a', [1, 1, 1]], ['b', [2, 2, 2]], ['c', [0, 0, 0]]]) == ['b', 'a', 'c']", "assert weighted_score_rank([['z', [5, 5]], ['y', [5, 5]]]) == ['y', 'z']", "assert weighted_score_rank([['a', [-1, -2]], ['b', [1, 2]]]) == ['b', 'a']", "assert weighted_score_rank([['p', [100]], ['q', [50]], ['r', [75]]]) == ['p', 'r', 'q']", "assert weighted_score_rank([['a', [1, 2, 3, 4, 5]]]) == ['a']", "assert weighted_score_rank([['a', [0]], ['b', [0]], ['c', [0]]]) == ['a', 'b', 'c']", "assert weighted_score_rank([['k', [10, 20]], ['j', [15, 15]]]) == ['j', 'k']", "assert weighted_score_rank([['a', [3]], ['b', [3]], ['c', [2]]]) == ['a', 'b', 'c']", "assert weighted_score_rank([['e', [1, 1, 1, 1]], ['d', [1, 1, 1, 1]]]) == ['d', 'e']", "assert weighted_score_rank([['a', [-5]], ['b', [5]]]) == ['b', 'a']", "assert weighted_score_rank([['one', [1, 2]], ['two', [3, 4]], ['three', [0, 0]]]) == ['two', 'one', 'three']", "assert weighted_score_rank([['a', [7, 7, 7]]]) == ['a']", "assert weighted_score_rank([['a', [2, 4]], ['b', [3, 3]]]) == ['a', 'b']"], "reference": "def weighted_score_rank(records):\n    def avg(scores):\n        return sum(scores) / len(scores)\n    return [r[0] for r in sorted(records, key=lambda r: (-avg(r[1]), r[0]))]"}
{"tid": "srt-200", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of scores between 0 and 100, label each with a quartile using fixed thresholds: 'Q4' for 75 or above, 'Q3' for 50 up to but not including 75, 'Q2' for 25 up to but not including 50, and 'Q1' for anything below 25. Return the list of labels in the same order as the input.", "signature": "def rank_percentile_bucket(scores):", "visible_tests": ["assert rank_percentile_bucket([90, 60, 30]) == ['Q4', 'Q3', 'Q2']", "assert rank_percentile_bucket([10, 20]) == ['Q1', 'Q1']", "assert rank_percentile_bucket([100]) == ['Q4']"], "hidden_tests": ["assert rank_percentile_bucket([]) == []", "assert rank_percentile_bucket([0]) == ['Q1']", "assert rank_percentile_bucket([24, 25]) == ['Q1', 'Q2']", "assert rank_percentile_bucket([49, 50]) == ['Q2', 'Q3']", "assert rank_percentile_bucket([74, 75]) == ['Q3', 'Q4']", "assert rank_percentile_bucket([99, 100]) == ['Q4', 'Q4']", "assert rank_percentile_bucket([0, 25, 50, 75]) == ['Q1', 'Q2', 'Q3', 'Q4']", "assert rank_percentile_bucket([100, 0]) == ['Q4', 'Q1']", "assert rank_percentile_bucket([25, 25, 25]) == ['Q2', 'Q2', 'Q2']", "assert rank_percentile_bucket([80, 20, 60, 40]) == ['Q4', 'Q1', 'Q3', 'Q2']", "assert rank_percentile_bucket([75, 75, 75]) == ['Q4', 'Q4', 'Q4']", "assert rank_percentile_bucket([1, 99]) == ['Q1', 'Q4']", "assert rank_percentile_bucket([26, 51, 76]) == ['Q2', 'Q3', 'Q4']", "assert rank_percentile_bucket([24, 49, 74, 99]) == ['Q1', 'Q2', 'Q3', 'Q4']", "assert rank_percentile_bucket([50, 50, 50, 50]) == ['Q3', 'Q3', 'Q3', 'Q3']"], "reference": "def rank_percentile_bucket(scores):\n    def label(s):\n        if s >= 75: return 'Q4'\n        if s >= 50: return 'Q3'\n        if s >= 25: return 'Q2'\n        return 'Q1'\n    return [label(s) for s in scores]"}
