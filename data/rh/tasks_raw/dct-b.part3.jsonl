{"tid": "dct-151", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given two dicts f and g representing mappings, build the composed mapping x -> g[f[x]] for every key x of f whose value f[x] is itself a key of g. Keys of f whose value is not found in g are omitted from the result. An empty f, or no matching keys, returns an empty dict.", "signature": "def compose_mappings(f, g):", "visible_tests": ["assert compose_mappings({'a': 'x', 'b': 'y'}, {'x': 1, 'y': 2}) == {'a': 1, 'b': 2}", "assert compose_mappings({'a': 'z'}, {'x': 1}) == {}", "assert compose_mappings({}, {'x': 1}) == {}"], "hidden_tests": ["assert compose_mappings({'a': 'x'}, {}) == {}", "assert compose_mappings({'a': 'b', 'b': 'c'}, {'b': 1, 'c': 2}) == {'a': 1, 'b': 2}", "assert compose_mappings({'a': 'b', 'c': 'd'}, {'b': 1}) == {'a': 1}", "assert compose_mappings({'1': '2', '2': '3'}, {'2': 'x', '3': 'y'}) == {'1': 'x', '2': 'y'}", "assert compose_mappings({'a': 'a'}, {'a': 1}) == {'a': 1}", "assert compose_mappings({'m': 'n', 'n': 'o', 'o': 'p'}, {'n': 10, 'o': 20, 'p': 30}) == {'m': 10, 'n': 20, 'o': 30}", "assert compose_mappings({'a': 1, 'b': 2}, {1: 'one', 2: 'two'}) == {'a': 'one', 'b': 'two'}", "assert compose_mappings({'k1': 'v1', 'k2': 'v2', 'k3': 'v3'}, {'v1': 100}) == {'k1': 100}", "assert compose_mappings({'x': 'y', 'y': 'x'}, {'y': 1, 'x': 2}) == {'x': 1, 'y': 2}", "assert compose_mappings({'a': 'missing'}, {'other': 1}) == {}", "assert compose_mappings({'only': 'found'}, {'found': 42}) == {'only': 42}", "assert compose_mappings({'a': 'b'}, {'b': 'c'}) == {'a': 'c'}", "assert compose_mappings({'p': 'q', 'r': 's'}, {'q': 5, 's': 6}) == {'p': 5, 'r': 6}", "assert compose_mappings({'a': 'x', 'b': 'y', 'c': 'z'}, {'x': 1, 'z': 3}) == {'a': 1, 'c': 3}", "assert compose_mappings({'chain1': 'chain2'}, {'chain2': 'value'}) == {'chain1': 'value'}"], "reference": "def compose_mappings(f, g):\n    return {x: g[f[x]] for x in f if f[x] in g}\n"}
{"tid": "dct-152", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict mapping keys to numbers, keep only the entries whose value is strictly positive, then invert them: build a dict mapping each such positive value to a sorted list of the keys that had it. Entries with a value less than or equal to zero are ignored entirely. An empty dict, or one with no positive values, returns an empty dict.", "signature": "def invert_filtered_positive(d):", "visible_tests": ["assert invert_filtered_positive({'a': 1, 'b': -1, 'c': 1}) == {1: ['a', 'c']}", "assert invert_filtered_positive({'x': 5}) == {5: ['x']}", "assert invert_filtered_positive({}) == {}"], "hidden_tests": ["assert invert_filtered_positive({'a': -1, 'b': -2}) == {}", "assert invert_filtered_positive({'a': 0}) == {}", "assert invert_filtered_positive({'a': 1, 'b': 2, 'c': 3}) == {1: ['a'], 2: ['b'], 3: ['c']}", "assert invert_filtered_positive({'a': 2, 'b': 2, 'c': -2, 'd': 2}) == {2: ['a', 'b', 'd']}", "assert invert_filtered_positive({'m': 1, 'n': -1, 'o': 0}) == {1: ['m']}", "assert invert_filtered_positive({'only_pos': 10}) == {10: ['only_pos']}", "assert invert_filtered_positive({'z': 1, 'y': 1, 'x': 1}) == {1: ['x', 'y', 'z']}", "assert invert_filtered_positive({'a': 5, 'b': -5, 'c': 5, 'd': -5}) == {5: ['a', 'c']}", "assert invert_filtered_positive({'p': 100}) == {100: ['p']}", "assert invert_filtered_positive({'a': 1, 'b': 1, 'c': 2, 'd': 2, 'e': 2}) == {1: ['a', 'b'], 2: ['c', 'd', 'e']}", "assert invert_filtered_positive({'neg1': -1, 'neg2': -2, 'neg3': -3}) == {}", "assert invert_filtered_positive({'a': 3, 'b': 3, 'c': 3, 'd': -3}) == {3: ['a', 'b', 'c']}", "assert invert_filtered_positive({'single_zero': 0}) == {}", "assert invert_filtered_positive({'k1': 7, 'k2': 8, 'k3': 7}) == {7: ['k1', 'k3'], 8: ['k2']}", "assert invert_filtered_positive({'a': 0.5, 'b': -0.5, 'c': 0.5}) == {0.5: ['a', 'c']}"], "reference": "def invert_filtered_positive(d):\n    result = {}\n    for k, v in d.items():\n        if v > 0:\n            result.setdefault(v, []).append(k)\n    return {v: sorted(ks) for v, ks in result.items()}\n"}
{"tid": "dct-153", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given two equal-length lists keys and values, build a dict by pairing them positionally. If a key appears more than once, keep the value from its first occurrence and ignore later ones. Empty lists return an empty dict.", "signature": "def zip_to_dict_first_wins(keys, values):", "visible_tests": ["assert zip_to_dict_first_wins(['a', 'b', 'a'], [1, 2, 3]) == {'a': 1, 'b': 2}", "assert zip_to_dict_first_wins(['x', 'y'], [10, 20]) == {'x': 10, 'y': 20}", "assert zip_to_dict_first_wins([], []) == {}"], "hidden_tests": ["assert zip_to_dict_first_wins(['a'], [1]) == {'a': 1}", "assert zip_to_dict_first_wins(['a', 'a', 'a'], [1, 2, 3]) == {'a': 1}", "assert zip_to_dict_first_wins(['a', 'b', 'c'], [1, 2, 3]) == {'a': 1, 'b': 2, 'c': 3}", "assert zip_to_dict_first_wins(['k', 'k'], [1, 2]) == {'k': 1}", "assert zip_to_dict_first_wins(['m', 'n', 'm', 'n', 'm'], [1, 2, 3, 4, 5]) == {'m': 1, 'n': 2}", "assert zip_to_dict_first_wins(['z'], [100]) == {'z': 100}", "assert zip_to_dict_first_wins(['a', 'b', 'a', 'b'], [1, 2, 3, 4]) == {'a': 1, 'b': 2}", "assert zip_to_dict_first_wins(['p', 'q', 'r', 'p'], [10, 20, 30, 40]) == {'p': 10, 'q': 20, 'r': 30}", "assert zip_to_dict_first_wins(['dup', 'dup', 'unique'], ['first', 'second', 'third']) == {'dup': 'first', 'unique': 'third'}", "assert zip_to_dict_first_wins(['1', '2', '1', '3'], [1, 2, 3, 4]) == {'1': 1, '2': 2, '3': 4}", "assert zip_to_dict_first_wins(['a', 'b', 'c', 'a', 'b', 'c'], [1, 2, 3, 4, 5, 6]) == {'a': 1, 'b': 2, 'c': 3}", "assert zip_to_dict_first_wins(['only'], ['value']) == {'only': 'value'}", "assert zip_to_dict_first_wins(['x', 'x', 'y', 'y', 'z'], [1, 2, 3, 4, 5]) == {'x': 1, 'y': 3, 'z': 5}", "assert zip_to_dict_first_wins(['a', 'b'], [None, None]) == {'a': None, 'b': None}", "assert zip_to_dict_first_wins(['rep', 'rep', 'rep', 'rep'], [1, 2, 3, 4]) == {'rep': 1}"], "reference": "def zip_to_dict_first_wins(keys, values):\n    result = {}\n    for k, v in zip(keys, values):\n        if k not in result:\n            result[k] = v\n    return result\n"}
{"tid": "dct-154", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given two equal-length lists keys and values, build a dict by pairing them positionally. If a key appears more than once, keep the value from its last occurrence, overwriting earlier ones. Empty lists return an empty dict.", "signature": "def zip_to_dict_last_wins(keys, values):", "visible_tests": ["assert zip_to_dict_last_wins(['a', 'b', 'a'], [1, 2, 3]) == {'a': 3, 'b': 2}", "assert zip_to_dict_last_wins(['x', 'y'], [10, 20]) == {'x': 10, 'y': 20}", "assert zip_to_dict_last_wins([], []) == {}"], "hidden_tests": ["assert zip_to_dict_last_wins(['a'], [1]) == {'a': 1}", "assert zip_to_dict_last_wins(['a', 'a', 'a'], [1, 2, 3]) == {'a': 3}", "assert zip_to_dict_last_wins(['a', 'b', 'c'], [1, 2, 3]) == {'a': 1, 'b': 2, 'c': 3}", "assert zip_to_dict_last_wins(['k', 'k'], [1, 2]) == {'k': 2}", "assert zip_to_dict_last_wins(['m', 'n', 'm', 'n', 'm'], [1, 2, 3, 4, 5]) == {'m': 5, 'n': 4}", "assert zip_to_dict_last_wins(['z'], [100]) == {'z': 100}", "assert zip_to_dict_last_wins(['a', 'b', 'a', 'b'], [1, 2, 3, 4]) == {'a': 3, 'b': 4}", "assert zip_to_dict_last_wins(['p', 'q', 'r', 'p'], [10, 20, 30, 40]) == {'p': 40, 'q': 20, 'r': 30}", "assert zip_to_dict_last_wins(['dup', 'dup', 'unique'], ['first', 'second', 'third']) == {'dup': 'second', 'unique': 'third'}", "assert zip_to_dict_last_wins(['1', '2', '1', '3'], [1, 2, 3, 4]) == {'1': 3, '2': 2, '3': 4}", "assert zip_to_dict_last_wins(['a', 'b', 'c', 'a', 'b', 'c'], [1, 2, 3, 4, 5, 6]) == {'a': 4, 'b': 5, 'c': 6}", "assert zip_to_dict_last_wins(['only'], ['value']) == {'only': 'value'}", "assert zip_to_dict_last_wins(['x', 'x', 'y', 'y', 'z'], [1, 2, 3, 4, 5]) == {'x': 2, 'y': 4, 'z': 5}", "assert zip_to_dict_last_wins(['a', 'b'], [None, None]) == {'a': None, 'b': None}", "assert zip_to_dict_last_wins(['rep', 'rep', 'rep', 'rep'], [1, 2, 3, 4]) == {'rep': 4}"], "reference": "def zip_to_dict_last_wins(keys, values):\n    result = {}\n    for k, v in zip(keys, values):\n        result[k] = v\n    return result\n"}
{"tid": "dct-155", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of strings each formatted as 'key<sep>value' (splitting only on the first occurrence of sep so the value may itself contain sep), parse them into a dict. If the same key appears more than once, keep the value from its first occurrence. An empty list returns an empty dict.", "signature": "def parse_kv_strings_first(strs, sep):", "visible_tests": ["assert parse_kv_strings_first(['a=1', 'b=2', 'a=3'], '=') == {'a': '1', 'b': '2'}", "assert parse_kv_strings_first(['x=10', 'y=20'], '=') == {'x': '10', 'y': '20'}", "assert parse_kv_strings_first([], '=') == {}"], "hidden_tests": ["assert parse_kv_strings_first(['a=1'], '=') == {'a': '1'}", "assert parse_kv_strings_first(['a=1', 'a=2', 'a=3'], '=') == {'a': '1'}", "assert parse_kv_strings_first(['k:1', 'k:2'], ':') == {'k': '1'}", "assert parse_kv_strings_first(['a=1=2'], '=') == {'a': '1=2'}", "assert parse_kv_strings_first(['p=1', 'q=2', 'p=3', 'q=4'], '=') == {'p': '1', 'q': '2'}", "assert parse_kv_strings_first(['name=Alice', 'name=Bob'], '=') == {'name': 'Alice'}", "assert parse_kv_strings_first(['single=value'], '=') == {'single': 'value'}", "assert parse_kv_strings_first(['a-1', 'b-2'], '-') == {'a': '1', 'b': '2'}", "assert parse_kv_strings_first(['x=1', 'y=2', 'z=3'], '=') == {'x': '1', 'y': '2', 'z': '3'}", "assert parse_kv_strings_first(['dup=first', 'dup=second', 'dup=third'], '=') == {'dup': 'first'}", "assert parse_kv_strings_first(['a=', 'a=nonempty'], '=') == {'a': ''}", "assert parse_kv_strings_first(['1=one', '2=two', '1=three'], '=') == {'1': 'one', '2': 'two'}", "assert parse_kv_strings_first(['k=v1', 'k=v2', 'j=v3'], '=') == {'k': 'v1', 'j': 'v3'}", "assert parse_kv_strings_first(['only=one'], '=') == {'only': 'one'}", "assert parse_kv_strings_first(['a:x:y', 'a:z'], ':') == {'a': 'x:y'}"], "reference": "def parse_kv_strings_first(strs, sep):\n    result = {}\n    for s in strs:\n        k, v = s.split(sep, 1)\n        if k not in result:\n            result[k] = v\n    return result\n"}
{"tid": "dct-156", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of strings each formatted as 'key<sep>value' (splitting only on the first occurrence of sep so the value may itself contain sep), parse them into a dict. If the same key appears more than once, keep the value from its last occurrence. An empty list returns an empty dict.", "signature": "def parse_kv_strings_last(strs, sep):", "visible_tests": ["assert parse_kv_strings_last(['a=1', 'b=2', 'a=3'], '=') == {'a': '3', 'b': '2'}", "assert parse_kv_strings_last(['x=10', 'y=20'], '=') == {'x': '10', 'y': '20'}", "assert parse_kv_strings_last([], '=') == {}"], "hidden_tests": ["assert parse_kv_strings_last(['a=1'], '=') == {'a': '1'}", "assert parse_kv_strings_last(['a=1', 'a=2', 'a=3'], '=') == {'a': '3'}", "assert parse_kv_strings_last(['k:1', 'k:2'], ':') == {'k': '2'}", "assert parse_kv_strings_last(['a=1=2'], '=') == {'a': '1=2'}", "assert parse_kv_strings_last(['p=1', 'q=2', 'p=3', 'q=4'], '=') == {'p': '3', 'q': '4'}", "assert parse_kv_strings_last(['name=Alice', 'name=Bob'], '=') == {'name': 'Bob'}", "assert parse_kv_strings_last(['single=value'], '=') == {'single': 'value'}", "assert parse_kv_strings_last(['a-1', 'b-2'], '-') == {'a': '1', 'b': '2'}", "assert parse_kv_strings_last(['x=1', 'y=2', 'z=3'], '=') == {'x': '1', 'y': '2', 'z': '3'}", "assert parse_kv_strings_last(['dup=first', 'dup=second', 'dup=third'], '=') == {'dup': 'third'}", "assert parse_kv_strings_last(['a=', 'a=nonempty'], '=') == {'a': 'nonempty'}", "assert parse_kv_strings_last(['1=one', '2=two', '1=three'], '=') == {'1': 'three', '2': 'two'}", "assert parse_kv_strings_last(['k=v1', 'k=v2', 'j=v3'], '=') == {'k': 'v2', 'j': 'v3'}", "assert parse_kv_strings_last(['only=one'], '=') == {'only': 'one'}", "assert parse_kv_strings_last(['a:x:y', 'a:z'], ':') == {'a': 'z'}"], "reference": "def parse_kv_strings_last(strs, sep):\n    result = {}\n    for s in strs:\n        k, v = s.split(sep, 1)\n        result[k] = v\n    return result\n"}
{"tid": "dct-157", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict d and a separator string sep, format each entry as 'key<sep>value' and return the resulting list of strings sorted alphabetically. An empty dict returns an empty list.", "signature": "def dict_to_kv_strings(d, sep):", "visible_tests": ["assert dict_to_kv_strings({'b': 2, 'a': 1}, '=') == ['a=1', 'b=2']", "assert dict_to_kv_strings({'x': 1}, ':') == ['x:1']", "assert dict_to_kv_strings({}, '=') == []"], "hidden_tests": ["assert dict_to_kv_strings({'z': 1, 'a': 2, 'm': 3}, '=') == ['a=2', 'm=3', 'z=1']", "assert dict_to_kv_strings({'a': 1, 'b': 2, 'c': 3}, '-') == ['a-1', 'b-2', 'c-3']", "assert dict_to_kv_strings({'single': 'value'}, '=') == ['single=value']", "assert dict_to_kv_strings({'1': 'one', '2': 'two'}, ':') == ['1:one', '2:two']", "assert dict_to_kv_strings({'k': None}, '=') == ['k=None']", "assert dict_to_kv_strings({'a': 1, 'aa': 2, 'aaa': 3}, '=') == ['a=1', 'aa=2', 'aaa=3']", "assert dict_to_kv_strings({'same_val': 1, 'same_val2': 1}, '=') == ['same_val2=1', 'same_val=1']", "assert dict_to_kv_strings({'p': True, 'q': False}, '=') == ['p=True', 'q=False']", "assert dict_to_kv_strings({'a': 1.5, 'b': 2.5}, '=') == ['a=1.5', 'b=2.5']", "assert dict_to_kv_strings({'c': 3, 'b': 2, 'a': 1, 'd': 4}, '|') == ['a|1', 'b|2', 'c|3', 'd|4']", "assert dict_to_kv_strings({'only_key': 'only_val'}, '->') == ['only_key->only_val']", "assert dict_to_kv_strings({'x': -1, 'y': -2}, '=') == ['x=-1', 'y=-2']", "assert dict_to_kv_strings({'a': [1, 2]}, '=') == ['a=[1, 2]']", "assert dict_to_kv_strings({'upper': 'A', 'lower': 'a'}, '=') == ['lower=a', 'upper=A']", "assert dict_to_kv_strings({'first': 1, 'second': 2, 'third': 3}, ';') == ['first;1', 'second;2', 'third;3']"], "reference": "def dict_to_kv_strings(d, sep):\n    return sorted(f\"{k}{sep}{v}\" for k, v in d.items())\n"}
{"tid": "dct-158", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict whose values are lists all of the same length (a column-oriented table), transpose it into a list of row dicts: the i-th row dict maps each key to the i-th element of its list. An empty dict returns an empty list. If the lists have length 0, return an empty list.", "signature": "def transpose_dict_of_lists(d):", "visible_tests": ["assert transpose_dict_of_lists({'a': [1, 2], 'b': [3, 4]}) == [{'a': 1, 'b': 3}, {'a': 2, 'b': 4}]", "assert transpose_dict_of_lists({'x': [1]}) == [{'x': 1}]", "assert transpose_dict_of_lists({}) == []"], "hidden_tests": ["assert transpose_dict_of_lists({'a': []}) == []", "assert transpose_dict_of_lists({'a': [1, 2, 3], 'b': [4, 5, 6]}) == [{'a': 1, 'b': 4}, {'a': 2, 'b': 5}, {'a': 3, 'b': 6}]", "assert transpose_dict_of_lists({'name': ['Alice', 'Bob'], 'age': [30, 25]}) == [{'name': 'Alice', 'age': 30}, {'name': 'Bob', 'age': 25}]", "assert transpose_dict_of_lists({'a': [1], 'b': [2], 'c': [3]}) == [{'a': 1, 'b': 2, 'c': 3}]", "assert transpose_dict_of_lists({'single_col': [1, 2, 3, 4]}) == [{'single_col': 1}, {'single_col': 2}, {'single_col': 3}, {'single_col': 4}]", "assert transpose_dict_of_lists({'a': [1, 2], 'b': [3, 4], 'c': [5, 6]}) == [{'a': 1, 'b': 3, 'c': 5}, {'a': 2, 'b': 4, 'c': 6}]", "assert transpose_dict_of_lists({'x': [True, False], 'y': [False, True]}) == [{'x': True, 'y': False}, {'x': False, 'y': True}]", "assert transpose_dict_of_lists({'k1': ['a', 'b', 'c'], 'k2': ['d', 'e', 'f']}) == [{'k1': 'a', 'k2': 'd'}, {'k1': 'b', 'k2': 'e'}, {'k1': 'c', 'k2': 'f'}]", "assert transpose_dict_of_lists({'only': [42]}) == [{'only': 42}]", "assert transpose_dict_of_lists({'a': [None, None]}) == [{'a': None}, {'a': None}]", "assert transpose_dict_of_lists({'m': [1, 2, 3], 'n': [4, 5, 6], 'o': [7, 8, 9]}) == [{'m': 1, 'n': 4, 'o': 7}, {'m': 2, 'n': 5, 'o': 8}, {'m': 3, 'n': 6, 'o': 9}]", "assert transpose_dict_of_lists({'p': [1.5, 2.5]}) == [{'p': 1.5}, {'p': 2.5}]", "assert transpose_dict_of_lists({'empty_list': []}) == []", "assert transpose_dict_of_lists({'a': [1, 2, 3, 4, 5]}) == [{'a': 1}, {'a': 2}, {'a': 3}, {'a': 4}, {'a': 5}]", "assert transpose_dict_of_lists({'a': [1, 2], 'b': [3, 4], 'c': [5, 6], 'd': [7, 8]}) == [{'a': 1, 'b': 3, 'c': 5, 'd': 7}, {'a': 2, 'b': 4, 'c': 6, 'd': 8}]"], "reference": "def transpose_dict_of_lists(d):\n    if not d:\n        return []\n    n = len(next(iter(d.values())))\n    return [{k: d[k][i] for k in d} for i in range(n)]\n"}
{"tid": "dct-159", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a non-empty list of dicts (rows) that all share the same set of keys, transpose it into a dict of lists (a column-oriented table): each key maps to a list of its values across the rows, in the original row order. An empty list returns an empty dict.", "signature": "def transpose_list_of_dicts(records):", "visible_tests": ["assert transpose_list_of_dicts([{'a': 1, 'b': 3}, {'a': 2, 'b': 4}]) == {'a': [1, 2], 'b': [3, 4]}", "assert transpose_list_of_dicts([{'x': 1}]) == {'x': [1]}", "assert transpose_list_of_dicts([]) == {}"], "hidden_tests": ["assert transpose_list_of_dicts([{'a': 1}, {'a': 2}, {'a': 3}]) == {'a': [1, 2, 3]}", "assert transpose_list_of_dicts([{'name': 'Alice', 'age': 30}, {'name': 'Bob', 'age': 25}]) == {'name': ['Alice', 'Bob'], 'age': [30, 25]}", "assert transpose_list_of_dicts([{'a': 1, 'b': 2, 'c': 3}]) == {'a': [1], 'b': [2], 'c': [3]}", "assert transpose_list_of_dicts([{'k': True}, {'k': False}]) == {'k': [True, False]}", "assert transpose_list_of_dicts([{'m': 1, 'n': 2}, {'m': 3, 'n': 4}, {'m': 5, 'n': 6}]) == {'m': [1, 3, 5], 'n': [2, 4, 6]}", "assert transpose_list_of_dicts([{'only': 42}]) == {'only': [42]}", "assert transpose_list_of_dicts([{'a': None}, {'a': None}]) == {'a': [None, None]}", "assert transpose_list_of_dicts([{'p': 1.5}, {'p': 2.5}]) == {'p': [1.5, 2.5]}", "assert transpose_list_of_dicts([{'x': 1, 'y': 1}, {'x': 2, 'y': 2}, {'x': 3, 'y': 3}, {'x': 4, 'y': 4}]) == {'x': [1, 2, 3, 4], 'y': [1, 2, 3, 4]}", "assert transpose_list_of_dicts([{'a': 'x'}, {'a': 'y'}, {'a': 'z'}]) == {'a': ['x', 'y', 'z']}", "assert transpose_list_of_dicts([{'col1': 1, 'col2': 2, 'col3': 3}, {'col1': 4, 'col2': 5, 'col3': 6}]) == {'col1': [1, 4], 'col2': [2, 5], 'col3': [3, 6]}", "assert transpose_list_of_dicts([{'single_row': 1}]) == {'single_row': [1]}", "assert transpose_list_of_dicts([{'a': 1, 'b': 2}, {'a': 1, 'b': 2}]) == {'a': [1, 1], 'b': [2, 2]}", "assert transpose_list_of_dicts([{'c1': 1, 'c2': 2, 'c3': 3}, {'c1': 4, 'c2': 5, 'c3': 6}, {'c1': 7, 'c2': 8, 'c3': 9}]) == {'c1': [1, 4, 7], 'c2': [2, 5, 8], 'c3': [3, 6, 9]}", "assert transpose_list_of_dicts([{'only_a': 'x'}, {'only_a': 'y'}]) == {'only_a': ['x', 'y']}"], "reference": "def transpose_list_of_dicts(records):\n    if not records:\n        return {}\n    keys = records[0].keys()\n    return {k: [r[k] for r in records] for k in keys}\n"}
{"tid": "dct-160", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of (key, value) tuples, build a dict mapping each key to a list of all the values associated with it, in the order they were encountered, keeping duplicate values (unlike a set-based grouping). An empty list returns an empty dict.", "signature": "def multidict_from_pairs(pairs):", "visible_tests": ["assert multidict_from_pairs([('a', 1), ('b', 2), ('a', 3)]) == {'a': [1, 3], 'b': [2]}", "assert multidict_from_pairs([('x', 1)]) == {'x': [1]}", "assert multidict_from_pairs([]) == {}"], "hidden_tests": ["assert multidict_from_pairs([('a', 1), ('a', 1)]) == {'a': [1, 1]}", "assert multidict_from_pairs([('a', 1), ('a', 2), ('a', 3)]) == {'a': [1, 2, 3]}", "assert multidict_from_pairs([('k', 1), ('j', 2), ('k', 3), ('j', 4)]) == {'k': [1, 3], 'j': [2, 4]}", "assert multidict_from_pairs([('only', 'value')]) == {'only': ['value']}", "assert multidict_from_pairs([('a', 1), ('b', 2), ('c', 3)]) == {'a': [1], 'b': [2], 'c': [3]}", "assert multidict_from_pairs([('z', 1), ('z', 2), ('z', 3), ('z', 4)]) == {'z': [1, 2, 3, 4]}", "assert multidict_from_pairs([('m', 'x'), ('n', 'y'), ('m', 'z')]) == {'m': ['x', 'z'], 'n': ['y']}", "assert multidict_from_pairs([('1', 1), ('2', 2), ('1', 3)]) == {'1': [1, 3], '2': [2]}", "assert multidict_from_pairs([('p', None), ('p', None)]) == {'p': [None, None]}", "assert multidict_from_pairs([('a', 1), ('a', 1), ('b', 2)]) == {'a': [1, 1], 'b': [2]}", "assert multidict_from_pairs([('dup', 'v1'), ('dup', 'v2'), ('dup', 'v3'), ('other', 'v4')]) == {'dup': ['v1', 'v2', 'v3'], 'other': ['v4']}", "assert multidict_from_pairs([('x', 1), ('y', 2), ('x', 3), ('y', 4), ('x', 5)]) == {'x': [1, 3, 5], 'y': [2, 4]}", "assert multidict_from_pairs([('solo', 1)]) == {'solo': [1]}", "assert multidict_from_pairs([('a', True), ('a', False)]) == {'a': [True, False]}", "assert multidict_from_pairs([('g1', 1), ('g2', 2), ('g1', 3), ('g3', 4)]) == {'g1': [1, 3], 'g2': [2], 'g3': [4]}"], "reference": "def multidict_from_pairs(pairs):\n    result = {}\n    for k, v in pairs:\n        result.setdefault(k, []).append(v)\n    return result\n"}
{"tid": "dct-161", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of (key, value) tuples with numeric values, sum only the strictly positive values for each key, ignoring entries whose value is zero or negative. Return a dict mapping each key that had at least one positive value to that sum; keys with no positive values are omitted entirely. An empty list returns an empty dict.", "signature": "def sum_positive_by_key(pairs):", "visible_tests": ["assert sum_positive_by_key([('a', 1), ('a', -2), ('b', 3)]) == {'a': 1, 'b': 3}", "assert sum_positive_by_key([('x', 5)]) == {'x': 5}", "assert sum_positive_by_key([]) == {}"], "hidden_tests": ["assert sum_positive_by_key([('a', -1), ('a', -2)]) == {}", "assert sum_positive_by_key([('a', 0)]) == {}", "assert sum_positive_by_key([('a', 1), ('a', 2), ('a', 3)]) == {'a': 6}", "assert sum_positive_by_key([('k', 5), ('j', -5), ('k', -5), ('j', 5)]) == {'k': 5, 'j': 5}", "assert sum_positive_by_key([('only_pos', 10)]) == {'only_pos': 10}", "assert sum_positive_by_key([('only_neg', -10)]) == {}", "assert sum_positive_by_key([('m', 1), ('n', 2), ('m', -1), ('n', -2)]) == {'m': 1, 'n': 2}", "assert sum_positive_by_key([('z', 100), ('z', -50), ('z', 25)]) == {'z': 125}", "assert sum_positive_by_key([('a', 0), ('a', 1), ('a', -1)]) == {'a': 1}", "assert sum_positive_by_key([('p', 3), ('q', -3), ('p', 3), ('q', 3)]) == {'p': 6, 'q': 3}", "assert sum_positive_by_key([('single', 7)]) == {'single': 7}", "assert sum_positive_by_key([('a', 1), ('b', 1), ('c', 1), ('a', -1), ('b', -1), ('c', 2)]) == {'a': 1, 'b': 1, 'c': 3}", "assert sum_positive_by_key([('neg_zero', 0), ('neg_zero', 0)]) == {}", "assert sum_positive_by_key([('mixed', 10), ('mixed', -20), ('mixed', 30)]) == {'mixed': 40}", "assert sum_positive_by_key([('last', -1), ('last', -2), ('last', -3)]) == {}"], "reference": "def sum_positive_by_key(pairs):\n    result = {}\n    for k, v in pairs:\n        if v > 0:\n            result[k] = result.get(k, 0) + v\n    return result\n"}
{"tid": "dct-162", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of (key, value) tuples with numeric values, compute the average value for each distinct key, rounded to 2 decimal places. Return a dict mapping each key to its average. An empty list returns an empty dict.", "signature": "def average_by_key_from_pairs(pairs):", "visible_tests": ["assert average_by_key_from_pairs([('a', 1), ('a', 3), ('b', 5)]) == {'a': 2.0, 'b': 5.0}", "assert average_by_key_from_pairs([('x', 10)]) == {'x': 10.0}", "assert average_by_key_from_pairs([]) == {}"], "hidden_tests": ["assert average_by_key_from_pairs([('a', 1), ('a', 2), ('a', 3)]) == {'a': 2.0}", "assert average_by_key_from_pairs([('k', 1), ('j', 2), ('k', 3), ('j', 4)]) == {'k': 2.0, 'j': 3.0}", "assert average_by_key_from_pairs([('only', 7)]) == {'only': 7.0}", "assert average_by_key_from_pairs([('a', 1), ('a', 2)]) == {'a': 1.5}", "assert average_by_key_from_pairs([('m', 10), ('m', 20), ('m', 30)]) == {'m': 20.0}", "assert average_by_key_from_pairs([('z', -5), ('z', 5)]) == {'z': 0.0}", "assert average_by_key_from_pairs([('p', 1), ('q', 2), ('r', 3)]) == {'p': 1.0, 'q': 2.0, 'r': 3.0}", "assert average_by_key_from_pairs([('a', 1), ('a', 1), ('a', 1), ('a', 1)]) == {'a': 1.0}", "assert average_by_key_from_pairs([('x', 1), ('x', 2), ('y', 3), ('y', 4), ('y', 5)]) == {'x': 1.5, 'y': 4.0}", "assert average_by_key_from_pairs([('neg', -10), ('neg', -20)]) == {'neg': -15.0}", "assert average_by_key_from_pairs([('frac', 1), ('frac', 2), ('frac', 4)]) == {'frac': 2.33}", "assert average_by_key_from_pairs([('a', 0), ('a', 0)]) == {'a': 0.0}", "assert average_by_key_from_pairs([('solo', 100)]) == {'solo': 100.0}", "assert average_by_key_from_pairs([('k1', 5), ('k2', 10), ('k1', 15), ('k2', 20)]) == {'k1': 10.0, 'k2': 15.0}", "assert average_by_key_from_pairs([('a', 2), ('a', 4), ('a', 6), ('a', 8)]) == {'a': 5.0}"], "reference": "def average_by_key_from_pairs(pairs):\n    sums = {}\n    counts = {}\n    for k, v in pairs:\n        sums[k] = sums.get(k, 0) + v\n        counts[k] = counts.get(k, 0) + 1\n    return {k: round(sums[k] / counts[k], 2) for k in sums}\n"}
{"tid": "dct-163", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of dicts with numeric values, compute for each key that appears in at least one dict the minimum and maximum value seen for it across all dicts that contain it. Return a dict mapping each such key to a tuple (min, max). An empty list returns an empty dict.", "signature": "def min_max_across_dicts(records):", "visible_tests": ["assert min_max_across_dicts([{'a': 1, 'b': 5}, {'a': 3, 'b': 2}]) == {'a': (1, 3), 'b': (2, 5)}", "assert min_max_across_dicts([{'x': 10}]) == {'x': (10, 10)}", "assert min_max_across_dicts([]) == {}"], "hidden_tests": ["assert min_max_across_dicts([{'a': 1}]) == {'a': (1, 1)}", "assert min_max_across_dicts([{'a': 1}, {'a': 1}]) == {'a': (1, 1)}", "assert min_max_across_dicts([{'a': 5}, {'b': 10}]) == {'a': (5, 5), 'b': (10, 10)}", "assert min_max_across_dicts([{'a': 1, 'b': 2}, {'a': 3, 'b': 4}, {'a': 5, 'b': 6}]) == {'a': (1, 5), 'b': (2, 6)}", "assert min_max_across_dicts([{'k': -5}, {'k': 5}, {'k': 0}]) == {'k': (-5, 5)}", "assert min_max_across_dicts([{'only': 42}]) == {'only': (42, 42)}", "assert min_max_across_dicts([{'m': 1, 'n': 2}, {'n': 3, 'o': 4}]) == {'m': (1, 1), 'n': (2, 3), 'o': (4, 4)}", "assert min_max_across_dicts([{'a': 100}, {'a': 50}, {'a': 75}]) == {'a': (50, 100)}", "assert min_max_across_dicts([{'z': 1.5}, {'z': 2.5}]) == {'z': (1.5, 2.5)}", "assert min_max_across_dicts([{'p': 1, 'q': 1}, {'p': 1, 'q': 1}]) == {'p': (1, 1), 'q': (1, 1)}", "assert min_max_across_dicts([{'a': -10}, {'a': -20}, {'a': -5}]) == {'a': (-20, -5)}", "assert min_max_across_dicts([{'x': 1, 'y': 1, 'z': 1}]) == {'x': (1, 1), 'y': (1, 1), 'z': (1, 1)}", "assert min_max_across_dicts([{'k1': 3}, {'k2': 4}, {'k1': 1}, {'k2': 9}]) == {'k1': (1, 3), 'k2': (4, 9)}", "assert min_max_across_dicts([{'a': 0}, {'a': -1}, {'a': 1}]) == {'a': (-1, 1)}", "assert min_max_across_dicts([{'w': 3, 'v': 4}, {'w': 1, 'v': 8}]) == {'w': (1, 3), 'v': (4, 8)}"], "reference": "def min_max_across_dicts(records):\n    mins = {}\n    maxs = {}\n    for r in records:\n        for k, v in r.items():\n            if k not in mins or v < mins[k]:\n                mins[k] = v\n            if k not in maxs or v > maxs[k]:\n                maxs[k] = v\n    return {k: (mins[k], maxs[k]) for k in mins}\n"}
{"tid": "dct-164", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict mapping keys to non-empty lists of numbers, compute the range (max minus min) of each list. Return a dict mapping each key to that range. An empty dict returns an empty dict.", "signature": "def range_by_key(d):", "visible_tests": ["assert range_by_key({'a': [1, 5, 3]}) == {'a': 4}", "assert range_by_key({'x': [10]}) == {'x': 0}", "assert range_by_key({}) == {}"], "hidden_tests": ["assert range_by_key({'a': [1, 1, 1]}) == {'a': 0}", "assert range_by_key({'a': [-5, 5]}) == {'a': 10}", "assert range_by_key({'m': [1, 2, 3], 'n': [10, 20, 30]}) == {'m': 2, 'n': 20}", "assert range_by_key({'z': [100]}) == {'z': 0}", "assert range_by_key({'k': [-10, -20, -30]}) == {'k': 20}", "assert range_by_key({'a': [1.5, 2.5, 3.5]}) == {'a': 2.0}", "assert range_by_key({'single': [7, 3, 9, 1]}) == {'single': 8}", "assert range_by_key({'a': [0, 0, 0]}) == {'a': 0}", "assert range_by_key({'p': [1, 2], 'q': [3, 4], 'r': [5, 6]}) == {'p': 1, 'q': 1, 'r': 1}", "assert range_by_key({'x': [1000000, -1000000]}) == {'x': 2000000}", "assert range_by_key({'a': [5]}) == {'a': 0}", "assert range_by_key({'b': [2, 8, 4, 6]}) == {'b': 6}", "assert range_by_key({'c': [-1, -2, -3, -4]}) == {'c': 3}", "assert range_by_key({'d': [1, 2, 3, 4, 5, 6, 7]}) == {'d': 6}", "assert range_by_key({'e': [3, 3, 3, 9]}) == {'e': 6}"], "reference": "def range_by_key(d):\n    return {k: (max(v) - min(v)) for k, v in d.items()}\n"}
{"tid": "dct-165", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given two dicts with the same keys, values mapping each key to a number and weights mapping each key to its weight, compute the overall weighted average: the sum of value times weight over all keys, divided by the sum of the weights. If the total weight is 0 (including when both dicts are empty), return 0.0.", "signature": "def weighted_average(values, weights):", "visible_tests": ["assert abs(weighted_average({'a': 10, 'b': 20}, {'a': 1, 'b': 1}) - (15.0)) < 1e-9", "assert abs(weighted_average({'x': 5}, {'x': 2}) - (5.0)) < 1e-9", "assert abs(weighted_average({}, {}) - (0.0)) < 1e-9"], "hidden_tests": ["assert abs(weighted_average({'a': 10}, {'a': 0}) - (0.0)) < 1e-9", "assert abs(weighted_average({'a': 1, 'b': 2, 'c': 3}, {'a': 1, 'b': 1, 'c': 1}) - (2.0)) < 1e-9", "assert abs(weighted_average({'a': 100, 'b': 0}, {'a': 1, 'b': 1}) - (50.0)) < 1e-9", "assert abs(weighted_average({'a': 10, 'b': 20, 'c': 30}, {'a': 3, 'b': 2, 'c': 1}) - (16.666666666666668)) < 1e-9", "assert abs(weighted_average({'m': -5, 'n': 5}, {'m': 1, 'n': 1}) - (0.0)) < 1e-9", "assert abs(weighted_average({'only': 42}, {'only': 5}) - (42.0)) < 1e-9", "assert abs(weighted_average({'a': 1, 'b': 1}, {'a': 0, 'b': 0}) - (0.0)) < 1e-9", "assert abs(weighted_average({'a': 2, 'b': 4, 'c': 6}, {'a': 1, 'b': 1, 'c': 1}) - (4.0)) < 1e-9", "assert abs(weighted_average({'x': 10, 'y': 90}, {'x': 9, 'y': 1}) - (18.0)) < 1e-9", "assert abs(weighted_average({'a': 5, 'b': 15}, {'a': 3, 'b': 1}) - (7.5)) < 1e-9", "assert abs(weighted_average({'p': 1, 'q': 2, 'r': 3, 's': 4}, {'p': 1, 'q': 1, 'r': 1, 's': 1}) - (2.5)) < 1e-9", "assert abs(weighted_average({'a': 0, 'b': 0}, {'a': 1, 'b': 1}) - (0.0)) < 1e-9", "assert abs(weighted_average({'a': 7}, {'a': 1}) - (7.0)) < 1e-9", "assert abs(weighted_average({'a': 1, 'b': 2}, {'a': 5, 'b': 5}) - (1.5)) < 1e-9", "assert abs(weighted_average({'only1': 8, 'only2': 2}, {'only1': 1, 'only2': 1}) - (5.0)) < 1e-9"], "reference": "def weighted_average(values, weights):\n    total_weight = sum(weights[k] for k in values)\n    if total_weight == 0:\n        return 0.0\n    return sum(values[k] * weights[k] for k in values) / total_weight\n"}
{"tid": "dct-166", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of dicts with numeric values, compute for every key that appears in at least one dict the average of its value across ALL the dicts in the list, treating a dict that is missing the key as contributing 0 (so the divisor is always the total number of dicts, not just those containing the key). Round each average to 2 decimal places. An empty list returns an empty dict.", "signature": "def average_across_dicts_zero_fill(dicts_list):", "visible_tests": ["assert average_across_dicts_zero_fill([{'a': 10}, {'a': 20}]) == {'a': 15.0}", "assert average_across_dicts_zero_fill([{'a': 1, 'b': 2}]) == {'b': 2.0, 'a': 1.0}", "assert average_across_dicts_zero_fill([]) == {}"], "hidden_tests": ["assert average_across_dicts_zero_fill([{'a': 10}, {}]) == {'a': 5.0}", "assert average_across_dicts_zero_fill([{'a': 1}, {'b': 1}]) == {'b': 0.5, 'a': 0.5}", "assert average_across_dicts_zero_fill([{'a': 1}, {'a': 2}, {'a': 3}]) == {'a': 2.0}", "assert average_across_dicts_zero_fill([{}]) == {}", "assert average_across_dicts_zero_fill([{}, {}]) == {}", "assert average_across_dicts_zero_fill([{'a': 5, 'b': 5}, {'a': 5}]) == {'b': 2.5, 'a': 5.0}", "assert average_across_dicts_zero_fill([{'x': 10}, {'y': 20}, {'z': 30}]) == {'z': 10.0, 'x': 3.33, 'y': 6.67}", "assert average_across_dicts_zero_fill([{'a': -10}, {'a': 10}]) == {'a': 0.0}", "assert average_across_dicts_zero_fill([{'only': 100}]) == {'only': 100.0}", "assert average_across_dicts_zero_fill([{'a': 1, 'b': 2}, {'a': 3, 'b': 4}, {'a': 5, 'b': 6}]) == {'b': 4.0, 'a': 3.0}", "assert average_across_dicts_zero_fill([{'k': 7}, {'k': 7}, {'k': 7}, {'k': 7}]) == {'k': 7.0}", "assert average_across_dicts_zero_fill([{'m': 1}, {'n': 1}, {'m': 1, 'n': 1}]) == {'m': 0.67, 'n': 0.67}", "assert average_across_dicts_zero_fill([{'a': 100}, {'a': 0}, {'a': 0}, {'a': 0}]) == {'a': 25.0}", "assert average_across_dicts_zero_fill([{'p': 3, 'q': 3}, {'p': 3}, {'q': 3}]) == {'p': 2.0, 'q': 2.0}", "assert average_across_dicts_zero_fill([{'solo': 1}]) == {'solo': 1.0}"], "reference": "def average_across_dicts_zero_fill(dicts_list):\n    n = len(dicts_list)\n    if n == 0:\n        return {}\n    all_keys = set()\n    for d in dicts_list:\n        all_keys.update(d.keys())\n    return {k: round(sum(d.get(k, 0) for d in dicts_list) / n, 2) for k in all_keys}\n"}
{"tid": "dct-167", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of dicts, return a sorted list of the keys that appear in exactly two of the dicts in the list (counting a key once per dict it appears in). An empty list, or one with no such keys, returns an empty list.", "signature": "def keys_present_in_exactly_two(dicts_list):", "visible_tests": ["assert keys_present_in_exactly_two([{'a': 1}, {'a': 2}, {'a': 3}]) == []", "assert keys_present_in_exactly_two([{'x': 1, 'y': 2}, {'y': 3}]) == ['y']", "assert keys_present_in_exactly_two([]) == []"], "hidden_tests": ["assert keys_present_in_exactly_two([{'a': 1}]) == []", "assert keys_present_in_exactly_two([{}]) == []", "assert keys_present_in_exactly_two([{'a': 1}, {'b': 2}]) == []", "assert keys_present_in_exactly_two([{'a': 1, 'b': 2}, {'a': 3}, {'b': 4}]) == ['a', 'b']", "assert keys_present_in_exactly_two([{'k': 1}, {'k': 2}]) == ['k']", "assert keys_present_in_exactly_two([{'m': 1}, {'m': 2}, {'m': 3}, {'m': 4}]) == []", "assert keys_present_in_exactly_two([{'a': 1, 'b': 2, 'c': 3}, {'a': 4, 'b': 5}, {'c': 6}]) == ['a', 'b', 'c']", "assert keys_present_in_exactly_two([{'z': 1}, {'y': 2}, {'z': 3}, {'y': 4}]) == ['y', 'z']", "assert keys_present_in_exactly_two([{'p': 1, 'q': 2}, {'p': 3, 'r': 4}, {'q': 5, 'r': 6}]) == ['p', 'q', 'r']", "assert keys_present_in_exactly_two([{'only1': 1}, {'only2': 2}]) == []", "assert keys_present_in_exactly_two([{'a': 1}, {'a': 2}, {'b': 3}, {'b': 4}]) == ['a', 'b']", "assert keys_present_in_exactly_two([{'shared': 1}, {'shared': 2}, {'other': 3}]) == ['shared']", "assert keys_present_in_exactly_two([{'a': 1, 'b': 1, 'c': 1}]) == []", "assert keys_present_in_exactly_two([{'x': 1}, {'x': 2}, {'x': 3}, {'y': 4}, {'y': 5}]) == ['y']", "assert keys_present_in_exactly_two([{'a': 1, 'b': 1}, {'a': 1}, {'b': 1}, {'c': 1}]) == ['a', 'b']"], "reference": "def keys_present_in_exactly_two(dicts_list):\n    from collections import Counter\n    cnt = Counter()\n    for d in dicts_list:\n        for k in d:\n            cnt[k] += 1\n    return sorted(k for k, c in cnt.items() if c == 2)\n"}
{"tid": "dct-168", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Merge two numeric dicts a and b into one containing every key from both. For a key present in both, keep the smaller of the two values; for a key present in only one, keep its existing value unchanged. Return the merged dict without mutating either input.", "signature": "def merge_min_all_keys(a, b):", "visible_tests": ["assert merge_min_all_keys({'a': 5, 'b': 10}, {'a': 3, 'c': 7}) == {'a': 3, 'b': 10, 'c': 7}", "assert merge_min_all_keys({}, {'x': 1}) == {'x': 1}", "assert merge_min_all_keys({'m': 1}, {}) == {'m': 1}"], "hidden_tests": ["assert merge_min_all_keys({}, {}) == {}", "assert merge_min_all_keys({'a': 1}, {'a': 1}) == {'a': 1}", "assert merge_min_all_keys({'a': -5}, {'a': 5}) == {'a': -5}", "assert merge_min_all_keys({'a': 1, 'b': 2}, {'a': 0, 'b': 3}) == {'a': 0, 'b': 2}", "assert merge_min_all_keys({'k': 100}, {'k': 200}) == {'k': 100}", "assert merge_min_all_keys({'only_a': 5}, {'only_b': 10}) == {'only_a': 5, 'only_b': 10}", "assert merge_min_all_keys({'x': 1, 'y': 2, 'z': 3}, {'y': -2, 'z': -3, 'w': 4}) == {'x': 1, 'y': -2, 'z': -3, 'w': 4}", "assert merge_min_all_keys({'a': 0}, {'a': 0}) == {'a': 0}", "assert merge_min_all_keys({'p': 10, 'q': 20, 'r': 30}, {'p': 5, 'q': 25, 'r': 35}) == {'p': 5, 'q': 20, 'r': 30}", "assert merge_min_all_keys({'m': 1.5}, {'m': 1.2}) == {'m': 1.2}", "assert merge_min_all_keys({'neg': -1}, {'neg': -10}) == {'neg': -10}", "assert merge_min_all_keys({'a': 1, 'b': 1, 'c': 1}, {'a': 2, 'b': 0, 'c': 1}) == {'a': 1, 'b': 0, 'c': 1}", "assert merge_min_all_keys({'solo': 9}, {}) == {'solo': 9}", "assert merge_min_all_keys({}, {'solo': 9}) == {'solo': 9}", "assert merge_min_all_keys({'a': 3, 'b': -3}, {'a': -3, 'b': 3}) == {'a': -3, 'b': -3}"], "reference": "def merge_min_all_keys(a, b):\n    result = dict(a)\n    for k, v in b.items():\n        if k in result:\n            result[k] = min(result[k], v)\n        else:\n            result[k] = v\n    return result\n"}
{"tid": "dct-169", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a base dict and an overrides dict, return a new dict equal to base but with the value of every key that exists in BOTH base and overrides replaced by the overrides value. Keys present only in overrides (not already in base) are ignored and not added. The original base dict is not mutated.", "signature": "def merge_override(base, overrides):", "visible_tests": ["assert merge_override({'a': 1, 'b': 2}, {'a': 10, 'c': 30}) == {'a': 10, 'b': 2}", "assert merge_override({}, {'x': 1}) == {}", "assert merge_override({'m': 1, 'n': 2}, {}) == {'m': 1, 'n': 2}"], "hidden_tests": ["assert merge_override({'a': 1}, {'a': 2}) == {'a': 2}", "assert merge_override({'a': 1, 'b': 2, 'c': 3}, {'b': 20, 'd': 40}) == {'a': 1, 'b': 20, 'c': 3}", "assert merge_override({'only': 1}, {'only': 2, 'new': 3}) == {'only': 2}", "assert merge_override({'a': 1}, {}) == {'a': 1}", "assert merge_override({}, {}) == {}", "assert merge_override({'x': 1, 'y': 2}, {'x': 10, 'y': 20, 'z': 30}) == {'x': 10, 'y': 20}", "assert merge_override({'k1': 5}, {'k2': 10}) == {'k1': 5}", "assert merge_override({'a': 1, 'b': 1, 'c': 1}, {'a': 2, 'b': 2, 'c': 2, 'd': 2}) == {'a': 2, 'b': 2, 'c': 2}", "assert merge_override({'p': 'old'}, {'p': 'new'}) == {'p': 'new'}", "assert merge_override({'unchanged': 1, 'changed': 2}, {'changed': 20}) == {'unchanged': 1, 'changed': 20}", "assert merge_override({'a': None}, {'a': 5}) == {'a': 5}", "assert merge_override({'a': 1, 'b': 2}, {'c': 3, 'd': 4}) == {'a': 1, 'b': 2}", "assert merge_override({'z': 100}, {'z': 200, 'y': 300}) == {'z': 200}", "assert merge_override({'solo': 1}, {'solo': 1}) == {'solo': 1}", "assert merge_override({'a': 1, 'b': 2, 'c': 3}, {'a': 100, 'b': 200, 'z': 999}) == {'a': 100, 'b': 200, 'c': 3}"], "reference": "def merge_override(base, overrides):\n    result = dict(base)\n    for k, v in overrides.items():\n        if k in result:\n            result[k] = v\n    return result\n"}
{"tid": "dct-170", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of dicts, build a dict mapping each key seen in any of them to a list of all the values recorded for that key, in the order the dicts appear (a dict missing a key simply contributes nothing for it). An empty list returns an empty dict.", "signature": "def aggregate_collect(records):", "visible_tests": ["assert aggregate_collect([{'a': 1}, {'a': 2}, {'b': 3}]) == {'a': [1, 2], 'b': [3]}", "assert aggregate_collect([{'x': 1, 'y': 2}]) == {'x': [1], 'y': [2]}", "assert aggregate_collect([]) == {}"], "hidden_tests": ["assert aggregate_collect([{}]) == {}", "assert aggregate_collect([{'a': 1}]) == {'a': [1]}", "assert aggregate_collect([{'a': 1}, {'a': 1}, {'a': 1}]) == {'a': [1, 1, 1]}", "assert aggregate_collect([{'m': 1, 'n': 2}, {'m': 3}, {'n': 4}]) == {'m': [1, 3], 'n': [2, 4]}", "assert aggregate_collect([{'k': 'x'}, {'k': 'y'}, {'k': 'z'}]) == {'k': ['x', 'y', 'z']}", "assert aggregate_collect([{'only': 42}]) == {'only': [42]}", "assert aggregate_collect([{'a': 1, 'b': 2}, {'a': 3, 'b': 4}, {'a': 5, 'b': 6}]) == {'a': [1, 3, 5], 'b': [2, 4, 6]}", "assert aggregate_collect([{'z': True}, {'z': False}]) == {'z': [True, False]}", "assert aggregate_collect([{'p': None}, {'p': 1}]) == {'p': [None, 1]}", "assert aggregate_collect([{'a': 1}, {'b': 2}, {'c': 3}]) == {'a': [1], 'b': [2], 'c': [3]}", "assert aggregate_collect([{'shared': 1, 'unique': 2}, {'shared': 3}]) == {'shared': [1, 3], 'unique': [2]}", "assert aggregate_collect([{'1': 'a'}, {'1': 'b'}, {'2': 'c'}]) == {'1': ['a', 'b'], '2': ['c']}", "assert aggregate_collect([{'a': 1, 'b': 1}, {}]) == {'a': [1], 'b': [1]}", "assert aggregate_collect([{'solo': 5}]) == {'solo': [5]}", "assert aggregate_collect([{'first_key': 1}, {'second_key': 2}, {'first_key': 3, 'second_key': 4}]) == {'first_key': [1, 3], 'second_key': [2, 4]}"], "reference": "def aggregate_collect(records):\n    result = {}\n    for r in records:\n        for k, v in r.items():\n            result.setdefault(k, []).append(v)\n    return result\n"}
