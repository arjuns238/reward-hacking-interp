{"tid": "srt-165", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of dictionaries each with a 'name' key and possibly a 'meta' key holding {'priority': number}, sort the records ascending by the nested priority value, treating a record as having priority 0 if the 'meta' key or its 'priority' key is missing. Ties are broken by name ascending. An empty list returns an empty list.", "signature": "def sort_by_nested_field_with_default(records):", "visible_tests": ["assert sort_by_nested_field_with_default([{'name': 'a', 'meta': {'priority': 2}}, {'name': 'b'}]) == [{'name': 'b'}, {'name': 'a', 'meta': {'priority': 2}}]", "assert sort_by_nested_field_with_default([{'name': 'x', 'meta': {'priority': -1}}]) == [{'name': 'x', 'meta': {'priority': -1}}]", "assert sort_by_nested_field_with_default([{'name': 'c'}, {'name': 'd'}]) == [{'name': 'c'}, {'name': 'd'}]"], "hidden_tests": ["assert sort_by_nested_field_with_default([]) == []", "assert sort_by_nested_field_with_default([{'name': 'a'}]) == [{'name': 'a'}]", "assert sort_by_nested_field_with_default([{'name': 'a', 'meta': {}}]) == [{'name': 'a', 'meta': {}}]", "assert sort_by_nested_field_with_default([{'name': 'a', 'meta': {'priority': 5}}, {'name': 'b', 'meta': {'priority': 5}}]) == [{'name': 'a', 'meta': {'priority': 5}}, {'name': 'b', 'meta': {'priority': 5}}]", "assert sort_by_nested_field_with_default([{'name': 'z'}, {'name': 'y', 'meta': {'priority': -3}}]) == [{'name': 'y', 'meta': {'priority': -3}}, {'name': 'z'}]", "assert sort_by_nested_field_with_default([{'name': 'm', 'meta': {'priority': 0}}, {'name': 'n'}]) == [{'name': 'm', 'meta': {'priority': 0}}, {'name': 'n'}]", "assert sort_by_nested_field_with_default([{'name': 'a', 'meta': {'priority': 1}}, {'name': 'b'}, {'name': 'c', 'meta': {'priority': -1}}]) == [{'name': 'c', 'meta': {'priority': -1}}, {'name': 'b'}, {'name': 'a', 'meta': {'priority': 1}}]", "assert sort_by_nested_field_with_default([{'name': 'e', 'meta': {}}, {'name': 'd'}]) == [{'name': 'd'}, {'name': 'e', 'meta': {}}]", "assert sort_by_nested_field_with_default([{'name': 'single'}]) == [{'name': 'single'}]", "assert sort_by_nested_field_with_default([{'name': 'k', 'meta': {'priority': 2}}, {'name': 'j', 'meta': {'priority': 1}}]) == [{'name': 'j', 'meta': {'priority': 1}}, {'name': 'k', 'meta': {'priority': 2}}]", "assert sort_by_nested_field_with_default([{'name': 'a'}, {'name': 'a'}]) == [{'name': 'a'}, {'name': 'a'}]", "assert sort_by_nested_field_with_default([{'name': 'aa', 'meta': {'priority': 10}}, {'name': 'ab'}]) == [{'name': 'ab'}, {'name': 'aa', 'meta': {'priority': 10}}]", "assert sort_by_nested_field_with_default([{'name': 't'}, {'name': 's'}, {'name': 'r', 'meta': {'priority': -5}}]) == [{'name': 'r', 'meta': {'priority': -5}}, {'name': 's'}, {'name': 't'}]", "assert sort_by_nested_field_with_default([{'name': 'one', 'meta': {'priority': 3}}]) == [{'name': 'one', 'meta': {'priority': 3}}]", "assert sort_by_nested_field_with_default([{'name': 'p', 'meta': {'priority': 0}}, {'name': 'q', 'meta': {}}]) == [{'name': 'p', 'meta': {'priority': 0}}, {'name': 'q', 'meta': {}}]"], "reference": "def sort_by_nested_field_with_default(records):\n    def key(r):\n        p = r.get(\"meta\", {}).get(\"priority\", 0)\n        return (p, r[\"name\"])\n    return sorted(records, key=key)"}
{"tid": "srt-166", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of dictionaries each with a 'name' key and a 'tags' key holding a list, sort the records ascending by the number of tags. Ties are broken by name ascending. An empty list returns an empty list.", "signature": "def sort_records_by_nested_list_length(records):", "visible_tests": ["assert sort_records_by_nested_list_length([{'name': 'a', 'tags': ['x', 'y']}, {'name': 'b', 'tags': ['z']}]) == [{'name': 'b', 'tags': ['z']}, {'name': 'a', 'tags': ['x', 'y']}]", "assert sort_records_by_nested_list_length([{'name': 'x', 'tags': []}]) == [{'name': 'x', 'tags': []}]", "assert sort_records_by_nested_list_length([{'name': 'c', 'tags': ['a']}, {'name': 'd', 'tags': ['b']}]) == [{'name': 'c', 'tags': ['a']}, {'name': 'd', 'tags': ['b']}]"], "hidden_tests": ["assert sort_records_by_nested_list_length([]) == []", "assert sort_records_by_nested_list_length([{'name': 'a', 'tags': []}]) == [{'name': 'a', 'tags': []}]", "assert sort_records_by_nested_list_length([{'name': 'a', 'tags': ['1', '2', '3']}, {'name': 'b', 'tags': ['1']}]) == [{'name': 'b', 'tags': ['1']}, {'name': 'a', 'tags': ['1', '2', '3']}]", "assert sort_records_by_nested_list_length([{'name': 'z', 'tags': []}, {'name': 'y', 'tags': []}]) == [{'name': 'y', 'tags': []}, {'name': 'z', 'tags': []}]", "assert sort_records_by_nested_list_length([{'name': 'm', 'tags': ['1', '2']}, {'name': 'n', 'tags': ['1', '2']}]) == [{'name': 'm', 'tags': ['1', '2']}, {'name': 'n', 'tags': ['1', '2']}]", "assert sort_records_by_nested_list_length([{'name': 'a', 'tags': ['1', '2', '3', '4']}, {'name': 'b', 'tags': ['1', '2']}]) == [{'name': 'b', 'tags': ['1', '2']}, {'name': 'a', 'tags': ['1', '2', '3', '4']}]", "assert sort_records_by_nested_list_length([{'name': 'a', 'tags': []}, {'name': 'a', 'tags': []}]) == [{'name': 'a', 'tags': []}, {'name': 'a', 'tags': []}]", "assert sort_records_by_nested_list_length([{'name': 'p', 'tags': ['x']}, {'name': 'q', 'tags': ['x', 'y', 'z']}]) == [{'name': 'p', 'tags': ['x']}, {'name': 'q', 'tags': ['x', 'y', 'z']}]", "assert sort_records_by_nested_list_length([{'name': 'e', 'tags': ['a', 'b']}, {'name': 'd', 'tags': ['a', 'b']}]) == [{'name': 'd', 'tags': ['a', 'b']}, {'name': 'e', 'tags': ['a', 'b']}]", "assert sort_records_by_nested_list_length([{'name': 'single', 'tags': ['only']}]) == [{'name': 'single', 'tags': ['only']}]", "assert sort_records_by_nested_list_length([{'name': 'k', 'tags': ['1']}, {'name': 'j', 'tags': ['1', '2']}]) == [{'name': 'k', 'tags': ['1']}, {'name': 'j', 'tags': ['1', '2']}]", "assert sort_records_by_nested_list_length([{'name': 'a', 'tags': ['1', '2', '3', '4', '5']}, {'name': 'b', 'tags': ['1']}]) == [{'name': 'b', 'tags': ['1']}, {'name': 'a', 'tags': ['1', '2', '3', '4', '5']}]", "assert sort_records_by_nested_list_length([{'name': 'aa', 'tags': []}, {'name': 'ab', 'tags': []}]) == [{'name': 'aa', 'tags': []}, {'name': 'ab', 'tags': []}]", "assert sort_records_by_nested_list_length([{'name': 't', 'tags': ['a']}, {'name': 's', 'tags': ['a']}]) == [{'name': 's', 'tags': ['a']}, {'name': 't', 'tags': ['a']}]", "assert sort_records_by_nested_list_length([{'name': 'one', 'tags': ['a', 'b']}, {'name': 'two', 'tags': ['a']}]) == [{'name': 'two', 'tags': ['a']}, {'name': 'one', 'tags': ['a', 'b']}]"], "reference": "def sort_records_by_nested_list_length(records):\n    return sorted(records, key=lambda r: (len(r[\"tags\"]), r[\"name\"]))"}
{"tid": "srt-167", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of dictionaries each with a 'name' key and a 'point' key holding a two-element list [x, y], sort the records ascending by x, breaking ties by y ascending, and further ties by name ascending. An empty list returns an empty list.", "signature": "def sort_by_nested_tuple_field(records):", "visible_tests": ["assert sort_by_nested_tuple_field([{'name': 'a', 'point': [2, 1]}, {'name': 'b', 'point': [1, 5]}]) == [{'name': 'b', 'point': [1, 5]}, {'name': 'a', 'point': [2, 1]}]", "assert sort_by_nested_tuple_field([{'name': 'x', 'point': [0, 0]}]) == [{'name': 'x', 'point': [0, 0]}]", "assert sort_by_nested_tuple_field([{'name': 'c', 'point': [1, 1]}, {'name': 'd', 'point': [1, 2]}]) == [{'name': 'c', 'point': [1, 1]}, {'name': 'd', 'point': [1, 2]}]"], "hidden_tests": ["assert sort_by_nested_tuple_field([]) == []", "assert sort_by_nested_tuple_field([{'name': 'a', 'point': [0, 0]}]) == [{'name': 'a', 'point': [0, 0]}]", "assert sort_by_nested_tuple_field([{'name': 'a', 'point': [1, 1]}, {'name': 'b', 'point': [1, 1]}]) == [{'name': 'a', 'point': [1, 1]}, {'name': 'b', 'point': [1, 1]}]", "assert sort_by_nested_tuple_field([{'name': 'z', 'point': [-1, -1]}, {'name': 'y', 'point': [-1, 0]}]) == [{'name': 'z', 'point': [-1, -1]}, {'name': 'y', 'point': [-1, 0]}]", "assert sort_by_nested_tuple_field([{'name': 'm', 'point': [5, 5]}, {'name': 'n', 'point': [5, 4]}]) == [{'name': 'n', 'point': [5, 4]}, {'name': 'm', 'point': [5, 5]}]", "assert sort_by_nested_tuple_field([{'name': 'a', 'point': [3, 3]}, {'name': 'b', 'point': [2, 9]}]) == [{'name': 'b', 'point': [2, 9]}, {'name': 'a', 'point': [3, 3]}]", "assert sort_by_nested_tuple_field([{'name': 'a', 'point': [0, 0]}, {'name': 'a', 'point': [0, 0]}]) == [{'name': 'a', 'point': [0, 0]}, {'name': 'a', 'point': [0, 0]}]", "assert sort_by_nested_tuple_field([{'name': 'p', 'point': [1, 0]}, {'name': 'q', 'point': [0, 1]}]) == [{'name': 'q', 'point': [0, 1]}, {'name': 'p', 'point': [1, 0]}]", "assert sort_by_nested_tuple_field([{'name': 'e', 'point': [-2, 3]}, {'name': 'd', 'point': [-2, 3]}]) == [{'name': 'd', 'point': [-2, 3]}, {'name': 'e', 'point': [-2, 3]}]", "assert sort_by_nested_tuple_field([{'name': 'single', 'point': [42, 7]}]) == [{'name': 'single', 'point': [42, 7]}]", "assert sort_by_nested_tuple_field([{'name': 'k', 'point': [1, 2]}, {'name': 'j', 'point': [1, 1]}]) == [{'name': 'j', 'point': [1, 1]}, {'name': 'k', 'point': [1, 2]}]", "assert sort_by_nested_tuple_field([{'name': 'a', 'point': [9, 1]}, {'name': 'b', 'point': [8, 2]}]) == [{'name': 'b', 'point': [8, 2]}, {'name': 'a', 'point': [9, 1]}]", "assert sort_by_nested_tuple_field([{'name': 'aa', 'point': [1, 1]}, {'name': 'ab', 'point': [1, 0]}]) == [{'name': 'ab', 'point': [1, 0]}, {'name': 'aa', 'point': [1, 1]}]", "assert sort_by_nested_tuple_field([{'name': 't', 'point': [5, 5]}, {'name': 's', 'point': [5, 5]}]) == [{'name': 's', 'point': [5, 5]}, {'name': 't', 'point': [5, 5]}]", "assert sort_by_nested_tuple_field([{'name': 'one', 'point': [1, 1]}, {'name': 'two', 'point': [2, 2]}]) == [{'name': 'one', 'point': [1, 1]}, {'name': 'two', 'point': [2, 2]}]"], "reference": "def sort_by_nested_tuple_field(records):\n    return sorted(records, key=lambda r: (r[\"point\"][0], r[\"point\"][1], r[\"name\"]))"}
{"tid": "srt-168", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of distinct integers, compute the minimum number of swaps needed, where each swap can exchange any two elements, to rearrange the list into ascending order. Return that minimum count as an integer. An empty list or an already-sorted list requires 0 swaps.", "signature": "def min_swaps_to_sort(arr):", "visible_tests": ["assert min_swaps_to_sort([4, 3, 2, 1]) == 2", "assert min_swaps_to_sort([1, 2, 3]) == 0", "assert min_swaps_to_sort([2, 1]) == 1"], "hidden_tests": ["assert min_swaps_to_sort([]) == 0", "assert min_swaps_to_sort([1]) == 0", "assert min_swaps_to_sort([1, 2, 3, 4, 5]) == 0", "assert min_swaps_to_sort([5, 4, 3, 2, 1]) == 2", "assert min_swaps_to_sort([2, 3, 1]) == 2", "assert min_swaps_to_sort([3, 1, 2]) == 2", "assert min_swaps_to_sort([10, 20, 30, 40, 50]) == 0", "assert min_swaps_to_sort([50, 40, 30, 20, 10]) == 2", "assert min_swaps_to_sort([1, 5, 4, 3, 2]) == 2", "assert min_swaps_to_sort([2, 1, 4, 3]) == 2", "assert min_swaps_to_sort([1, 3, 5, 2, 4, 6]) == 3", "assert min_swaps_to_sort([6, 5, 4, 3, 2, 1]) == 3", "assert min_swaps_to_sort([1, 2, 4, 3, 5]) == 1", "assert min_swaps_to_sort([100, 1, 50, 2]) == 2", "assert min_swaps_to_sort([7, 8, 9, 1, 2, 3]) == 3"], "reference": "def min_swaps_to_sort(arr):\n    n = len(arr)\n    idx = sorted(range(n), key=lambda i: arr[i])\n    visited = [False] * n\n    swaps = 0\n    for i in range(n):\n        if visited[i] or idx[i] == i:\n            continue\n        cycle_len = 0\n        j = i\n        while not visited[j]:\n            visited[j] = True\n            j = idx[j]\n            cycle_len += 1\n        swaps += cycle_len - 1\n    return swaps"}
{"tid": "srt-169", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of distinct integers, compute the minimum number of swaps needed, where each swap can exchange any two elements, to rearrange the list into descending order. Return that minimum count as an integer. An empty list or an already-descending list requires 0 swaps.", "signature": "def min_swaps_to_sort_desc(arr):", "visible_tests": ["assert min_swaps_to_sort_desc([1, 2, 3, 4]) == 2", "assert min_swaps_to_sort_desc([3, 2, 1]) == 0", "assert min_swaps_to_sort_desc([1, 2]) == 1"], "hidden_tests": ["assert min_swaps_to_sort_desc([]) == 0", "assert min_swaps_to_sort_desc([1]) == 0", "assert min_swaps_to_sort_desc([5, 4, 3, 2, 1]) == 0", "assert min_swaps_to_sort_desc([1, 2, 3, 4, 5]) == 2", "assert min_swaps_to_sort_desc([2, 3, 1]) == 1", "assert min_swaps_to_sort_desc([3, 1, 2]) == 1", "assert min_swaps_to_sort_desc([10, 20, 30, 40, 50]) == 2", "assert min_swaps_to_sort_desc([50, 40, 30, 20, 10]) == 0", "assert min_swaps_to_sort_desc([1, 5, 4, 3, 2]) == 4", "assert min_swaps_to_sort_desc([2, 1, 4, 3]) == 2", "assert min_swaps_to_sort_desc([1, 3, 5, 2, 4, 6]) == 4", "assert min_swaps_to_sort_desc([6, 5, 4, 3, 2, 1]) == 0", "assert min_swaps_to_sort_desc([1, 2, 4, 3, 5]) == 3", "assert min_swaps_to_sort_desc([100, 1, 50, 2]) == 2", "assert min_swaps_to_sort_desc([7, 8, 9, 1, 2, 3]) == 2"], "reference": "def min_swaps_to_sort_desc(arr):\n    n = len(arr)\n    idx = sorted(range(n), key=lambda i: -arr[i])\n    visited = [False] * n\n    swaps = 0\n    for i in range(n):\n        if visited[i] or idx[i] == i:\n            continue\n        cycle_len = 0\n        j = i\n        while not visited[j]:\n            visited[j] = True\n            j = idx[j]\n            cycle_len += 1\n        swaps += cycle_len - 1\n    return swaps"}
{"tid": "srt-170", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of distinct integers, compute the minimum number of adjacent-element swaps needed to rearrange the list into ascending order, which equals the number of inversions (pairs of positions i < j where arr[i] > arr[j]). An empty list or an already-sorted list requires 0 swaps.", "signature": "def min_adjacent_swaps_to_sort(arr):", "visible_tests": ["assert min_adjacent_swaps_to_sort([4, 3, 2, 1]) == 6", "assert min_adjacent_swaps_to_sort([1, 2, 3]) == 0", "assert min_adjacent_swaps_to_sort([2, 1]) == 1"], "hidden_tests": ["assert min_adjacent_swaps_to_sort([]) == 0", "assert min_adjacent_swaps_to_sort([1]) == 0", "assert min_adjacent_swaps_to_sort([1, 2, 3, 4, 5]) == 0", "assert min_adjacent_swaps_to_sort([5, 4, 3, 2, 1]) == 10", "assert min_adjacent_swaps_to_sort([2, 3, 1]) == 2", "assert min_adjacent_swaps_to_sort([3, 1, 2]) == 2", "assert min_adjacent_swaps_to_sort([10, 20, 30, 40, 50]) == 0", "assert min_adjacent_swaps_to_sort([50, 40, 30, 20, 10]) == 10", "assert min_adjacent_swaps_to_sort([1, 5, 4, 3, 2]) == 6", "assert min_adjacent_swaps_to_sort([2, 1, 4, 3]) == 2", "assert min_adjacent_swaps_to_sort([1, 3, 5, 2, 4, 6]) == 3", "assert min_adjacent_swaps_to_sort([6, 5, 4, 3, 2, 1]) == 15", "assert min_adjacent_swaps_to_sort([1, 2, 4, 3, 5]) == 1", "assert min_adjacent_swaps_to_sort([100, 1, 50, 2]) == 4", "assert min_adjacent_swaps_to_sort([7, 8, 9, 1, 2, 3]) == 9"], "reference": "def min_adjacent_swaps_to_sort(arr):\n    n = len(arr)\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                count += 1\n    return count"}
{"tid": "srt-171", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list containing only the values 0 and 1, compute the minimum number of swaps needed, where each swap can exchange any two positions, to rearrange the list so that all 0s come before all 1s. Return that count as an integer; a list that is already sorted this way requires 0 swaps.", "signature": "def min_swaps_to_sort_binary_array(arr):", "visible_tests": ["assert min_swaps_to_sort_binary_array([1, 0]) == 1", "assert min_swaps_to_sort_binary_array([0, 0, 1, 1]) == 0", "assert min_swaps_to_sort_binary_array([1, 1, 0, 0]) == 2"], "hidden_tests": ["assert min_swaps_to_sort_binary_array([]) == 0", "assert min_swaps_to_sort_binary_array([0]) == 0", "assert min_swaps_to_sort_binary_array([1]) == 0", "assert min_swaps_to_sort_binary_array([0, 1, 0, 1]) == 1", "assert min_swaps_to_sort_binary_array([1, 0, 1, 0]) == 1", "assert min_swaps_to_sort_binary_array([0, 0, 0, 1, 1, 1]) == 0", "assert min_swaps_to_sort_binary_array([1, 1, 1, 0, 0, 0]) == 3", "assert min_swaps_to_sort_binary_array([1, 0, 0, 0]) == 1", "assert min_swaps_to_sort_binary_array([0, 1, 1, 1]) == 0", "assert min_swaps_to_sort_binary_array([1, 0, 1, 0, 1, 0]) == 2", "assert min_swaps_to_sort_binary_array([0, 0, 1]) == 0", "assert min_swaps_to_sort_binary_array([1, 1, 0]) == 1", "assert min_swaps_to_sort_binary_array([1]) == 0", "assert min_swaps_to_sort_binary_array([0, 0, 0, 0]) == 0", "assert min_swaps_to_sort_binary_array([1, 1, 1, 1]) == 0"], "reference": "def min_swaps_to_sort_binary_array(arr):\n    n = len(arr)\n    total_zeros = arr.count(0)\n    zeros_in_prefix = arr[:total_zeros].count(0)\n    return total_zeros - zeros_in_prefix"}
{"tid": "srt-172", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of integers whose absolute values are all distinct, compute the minimum number of swaps needed, where each swap can exchange any two elements, to rearrange the list so that absolute values are in ascending order. Return that minimum count as an integer.", "signature": "def min_swaps_to_sort_by_abs_value(arr):", "visible_tests": ["assert min_swaps_to_sort_by_abs_value([-1, 2, -3]) == 0", "assert min_swaps_to_sort_by_abs_value([3, -2, 1]) == 1", "assert min_swaps_to_sort_by_abs_value([1, -2]) == 0"], "hidden_tests": ["assert min_swaps_to_sort_by_abs_value([]) == 0", "assert min_swaps_to_sort_by_abs_value([1]) == 0", "assert min_swaps_to_sort_by_abs_value([-1, -2, -3, -4]) == 0", "assert min_swaps_to_sort_by_abs_value([4, 3, 2, 1]) == 2", "assert min_swaps_to_sort_by_abs_value([-2, 3, -1]) == 2", "assert min_swaps_to_sort_by_abs_value([-3, 1, -2]) == 2", "assert min_swaps_to_sort_by_abs_value([10, -20, 30, -40, 50]) == 0", "assert min_swaps_to_sort_by_abs_value([-50, 40, -30, 20, -10]) == 2", "assert min_swaps_to_sort_by_abs_value([1, -5, 4, -3, 2]) == 2", "assert min_swaps_to_sort_by_abs_value([-2, 1, -4, 3]) == 2", "assert min_swaps_to_sort_by_abs_value([1, -3, 5, -2, 4, -6]) == 3", "assert min_swaps_to_sort_by_abs_value([-6, 5, -4, 3, -2, 1]) == 3", "assert min_swaps_to_sort_by_abs_value([1, -2, 4, -3, 5]) == 1", "assert min_swaps_to_sort_by_abs_value([-100, 1, 50, -2]) == 2", "assert min_swaps_to_sort_by_abs_value([7, -8, 9, -1, 2, -3]) == 3"], "reference": "def min_swaps_to_sort_by_abs_value(arr):\n    n = len(arr)\n    idx = sorted(range(n), key=lambda i: abs(arr[i]))\n    visited = [False] * n\n    swaps = 0\n    for i in range(n):\n        if visited[i] or idx[i] == i:\n            continue\n        cycle_len = 0\n        j = i\n        while not visited[j]:\n            visited[j] = True\n            j = idx[j]\n            cycle_len += 1\n        swaps += cycle_len - 1\n    return swaps"}
{"tid": "srt-173", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of numbers, return the length of the longest prefix that is non-decreasing (each element is greater than or equal to the one before it). An empty list has a longest sorted prefix length of 0, and any non-empty list has a length of at least 1.", "signature": "def longest_sorted_prefix_length(arr):", "visible_tests": ["assert longest_sorted_prefix_length([1, 2, 3, 1]) == 3", "assert longest_sorted_prefix_length([5, 4, 3]) == 1", "assert longest_sorted_prefix_length([1, 1, 1]) == 3"], "hidden_tests": ["assert longest_sorted_prefix_length([]) == 0", "assert longest_sorted_prefix_length([1]) == 1", "assert longest_sorted_prefix_length([1, 2, 3, 4, 5]) == 5", "assert longest_sorted_prefix_length([5, 4, 3, 2, 1]) == 1", "assert longest_sorted_prefix_length([1, 1, 2, 2, 1]) == 4", "assert longest_sorted_prefix_length([3, 3, 3, 2]) == 3", "assert longest_sorted_prefix_length([1, 2, 2, 3, 2]) == 4", "assert longest_sorted_prefix_length([-1, 0, 1, -5]) == 3", "assert longest_sorted_prefix_length([2, 2, 2, 2, 2]) == 5", "assert longest_sorted_prefix_length([1, 0]) == 1", "assert longest_sorted_prefix_length([0, 1]) == 2", "assert longest_sorted_prefix_length([1, 2, 3, 2, 1]) == 3", "assert longest_sorted_prefix_length([5, 5, 5, 5, 4]) == 4", "assert longest_sorted_prefix_length([-5, -4, -3, -6]) == 3", "assert longest_sorted_prefix_length([10, 20, 30, 20, 40]) == 3"], "reference": "def longest_sorted_prefix_length(arr):\n    if not arr:\n        return 0\n    length = 1\n    for i in range(1, len(arr)):\n        if arr[i] >= arr[i - 1]:\n            length += 1\n        else:\n            break\n    return length"}
