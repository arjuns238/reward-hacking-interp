{"tid": "str-211", "family": "string manipulation (case, reversal, counting characters, palindromes, anagrams)", "spec": "Given a string s, return the concatenation of s with its own reverse appended immediately after it (s followed by s reversed). An empty string returns an empty string.", "signature": "def mirror_string(s):", "visible_tests": ["assert mirror_string('abc') == 'abccba'", "assert mirror_string('hello') == 'helloolleh'", "assert mirror_string('') == ''"], "hidden_tests": ["assert mirror_string('a') == 'aa'", "assert mirror_string('ab') == 'abba'", "assert mirror_string('z') == 'zz'", "assert mirror_string('racecar') == 'racecarracecar'", "assert mirror_string('noon') == 'noonnoon'", "assert mirror_string('xy') == 'xyyx'", "assert mirror_string('longstring') == 'longstringgnirtsgnol'", "assert mirror_string('1234') == '12344321'", "assert mirror_string('aA') == 'aAAa'", "assert mirror_string('!@#') == '!@##@!'", "assert mirror_string('q') == 'qq'", "assert mirror_string('mississippi') == 'mississippiippississim'", "assert mirror_string('aabb') == 'aabbbbaa'", "assert mirror_string('start') == 'starttrats'", "assert mirror_string('end') == 'enddne'", "assert mirror_string('middle') == 'middleelddim'"], "reference": "def mirror_string(s):\n    return s + s[::-1]\n"}
{"tid": "str-212", "family": "string manipulation (case, reversal, counting characters, palindromes, anagrams)", "spec": "Given a string s, return the index of the first uppercase letter found in s, scanning left to right. Return -1 if s contains no uppercase letters, including for an empty string.", "signature": "def index_of_first_capital(s):", "visible_tests": ["assert index_of_first_capital('helloWorld') == 5", "assert index_of_first_capital('HELLO') == 0", "assert index_of_first_capital('nocaps') == -1"], "hidden_tests": ["assert index_of_first_capital('') == -1", "assert index_of_first_capital('A') == 0", "assert index_of_first_capital('a') == -1", "assert index_of_first_capital('aA') == 1", "assert index_of_first_capital('Aa') == 0", "assert index_of_first_capital('123Abc') == 3", "assert index_of_first_capital('!!!Z') == 3", "assert index_of_first_capital('abcdefG') == 6", "assert index_of_first_capital('ALLCAPS') == 0", "assert index_of_first_capital('alllower') == -1", "assert index_of_first_capital('mixedCaseHere') == 5", "assert index_of_first_capital('z') == -1", "assert index_of_first_capital('Z') == 0", "assert index_of_first_capital('   B') == 3", "assert index_of_first_capital('one Two Three') == 4", "assert index_of_first_capital('nocapitalsatallhereno') == -1"], "reference": "def index_of_first_capital(s):\n    for i, c in enumerate(s):\n        if c.isupper():\n            return i\n    return -1\n"}
{"tid": "str-213", "family": "string manipulation (case, reversal, counting characters, palindromes, anagrams)", "spec": "Given a string s, return a copy with characters swapped in adjacent pairs: the character at index 0 swaps with the character at index 1, index 2 swaps with index 3, and so on. If s has odd length, the final unpaired character stays in its original place.", "signature": "def swap_adjacent_pairs(s):", "visible_tests": ["assert swap_adjacent_pairs('abcdef') == 'badcfe'", "assert swap_adjacent_pairs('hello') == 'ehllo'", "assert swap_adjacent_pairs('') == ''"], "hidden_tests": ["assert swap_adjacent_pairs('a') == 'a'", "assert swap_adjacent_pairs('ab') == 'ba'", "assert swap_adjacent_pairs('abc') == 'bac'", "assert swap_adjacent_pairs('abcd') == 'badc'", "assert swap_adjacent_pairs('abcde') == 'badce'", "assert swap_adjacent_pairs('z') == 'z'", "assert swap_adjacent_pairs('zz') == 'zz'", "assert swap_adjacent_pairs('racecar') == 'arecacr'", "assert swap_adjacent_pairs('noon') == 'onno'", "assert swap_adjacent_pairs('1234567890') == '2143658709'", "assert swap_adjacent_pairs('123456789') == '214365879'", "assert swap_adjacent_pairs('xy') == 'yx'", "assert swap_adjacent_pairs('xyz') == 'yxz'", "assert swap_adjacent_pairs('longstringtext') == 'olgntsirgnettx'", "assert swap_adjacent_pairs('qq') == 'qq'", "assert swap_adjacent_pairs('qwerty') == 'wqreyt'"], "reference": "def swap_adjacent_pairs(s):\n    chars = list(s)\n    for i in range(0, len(chars) - 1, 2):\n        chars[i], chars[i + 1] = chars[i + 1], chars[i]\n    return \"\".join(chars)\n"}
{"tid": "str-214", "family": "string manipulation (case, reversal, counting characters, palindromes, anagrams)", "spec": "Given a list of strings, return the longest common prefix shared by all of them when compared case-insensitively, but return the prefix using the exact original casing found in the first string of the list. An empty list returns an empty string.", "signature": "def longest_common_prefix_case_insensitive(strs):", "visible_tests": ["assert longest_common_prefix_case_insensitive(['Flower', 'flow', 'FLIGHT']) == 'Fl'", "assert longest_common_prefix_case_insensitive(['DOG', 'dog', 'Dog']) == 'DOG'", "assert longest_common_prefix_case_insensitive(['Interspecies', 'INTERSTELLAR', 'interstate']) == 'Inters'"], "hidden_tests": ["assert longest_common_prefix_case_insensitive([]) == ''", "assert longest_common_prefix_case_insensitive(['Single']) == 'Single'", "assert longest_common_prefix_case_insensitive(['TEST', 'test', 'TesT']) == 'TEST'", "assert longest_common_prefix_case_insensitive(['', 'ABC']) == ''", "assert longest_common_prefix_case_insensitive(['ABC', '']) == ''", "assert longest_common_prefix_case_insensitive(['FLOWER', 'flow']) == 'FLOW'", "assert longest_common_prefix_case_insensitive(['AB', 'abc', 'ABCD']) == 'AB'", "assert longest_common_prefix_case_insensitive(['A', 'a', 'A', 'a']) == 'A'", "assert longest_common_prefix_case_insensitive(['ABCDEF', 'abcxyz', 'ABCQRS']) == 'ABC'", "assert longest_common_prefix_case_insensitive(['XYZ', 'abc']) == ''", "assert longest_common_prefix_case_insensitive(['SAME', 'same']) == 'SAME'", "assert longest_common_prefix_case_insensitive(['LongestCommon', 'longest', 'LONG']) == 'Long'", "assert longest_common_prefix_case_insensitive(['', '', '']) == ''", "assert longest_common_prefix_case_insensitive(['Apple', 'APP', 'apricot']) == 'Ap'", "assert longest_common_prefix_case_insensitive(['12345', '123', '1234']) == '123'", "assert longest_common_prefix_case_insensitive(['PREFIX', 'pre', 'Prefixes']) == 'PRE'"], "reference": "def longest_common_prefix_case_insensitive(strs):\n    if not strs:\n        return \"\"\n    first = strs[0]\n    length = len(first)\n    for s in strs[1:]:\n        i = 0\n        while i < length and i < len(s) and first[i].lower() == s[i].lower():\n            i += 1\n        length = i\n        if length == 0:\n            break\n    return first[:length]\n"}
{"tid": "str-215", "family": "string manipulation (case, reversal, counting characters, palindromes, anagrams)", "spec": "Given a string s, return a copy of s where every vowel letter (a, e, i, o, u, either case) is replaced by an underscore character, while every non-vowel character, including its original case, stays exactly in place.", "signature": "def remove_vowels_keep_positions(s):", "visible_tests": ["assert remove_vowels_keep_positions('hello world') == 'h_ll_ w_rld'", "assert remove_vowels_keep_positions('AEIOU') == '_____'", "assert remove_vowels_keep_positions('rhythm') == 'rhythm'"], "hidden_tests": ["assert remove_vowels_keep_positions('') == ''", "assert remove_vowels_keep_positions('aeiouAEIOU') == '__________'", "assert remove_vowels_keep_positions('bcdfg') == 'bcdfg'", "assert remove_vowels_keep_positions('Programming') == 'Pr_gr_mm_ng'", "assert remove_vowels_keep_positions('xyz') == 'xyz'", "assert remove_vowels_keep_positions('The Quick Fox') == 'Th_ Q__ck F_x'", "assert remove_vowels_keep_positions('a') == '_'", "assert remove_vowels_keep_positions('umbrella') == '_mbr_ll_'", "assert remove_vowels_keep_positions('EEEEE') == '_____'", "assert remove_vowels_keep_positions('noVowelsHr') == 'n_V_w_lsHr'", "assert remove_vowels_keep_positions('queue') == 'q____'", "assert remove_vowels_keep_positions('Mississippi') == 'M_ss_ss_pp_'", "assert remove_vowels_keep_positions('z') == 'z'", "assert remove_vowels_keep_positions('YoU') == 'Y__'", "assert remove_vowels_keep_positions('123 vowels 456') == '123 v_w_ls 456'", "assert remove_vowels_keep_positions('!!!') == '!!!'"], "reference": "def remove_vowels_keep_positions(s):\n    vowels = set(\"aeiouAEIOU\")\n    return \"\".join('_' if c in vowels else c for c in s)\n"}
