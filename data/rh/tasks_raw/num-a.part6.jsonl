{"tid": "num-101", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Compute the sum of the factorials of each decimal digit of the absolute value of an integer n.", "signature": "def sum_of_digit_factorials(n):", "visible_tests": ["assert sum_of_digit_factorials(123) == 9", "assert sum_of_digit_factorials(15) == 121", "assert sum_of_digit_factorials(0) == 1"], "hidden_tests": ["assert sum_of_digit_factorials(1) == 1", "assert sum_of_digit_factorials(9) == 362880", "assert sum_of_digit_factorials(145) == 145", "assert sum_of_digit_factorials(40585) == 40585", "assert sum_of_digit_factorials(10) == 2", "assert sum_of_digit_factorials(100) == 3", "assert sum_of_digit_factorials(999) == 1088640", "assert sum_of_digit_factorials(55) == 240", "assert sum_of_digit_factorials(220) == 5", "assert sum_of_digit_factorials(304) == 31", "assert sum_of_digit_factorials(7) == 5040", "assert sum_of_digit_factorials(88) == 80640", "assert sum_of_digit_factorials(200) == 4", "assert sum_of_digit_factorials(45) == 144", "assert sum_of_digit_factorials(500) == 122", "assert sum_of_digit_factorials(321) == 9"], "reference": "def sum_of_digit_factorials(n):\n    def fact(k):\n        r = 1\n        for i in range(2, k + 1):\n            r *= i\n        return r\n    return sum(fact(int(d)) for d in str(abs(n)))"}
{"tid": "num-102", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether a positive integer n is 9-digit pandigital: its decimal representation has exactly 9 digits, and each of the digits 1 through 9 appears exactly once.", "signature": "def is_pandigital(n):", "visible_tests": ["assert is_pandigital(123456789) == True", "assert is_pandigital(987654321) == True", "assert is_pandigital(918273645) == True"], "hidden_tests": ["assert is_pandigital(12345678) == False", "assert is_pandigital(123456780) == False", "assert is_pandigital(111111111) == False", "assert is_pandigital(1234567891) == False", "assert is_pandigital(213456789) == True", "assert is_pandigital(198765432) == True", "assert is_pandigital(0) == False", "assert is_pandigital(123456798) == True", "assert is_pandigital(9) == False", "assert is_pandigital(1) == False", "assert is_pandigital(100000000) == False", "assert is_pandigital(999999999) == False", "assert is_pandigital(135792468) == True", "assert is_pandigital(987651234) == True", "assert is_pandigital(864197532) == True"], "reference": "def is_pandigital(n):\n    s = str(n)\n    return len(s) == 9 and set(s) == set('123456789')"}
{"tid": "num-103", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Compute the sum of the digits of a non-negative integer n when represented in the given base (an integer of 2 or greater).", "signature": "def digit_sum_base(n, base):", "visible_tests": ["assert digit_sum_base(255, 16) == 30", "assert digit_sum_base(10, 2) == 2", "assert digit_sum_base(100, 10) == 1"], "hidden_tests": ["assert digit_sum_base(0, 2) == 0", "assert digit_sum_base(0, 16) == 0", "assert digit_sum_base(1, 2) == 1", "assert digit_sum_base(255, 2) == 8", "assert digit_sum_base(1000, 16) == 25", "assert digit_sum_base(999, 10) == 27", "assert digit_sum_base(31, 5) == 3", "assert digit_sum_base(63, 2) == 6", "assert digit_sum_base(100, 3) == 4", "assert digit_sum_base(9, 10) == 9", "assert digit_sum_base(16, 16) == 1", "assert digit_sum_base(2, 2) == 1", "assert digit_sum_base(1024, 2) == 1", "assert digit_sum_base(729, 3) == 1", "assert digit_sum_base(15, 16) == 15", "assert digit_sum_base(50, 8) == 8"], "reference": "def digit_sum_base(n, base):\n    if n == 0:\n        return 0\n    total = 0\n    while n > 0:\n        total += n % base\n        n //= base\n    return total"}
{"tid": "num-104", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether the decimal digits of a non-negative integer n strictly alternate between exactly two distinct values, like 1212 or 90909. Numbers with fewer than 3 digits are never undulating.", "signature": "def is_undulating_number(n):", "visible_tests": ["assert is_undulating_number(121) == True", "assert is_undulating_number(343) == True", "assert is_undulating_number(212) == True"], "hidden_tests": ["assert is_undulating_number(1212) == True", "assert is_undulating_number(3131) == True", "assert is_undulating_number(90909) == True", "assert is_undulating_number(171717) == True", "assert is_undulating_number(2121) == True", "assert is_undulating_number(4545) == True", "assert is_undulating_number(123) == False", "assert is_undulating_number(1122) == False", "assert is_undulating_number(111) == False", "assert is_undulating_number(1234) == False", "assert is_undulating_number(120) == False", "assert is_undulating_number(9898989) == True", "assert is_undulating_number(1) == False", "assert is_undulating_number(11) == False", "assert is_undulating_number(101) == True"], "reference": "def is_undulating_number(n):\n    s = str(abs(n))\n    if len(s) < 3:\n        return False\n    if s[0] == s[1]:\n        return False\n    for i in range(2, len(s)):\n        if s[i] != s[i - 2]:\n            return False\n    return True"}
{"tid": "num-105", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Count the number of unordered pairs of positive integers (a, b) with a <= b such that a*b equals n, for a positive integer n.", "signature": "def count_divisor_pairs(n):", "visible_tests": ["assert count_divisor_pairs(12) == 3", "assert count_divisor_pairs(36) == 5", "assert count_divisor_pairs(7) == 1"], "hidden_tests": ["assert count_divisor_pairs(1) == 1", "assert count_divisor_pairs(2) == 1", "assert count_divisor_pairs(100) == 5", "assert count_divisor_pairs(97) == 1", "assert count_divisor_pairs(60) == 6", "assert count_divisor_pairs(48) == 5", "assert count_divisor_pairs(64) == 4", "assert count_divisor_pairs(1024) == 6", "assert count_divisor_pairs(999) == 4", "assert count_divisor_pairs(45) == 3", "assert count_divisor_pairs(84) == 6", "assert count_divisor_pairs(101) == 1", "assert count_divisor_pairs(360) == 12", "assert count_divisor_pairs(1000000) == 25", "assert count_divisor_pairs(210) == 8", "assert count_divisor_pairs(9) == 2"], "reference": "def count_divisor_pairs(n):\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            count += 1\n        i += 1\n    return count"}
{"tid": "num-106", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Compute the sum of all positive divisors of a positive integer n that are themselves even numbers.", "signature": "def sum_of_even_divisors(n):", "visible_tests": ["assert sum_of_even_divisors(12) == 24", "assert sum_of_even_divisors(18) == 26", "assert sum_of_even_divisors(7) == 0"], "hidden_tests": ["assert sum_of_even_divisors(1) == 0", "assert sum_of_even_divisors(2) == 2", "assert sum_of_even_divisors(100) == 186", "assert sum_of_even_divisors(28) == 48", "assert sum_of_even_divisors(496) == 960", "assert sum_of_even_divisors(360) == 1092", "assert sum_of_even_divisors(999) == 0", "assert sum_of_even_divisors(1024) == 2046", "assert sum_of_even_divisors(45) == 0", "assert sum_of_even_divisors(84) == 192", "assert sum_of_even_divisors(101) == 0", "assert sum_of_even_divisors(60) == 144", "assert sum_of_even_divisors(36) == 78", "assert sum_of_even_divisors(8128) == 16128", "assert sum_of_even_divisors(50) == 62", "assert sum_of_even_divisors(6) == 8"], "reference": "def sum_of_even_divisors(n):\n    return sum(i for i in range(1, n + 1) if n % i == 0 and i % 2 == 0)"}
{"tid": "num-107", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Compute the sum of all positive divisors of a positive integer n that are themselves odd numbers.", "signature": "def sum_of_odd_divisors(n):", "visible_tests": ["assert sum_of_odd_divisors(12) == 4", "assert sum_of_odd_divisors(18) == 13", "assert sum_of_odd_divisors(7) == 8"], "hidden_tests": ["assert sum_of_odd_divisors(1) == 1", "assert sum_of_odd_divisors(2) == 1", "assert sum_of_odd_divisors(100) == 31", "assert sum_of_odd_divisors(28) == 8", "assert sum_of_odd_divisors(496) == 32", "assert sum_of_odd_divisors(360) == 78", "assert sum_of_odd_divisors(999) == 1520", "assert sum_of_odd_divisors(1024) == 1", "assert sum_of_odd_divisors(45) == 78", "assert sum_of_odd_divisors(84) == 32", "assert sum_of_odd_divisors(101) == 102", "assert sum_of_odd_divisors(60) == 24", "assert sum_of_odd_divisors(36) == 13", "assert sum_of_odd_divisors(8128) == 128", "assert sum_of_odd_divisors(50) == 31", "assert sum_of_odd_divisors(6) == 4"], "reference": "def sum_of_odd_divisors(n):\n    return sum(i for i in range(1, n + 1) if n % i == 0 and i % 2 == 1)"}
{"tid": "num-108", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether the sum of all positive divisors of a positive integer n (including n itself) equals k times n, for a positive integer k.", "signature": "def is_multiply_perfect(n, k):", "visible_tests": ["assert is_multiply_perfect(6, 2) == True", "assert is_multiply_perfect(1, 1) == True", "assert is_multiply_perfect(28, 2) == True"], "hidden_tests": ["assert is_multiply_perfect(2, 1) == False", "assert is_multiply_perfect(12, 3) == False", "assert is_multiply_perfect(120, 3) == True", "assert is_multiply_perfect(496, 2) == True", "assert is_multiply_perfect(2, 2) == False", "assert is_multiply_perfect(8128, 2) == True", "assert is_multiply_perfect(24, 2) == False", "assert is_multiply_perfect(5, 1) == False", "assert is_multiply_perfect(672, 3) == True", "assert is_multiply_perfect(60, 3) == False", "assert is_multiply_perfect(30240, 5) == False", "assert is_multiply_perfect(20, 2) == False", "assert is_multiply_perfect(10, 2) == False", "assert is_multiply_perfect(36, 3) == False", "assert is_multiply_perfect(100, 2) == False"], "reference": "def is_multiply_perfect(n, k):\n    total = sum(i for i in range(1, n + 1) if n % i == 0)\n    return total == k * n"}
{"tid": "num-109", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "For a non-negative integer n and a base of 2 or greater, reverse the sequence of digits of n's representation in that base, then return the value of the reversed digit sequence converted back to a decimal integer.", "signature": "def reverse_in_base(n, base):", "visible_tests": ["assert reverse_in_base(12, 10) == 21", "assert reverse_in_base(100, 10) == 1", "assert reverse_in_base(255, 16) == 255"], "hidden_tests": ["assert reverse_in_base(0, 10) == 0", "assert reverse_in_base(0, 16) == 0", "assert reverse_in_base(1, 2) == 1", "assert reverse_in_base(10, 10) == 1", "assert reverse_in_base(1000, 10) == 1", "assert reverse_in_base(999, 10) == 999", "assert reverse_in_base(31, 5) == 31", "assert reverse_in_base(63, 2) == 63", "assert reverse_in_base(1024, 2) == 1", "assert reverse_in_base(729, 3) == 1", "assert reverse_in_base(15, 16) == 15", "assert reverse_in_base(50, 8) == 22", "assert reverse_in_base(7, 7) == 1", "assert reverse_in_base(9999, 10) == 9999", "assert reverse_in_base(255, 10) == 552", "assert reverse_in_base(2, 2) == 1"], "reference": "def reverse_in_base(n, base):\n    if n == 0:\n        return 0\n    digits = []\n    x = n\n    while x > 0:\n        digits.append(x % base)\n        x //= base\n    value = 0\n    for d in digits:\n        value = value * base + d\n    return value"}
{"tid": "num-110", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether the decimal digits of the absolute value of an integer n are in strictly increasing order from left to right. A single-digit number is trivially strictly increasing.", "signature": "def is_strictly_increasing_digits(n):", "visible_tests": ["assert is_strictly_increasing_digits(123) == True", "assert is_strictly_increasing_digits(1359) == True", "assert is_strictly_increasing_digits(5) == True"], "hidden_tests": ["assert is_strictly_increasing_digits(0) == True", "assert is_strictly_increasing_digits(12) == True", "assert is_strictly_increasing_digits(21) == False", "assert is_strictly_increasing_digits(1111) == False", "assert is_strictly_increasing_digits(9) == True", "assert is_strictly_increasing_digits(123456789) == True", "assert is_strictly_increasing_digits(987654321) == False", "assert is_strictly_increasing_digits(1122) == False", "assert is_strictly_increasing_digits(111) == False", "assert is_strictly_increasing_digits(100) == False", "assert is_strictly_increasing_digits(19) == True", "assert is_strictly_increasing_digits(24) == True", "assert is_strictly_increasing_digits(13579) == True", "assert is_strictly_increasing_digits(2468) == True", "assert is_strictly_increasing_digits(1) == True", "assert is_strictly_increasing_digits(1234) == True"], "reference": "def is_strictly_increasing_digits(n):\n    s = str(abs(n))\n    return all(s[i] < s[i + 1] for i in range(len(s) - 1))"}
