{"tid": "dct-061", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Flatten a dict that may contain nested dicts as values into a single-level dict, joining the path of keys with '.' (e.g. {'a': {'b': 1}} becomes {'a.b': 1}). Leaf (non-dict) values are copied as-is. An empty dict returns an empty dict.", "signature": "def flatten_nested_dict(nested):", "visible_tests": ["assert flatten_nested_dict({'a': {'b': 1}}) == {'a.b': 1}", "assert flatten_nested_dict({'x': 1, 'y': 2}) == {'x': 1, 'y': 2}", "assert flatten_nested_dict({}) == {}"], "hidden_tests": ["assert flatten_nested_dict({'a': {}}) == {}", "assert flatten_nested_dict({'a': {'b': {'c': 2}}}) == {'a.b.c': 2}", "assert flatten_nested_dict({'a': 1, 'b': {'c': 2}}) == {'a': 1, 'b.c': 2}", "assert flatten_nested_dict({'only': {'nested': {'deep': 'value'}}}) == {'only.nested.deep': 'value'}", "assert flatten_nested_dict({'p': {'q': 1}, 'r': 2}) == {'p.q': 1, 'r': 2}", "assert flatten_nested_dict({'m': {'n': 1, 'o': 2}}) == {'m.n': 1, 'm.o': 2}", "assert flatten_nested_dict({'a': {'b': 1, 'c': {'d': 2}}}) == {'a.b': 1, 'a.c.d': 2}", "assert flatten_nested_dict({'top': 1}) == {'top': 1}", "assert flatten_nested_dict({'a': {'b': {'c': {'d': 1}}}}) == {'a.b.c.d': 1}", "assert flatten_nested_dict({'x': {}, 'y': {'z': 1}}) == {'y.z': 1}", "assert flatten_nested_dict({'k1': {'k2': {'k3': 3}}}) == {'k1.k2.k3': 3}", "assert flatten_nested_dict({'a': None}) == {'a': None}", "assert flatten_nested_dict({'a': {'b': None}}) == {'a.b': None}", "assert flatten_nested_dict({'g1': {'g2': 1}, 'g3': {'g4': 2}}) == {'g1.g2': 1, 'g3.g4': 2}", "assert flatten_nested_dict({'single': 'value'}) == {'single': 'value'}"], "reference": "def flatten_nested_dict(nested):\n    res = {}\n    def rec(d, prefix):\n        for k, v in d.items():\n            key = f\"{prefix}.{k}\" if prefix else str(k)\n            if isinstance(v, dict):\n                rec(v, key)\n            else:\n                res[key] = v\n    rec(nested, \"\")\n    return res"}
{"tid": "dct-062", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Recursively merge two dicts that may contain nested dicts as values. When a key exists in both and both values are dicts, merge them recursively; otherwise the value from d2 overrides d1's. Return the merged dict without mutating the inputs.", "signature": "def deep_merge(d1, d2):", "visible_tests": ["assert deep_merge({'a': 1}, {'b': 2}) == {'a': 1, 'b': 2}", "assert deep_merge({'a': {'x': 1}}, {'a': {'y': 2}}) == {'a': {'x': 1, 'y': 2}}", "assert deep_merge({}, {}) == {}"], "hidden_tests": ["assert deep_merge({}, {'a': 1}) == {'a': 1}", "assert deep_merge({'a': 1}, {}) == {'a': 1}", "assert deep_merge({'a': 1}, {'a': 2}) == {'a': 2}", "assert deep_merge({'a': {'x': 1}}, {'a': {'x': 2}}) == {'a': {'x': 2}}", "assert deep_merge({'a': {'x': 1, 'y': 2}}, {'a': {'y': 3, 'z': 4}}) == {'a': {'x': 1, 'y': 3, 'z': 4}}", "assert deep_merge({'a': {'b': {'c': 1}}}, {'a': {'b': {'d': 2}}}) == {'a': {'b': {'c': 1, 'd': 2}}}", "assert deep_merge({'a': 1}, {'a': {'b': 2}}) == {'a': {'b': 2}}", "assert deep_merge({'a': {'b': 1}}, {'a': 5}) == {'a': 5}", "assert deep_merge({'only1': 1}, {'only2': 2}) == {'only1': 1, 'only2': 2}", "assert deep_merge({'m': {'n': {'o': 1}}}, {'m': {'n': {'p': 2}}}) == {'m': {'n': {'o': 1, 'p': 2}}}", "assert deep_merge({'a': {}}, {'a': {'b': 1}}) == {'a': {'b': 1}}", "assert deep_merge({'a': {'b': 1}}, {'a': {}}) == {'a': {'b': 1}}", "assert deep_merge({'z': 1, 'y': {'x': 1}}, {'z': 2, 'y': {'w': 3}}) == {'z': 2, 'y': {'x': 1, 'w': 3}}", "assert deep_merge({'a': {'b': {'c': 1}}}, {'a': {'b': {'c': 2}}}) == {'a': {'b': {'c': 2}}}", "assert deep_merge({}, {}) == {}"], "reference": "def deep_merge(d1, d2):\n    res = dict(d1)\n    for k, v in d2.items():\n        if k in res and isinstance(res[k], dict) and isinstance(v, dict):\n            res[k] = deep_merge(res[k], v)\n        else:\n            res[k] = v\n    return res"}
{"tid": "dct-063", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of strings, count how many times each character appears across all of them combined. Return a dict mapping each distinct character to its total count. An empty list returns an empty dict.", "signature": "def merge_char_frequencies(strings):", "visible_tests": ["assert merge_char_frequencies(['aab', 'bcc']) == {'a': 2, 'b': 2, 'c': 2}", "assert merge_char_frequencies(['hello']) == {'h': 1, 'e': 1, 'l': 2, 'o': 1}", "assert merge_char_frequencies([]) == {}"], "hidden_tests": ["assert merge_char_frequencies(['']) == {}", "assert merge_char_frequencies(['a', 'a', 'a']) == {'a': 3}", "assert merge_char_frequencies(['ab', 'ba']) == {'a': 2, 'b': 2}", "assert merge_char_frequencies(['xyz', 'zyx']) == {'x': 2, 'y': 2, 'z': 2}", "assert merge_char_frequencies(['', '', '']) == {}", "assert merge_char_frequencies(['mississippi']) == {'m': 1, 'i': 4, 's': 4, 'p': 2}", "assert merge_char_frequencies(['aaaaa']) == {'a': 5}", "assert merge_char_frequencies(['abc', 'def', 'ghi']) == {'a': 1, 'b': 1, 'c': 1, 'd': 1, 'e': 1, 'f': 1, 'g': 1, 'h': 1, 'i': 1}", "assert merge_char_frequencies(['same', 'same']) == {'s': 2, 'a': 2, 'm': 2, 'e': 2}", "assert merge_char_frequencies(['1', '2', '1']) == {'1': 2, '2': 1}", "assert merge_char_frequencies(['  ', '  ']) == {' ': 4}", "assert merge_char_frequencies(['z']) == {'z': 1}", "assert merge_char_frequencies(['cat', 'dog', 'cat', 'dog']) == {'c': 2, 'a': 2, 't': 2, 'd': 2, 'o': 2, 'g': 2}", "assert merge_char_frequencies(['a b', 'c d']) == {'a': 1, ' ': 2, 'b': 1, 'c': 1, 'd': 1}", "assert merge_char_frequencies(['single']) == {'s': 1, 'i': 1, 'n': 1, 'g': 1, 'l': 1, 'e': 1}"], "reference": "def merge_char_frequencies(strings):\n    res = {}\n    for s in strings:\n        for ch in s:\n            res[ch] = res.get(ch, 0) + 1\n    return res"}
{"tid": "dct-064", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a list of the k keys with the largest values in d, ordered by value descending and, for ties, by key ascending. If k exceeds the number of keys, return all keys in that order. An empty dict returns an empty list.", "signature": "def top_k_keys_by_value(d, k):", "visible_tests": ["assert top_k_keys_by_value({'a': 1, 'b': 3, 'c': 2}, 2) == ['b', 'c']", "assert top_k_keys_by_value({'x': 5}, 1) == ['x']", "assert top_k_keys_by_value({}, 3) == []"], "hidden_tests": ["assert top_k_keys_by_value({'a': 1, 'b': 1, 'c': 1}, 2) == ['a', 'b']", "assert top_k_keys_by_value({'a': 1, 'b': 2}, 0) == []", "assert top_k_keys_by_value({'a': 1}, 5) == ['a']", "assert top_k_keys_by_value({'z': 1, 'y': 2, 'x': 3}, 3) == ['x', 'y', 'z']", "assert top_k_keys_by_value({'m': 5, 'n': 5, 'o': 5, 'p': 1}, 2) == ['m', 'n']", "assert top_k_keys_by_value({'p': -1, 'q': -2, 'r': -3}, 1) == ['p']", "assert top_k_keys_by_value({'k1': 10, 'k2': 20, 'k3': 20}, 2) == ['k2', 'k3']", "assert top_k_keys_by_value({'only': 1}, 1) == ['only']", "assert top_k_keys_by_value({'a': 1, 'b': 2, 'c': 3, 'd': 4, 'e': 5}, 3) == ['e', 'd', 'c']", "assert top_k_keys_by_value({'tie1': 5, 'tie2': 5, 'tie3': 5}, 3) == ['tie1', 'tie2', 'tie3']", "assert top_k_keys_by_value({'a': 0}, 1) == ['a']", "assert top_k_keys_by_value({'x': 100, 'y': 50, 'z': 75}, 2) == ['x', 'z']", "assert top_k_keys_by_value({'a': 1, 'b': 2}, 2) == ['b', 'a']", "assert top_k_keys_by_value({'g': 1, 'h': 1, 'i': 2, 'j': 2}, 4) == ['i', 'j', 'g', 'h']", "assert top_k_keys_by_value({'single': 9}, 0) == []"], "reference": "def top_k_keys_by_value(d, k):\n    items = sorted(d.items(), key=lambda kv: (-kv[1], kv[0]))\n    return [kv[0] for kv in items[:k]]"}
{"tid": "dct-065", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a list of the k keys with the smallest values in d, ordered by value ascending and, for ties, by key ascending. If k exceeds the number of keys, return all keys in that order. An empty dict returns an empty list.", "signature": "def bottom_k_keys_by_value(d, k):", "visible_tests": ["assert bottom_k_keys_by_value({'a': 1, 'b': 3, 'c': 2}, 2) == ['a', 'c']", "assert bottom_k_keys_by_value({'x': 5}, 1) == ['x']", "assert bottom_k_keys_by_value({}, 3) == []"], "hidden_tests": ["assert bottom_k_keys_by_value({'a': 1, 'b': 1, 'c': 1}, 2) == ['a', 'b']", "assert bottom_k_keys_by_value({'a': 1, 'b': 2}, 0) == []", "assert bottom_k_keys_by_value({'a': 1}, 5) == ['a']", "assert bottom_k_keys_by_value({'z': 1, 'y': 2, 'x': 3}, 3) == ['z', 'y', 'x']", "assert bottom_k_keys_by_value({'m': 5, 'n': 5, 'o': 5, 'p': 1}, 2) == ['p', 'm']", "assert bottom_k_keys_by_value({'p': -1, 'q': -2, 'r': -3}, 1) == ['r']", "assert bottom_k_keys_by_value({'k1': 10, 'k2': 20, 'k3': 10}, 2) == ['k1', 'k3']", "assert bottom_k_keys_by_value({'only': 1}, 1) == ['only']", "assert bottom_k_keys_by_value({'a': 1, 'b': 2, 'c': 3, 'd': 4, 'e': 5}, 3) == ['a', 'b', 'c']", "assert bottom_k_keys_by_value({'tie1': 5, 'tie2': 5, 'tie3': 5}, 3) == ['tie1', 'tie2', 'tie3']", "assert bottom_k_keys_by_value({'a': 0}, 1) == ['a']", "assert bottom_k_keys_by_value({'x': 100, 'y': 50, 'z': 75}, 2) == ['y', 'z']", "assert bottom_k_keys_by_value({'a': 1, 'b': 2}, 2) == ['a', 'b']", "assert bottom_k_keys_by_value({'g': 1, 'h': 1, 'i': 2, 'j': 2}, 4) == ['g', 'h', 'i', 'j']", "assert bottom_k_keys_by_value({'single': 9}, 0) == []"], "reference": "def bottom_k_keys_by_value(d, k):\n    items = sorted(d.items(), key=lambda kv: (kv[1], kv[0]))\n    return [kv[0] for kv in items[:k]]"}
{"tid": "dct-066", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a new dict containing only the entries of d whose key (a string) has length less than or equal to max_len. The original dict is unmodified. If nothing qualifies, return an empty dict.", "signature": "def filter_keys_by_max_length(d, max_len):", "visible_tests": ["assert filter_keys_by_max_length({'a': 1, 'bb': 2, 'ccc': 3}, 2) == {'a': 1, 'bb': 2}", "assert filter_keys_by_max_length({'x': 1}, 0) == {}", "assert filter_keys_by_max_length({}, 5) == {}"], "hidden_tests": ["assert filter_keys_by_max_length({'a': 1}, 1) == {'a': 1}", "assert filter_keys_by_max_length({'a': 1}, 0) == {}", "assert filter_keys_by_max_length({'ab': 1, 'cd': 2}, 5) == {'ab': 1, 'cd': 2}", "assert filter_keys_by_max_length({'long_key': 1, 'x': 2}, 3) == {'x': 2}", "assert filter_keys_by_max_length({'a': 1, 'bb': 2, 'ccc': 3, 'dddd': 4}, 3) == {'a': 1, 'bb': 2, 'ccc': 3}", "assert filter_keys_by_max_length({'': 1}, 0) == {'': 1}", "assert filter_keys_by_max_length({'same': 1, 'size': 2, 'word': 3}, 4) == {'same': 1, 'size': 2, 'word': 3}", "assert filter_keys_by_max_length({'onelongkey': 1}, 100) == {'onelongkey': 1}", "assert filter_keys_by_max_length({'a': 1, 'b': 2, 'c': 3}, 1) == {'a': 1, 'b': 2, 'c': 3}", "assert filter_keys_by_max_length({'k1': 1, 'kk2': 2, 'kkk3': 3}, 2) == {'k1': 1}", "assert filter_keys_by_max_length({'z': 1}, -1) == {}", "assert filter_keys_by_max_length({'aa': 1, 'aaa': 2, 'aaaa': 3}, 3) == {'aa': 1, 'aaa': 2}", "assert filter_keys_by_max_length({'solo': 1}, 4) == {'solo': 1}", "assert filter_keys_by_max_length({'a': 1, 'bb': 2}, 10) == {'a': 1, 'bb': 2}", "assert filter_keys_by_max_length({'xx': 1, 'xxx': 2, 'xxxx': 3, 'x': 4}, 1) == {'x': 4}"], "reference": "def filter_keys_by_max_length(d, max_len):\n    return {k: v for k, v in d.items() if len(k) <= max_len}"}
{"tid": "dct-067", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of item names and a dict mapping some item names to a category string, count how many items fall into each category. Items not present in the categories dict are counted under 'other'. Return a dict mapping category to count. An empty items list returns an empty dict.", "signature": "def count_items_by_category(items, categories):", "visible_tests": ["assert count_items_by_category(['apple', 'carrot', 'banana'], {'apple': 'fruit', 'banana': 'fruit', 'carrot': 'veg'}) == {'fruit': 2, 'veg': 1}", "assert count_items_by_category(['x'], {}) == {'other': 1}", "assert count_items_by_category([], {}) == {}"], "hidden_tests": ["assert count_items_by_category(['a'], {'a': 'cat1'}) == {'cat1': 1}", "assert count_items_by_category(['a', 'b'], {'a': 'cat1'}) == {'cat1': 1, 'other': 1}", "assert count_items_by_category(['unknown1', 'unknown2'], {}) == {'other': 2}", "assert count_items_by_category(['a', 'a', 'a'], {'a': 'same'}) == {'same': 3}", "assert count_items_by_category(['x', 'y', 'z'], {'x': 'c1', 'y': 'c1', 'z': 'c2'}) == {'c1': 2, 'c2': 1}", "assert count_items_by_category(['p', 'q', 'r', 's'], {'p': 'g1', 'q': 'g1', 'r': 'g2'}) == {'g1': 2, 'g2': 1, 'other': 1}", "assert count_items_by_category(['only'], {'only': 'solo_cat'}) == {'solo_cat': 1}", "assert count_items_by_category(['m', 'n', 'o', 'm'], {'m': 'cat_a', 'n': 'cat_b', 'o': 'cat_a'}) == {'cat_a': 3, 'cat_b': 1}", "assert count_items_by_category(['a', 'b', 'c', 'd'], {'a': 'x', 'b': 'x', 'c': 'y', 'd': 'y'}) == {'x': 2, 'y': 2}", "assert count_items_by_category(['k1', 'k2', 'unmapped'], {'k1': 'known', 'k2': 'known'}) == {'known': 2, 'other': 1}", "assert count_items_by_category(['a'], {'b': 'cat'}) == {'other': 1}", "assert count_items_by_category(['dup', 'dup', 'dup'], {}) == {'other': 3}", "assert count_items_by_category(['mix1', 'mix2', 'mix3'], {'mix1': 'special'}) == {'special': 1, 'other': 2}", "assert count_items_by_category(['z', 'z', 'y', 'y', 'x'], {'z': 'letters', 'y': 'letters', 'x': 'letters'}) == {'letters': 5}", "assert count_items_by_category(['item'], {'item': 'cat1', 'other_item': 'cat2'}) == {'cat1': 1}"], "reference": "def count_items_by_category(items, categories):\n    res = {}\n    for it in items:\n        cat = categories.get(it, \"other\")\n        res[cat] = res.get(cat, 0) + 1\n    return res"}
{"tid": "dct-068", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of (key, value) tuples, build a dict mapping each key to a sorted list of the distinct values associated with it. Duplicate (key, value) pairs contribute only one entry. An empty list returns an empty dict.", "signature": "def build_multimap(pairs):", "visible_tests": ["assert build_multimap([('a', 1), ('a', 2), ('b', 1)]) == {'a': [1, 2], 'b': [1]}", "assert build_multimap([('x', 'p')]) == {'x': ['p']}", "assert build_multimap([]) == {}"], "hidden_tests": ["assert build_multimap([('a', 1), ('a', 1), ('a', 1)]) == {'a': [1]}", "assert build_multimap([('g', 3), ('g', 1), ('g', 2)]) == {'g': [1, 2, 3]}", "assert build_multimap([('m', 'z'), ('m', 'a')]) == {'m': ['a', 'z']}", "assert build_multimap([('k', 1), ('j', 2), ('k', 1), ('j', 2)]) == {'k': [1], 'j': [2]}", "assert build_multimap([('only', 'solo')]) == {'only': ['solo']}", "assert build_multimap([('p', 1), ('p', 2), ('q', 1), ('q', 2), ('q', 3)]) == {'p': [1, 2], 'q': [1, 2, 3]}", "assert build_multimap([('a', 'x'), ('b', 'y'), ('a', 'z')]) == {'a': ['x', 'z'], 'b': ['y']}", "assert build_multimap([('z', 1)]) == {'z': [1]}", "assert build_multimap([('s', 5), ('s', 3), ('s', 4), ('s', 3)]) == {'s': [3, 4, 5]}", "assert build_multimap([('g1', 'a'), ('g2', 'a')]) == {'g1': ['a'], 'g2': ['a']}", "assert build_multimap([('t', 1), ('t', 2), ('t', 3), ('t', 1), ('t', 2)]) == {'t': [1, 2, 3]}", "assert build_multimap([('a', 1), ('a', 2), ('a', 3), ('b', 1), ('b', 2)]) == {'a': [1, 2, 3], 'b': [1, 2]}", "assert build_multimap([('k', 'v')]) == {'k': ['v']}", "assert build_multimap([('dup', 1), ('dup', 1), ('dup', 2)]) == {'dup': [1, 2]}", "assert build_multimap([('x', 1), ('y', 1), ('z', 1)]) == {'x': [1], 'y': [1], 'z': [1]}"], "reference": "def build_multimap(pairs):\n    res = {}\n    for k, v in pairs:\n        res.setdefault(k, set()).add(v)\n    return {k: sorted(vs) for k, vs in res.items()}"}
{"tid": "dct-069", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict mapping keys to lists of values, count the total number of times each value appears across all the lists combined (not deduplicated). Return a dict mapping each distinct value to its total count. An empty dict returns an empty dict.", "signature": "def count_values_across_multimap(d):", "visible_tests": ["assert count_values_across_multimap({'a': [1, 2], 'b': [2, 3]}) == {1: 1, 2: 2, 3: 1}", "assert count_values_across_multimap({'x': [1, 1, 1]}) == {1: 3}", "assert count_values_across_multimap({}) == {}"], "hidden_tests": ["assert count_values_across_multimap({'a': []}) == {}", "assert count_values_across_multimap({'a': [], 'b': []}) == {}", "assert count_values_across_multimap({'only': [5]}) == {5: 1}", "assert count_values_across_multimap({'m': [1, 2, 3], 'n': [1, 2, 3]}) == {1: 2, 2: 2, 3: 2}", "assert count_values_across_multimap({'z': ['x', 'x', 'y']}) == {'x': 2, 'y': 1}", "assert count_values_across_multimap({'p': [1], 'q': [1], 'r': [1]}) == {1: 3}", "assert count_values_across_multimap({'k': [1, 1, 1, 1]}) == {1: 4}", "assert count_values_across_multimap({'g1': ['a', 'b'], 'g2': ['b', 'c'], 'g3': ['c', 'a']}) == {'a': 2, 'b': 2, 'c': 2}", "assert count_values_across_multimap({'a': [1, 2, 3, 4, 5]}) == {1: 1, 2: 1, 3: 1, 4: 1, 5: 1}", "assert count_values_across_multimap({'single_key': ['single_val']}) == {'single_val': 1}", "assert count_values_across_multimap({'a': [1], 'b': [2], 'c': [1]}) == {1: 2, 2: 1}", "assert count_values_across_multimap({'a': [0, 0], 'b': [0]}) == {0: 3}", "assert count_values_across_multimap({'x': ['dup', 'dup', 'other']}) == {'dup': 2, 'other': 1}", "assert count_values_across_multimap({'a': [1, 1], 'b': [1, 1]}) == {1: 4}", "assert count_values_across_multimap({'empty1': [], 'nonempty': [1, 2]}) == {1: 1, 2: 1}"], "reference": "def count_values_across_multimap(d):\n    res = {}\n    for vals in d.values():\n        for v in vals:\n            res[v] = res.get(v, 0) + 1\n    return res"}
{"tid": "dct-070", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Split both text1 and text2 on whitespace and find the distinct words that appear in both. Return a sorted list of those common words. If there is no overlap, return an empty list.", "signature": "def common_words(text1, text2):", "visible_tests": ["assert common_words('the cat sat', 'the dog sat') == ['sat', 'the']", "assert common_words('a b c', 'd e f') == []", "assert common_words('', '') == []"], "hidden_tests": ["assert common_words('', 'a b c') == []", "assert common_words('a b c', '') == []", "assert common_words('same words here', 'same words here') == ['here', 'same', 'words']", "assert common_words('a a a', 'a b c') == ['a']", "assert common_words('x y z', 'z y x') == ['x', 'y', 'z']", "assert common_words('one two three', 'two three four') == ['three', 'two']", "assert common_words('cat dog', 'bird fish') == []", "assert common_words('word', 'word') == ['word']", "assert common_words('m n o', 'n o p') == ['n', 'o']", "assert common_words('a b', 'a b c d') == ['a', 'b']", "assert common_words('hello world', 'world hello') == ['hello', 'world']", "assert common_words('unique1', 'unique2') == []", "assert common_words('repeat repeat', 'repeat') == ['repeat']", "assert common_words('z', 'z') == ['z']", "assert common_words('all different here', 'totally other words') == []"], "reference": "def common_words(text1, text2):\n    return sorted(set(text1.split()) & set(text2.split()))"}
{"tid": "dct-071", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Split both text1 and text2 on whitespace and find the distinct words that appear in text1 but not in text2. Return a sorted list of those words. If every word of text1 also appears in text2, return an empty list.", "signature": "def unique_words_first_only(text1, text2):", "visible_tests": ["assert unique_words_first_only('the cat sat', 'the dog sat') == ['cat']", "assert unique_words_first_only('a b c', 'd e f') == ['a', 'b', 'c']", "assert unique_words_first_only('', '') == []"], "hidden_tests": ["assert unique_words_first_only('a b c', '') == ['a', 'b', 'c']", "assert unique_words_first_only('', 'a b c') == []", "assert unique_words_first_only('same words', 'same words') == []", "assert unique_words_first_only('a a a', 'b c') == ['a']", "assert unique_words_first_only('x y z', 'x y z') == []", "assert unique_words_first_only('one two three', 'two three') == ['one']", "assert unique_words_first_only('cat dog bird', 'bird') == ['cat', 'dog']", "assert unique_words_first_only('word', 'other') == ['word']", "assert unique_words_first_only('m n o', 'n') == ['m', 'o']", "assert unique_words_first_only('a b c d', 'a b') == ['c', 'd']", "assert unique_words_first_only('hello world', 'goodbye') == ['hello', 'world']", "assert unique_words_first_only('unique', 'different') == ['unique']", "assert unique_words_first_only('repeat repeat unique', 'repeat') == ['unique']", "assert unique_words_first_only('z y x', 'y') == ['x', 'z']", "assert unique_words_first_only('all new words here', 'none of these match') == ['all', 'here', 'new', 'words']"], "reference": "def unique_words_first_only(text1, text2):\n    return sorted(set(text1.split()) - set(text2.split()))"}
{"tid": "dct-072", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Split both text1 and text2 on whitespace and count occurrences of each word in each. For every word that appears in either text, compute its count in text1 minus its count in text2 (treating a missing word as count 0). Return a dict mapping each such word to that difference.", "signature": "def word_count_difference(text1, text2):", "visible_tests": ["assert word_count_difference('a a b', 'a b b') == {'a': 1, 'b': -1}", "assert word_count_difference('cat dog', 'cat') == {'dog': 1, 'cat': 0}", "assert word_count_difference('', '') == {}"], "hidden_tests": ["assert word_count_difference('', 'a b c') == {'c': -1, 'a': -1, 'b': -1}", "assert word_count_difference('a b c', '') == {'c': 1, 'a': 1, 'b': 1}", "assert word_count_difference('same same', 'same same') == {'same': 0}", "assert word_count_difference('x x x', 'x') == {'x': 2}", "assert word_count_difference('a b c', 'd e f') == {'d': -1, 'c': 1, 'a': 1, 'b': 1, 'e': -1, 'f': -1}", "assert word_count_difference('one one two', 'one two two') == {'two': -1, 'one': 1}", "assert word_count_difference('word', 'word word') == {'word': -1}", "assert word_count_difference('m n', 'm n o') == {'o': -1, 'n': 0, 'm': 0}", "assert word_count_difference('repeat repeat', 'repeat') == {'repeat': 1}", "assert word_count_difference('z z z', 'z z') == {'z': 1}", "assert word_count_difference('only1', 'only2') == {'only2': -1, 'only1': 1}", "assert word_count_difference('a', 'a a a') == {'a': -2}", "assert word_count_difference('cat cat dog', 'dog dog cat') == {'dog': -1, 'cat': 1}", "assert word_count_difference('k k k k', 'k') == {'k': 3}", "assert word_count_difference('p q r', 'p q r p q r') == {'r': -1, 'q': -1, 'p': -1}"], "reference": "def word_count_difference(text1, text2):\n    c1 = {}\n    for w in text1.split():\n        c1[w] = c1.get(w, 0) + 1\n    c2 = {}\n    for w in text2.split():\n        c2[w] = c2.get(w, 0) + 1\n    keys = set(c1) | set(c2)\n    return {k: c1.get(k, 0) - c2.get(k, 0) for k in keys}"}
{"tid": "dct-073", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Classify each integer score in scores into a letter grade: 'A' for 90 and above, 'B' for 80-89, 'C' for 70-79, 'D' for 60-69, and 'F' below 60. Return a dict with all five grade letters as keys, mapping to how many scores fall into each (0 if none).", "signature": "def grade_distribution(scores):", "visible_tests": ["assert grade_distribution([95, 85, 75]) == {'A': 1, 'B': 1, 'C': 1, 'D': 0, 'F': 0}", "assert grade_distribution([100, 0]) == {'A': 1, 'B': 0, 'C': 0, 'D': 0, 'F': 1}", "assert grade_distribution([]) == {'A': 0, 'B': 0, 'C': 0, 'D': 0, 'F': 0}"], "hidden_tests": ["assert grade_distribution([90]) == {'A': 1, 'B': 0, 'C': 0, 'D': 0, 'F': 0}", "assert grade_distribution([89]) == {'A': 0, 'B': 1, 'C': 0, 'D': 0, 'F': 0}", "assert grade_distribution([80]) == {'A': 0, 'B': 1, 'C': 0, 'D': 0, 'F': 0}", "assert grade_distribution([79]) == {'A': 0, 'B': 0, 'C': 1, 'D': 0, 'F': 0}", "assert grade_distribution([70]) == {'A': 0, 'B': 0, 'C': 1, 'D': 0, 'F': 0}", "assert grade_distribution([69]) == {'A': 0, 'B': 0, 'C': 0, 'D': 1, 'F': 0}", "assert grade_distribution([60]) == {'A': 0, 'B': 0, 'C': 0, 'D': 1, 'F': 0}", "assert grade_distribution([59]) == {'A': 0, 'B': 0, 'C': 0, 'D': 0, 'F': 1}", "assert grade_distribution([100, 100, 100]) == {'A': 3, 'B': 0, 'C': 0, 'D': 0, 'F': 0}", "assert grade_distribution([0, 0, 0]) == {'A': 0, 'B': 0, 'C': 0, 'D': 0, 'F': 3}", "assert grade_distribution([90, 80, 70, 60, 50]) == {'A': 1, 'B': 1, 'C': 1, 'D': 1, 'F': 1}", "assert grade_distribution([65, 75, 85, 95]) == {'A': 1, 'B': 1, 'C': 1, 'D': 1, 'F': 0}", "assert grade_distribution([59, 60, 69, 70]) == {'A': 0, 'B': 0, 'C': 1, 'D': 2, 'F': 1}", "assert grade_distribution([100]) == {'A': 1, 'B': 0, 'C': 0, 'D': 0, 'F': 0}", "assert grade_distribution([55, 45, 35]) == {'A': 0, 'B': 0, 'C': 0, 'D': 0, 'F': 3}"], "reference": "def grade_distribution(scores):\n    d = {\"A\": 0, \"B\": 0, \"C\": 0, \"D\": 0, \"F\": 0}\n    for s in scores:\n        if s >= 90:\n            d[\"A\"] += 1\n        elif s >= 80:\n            d[\"B\"] += 1\n        elif s >= 70:\n            d[\"C\"] += 1\n        elif s >= 60:\n            d[\"D\"] += 1\n        else:\n            d[\"F\"] += 1\n    return d"}
{"tid": "dct-074", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Bucket each non-negative integer age into a decade label: '0-9', '10-19', ..., '90-99', or '100+' for ages 100 and above. Return a dict mapping each label that has at least one age to the count of ages in it (labels with no ages are omitted). An empty list returns an empty dict.", "signature": "def age_group_counts(ages):", "visible_tests": ["assert age_group_counts([5, 25, 45]) == {'0-9': 1, '20-29': 1, '40-49': 1}", "assert age_group_counts([0, 9]) == {'0-9': 2}", "assert age_group_counts([]) == {}"], "hidden_tests": ["assert age_group_counts([100]) == {'100+': 1}", "assert age_group_counts([99]) == {'90-99': 1}", "assert age_group_counts([10, 19]) == {'10-19': 2}", "assert age_group_counts([0]) == {'0-9': 1}", "assert age_group_counts([100, 101, 150]) == {'100+': 3}", "assert age_group_counts([5, 5, 5]) == {'0-9': 3}", "assert age_group_counts([25, 35, 45, 55]) == {'20-29': 1, '30-39': 1, '40-49': 1, '50-59': 1}", "assert age_group_counts([0, 100]) == {'0-9': 1, '100+': 1}", "assert age_group_counts([9, 10]) == {'0-9': 1, '10-19': 1}", "assert age_group_counts([99, 100]) == {'90-99': 1, '100+': 1}", "assert age_group_counts([20, 21, 22, 29]) == {'20-29': 4}", "assert age_group_counts([70, 71, 79, 80]) == {'70-79': 3, '80-89': 1}", "assert age_group_counts([1, 11, 21, 31, 41]) == {'0-9': 1, '10-19': 1, '20-29': 1, '30-39': 1, '40-49': 1}", "assert age_group_counts([100, 100, 100]) == {'100+': 3}", "assert age_group_counts([50]) == {'50-59': 1}"], "reference": "def age_group_counts(ages):\n    d = {}\n    for a in ages:\n        if a >= 100:\n            label = \"100+\"\n        else:\n            low = (a // 10) * 10\n            label = f\"{low}-{low + 9}\"\n        d[label] = d.get(label, 0) + 1\n    return d"}
{"tid": "dct-075", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Classify each integer in nums as positive, negative, or zero. Return a dict with keys 'positive', 'negative', and 'zero' mapping to the counts of each (0 if none). An empty list returns all zeros.", "signature": "def count_by_sign(nums):", "visible_tests": ["assert count_by_sign([1, -1, 0]) == {'positive': 1, 'negative': 1, 'zero': 1}", "assert count_by_sign([1, 2, 3]) == {'positive': 3, 'negative': 0, 'zero': 0}", "assert count_by_sign([]) == {'positive': 0, 'negative': 0, 'zero': 0}"], "hidden_tests": ["assert count_by_sign([0]) == {'positive': 0, 'negative': 0, 'zero': 1}", "assert count_by_sign([-1]) == {'positive': 0, 'negative': 1, 'zero': 0}", "assert count_by_sign([1]) == {'positive': 1, 'negative': 0, 'zero': 0}", "assert count_by_sign([0, 0, 0]) == {'positive': 0, 'negative': 0, 'zero': 3}", "assert count_by_sign([-1, -2, -3]) == {'positive': 0, 'negative': 3, 'zero': 0}", "assert count_by_sign([100, -100, 0]) == {'positive': 1, 'negative': 1, 'zero': 1}", "assert count_by_sign([1, 1, -1, -1, 0, 0]) == {'positive': 2, 'negative': 2, 'zero': 2}", "assert count_by_sign([5]) == {'positive': 1, 'negative': 0, 'zero': 0}", "assert count_by_sign([-5]) == {'positive': 0, 'negative': 1, 'zero': 0}", "assert count_by_sign([0, 1, -1, 2, -2]) == {'positive': 2, 'negative': 2, 'zero': 1}", "assert count_by_sign([1000000]) == {'positive': 1, 'negative': 0, 'zero': 0}", "assert count_by_sign([-1000000]) == {'positive': 0, 'negative': 1, 'zero': 0}", "assert count_by_sign([1, 2, 3, -1, -2, -3, 0]) == {'positive': 3, 'negative': 3, 'zero': 1}", "assert count_by_sign([0, 0, 1]) == {'positive': 1, 'negative': 0, 'zero': 2}", "assert count_by_sign([-1, 0, 1, 0, -1, 1]) == {'positive': 2, 'negative': 2, 'zero': 2}"], "reference": "def count_by_sign(nums):\n    d = {\"positive\": 0, \"negative\": 0, \"zero\": 0}\n    for x in nums:\n        if x > 0:\n            d[\"positive\"] += 1\n        elif x < 0:\n            d[\"negative\"] += 1\n        else:\n            d[\"zero\"] += 1\n    return d"}
{"tid": "dct-076", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Across all integers in numbers (using the digits of their absolute value), count how often each digit 0-9 occurs. Return the digit with the highest total count; if several digits tie, return the smallest one. The list is assumed non-empty.", "signature": "def most_frequent_digit(numbers):", "visible_tests": ["assert most_frequent_digit([11, 22, 11]) == 1", "assert most_frequent_digit([123]) == 1", "assert most_frequent_digit([-5, 5]) == 5"], "hidden_tests": ["assert most_frequent_digit([0]) == 0", "assert most_frequent_digit([100, 200, 300]) == 0", "assert most_frequent_digit([111, 222, 333]) == 1", "assert most_frequent_digit([9]) == 9", "assert most_frequent_digit([-99, 99]) == 9", "assert most_frequent_digit([12, 21]) == 1", "assert most_frequent_digit([555, 5]) == 5", "assert most_frequent_digit([1, 2, 3, 4, 5, 6, 7, 8, 9]) == 1", "assert most_frequent_digit([10, 20, 30, 10]) == 0", "assert most_frequent_digit([1000000]) == 0", "assert most_frequent_digit([-1, -1, -1]) == 1", "assert most_frequent_digit([123456789]) == 1", "assert most_frequent_digit([11, 22, 33, 11, 22, 11]) == 1", "assert most_frequent_digit([0, 0, 1]) == 0", "assert most_frequent_digit([7, 77, 777]) == 7"], "reference": "def most_frequent_digit(numbers):\n    counts = [0] * 10\n    for n in numbers:\n        for ch in str(abs(n)):\n            counts[int(ch)] += 1\n    best = max(counts)\n    for d in range(10):\n        if counts[d] == best:\n            return d"}
{"tid": "dct-077", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict with values of possibly different types, count how many values belong to each Python type (using the type's __name__, e.g. 'int', 'str', 'list'). Return a dict mapping each type name found to its count. An empty dict returns an empty dict.", "signature": "def count_value_types(d):", "visible_tests": ["assert count_value_types({'a': 1, 'b': 'x'}) == {'int': 1, 'str': 1}", "assert count_value_types({'a': [1], 'b': [2]}) == {'list': 2}", "assert count_value_types({}) == {}"], "hidden_tests": ["assert count_value_types({'a': 1}) == {'int': 1}", "assert count_value_types({'a': 'x'}) == {'str': 1}", "assert count_value_types({'a': 1, 'b': 2, 'c': 'z'}) == {'int': 2, 'str': 1}", "assert count_value_types({'a': [1], 'b': 's', 'c': 3}) == {'list': 1, 'str': 1, 'int': 1}", "assert count_value_types({'a': None}) == {'NoneType': 1}", "assert count_value_types({'a': True, 'b': False}) == {'bool': 2}", "assert count_value_types({'a': 1.5}) == {'float': 1}", "assert count_value_types({'a': (1, 2)}) == {'tuple': 1}", "assert count_value_types({'a': {}}) == {'dict': 1}", "assert count_value_types({'a': 1, 'b': 1.5, 'c': 's', 'd': [1], 'e': {}}) == {'int': 1, 'float': 1, 'str': 1, 'list': 1, 'dict': 1}", "assert count_value_types({'only': 1}) == {'int': 1}", "assert count_value_types({'a': [1], 'b': [2], 'c': [3]}) == {'list': 3}", "assert count_value_types({'a': True, 'b': 1}) == {'bool': 1, 'int': 1}", "assert count_value_types({'a': None, 'b': None, 'c': 1}) == {'NoneType': 2, 'int': 1}", "assert count_value_types({'a': (1,), 'b': (2,), 'c': [3]}) == {'tuple': 2, 'list': 1}"], "reference": "def count_value_types(d):\n    res = {}\n    for v in d.values():\n        t = type(v).__name__\n        res[t] = res.get(t, 0) + 1\n    return res"}
{"tid": "dct-078", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict with string keys and numeric values, sum the values of all keys that start with the given prefix. Return that sum (0 if no key matches, including for an empty dict).", "signature": "def sum_values_by_key_prefix(d, prefix):", "visible_tests": ["assert sum_values_by_key_prefix({'apple': 1, 'apricot': 2, 'banana': 3}, 'ap') == 3", "assert sum_values_by_key_prefix({'x1': 5}, 'x') == 5", "assert sum_values_by_key_prefix({}, 'a') == 0"], "hidden_tests": ["assert sum_values_by_key_prefix({'a': 1}, 'b') == 0", "assert sum_values_by_key_prefix({'a': 1}, '') == 1", "assert sum_values_by_key_prefix({'a': 1, 'b': 2}, '') == 3", "assert sum_values_by_key_prefix({'cat1': 1, 'cat2': 2, 'dog1': 3}, 'cat') == 3", "assert sum_values_by_key_prefix({'pre_a': 1, 'pre_b': 2}, 'pre_') == 3", "assert sum_values_by_key_prefix({'x': 1, 'xx': 2, 'xxx': 3}, 'x') == 6", "assert sum_values_by_key_prefix({'only': 5}, 'only') == 5", "assert sum_values_by_key_prefix({'key1': -1, 'key2': -2}, 'key') == -3", "assert sum_values_by_key_prefix({'a': 1, 'ab': 2, 'abc': 3}, 'abc') == 3", "assert sum_values_by_key_prefix({'m1': 10, 'n1': 20}, 'z') == 0", "assert sum_values_by_key_prefix({'same': 1, 'same2': 2}, 'same') == 3", "assert sum_values_by_key_prefix({'p': 1, 'q': 1, 'r': 1}, 'p') == 1", "assert sum_values_by_key_prefix({}, '') == 0", "assert sum_values_by_key_prefix({'a1': 1, 'a2': 2, 'a3': 3}, 'a') == 6", "assert sum_values_by_key_prefix({'long_prefix_key': 100}, 'long_prefix') == 100"], "reference": "def sum_values_by_key_prefix(d, prefix):\n    return sum(v for k, v in d.items() if k.startswith(prefix))"}
{"tid": "dct-079", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Split the strings in the list into two groups based on whether their length is even or odd. Return a dict with keys 'even_length' and 'odd_length', each mapping to a sorted list of the matching strings. An empty list returns two empty lists.", "signature": "def group_by_length_parity(strings):", "visible_tests": ["assert group_by_length_parity(['ab', 'abc', 'cd']) == {'even_length': ['ab', 'cd'], 'odd_length': ['abc']}", "assert group_by_length_parity(['a']) == {'even_length': [], 'odd_length': ['a']}", "assert group_by_length_parity([]) == {'even_length': [], 'odd_length': []}"], "hidden_tests": ["assert group_by_length_parity(['']) == {'even_length': [''], 'odd_length': []}", "assert group_by_length_parity(['a', 'ab', 'abc', 'abcd']) == {'even_length': ['ab', 'abcd'], 'odd_length': ['a', 'abc']}", "assert group_by_length_parity(['x', 'y', 'z']) == {'even_length': [], 'odd_length': ['x', 'y', 'z']}", "assert group_by_length_parity(['xx', 'yy']) == {'even_length': ['xx', 'yy'], 'odd_length': []}", "assert group_by_length_parity(['odd', 'even']) == {'even_length': ['even'], 'odd_length': ['odd']}", "assert group_by_length_parity(['a', 'b', 'c', 'd', 'e']) == {'even_length': [], 'odd_length': ['a', 'b', 'c', 'd', 'e']}", "assert group_by_length_parity(['ab', 'cd', 'ef']) == {'even_length': ['ab', 'cd', 'ef'], 'odd_length': []}", "assert group_by_length_parity(['single']) == {'even_length': ['single'], 'odd_length': []}", "assert group_by_length_parity(['z', 'zz', 'zzz', 'zzzz']) == {'even_length': ['zz', 'zzzz'], 'odd_length': ['z', 'zzz']}", "assert group_by_length_parity(['', 'a', 'aa']) == {'even_length': ['', 'aa'], 'odd_length': ['a']}", "assert group_by_length_parity(['m', 'mm', 'mmm']) == {'even_length': ['mm'], 'odd_length': ['m', 'mmm']}", "assert group_by_length_parity(['ppppp', 'qqqq']) == {'even_length': ['qqqq'], 'odd_length': ['ppppp']}", "assert group_by_length_parity(['one', 'two', 'six']) == {'even_length': [], 'odd_length': ['one', 'six', 'two']}", "assert group_by_length_parity(['a', 'a', 'aa', 'aa']) == {'even_length': ['aa', 'aa'], 'odd_length': ['a', 'a']}", "assert group_by_length_parity(['longword', 'short', 'hi', 'me']) == {'even_length': ['hi', 'longword', 'me'], 'odd_length': ['short']}"], "reference": "def group_by_length_parity(strings):\n    res = {\"even_length\": [], \"odd_length\": []}\n    for s in strings:\n        if len(s) % 2 == 0:\n            res[\"even_length\"].append(s)\n        else:\n            res[\"odd_length\"].append(s)\n    res[\"even_length\"] = sorted(res[\"even_length\"])\n    res[\"odd_length\"] = sorted(res[\"odd_length\"])\n    return res"}
{"tid": "dct-080", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Count how many times each character occurs in s, then keep only the characters that occur more than once. Return a dict mapping each such repeated character to its count. If no character repeats (including an empty string), return an empty dict.", "signature": "def count_repeated_chars(s):", "visible_tests": ["assert count_repeated_chars('aabbc') == {'a': 2, 'b': 2}", "assert count_repeated_chars('abc') == {}", "assert count_repeated_chars('') == {}"], "hidden_tests": ["assert count_repeated_chars('a') == {}", "assert count_repeated_chars('aa') == {'a': 2}", "assert count_repeated_chars('aaa') == {'a': 3}", "assert count_repeated_chars('abab') == {'a': 2, 'b': 2}", "assert count_repeated_chars('mississippi') == {'i': 4, 's': 4, 'p': 2}", "assert count_repeated_chars('noon') == {'n': 2, 'o': 2}", "assert count_repeated_chars('racecar') == {'r': 2, 'a': 2, 'c': 2}", "assert count_repeated_chars('112233') == {'1': 2, '2': 2, '3': 2}", "assert count_repeated_chars('xyzxyz') == {'x': 2, 'y': 2, 'z': 2}", "assert count_repeated_chars('hello') == {'l': 2}", "assert count_repeated_chars('z') == {}", "assert count_repeated_chars('aabbccdd') == {'a': 2, 'b': 2, 'c': 2, 'd': 2}", "assert count_repeated_chars('no repeats here') == {' ': 2, 'r': 2, 'e': 4}", "assert count_repeated_chars('aabbccddeeffgg') == {'a': 2, 'b': 2, 'c': 2, 'd': 2, 'e': 2, 'f': 2, 'g': 2}", "assert count_repeated_chars('q') == {}"], "reference": "def count_repeated_chars(s):\n    d = {}\n    for ch in s:\n        d[ch] = d.get(ch, 0) + 1\n    return {k: v for k, v in d.items() if v > 1}"}
