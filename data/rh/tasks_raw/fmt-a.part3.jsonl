{"tid": "fmt-045", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a kebab-case string (words separated by hyphens) into camelCase, where the first word stays lowercase and every subsequent word is capitalized, with all hyphens removed.", "signature": "def kebab_to_camel(s):", "visible_tests": ["assert kebab_to_camel('hello-world') == 'helloWorld'", "assert kebab_to_camel('my-variable-name') == 'myVariableName'", "assert kebab_to_camel('simple') == 'simple'"], "hidden_tests": ["assert kebab_to_camel('a-b-c-d') == 'aBCD'", "assert kebab_to_camel('single-word') == 'singleWord'", "assert kebab_to_camel('x') == 'x'", "assert kebab_to_camel('one-two-three-four-five') == 'oneTwoThreeFourFive'", "assert kebab_to_camel('already') == 'already'", "assert kebab_to_camel('a-b') == 'aB'", "assert kebab_to_camel('this-is-a-test') == 'thisIsATest'", "assert kebab_to_camel('y-z') == 'yZ'", "assert kebab_to_camel('q-r-s') == 'qRS'", "assert kebab_to_camel('test-case-here') == 'testCaseHere'", "assert kebab_to_camel('multi-word-example') == 'multiWordExample'", "assert kebab_to_camel('k') == 'k'", "assert kebab_to_camel('p-q') == 'pQ'", "assert kebab_to_camel('data-frame-object') == 'dataFrameObject'", "assert kebab_to_camel('z') == 'z'", "assert kebab_to_camel('first-second-third') == 'firstSecondThird'"], "reference": "def kebab_to_camel(s):\n    parts = s.split('-')\n    return parts[0] + ''.join(p.capitalize() for p in parts[1:])"}
{"tid": "fmt-046", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a camelCase string into kebab-case by inserting a hyphen before every internal uppercase letter and lowercasing the whole result.", "signature": "def camel_to_kebab(s):", "visible_tests": ["assert camel_to_kebab('helloWorld') == 'hello-world'", "assert camel_to_kebab('myVariableName') == 'my-variable-name'", "assert camel_to_kebab('simple') == 'simple'"], "hidden_tests": ["assert camel_to_kebab('') == ''", "assert camel_to_kebab('A') == 'a'", "assert camel_to_kebab('a') == 'a'", "assert camel_to_kebab('camelCaseString') == 'camel-case-string'", "assert camel_to_kebab('oneTwoThree') == 'one-two-three'", "assert camel_to_kebab('XMLHttpRequest') == 'x-m-l-http-request'", "assert camel_to_kebab('word') == 'word'", "assert camel_to_kebab('aB') == 'a-b'", "assert camel_to_kebab('ABC') == 'a-b-c'", "assert camel_to_kebab('thisIsATest') == 'this-is-a-test'", "assert camel_to_kebab('SingleWord') == 'single-word'", "assert camel_to_kebab('multipleWordsHereNow') == 'multiple-words-here-now'", "assert camel_to_kebab('x') == 'x'", "assert camel_to_kebab('dataFrameObject') == 'data-frame-object'", "assert camel_to_kebab('testCaseHere') == 'test-case-here'", "assert camel_to_kebab('myID') == 'my-i-d'"], "reference": "def camel_to_kebab(s):\n    import re\n    s1 = re.sub(r'(?<!^)(?=[A-Z])', '-', s)\n    return s1.lower()"}
{"tid": "fmt-047", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a space-separated, title-cased phrase into snake_case by lowercasing each word and joining them with underscores.", "signature": "def title_to_snake(s):", "visible_tests": ["assert title_to_snake('Hello World') == 'hello_world'", "assert title_to_snake('My Variable Name') == 'my_variable_name'", "assert title_to_snake('Simple') == 'simple'"], "hidden_tests": ["assert title_to_snake('A B C D') == 'a_b_c_d'", "assert title_to_snake('Single Word') == 'single_word'", "assert title_to_snake('X') == 'x'", "assert title_to_snake('One Two Three Four Five') == 'one_two_three_four_five'", "assert title_to_snake('Already') == 'already'", "assert title_to_snake('A B') == 'a_b'", "assert title_to_snake('This Is A Test') == 'this_is_a_test'", "assert title_to_snake('Y Z') == 'y_z'", "assert title_to_snake('Q R S') == 'q_r_s'", "assert title_to_snake('Test Case Here') == 'test_case_here'", "assert title_to_snake('Multi Word Example') == 'multi_word_example'", "assert title_to_snake('K') == 'k'", "assert title_to_snake('P Q') == 'p_q'", "assert title_to_snake('Data Frame Object') == 'data_frame_object'", "assert title_to_snake('Z') == 'z'", "assert title_to_snake('First Second Third') == 'first_second_third'"], "reference": "def title_to_snake(s):\n    return '_'.join(w.lower() for w in s.split())"}
{"tid": "fmt-048", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a kebab-case string into snake_case by replacing every hyphen with an underscore.", "signature": "def kebab_to_snake(s):", "visible_tests": ["assert kebab_to_snake('hello-world') == 'hello_world'", "assert kebab_to_snake('my-blog-post') == 'my_blog_post'", "assert kebab_to_snake('simple') == 'simple'"], "hidden_tests": ["assert kebab_to_snake('') == ''", "assert kebab_to_snake('-') == '_'", "assert kebab_to_snake('--leading') == '__leading'", "assert kebab_to_snake('trailing--') == 'trailing__'", "assert kebab_to_snake('multiple---hyphens') == 'multiple___hyphens'", "assert kebab_to_snake('a-b-c-d') == 'a_b_c_d'", "assert kebab_to_snake('ALREADY_CAPS') == 'ALREADY_CAPS'", "assert kebab_to_snake('single') == 'single'", "assert kebab_to_snake('-start-end-') == '_start_end_'", "assert kebab_to_snake('one-two-three-four') == 'one_two_three_four'", "assert kebab_to_snake('x-y') == 'x_y'", "assert kebab_to_snake('no-hyphen-at-all-here') == 'no_hyphen_at_all_here'", "assert kebab_to_snake('-') == '_'", "assert kebab_to_snake('a--b') == 'a__b'", "assert kebab_to_snake('word-') == 'word_'", "assert kebab_to_snake('-word') == '_word'"], "reference": "def kebab_to_snake(s):\n    return s.replace('-', '_')"}
{"tid": "fmt-049", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a space-separated phrase into PascalCase by capitalizing each word and concatenating them with no separator.", "signature": "def spaced_to_pascal(s):", "visible_tests": ["assert spaced_to_pascal('hello world') == 'HelloWorld'", "assert spaced_to_pascal('my variable name') == 'MyVariableName'", "assert spaced_to_pascal('simple') == 'Simple'"], "hidden_tests": ["assert spaced_to_pascal('a b c d') == 'ABCD'", "assert spaced_to_pascal('single word') == 'SingleWord'", "assert spaced_to_pascal('x') == 'X'", "assert spaced_to_pascal('one two three four five') == 'OneTwoThreeFourFive'", "assert spaced_to_pascal('already') == 'Already'", "assert spaced_to_pascal('a b') == 'AB'", "assert spaced_to_pascal('this is a test') == 'ThisIsATest'", "assert spaced_to_pascal('y z') == 'YZ'", "assert spaced_to_pascal('q r s') == 'QRS'", "assert spaced_to_pascal('test case here') == 'TestCaseHere'", "assert spaced_to_pascal('multi word example') == 'MultiWordExample'", "assert spaced_to_pascal('k') == 'K'", "assert spaced_to_pascal('p q') == 'PQ'", "assert spaced_to_pascal('data frame object') == 'DataFrameObject'", "assert spaced_to_pascal('z') == 'Z'", "assert spaced_to_pascal('  extra   spaces  ') == 'ExtraSpaces'"], "reference": "def spaced_to_pascal(s):\n    return ''.join(w.capitalize() for w in s.split())"}
{"tid": "fmt-050", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a string with words separated by spaces, hyphens, or underscores into CONSTANT_CASE: uppercase every word and join them with underscores.", "signature": "def constant_case(s):", "visible_tests": ["assert constant_case('hello world') == 'HELLO_WORLD'", "assert constant_case('my-variable-name') == 'MY_VARIABLE_NAME'", "assert constant_case('simple') == 'SIMPLE'"], "hidden_tests": ["assert constant_case('a_b_c_d') == 'A_B_C_D'", "assert constant_case('single word') == 'SINGLE_WORD'", "assert constant_case('x') == 'X'", "assert constant_case('one-two-three-four-five') == 'ONE_TWO_THREE_FOUR_FIVE'", "assert constant_case('already') == 'ALREADY'", "assert constant_case('a b') == 'A_B'", "assert constant_case('this_is-a test') == 'THIS_IS_A_TEST'", "assert constant_case('y-z') == 'Y_Z'", "assert constant_case('q_r_s') == 'Q_R_S'", "assert constant_case('test case here') == 'TEST_CASE_HERE'", "assert constant_case('multi-word_example') == 'MULTI_WORD_EXAMPLE'", "assert constant_case('k') == 'K'", "assert constant_case('p q') == 'P_Q'", "assert constant_case('data_frame-object') == 'DATA_FRAME_OBJECT'", "assert constant_case('z') == 'Z'", "assert constant_case('mixed - separators_here') == 'MIXED_SEPARATORS_HERE'"], "reference": "def constant_case(s):\n    s = s.replace('-', ' ').replace('_', ' ')\n    return '_'.join(w.upper() for w in s.split())"}
{"tid": "fmt-051", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Format an integer as a string with commas separating groups of three digits, keeping a leading minus sign for negative numbers in front of the separated digits.", "signature": "def add_thousands_separator(n):", "visible_tests": ["assert add_thousands_separator(1234567) == '1,234,567'", "assert add_thousands_separator(100) == '100'", "assert add_thousands_separator(0) == '0'"], "hidden_tests": ["assert add_thousands_separator(-1234567) == '-1,234,567'", "assert add_thousands_separator(999) == '999'", "assert add_thousands_separator(1000) == '1,000'", "assert add_thousands_separator(-1) == '-1'", "assert add_thousands_separator(1000000000) == '1,000,000,000'", "assert add_thousands_separator(42) == '42'", "assert add_thousands_separator(-42) == '-42'", "assert add_thousands_separator(123456789) == '123,456,789'", "assert add_thousands_separator(-999) == '-999'", "assert add_thousands_separator(1) == '1'", "assert add_thousands_separator(10000) == '10,000'", "assert add_thousands_separator(-1000) == '-1,000'", "assert add_thousands_separator(999999) == '999,999'", "assert add_thousands_separator(1234) == '1,234'", "assert add_thousands_separator(-10000) == '-10,000'", "assert add_thousands_separator(100000) == '100,000'"], "reference": "def add_thousands_separator(n):\n    return f\"{n:,}\""}
{"tid": "fmt-052", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Format a number as US currency: two decimal places, comma thousands separators, and a leading dollar sign, with the minus sign (if the amount is negative) placed before the dollar sign.", "signature": "def format_currency(amount):", "visible_tests": ["assert format_currency(1234.5) == '$1,234.50'", "assert format_currency(0) == '$0.00'", "assert format_currency(99.999) == '$100.00'"], "hidden_tests": ["assert format_currency(-1234.5) == '-$1,234.50'", "assert format_currency(1000000) == '$1,000,000.00'", "assert format_currency(-0.5) == '-$0.50'", "assert format_currency(0.01) == '$0.01'", "assert format_currency(1234567.891) == '$1,234,567.89'", "assert format_currency(-1) == '-$1.00'", "assert format_currency(5) == '$5.00'", "assert format_currency(-100) == '-$100.00'", "assert format_currency(999.995) == '$1,000.00'", "assert format_currency(1000) == '$1,000.00'", "assert format_currency(-1000000) == '-$1,000,000.00'", "assert format_currency(250.4) == '$250.40'", "assert format_currency(3.1) == '$3.10'", "assert format_currency(-3.1) == '-$3.10'", "assert format_currency(12.0) == '$12.00'", "assert format_currency(1000000.5) == '$1,000,000.50'"], "reference": "def format_currency(amount):\n    neg = amount < 0\n    amount = abs(amount)\n    s = f\"${amount:,.2f}\"\n    return ('-' + s) if neg else s"}
{"tid": "fmt-053", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a fraction (e.g. 0.5) into a percentage string with exactly one decimal place and a trailing percent sign (e.g. '50.0%'). Negative fractions and fractions above 1 are formatted the same way.", "signature": "def format_percentage(x):", "visible_tests": ["assert format_percentage(0.5) == '50.0%'", "assert format_percentage(0.25) == '25.0%'", "assert format_percentage(1.0) == '100.0%'"], "hidden_tests": ["assert format_percentage(0) == '0.0%'", "assert format_percentage(-0.5) == '-50.0%'", "assert format_percentage(0.333) == '33.3%'", "assert format_percentage(2.0) == '200.0%'", "assert format_percentage(0.001) == '0.1%'", "assert format_percentage(-1.0) == '-100.0%'", "assert format_percentage(0.999) == '99.9%'", "assert format_percentage(0.1) == '10.0%'", "assert format_percentage(1.5) == '150.0%'", "assert format_percentage(0.0001) == '0.0%'", "assert format_percentage(-0.25) == '-25.0%'", "assert format_percentage(0.756) == '75.6%'", "assert format_percentage(3.0) == '300.0%'", "assert format_percentage(-2.5) == '-250.0%'", "assert format_percentage(0.005) == '0.5%'", "assert format_percentage(0.995) == '99.5%'"], "reference": "def format_percentage(x):\n    return f\"{x * 100:.1f}%\""}
{"tid": "fmt-054", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Format a number as a string with exactly the given number of decimal places.", "signature": "def format_fixed_decimals(x, places):", "visible_tests": ["assert format_fixed_decimals(3.14159, 2) == '3.14'", "assert format_fixed_decimals(1.0, 0) == '1'", "assert format_fixed_decimals(2.5, 1) == '2.5'"], "hidden_tests": ["assert format_fixed_decimals(0, 3) == '0.000'", "assert format_fixed_decimals(-1.5, 2) == '-1.50'", "assert format_fixed_decimals(100, 0) == '100'", "assert format_fixed_decimals(0.005, 2) == '0.01'", "assert format_fixed_decimals(3.14159, 4) == '3.1416'", "assert format_fixed_decimals(-3.14159, 2) == '-3.14'", "assert format_fixed_decimals(1.0, 5) == '1.00000'", "assert format_fixed_decimals(0.0, 0) == '0'", "assert format_fixed_decimals(99.999, 2) == '100.00'", "assert format_fixed_decimals(-0.1, 1) == '-0.1'", "assert format_fixed_decimals(7, 2) == '7.00'", "assert format_fixed_decimals(2.71828, 3) == '2.718'", "assert format_fixed_decimals(-100.5, 1) == '-100.5'", "assert format_fixed_decimals(0.1, 0) == '0'", "assert format_fixed_decimals(123.456, 2) == '123.46'", "assert format_fixed_decimals(5.5, 0) == '6'"], "reference": "def format_fixed_decimals(x, places):\n    return f\"{x:.{places}f}\""}
{"tid": "fmt-055", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a non-negative integer number of bytes into a human-readable string using binary units (B, KB, MB, GB, TB), dividing by 1024 for each larger unit. Sizes under 1024 bytes show as a whole number of B; larger sizes show one decimal place.", "signature": "def human_readable_bytes(n):", "visible_tests": ["assert human_readable_bytes(500) == '500 B'", "assert human_readable_bytes(1024) == '1.0 KB'", "assert human_readable_bytes(1048576) == '1.0 MB'"], "hidden_tests": ["assert human_readable_bytes(0) == '0 B'", "assert human_readable_bytes(1) == '1 B'", "assert human_readable_bytes(1023) == '1023 B'", "assert human_readable_bytes(1025) == '1.0 KB'", "assert human_readable_bytes(1073741824) == '1.0 GB'", "assert human_readable_bytes(1099511627776) == '1.0 TB'", "assert human_readable_bytes(2048) == '2.0 KB'", "assert human_readable_bytes(10240) == '10.0 KB'", "assert human_readable_bytes(5242880) == '5.0 MB'", "assert human_readable_bytes(1536) == '1.5 KB'", "assert human_readable_bytes(2147483648) == '2.0 GB'", "assert human_readable_bytes(999) == '999 B'", "assert human_readable_bytes(5120) == '5.0 KB'", "assert human_readable_bytes(2147483648) == '2.0 GB'", "assert human_readable_bytes(700) == '700 B'", "assert human_readable_bytes(1048575) == '1024.0 KB'"], "reference": "def human_readable_bytes(n):\n    units = ['B', 'KB', 'MB', 'GB', 'TB']\n    size = float(n)\n    idx = 0\n    while size >= 1024 and idx < len(units) - 1:\n        size /= 1024\n        idx += 1\n    if idx == 0:\n        return f\"{int(size)} {units[idx]}\"\n    return f\"{size:.1f} {units[idx]}\""}
{"tid": "fmt-056", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a non-negative number of whole seconds into a string. If the duration is under one hour, format it as 'M:SS' (minutes, no leading zero, and two-digit seconds). If it is one hour or more, format it as 'H:MM:SS'.", "signature": "def format_duration(seconds):", "visible_tests": ["assert format_duration(90) == '1:30'", "assert format_duration(3661) == '1:01:01'", "assert format_duration(5) == '0:05'"], "hidden_tests": ["assert format_duration(0) == '0:00'", "assert format_duration(59) == '0:59'", "assert format_duration(60) == '1:00'", "assert format_duration(3599) == '59:59'", "assert format_duration(3600) == '1:00:00'", "assert format_duration(3601) == '1:00:01'", "assert format_duration(7325) == '2:02:05'", "assert format_duration(600) == '10:00'", "assert format_duration(3660) == '1:01:00'", "assert format_duration(61) == '1:01'", "assert format_duration(36000) == '10:00:00'", "assert format_duration(119) == '1:59'", "assert format_duration(86399) == '23:59:59'", "assert format_duration(9) == '0:09'", "assert format_duration(3700) == '1:01:40'", "assert format_duration(200) == '3:20'"], "reference": "def format_duration(seconds):\n    h, rem = divmod(seconds, 3600)\n    m, s = divmod(rem, 60)\n    if h > 0:\n        return f\"{h}:{m:02d}:{s:02d}\"\n    return f\"{m}:{s:02d}\""}
{"tid": "fmt-057", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Append the correct English ordinal suffix ('st', 'nd', 'rd', or 'th') to an integer, based on its last one or two digits: numbers ending in 11, 12, or 13 always use 'th'; otherwise numbers ending in 1, 2, or 3 use 'st', 'nd', 'rd' respectively, and all others use 'th'. Negative numbers use the suffix for their absolute value.", "signature": "def ordinal_suffix(n):", "visible_tests": ["assert ordinal_suffix(1) == '1st'", "assert ordinal_suffix(2) == '2nd'", "assert ordinal_suffix(4) == '4th'"], "hidden_tests": ["assert ordinal_suffix(3) == '3rd'", "assert ordinal_suffix(11) == '11th'", "assert ordinal_suffix(12) == '12th'", "assert ordinal_suffix(13) == '13th'", "assert ordinal_suffix(21) == '21st'", "assert ordinal_suffix(22) == '22nd'", "assert ordinal_suffix(23) == '23rd'", "assert ordinal_suffix(100) == '100th'", "assert ordinal_suffix(101) == '101st'", "assert ordinal_suffix(111) == '111th'", "assert ordinal_suffix(112) == '112th'", "assert ordinal_suffix(113) == '113th'", "assert ordinal_suffix(0) == '0th'", "assert ordinal_suffix(-1) == '-1st'", "assert ordinal_suffix(-11) == '-11th'", "assert ordinal_suffix(1000) == '1000th'"], "reference": "def ordinal_suffix(n):\n    a = abs(n)\n    if 11 <= a % 100 <= 13:\n        suf = 'th'\n    else:\n        suf = {1: 'st', 2: 'nd', 3: 'rd'}.get(a % 10, 'th')\n    return f\"{n}{suf}\""}
{"tid": "fmt-058", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Format an integer with an explicit sign: prefix positive numbers with '+', leave negative numbers as-is (with their existing minus sign), and format zero as the plain string '0' with no sign.", "signature": "def format_signed_number(n):", "visible_tests": ["assert format_signed_number(5) == '+5'", "assert format_signed_number(-3) == '-3'", "assert format_signed_number(0) == '0'"], "hidden_tests": ["assert format_signed_number(1) == '+1'", "assert format_signed_number(-1) == '-1'", "assert format_signed_number(100) == '+100'", "assert format_signed_number(-100) == '-100'", "assert format_signed_number(999999) == '+999999'", "assert format_signed_number(-999999) == '-999999'", "assert format_signed_number(2) == '+2'", "assert format_signed_number(-2) == '-2'", "assert format_signed_number(10) == '+10'", "assert format_signed_number(-10) == '-10'", "assert format_signed_number(7) == '+7'", "assert format_signed_number(-7) == '-7'", "assert format_signed_number(50) == '+50'", "assert format_signed_number(-50) == '-50'", "assert format_signed_number(1000) == '+1000'", "assert format_signed_number(-1000) == '-1000'"], "reference": "def format_signed_number(n):\n    if n > 0:\n        return f\"+{n}\"\n    if n < 0:\n        return str(n)\n    return \"0\""}
{"tid": "fmt-059", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Given a positive integer numerator and denominator, reduce the fraction to lowest terms using their greatest common divisor and return it as a string 'a/b'.", "signature": "def format_fraction(numerator, denominator):", "visible_tests": ["assert format_fraction(2, 4) == '1/2'", "assert format_fraction(3, 9) == '1/3'", "assert format_fraction(5, 7) == '5/7'"], "hidden_tests": ["assert format_fraction(6, 8) == '3/4'", "assert format_fraction(10, 20) == '1/2'", "assert format_fraction(1, 1) == '1/1'", "assert format_fraction(7, 14) == '1/2'", "assert format_fraction(9, 3) == '3/1'", "assert format_fraction(100, 25) == '4/1'", "assert format_fraction(12, 18) == '2/3'", "assert format_fraction(5, 5) == '1/1'", "assert format_fraction(8, 12) == '2/3'", "assert format_fraction(15, 45) == '1/3'", "assert format_fraction(1, 2) == '1/2'", "assert format_fraction(21, 7) == '3/1'", "assert format_fraction(16, 24) == '2/3'", "assert format_fraction(4, 6) == '2/3'", "assert format_fraction(13, 39) == '1/3'", "assert format_fraction(50, 100) == '1/2'"], "reference": "def format_fraction(numerator, denominator):\n    import math\n    g = math.gcd(numerator, denominator)\n    return f\"{numerator // g}/{denominator // g}\""}
{"tid": "fmt-060", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert an integer between 1 and 3999 inclusive into its Roman numeral representation using standard subtractive notation.", "signature": "def roman_numeral(n):", "visible_tests": ["assert roman_numeral(3) == 'III'", "assert roman_numeral(9) == 'IX'", "assert roman_numeral(14) == 'XIV'"], "hidden_tests": ["assert roman_numeral(1) == 'I'", "assert roman_numeral(4) == 'IV'", "assert roman_numeral(40) == 'XL'", "assert roman_numeral(49) == 'XLIX'", "assert roman_numeral(90) == 'XC'", "assert roman_numeral(99) == 'XCIX'", "assert roman_numeral(400) == 'CD'", "assert roman_numeral(444) == 'CDXLIV'", "assert roman_numeral(900) == 'CM'", "assert roman_numeral(1994) == 'MCMXCIV'", "assert roman_numeral(2024) == 'MMXXIV'", "assert roman_numeral(3999) == 'MMMCMXCIX'", "assert roman_numeral(500) == 'D'", "assert roman_numeral(2000) == 'MM'", "assert roman_numeral(58) == 'LVIII'", "assert roman_numeral(1666) == 'MDCLXVI'"], "reference": "def roman_numeral(n):\n    vals = [(1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'), (100, 'C'),\n             (90, 'XC'), (50, 'L'), (40, 'XL'), (10, 'X'), (9, 'IX'),\n             (5, 'V'), (4, 'IV'), (1, 'I')]\n    res = ''\n    for v, sym in vals:\n        while n >= v:\n            res += sym\n            n -= v\n    return res"}
