{"tid": "fmt-041", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a snake_case string (words separated by underscores) into camelCase, where the first word stays lowercase and every subsequent word is capitalized, with all underscores removed.", "signature": "def snake_to_camel(s):", "visible_tests": ["assert snake_to_camel('hello_world') == 'helloWorld'", "assert snake_to_camel('my_variable_name') == 'myVariableName'", "assert snake_to_camel('simple') == 'simple'"], "hidden_tests": ["assert snake_to_camel('a_b_c_d') == 'aBCD'", "assert snake_to_camel('single_word') == 'singleWord'", "assert snake_to_camel('x') == 'x'", "assert snake_to_camel('one_two_three_four_five') == 'oneTwoThreeFourFive'", "assert snake_to_camel('already') == 'already'", "assert snake_to_camel('a_b') == 'aB'", "assert snake_to_camel('this_is_a_test') == 'thisIsATest'", "assert snake_to_camel('y_z') == 'yZ'", "assert snake_to_camel('q_r_s') == 'qRS'", "assert snake_to_camel('test_case_here') == 'testCaseHere'", "assert snake_to_camel('multi_word_example') == 'multiWordExample'", "assert snake_to_camel('k') == 'k'", "assert snake_to_camel('p_q') == 'pQ'", "assert snake_to_camel('data_frame_object') == 'dataFrameObject'", "assert snake_to_camel('z') == 'z'", "assert snake_to_camel('first_second_third') == 'firstSecondThird'"], "reference": "def snake_to_camel(s):\n    parts = s.split('_')\n    return parts[0] + ''.join(p.capitalize() for p in parts[1:])"}
{"tid": "fmt-042", "family": "simple text formatting (padding, wrapping, title-casing, abbreviations, slugs)", "spec": "Convert a camelCase string into snake_case by inserting an underscore before every internal uppercase letter and lowercasing the whole result.", "signature": "def camel_to_snake(s):", "visible_tests": ["assert camel_to_snake('helloWorld') == 'hello_world'", "assert camel_to_snake('myVariableName') == 'my_variable_name'", "assert camel_to_snake('simple') == 'simple'"], "hidden_tests": ["assert camel_to_snake('') == ''", "assert camel_to_snake('A') == 'a'", "assert camel_to_snake('a') == 'a'", "assert camel_to_snake('camelCaseString') == 'camel_case_string'", "assert camel_to_snake('oneTwoThree') == 'one_two_three'", "assert camel_to_snake('XMLHttpRequest') == 'x_m_l_http_request'", "assert camel_to_snake('word') == 'word'", "assert camel_to_snake('aB') == 'a_b'", "assert camel_to_snake('ABC') == 'a_b_c'", "assert camel_to_snake('thisIsATest') == 'this_is_a_test'", "assert camel_to_snake('SingleWord') == 'single_word'", "assert camel_to_snake('multipleWordsHereNow') == 'multiple_words_here_now'", "assert camel_to_snake('x') == 'x'", "assert camel_to_snake('dataFrameObject') == 'data_frame_object'", "assert camel_to_snake('testCaseHere') == 'test_case_here'", "assert camel_to_snake('myID') == 'my_i_d'"], "reference": "def camel_to_snake(s):\n    import re\n    s1 = re.sub(r'(?<!^)(?=[A-Z])', '_', s)\n    return s1.lower()"}
