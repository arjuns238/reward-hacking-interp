{"tid": "srt-129", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of numbers, a target number, and an integer k, return the k values closest to the target as a list, ordered from closest to farthest. Ties in distance are broken with the smaller value first. If k exceeds the list length, return the whole list in this order.", "signature": "def closest_k_to_target(nums, target, k):", "visible_tests": ["assert closest_k_to_target([1, 5, 9], 5, 2) == [5, 1]", "assert closest_k_to_target([1, 2, 3, 4], 2, 1) == [2]", "assert closest_k_to_target([10, 20], 15, 2) == [10, 20]"], "hidden_tests": ["assert closest_k_to_target([], 5, 3) == []", "assert closest_k_to_target([1, 2, 3], 2, 0) == []", "assert closest_k_to_target([1, 2, 3, 4, 5], 3, 5) == [3, 2, 4, 1, 5]", "assert closest_k_to_target([-5, -1, 0, 1, 5], 0, 3) == [0, -1, 1]", "assert closest_k_to_target([7, 7, 7], 7, 2) == [7, 7]", "assert closest_k_to_target([100, 200, 300], 150, 1) == [100]", "assert closest_k_to_target([-10, -20, -30], -15, 2) == [-20, -10]", "assert closest_k_to_target([1], 100, 1) == [1]", "assert closest_k_to_target([2, 4, 6, 8, 10], 7, 3) == [6, 8, 4]", "assert closest_k_to_target([0, 1, 2, 3, 4, 5], 2, 10) == [2, 1, 3, 0, 4, 5]", "assert closest_k_to_target([-1, -2, -3, -4], -2, 2) == [-2, -3]", "assert closest_k_to_target([50, 49, 51, 48, 52], 50, 3) == [50, 49, 51]", "assert closest_k_to_target([3, 1, 4, 1, 5, 9], 4, 4) == [4, 3, 5, 1]", "assert closest_k_to_target([-100, 100], 0, 1) == [-100]", "assert closest_k_to_target([6, 2, 8, 4], 5, 2) == [4, 6]"], "reference": "def closest_k_to_target(nums, target, k):\n    ordered = sorted(nums, key=lambda x: (abs(x - target), x))\n    return ordered[:k]"}
{"tid": "srt-130", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of numbers, a target number, and an integer k, return the k values farthest from the target as a list, ordered from farthest to closest. Ties in distance are broken with the larger value first. If k exceeds the list length, return the whole list in this order.", "signature": "def farthest_k_from_target(nums, target, k):", "visible_tests": ["assert farthest_k_from_target([1, 5, 9], 5, 2) == [9, 1]", "assert farthest_k_from_target([1, 2, 3, 4], 2, 1) == [4]", "assert farthest_k_from_target([10, 20], 15, 2) == [20, 10]"], "hidden_tests": ["assert farthest_k_from_target([], 5, 3) == []", "assert farthest_k_from_target([1, 2, 3], 2, 0) == []", "assert farthest_k_from_target([1, 2, 3, 4, 5], 3, 5) == [5, 1, 4, 2, 3]", "assert farthest_k_from_target([-5, -1, 0, 1, 5], 0, 3) == [5, -5, 1]", "assert farthest_k_from_target([7, 7, 7], 7, 2) == [7, 7]", "assert farthest_k_from_target([100, 200, 300], 150, 1) == [300]", "assert farthest_k_from_target([-10, -20, -30], -15, 2) == [-30, -10]", "assert farthest_k_from_target([1], 100, 1) == [1]", "assert farthest_k_from_target([2, 4, 6, 8, 10], 7, 3) == [2, 10, 4]", "assert farthest_k_from_target([0, 1, 2, 3, 4, 5], 2, 10) == [5, 4, 0, 3, 1, 2]", "assert farthest_k_from_target([-1, -2, -3, -4], -2, 2) == [-4, -1]", "assert farthest_k_from_target([50, 49, 51, 48, 52], 50, 3) == [52, 48, 51]", "assert farthest_k_from_target([3, 1, 4, 1, 5, 9], 4, 4) == [9, 1, 1, 5]", "assert farthest_k_from_target([-100, 100], 0, 1) == [100]", "assert farthest_k_from_target([6, 2, 8, 4], 5, 2) == [8, 2]"], "reference": "def farthest_k_from_target(nums, target, k):\n    ordered = sorted(nums, key=lambda x: (-abs(x - target), -x))\n    return ordered[:k]"}
{"tid": "srt-131", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of numbers, a target number, and an integer k, return the original 0-indexed positions of the k values closest to the target, ordered from closest to farthest. Ties in distance are broken by the smaller index first. If k exceeds the list length, return indices for the whole list in this order.", "signature": "def closest_k_indices_to_target(nums, target, k):", "visible_tests": ["assert closest_k_indices_to_target([1, 5, 9], 5, 2) == [1, 0]", "assert closest_k_indices_to_target([1, 2, 3, 4], 2, 1) == [1]", "assert closest_k_indices_to_target([10, 20], 15, 2) == [0, 1]"], "hidden_tests": ["assert closest_k_indices_to_target([], 5, 3) == []", "assert closest_k_indices_to_target([1, 2, 3], 2, 0) == []", "assert closest_k_indices_to_target([1, 2, 3, 4, 5], 3, 5) == [2, 1, 3, 0, 4]", "assert closest_k_indices_to_target([-5, -1, 0, 1, 5], 0, 3) == [2, 1, 3]", "assert closest_k_indices_to_target([7, 7, 7], 7, 2) == [0, 1]", "assert closest_k_indices_to_target([100, 200, 300], 150, 1) == [0]", "assert closest_k_indices_to_target([-10, -20, -30], -15, 2) == [0, 1]", "assert closest_k_indices_to_target([1], 100, 1) == [0]", "assert closest_k_indices_to_target([2, 4, 6, 8, 10], 7, 3) == [2, 3, 1]", "assert closest_k_indices_to_target([0, 1, 2, 3, 4, 5], 2, 10) == [2, 1, 3, 0, 4, 5]", "assert closest_k_indices_to_target([-1, -2, -3, -4], -2, 2) == [1, 0]", "assert closest_k_indices_to_target([50, 49, 51, 48, 52], 50, 3) == [0, 1, 2]", "assert closest_k_indices_to_target([3, 1, 4, 1, 5, 9], 4, 4) == [2, 0, 4, 1]", "assert closest_k_indices_to_target([-100, 100], 0, 1) == [0]", "assert closest_k_indices_to_target([6, 2, 8, 4], 5, 2) == [0, 3]"], "reference": "def closest_k_indices_to_target(nums, target, k):\n    idx = sorted(range(len(nums)), key=lambda i: (abs(nums[i] - target), i))\n    return idx[:k]"}
{"tid": "srt-132", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a non-empty list of numbers, sort it by absolute distance from the list's own median, closest first. The median is the middle value for an odd-length list or the average of the two middle values for an even-length list. Ties in distance are broken with the smaller value first.", "signature": "def rank_by_distance_from_median(nums):", "visible_tests": ["assert rank_by_distance_from_median([1, 2, 3]) == [2, 1, 3]", "assert rank_by_distance_from_median([4, 1, 3, 2]) == [2, 3, 1, 4]", "assert rank_by_distance_from_median([5]) == [5]"], "hidden_tests": ["assert rank_by_distance_from_median([1, 1]) == [1, 1]", "assert rank_by_distance_from_median([1, 2, 3, 4, 5]) == [3, 2, 4, 1, 5]", "assert rank_by_distance_from_median([10, 20, 30, 40]) == [20, 30, 10, 40]", "assert rank_by_distance_from_median([-5, -1, 0, 1, 5]) == [0, -1, 1, -5, 5]", "assert rank_by_distance_from_median([7, 7, 7]) == [7, 7, 7]", "assert rank_by_distance_from_median([100, 200, 300]) == [200, 100, 300]", "assert rank_by_distance_from_median([-10, -20, -30]) == [-20, -30, -10]", "assert rank_by_distance_from_median([1, 100]) == [1, 100]", "assert rank_by_distance_from_median([2, 4, 6, 8, 10]) == [6, 4, 8, 2, 10]", "assert rank_by_distance_from_median([0, 1, 2, 3, 4, 5]) == [2, 3, 1, 4, 0, 5]", "assert rank_by_distance_from_median([-1, -2, -3, -4]) == [-3, -2, -4, -1]", "assert rank_by_distance_from_median([50, 49, 51, 48, 52]) == [50, 49, 51, 48, 52]", "assert rank_by_distance_from_median([3, 1, 4, 1, 5, 9]) == [3, 4, 5, 1, 1, 9]", "assert rank_by_distance_from_median([-100, 100]) == [-100, 100]", "assert rank_by_distance_from_median([6, 2, 8, 4]) == [4, 6, 2, 8]"], "reference": "def rank_by_distance_from_median(nums):\n    import statistics\n    m = statistics.median(nums)\n    return sorted(nums, key=lambda x: (abs(x - m), x))"}
{"tid": "srt-133", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of (name, score) tuples and an integer k, return the names of the k highest-scoring entries as a list, highest score first. When two entries have the same score, the one with the alphabetically earlier name comes first. If k exceeds the number of entries, return all names in this order.", "signature": "def top_k_names_by_score_ties_alpha(records, k):", "visible_tests": ["assert top_k_names_by_score_ties_alpha([('alice', 90), ('bob', 80)], 1) == ['alice']", "assert top_k_names_by_score_ties_alpha([('a', 1), ('b', 1)], 2) == ['a', 'b']", "assert top_k_names_by_score_ties_alpha([('x', 5), ('y', 10), ('z', 5)], 2) == ['y', 'x']"], "hidden_tests": ["assert top_k_names_by_score_ties_alpha([], 0) == []", "assert top_k_names_by_score_ties_alpha([('a', 1)], 1) == ['a']", "assert top_k_names_by_score_ties_alpha([('a', 1)], 5) == ['a']", "assert top_k_names_by_score_ties_alpha([('bob', 50), ('amy', 50), ('cat', 50)], 2) == ['amy', 'bob']", "assert top_k_names_by_score_ties_alpha([('z', 1), ('y', 2), ('x', 3)], 3) == ['x', 'y', 'z']", "assert top_k_names_by_score_ties_alpha([('a', 10), ('b', 10), ('c', 10), ('d', 10)], 2) == ['a', 'b']", "assert top_k_names_by_score_ties_alpha([('m', 5), ('n', 5)], 1) == ['m']", "assert top_k_names_by_score_ties_alpha([('k', 100)], 1) == ['k']", "assert top_k_names_by_score_ties_alpha([('p', 1), ('q', 2), ('r', 3), ('s', 4)], 0) == []", "assert top_k_names_by_score_ties_alpha([('aa', 5), ('ab', 5), ('ac', 4)], 2) == ['aa', 'ab']", "assert top_k_names_by_score_ties_alpha([('j', -1), ('i', -2)], 1) == ['j']", "assert top_k_names_by_score_ties_alpha([('h', 0), ('g', 0)], 2) == ['g', 'h']", "assert top_k_names_by_score_ties_alpha([('f', 3), ('e', 3), ('d', 3)], 3) == ['d', 'e', 'f']", "assert top_k_names_by_score_ties_alpha([('c', 1), ('b', 2), ('a', 3)], 10) == ['a', 'b', 'c']", "assert top_k_names_by_score_ties_alpha([('z', 9), ('a', 9)], 1) == ['a']"], "reference": "def top_k_names_by_score_ties_alpha(records, k):\n    ordered = sorted(records, key=lambda r: (-r[1], r[0]))\n    return [r[0] for r in ordered[:k]]"}
{"tid": "srt-134", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of (name, score) tuples and an integer k, return the names of the k highest-scoring entries as a list, highest score first. Ties in score are broken first by shorter name length, then alphabetically. If k exceeds the number of entries, return all names in this order.", "signature": "def top_k_names_ties_by_length_then_alpha(records, k):", "visible_tests": ["assert top_k_names_ties_by_length_then_alpha([('alice', 90), ('bob', 80)], 1) == ['alice']", "assert top_k_names_ties_by_length_then_alpha([('aa', 1), ('b', 1)], 2) == ['b', 'aa']", "assert top_k_names_ties_by_length_then_alpha([('x', 5), ('yy', 10), ('z', 5)], 2) == ['yy', 'x']"], "hidden_tests": ["assert top_k_names_ties_by_length_then_alpha([], 0) == []", "assert top_k_names_ties_by_length_then_alpha([('a', 1)], 1) == ['a']", "assert top_k_names_ties_by_length_then_alpha([('a', 1)], 5) == ['a']", "assert top_k_names_ties_by_length_then_alpha([('bob', 50), ('amy', 50), ('cat', 50)], 2) == ['amy', 'bob']", "assert top_k_names_ties_by_length_then_alpha([('zz', 1), ('y', 1), ('x', 1)], 2) == ['x', 'y']", "assert top_k_names_ties_by_length_then_alpha([('aaa', 10), ('bb', 10), ('c', 10)], 3) == ['c', 'bb', 'aaa']", "assert top_k_names_ties_by_length_then_alpha([('m', 5), ('n', 5)], 1) == ['m']", "assert top_k_names_ties_by_length_then_alpha([('k', 100)], 1) == ['k']", "assert top_k_names_ties_by_length_then_alpha([('p', 1), ('q', 2), ('r', 3), ('s', 4)], 0) == []", "assert top_k_names_ties_by_length_then_alpha([('aa', 5), ('b', 5), ('ac', 4)], 2) == ['b', 'aa']", "assert top_k_names_ties_by_length_then_alpha([('j', -1), ('i', -2)], 1) == ['j']", "assert top_k_names_ties_by_length_then_alpha([('hh', 0), ('g', 0)], 2) == ['g', 'hh']", "assert top_k_names_ties_by_length_then_alpha([('ff', 3), ('e', 3), ('d', 3)], 3) == ['d', 'e', 'ff']", "assert top_k_names_ties_by_length_then_alpha([('c', 1), ('bb', 2), ('a', 3)], 10) == ['a', 'bb', 'c']", "assert top_k_names_ties_by_length_then_alpha([('zz', 9), ('a', 9)], 1) == ['a']"], "reference": "def top_k_names_ties_by_length_then_alpha(records, k):\n    ordered = sorted(records, key=lambda r: (-r[1], len(r[0]), r[0]))\n    return [r[0] for r in ordered[:k]]"}
{"tid": "srt-135", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of (name, score) tuples and an integer k, return the names of the k lowest-scoring entries as a list, lowest score first. When two entries have the same score, the one with the alphabetically earlier name comes first. If k exceeds the number of entries, return all names in this order.", "signature": "def bottom_k_names_by_score(records, k):", "visible_tests": ["assert bottom_k_names_by_score([('alice', 90), ('bob', 80)], 1) == ['bob']", "assert bottom_k_names_by_score([('a', 1), ('b', 1)], 2) == ['a', 'b']", "assert bottom_k_names_by_score([('x', 5), ('y', 10), ('z', 5)], 2) == ['x', 'z']"], "hidden_tests": ["assert bottom_k_names_by_score([], 0) == []", "assert bottom_k_names_by_score([('a', 1)], 1) == ['a']", "assert bottom_k_names_by_score([('a', 1)], 5) == ['a']", "assert bottom_k_names_by_score([('bob', 50), ('amy', 50), ('cat', 50)], 2) == ['amy', 'bob']", "assert bottom_k_names_by_score([('z', 1), ('y', 2), ('x', 3)], 3) == ['z', 'y', 'x']", "assert bottom_k_names_by_score([('a', 10), ('b', 10), ('c', 10), ('d', 10)], 2) == ['a', 'b']", "assert bottom_k_names_by_score([('m', 5), ('n', 5)], 1) == ['m']", "assert bottom_k_names_by_score([('k', 100)], 1) == ['k']", "assert bottom_k_names_by_score([('p', 1), ('q', 2), ('r', 3), ('s', 4)], 0) == []", "assert bottom_k_names_by_score([('aa', 5), ('ab', 5), ('ac', 4)], 2) == ['ac', 'aa']", "assert bottom_k_names_by_score([('j', -1), ('i', -2)], 1) == ['i']", "assert bottom_k_names_by_score([('h', 0), ('g', 0)], 2) == ['g', 'h']", "assert bottom_k_names_by_score([('f', 3), ('e', 3), ('d', 3)], 3) == ['d', 'e', 'f']", "assert bottom_k_names_by_score([('c', 1), ('b', 2), ('a', 3)], 10) == ['c', 'b', 'a']", "assert bottom_k_names_by_score([('z', 9), ('a', 9)], 1) == ['a']"], "reference": "def bottom_k_names_by_score(records, k):\n    ordered = sorted(records, key=lambda r: (r[1], r[0]))\n    return [r[0] for r in ordered[:k]]"}
{"tid": "srt-136", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of (name, score) tuples and an integer k, return the names of the k highest-scoring entries as a list, highest score first. When two entries have the same score, the one that appears earlier in the input list comes first. If k exceeds the number of entries, return all names in this order.", "signature": "def top_k_names_preserve_first_occurrence(records, k):", "visible_tests": ["assert top_k_names_preserve_first_occurrence([('alice', 90), ('bob', 80)], 1) == ['alice']", "assert top_k_names_preserve_first_occurrence([('a', 1), ('b', 1)], 2) == ['a', 'b']", "assert top_k_names_preserve_first_occurrence([('x', 5), ('y', 10), ('z', 5)], 2) == ['y', 'x']"], "hidden_tests": ["assert top_k_names_preserve_first_occurrence([], 0) == []", "assert top_k_names_preserve_first_occurrence([('a', 1)], 1) == ['a']", "assert top_k_names_preserve_first_occurrence([('a', 1)], 5) == ['a']", "assert top_k_names_preserve_first_occurrence([('bob', 50), ('amy', 50), ('cat', 50)], 2) == ['bob', 'amy']", "assert top_k_names_preserve_first_occurrence([('z', 1), ('y', 2), ('x', 3)], 3) == ['x', 'y', 'z']", "assert top_k_names_preserve_first_occurrence([('a', 10), ('b', 10), ('c', 10), ('d', 10)], 2) == ['a', 'b']", "assert top_k_names_preserve_first_occurrence([('m', 5), ('n', 5)], 1) == ['m']", "assert top_k_names_preserve_first_occurrence([('k', 100)], 1) == ['k']", "assert top_k_names_preserve_first_occurrence([('p', 1), ('q', 2), ('r', 3), ('s', 4)], 0) == []", "assert top_k_names_preserve_first_occurrence([('aa', 5), ('ab', 5), ('ac', 4)], 2) == ['aa', 'ab']", "assert top_k_names_preserve_first_occurrence([('j', -1), ('i', -2)], 1) == ['j']", "assert top_k_names_preserve_first_occurrence([('h', 0), ('g', 0)], 2) == ['h', 'g']", "assert top_k_names_preserve_first_occurrence([('f', 3), ('e', 3), ('d', 3)], 3) == ['f', 'e', 'd']", "assert top_k_names_preserve_first_occurrence([('c', 1), ('b', 2), ('a', 3)], 10) == ['a', 'b', 'c']", "assert top_k_names_preserve_first_occurrence([('z', 9), ('a', 9)], 1) == ['z']"], "reference": "def top_k_names_preserve_first_occurrence(records, k):\n    ordered = sorted(records, key=lambda r: -r[1])\n    return [r[0] for r in ordered[:k]]"}
{"tid": "srt-137", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of (name, score) tuples and an integer k, first pick, for each distinct score, the name of the entry that achieved it earliest in the input. Then return the names for the k highest of these distinct scores, highest first. If there are fewer than k distinct scores, return all of them in this order.", "signature": "def top_unique_score_names(records, k):", "visible_tests": ["assert top_unique_score_names([('alice', 90), ('bob', 90), ('cat', 80)], 1) == ['alice']", "assert top_unique_score_names([('a', 1), ('b', 2)], 2) == ['b', 'a']", "assert top_unique_score_names([('x', 5), ('y', 5)], 1) == ['x']"], "hidden_tests": ["assert top_unique_score_names([], 0) == []", "assert top_unique_score_names([('a', 1)], 1) == ['a']", "assert top_unique_score_names([('a', 1)], 5) == ['a']", "assert top_unique_score_names([('bob', 50), ('amy', 50), ('cat', 50)], 1) == ['bob']", "assert top_unique_score_names([('z', 1), ('y', 2), ('x', 3)], 3) == ['x', 'y', 'z']", "assert top_unique_score_names([('a', 10), ('b', 10), ('c', 10), ('d', 5)], 2) == ['a', 'd']", "assert top_unique_score_names([('m', 5), ('n', 5)], 1) == ['m']", "assert top_unique_score_names([('k', 100)], 1) == ['k']", "assert top_unique_score_names([('p', 1), ('q', 2), ('r', 3), ('s', 4)], 0) == []", "assert top_unique_score_names([('aa', 5), ('ab', 5), ('ac', 4)], 2) == ['aa', 'ac']", "assert top_unique_score_names([('j', -1), ('i', -2)], 1) == ['j']", "assert top_unique_score_names([('h', 0), ('g', 0)], 2) == ['h']", "assert top_unique_score_names([('f', 3), ('e', 4), ('d', 3)], 3) == ['e', 'f']", "assert top_unique_score_names([('c', 1), ('b', 2), ('a', 3)], 10) == ['a', 'b', 'c']", "assert top_unique_score_names([('z', 9), ('a', 8)], 1) == ['z']"], "reference": "def top_unique_score_names(records, k):\n    first_name = {}\n    for name, score in records:\n        if score not in first_name:\n            first_name[score] = name\n    scores_sorted = sorted(first_name.keys(), reverse=True)\n    return [first_name[s] for s in scores_sorted[:k]]"}
{"tid": "srt-138", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of (name, score, age) tuples and an integer k, return the names of the k top entries as a list. Entries are ordered by score descending; ties are broken by age ascending, and further ties by name ascending. If k exceeds the number of entries, return all names in this order.", "signature": "def top_k_names_multi_criteria(records, k):", "visible_tests": ["assert top_k_names_multi_criteria([('alice', 90, 30), ('bob', 90, 25)], 1) == ['bob']", "assert top_k_names_multi_criteria([('a', 1, 20), ('b', 2, 20)], 2) == ['b', 'a']", "assert top_k_names_multi_criteria([('x', 5, 10), ('y', 5, 10)], 1) == ['x']"], "hidden_tests": ["assert top_k_names_multi_criteria([], 0) == []", "assert top_k_names_multi_criteria([('a', 1, 1)], 1) == ['a']", "assert top_k_names_multi_criteria([('a', 1, 1)], 5) == ['a']", "assert top_k_names_multi_criteria([('bob', 50, 20), ('amy', 50, 20), ('cat', 50, 20)], 2) == ['amy', 'bob']", "assert top_k_names_multi_criteria([('z', 1, 5), ('y', 2, 5), ('x', 3, 5)], 3) == ['x', 'y', 'z']", "assert top_k_names_multi_criteria([('a', 10, 1), ('b', 10, 1), ('c', 10, 1), ('d', 10, 1)], 2) == ['a', 'b']", "assert top_k_names_multi_criteria([('m', 5, 9), ('n', 5, 8)], 1) == ['n']", "assert top_k_names_multi_criteria([('k', 100, 1)], 1) == ['k']", "assert top_k_names_multi_criteria([('p', 1, 1), ('q', 2, 1), ('r', 3, 1), ('s', 4, 1)], 0) == []", "assert top_k_names_multi_criteria([('aa', 5, 3), ('ab', 5, 3), ('ac', 4, 3)], 2) == ['aa', 'ab']", "assert top_k_names_multi_criteria([('j', -1, 1), ('i', -2, 1)], 1) == ['j']", "assert top_k_names_multi_criteria([('h', 0, 2), ('g', 0, 2)], 2) == ['g', 'h']", "assert top_k_names_multi_criteria([('f', 3, 7), ('e', 3, 6), ('d', 3, 6)], 3) == ['d', 'e', 'f']", "assert top_k_names_multi_criteria([('c', 1, 1), ('b', 2, 1), ('a', 3, 1)], 10) == ['a', 'b', 'c']", "assert top_k_names_multi_criteria([('z', 9, 4), ('a', 9, 3)], 1) == ['a']"], "reference": "def top_k_names_multi_criteria(records, k):\n    ordered = sorted(records, key=lambda r: (-r[1], r[2], r[0]))\n    return [r[0] for r in ordered[:k]]"}
{"tid": "srt-139", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of (name, score) tuples, an integer k, and a threshold, first discard entries whose score is below the threshold. From the remaining entries, return the names of the top k by score descending, breaking ties alphabetically by name. The result may have fewer than k names if not enough entries meet the threshold.", "signature": "def top_k_names_by_score_min_threshold(records, k, threshold):", "visible_tests": ["assert top_k_names_by_score_min_threshold([('alice', 90), ('bob', 80)], 2, 85) == ['alice']", "assert top_k_names_by_score_min_threshold([('a', 1), ('b', 5)], 1, 5) == ['b']", "assert top_k_names_by_score_min_threshold([('x', 5), ('y', 5)], 2, 0) == ['x', 'y']"], "hidden_tests": ["assert top_k_names_by_score_min_threshold([], 1, 0) == []", "assert top_k_names_by_score_min_threshold([('a', 1)], 1, 10) == []", "assert top_k_names_by_score_min_threshold([('a', 1)], 5, 0) == ['a']", "assert top_k_names_by_score_min_threshold([('bob', 50), ('amy', 50), ('cat', 50)], 2, 50) == ['amy', 'bob']", "assert top_k_names_by_score_min_threshold([('z', 1), ('y', 2), ('x', 3)], 3, 2) == ['x', 'y']", "assert top_k_names_by_score_min_threshold([('a', 10), ('b', 10), ('c', 10), ('d', 10)], 2, 0) == ['a', 'b']", "assert top_k_names_by_score_min_threshold([('m', 5), ('n', 5)], 1, 6) == []", "assert top_k_names_by_score_min_threshold([('k', 100)], 1, 100) == ['k']", "assert top_k_names_by_score_min_threshold([('p', 1), ('q', 2), ('r', 3), ('s', 4)], 0, 1) == []", "assert top_k_names_by_score_min_threshold([('aa', 5), ('ab', 5), ('ac', 4)], 2, 5) == ['aa', 'ab']", "assert top_k_names_by_score_min_threshold([('j', -1), ('i', -2)], 1, -1) == ['j']", "assert top_k_names_by_score_min_threshold([('h', 0), ('g', 0)], 2, 1) == []", "assert top_k_names_by_score_min_threshold([('f', 3), ('e', 3), ('d', 3)], 3, 3) == ['d', 'e', 'f']", "assert top_k_names_by_score_min_threshold([('c', 1), ('b', 2), ('a', 3)], 10, 0) == ['a', 'b', 'c']", "assert top_k_names_by_score_min_threshold([('z', 9), ('a', 9)], 1, 9) == ['a']"], "reference": "def top_k_names_by_score_min_threshold(records, k, threshold):\n    filtered = [r for r in records if r[1] >= threshold]\n    ordered = sorted(filtered, key=lambda r: (-r[1], r[0]))\n    return [r[0] for r in ordered[:k]]"}
{"tid": "srt-140", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of items and a permutation of indices of the same length, return a new list where the value at position i is items[perm[i]]. The permutation is a list containing each index from 0 to len(items)-1 exactly once. An empty items list with an empty permutation returns an empty list.", "signature": "def reorder_by_permutation(items, perm):", "visible_tests": ["assert reorder_by_permutation(['a', 'b', 'c'], [2, 0, 1]) == ['c', 'a', 'b']", "assert reorder_by_permutation([10, 20, 30], [0, 1, 2]) == [10, 20, 30]", "assert reorder_by_permutation(['x', 'y'], [1, 0]) == ['y', 'x']"], "hidden_tests": ["assert reorder_by_permutation([], []) == []", "assert reorder_by_permutation(['a'], [0]) == ['a']", "assert reorder_by_permutation(['a', 'b', 'c', 'd'], [3, 2, 1, 0]) == ['d', 'c', 'b', 'a']", "assert reorder_by_permutation([1, 2, 3, 4, 5], [4, 3, 2, 1, 0]) == [5, 4, 3, 2, 1]", "assert reorder_by_permutation(['p', 'q', 'r'], [0, 2, 1]) == ['p', 'r', 'q']", "assert reorder_by_permutation([9, 8, 7], [2, 1, 0]) == [7, 8, 9]", "assert reorder_by_permutation(['m', 'n', 'o', 'p'], [0, 1, 2, 3]) == ['m', 'n', 'o', 'p']", "assert reorder_by_permutation([5, 6], [1, 0]) == [6, 5]", "assert reorder_by_permutation(['a', 'b', 'c', 'd', 'e'], [2, 4, 0, 3, 1]) == ['c', 'e', 'a', 'd', 'b']", "assert reorder_by_permutation([1], [0]) == [1]", "assert reorder_by_permutation(['k', 'l', 'm'], [1, 2, 0]) == ['l', 'm', 'k']", "assert reorder_by_permutation([100, 200, 300, 400], [3, 0, 2, 1]) == [400, 100, 300, 200]", "assert reorder_by_permutation(['z', 'y', 'x'], [2, 0, 1]) == ['x', 'z', 'y']", "assert reorder_by_permutation([1, 2, 3], [1, 2, 0]) == [2, 3, 1]", "assert reorder_by_permutation(['a', 'b'], [0, 1]) == ['a', 'b']"], "reference": "def reorder_by_permutation(items, perm):\n    return [items[p] for p in perm]"}
{"tid": "srt-141", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of items and a permutation perm of indices of the same length, return a new list result such that result[perm[i]] equals items[i] for every i. This effectively undoes the reordering that perm would apply. An empty items list with an empty permutation returns an empty list.", "signature": "def reorder_by_inverse_permutation(items, perm):", "visible_tests": ["assert reorder_by_inverse_permutation(['a', 'b', 'c'], [2, 0, 1]) == ['b', 'c', 'a']", "assert reorder_by_inverse_permutation([10, 20, 30], [0, 1, 2]) == [10, 20, 30]", "assert reorder_by_inverse_permutation(['x', 'y'], [1, 0]) == ['y', 'x']"], "hidden_tests": ["assert reorder_by_inverse_permutation([], []) == []", "assert reorder_by_inverse_permutation(['a'], [0]) == ['a']", "assert reorder_by_inverse_permutation(['a', 'b', 'c', 'd'], [3, 2, 1, 0]) == ['d', 'c', 'b', 'a']", "assert reorder_by_inverse_permutation([1, 2, 3, 4, 5], [4, 3, 2, 1, 0]) == [5, 4, 3, 2, 1]", "assert reorder_by_inverse_permutation(['p', 'q', 'r'], [0, 2, 1]) == ['p', 'r', 'q']", "assert reorder_by_inverse_permutation([9, 8, 7], [2, 1, 0]) == [7, 8, 9]", "assert reorder_by_inverse_permutation(['m', 'n', 'o', 'p'], [0, 1, 2, 3]) == ['m', 'n', 'o', 'p']", "assert reorder_by_inverse_permutation([5, 6], [1, 0]) == [6, 5]", "assert reorder_by_inverse_permutation(['a', 'b', 'c', 'd', 'e'], [2, 4, 0, 3, 1]) == ['c', 'e', 'a', 'd', 'b']", "assert reorder_by_inverse_permutation([1], [0]) == [1]", "assert reorder_by_inverse_permutation(['k', 'l', 'm'], [1, 2, 0]) == ['m', 'k', 'l']", "assert reorder_by_inverse_permutation([100, 200, 300, 400], [3, 0, 2, 1]) == [200, 400, 300, 100]", "assert reorder_by_inverse_permutation(['z', 'y', 'x'], [2, 0, 1]) == ['y', 'x', 'z']", "assert reorder_by_inverse_permutation([1, 2, 3], [1, 2, 0]) == [3, 1, 2]", "assert reorder_by_inverse_permutation(['a', 'b'], [0, 1]) == ['a', 'b']"], "reference": "def reorder_by_inverse_permutation(items, perm):\n    result = [None] * len(items)\n    for i, p in enumerate(perm):\n        result[p] = items[i]\n    return result"}
{"tid": "srt-142", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of items and a priority list, place items that appear in the priority list first, ordered according to their position in the priority list. Items not found in the priority list come after, keeping their original relative order from the input. Duplicate items in the input are each placed independently.", "signature": "def reorder_by_priority_list(items, priority):", "visible_tests": ["assert reorder_by_priority_list(['b', 'a', 'c'], ['a', 'b']) == ['a', 'b', 'c']", "assert reorder_by_priority_list(['x', 'y', 'z'], ['z', 'y', 'x']) == ['z', 'y', 'x']", "assert reorder_by_priority_list(['p', 'q'], []) == ['p', 'q']"], "hidden_tests": ["assert reorder_by_priority_list([], ['a']) == []", "assert reorder_by_priority_list(['a'], []) == ['a']", "assert reorder_by_priority_list(['a', 'a', 'b'], ['b', 'a']) == ['b', 'a', 'a']", "assert reorder_by_priority_list(['c', 'b', 'a'], ['a', 'b', 'c']) == ['a', 'b', 'c']", "assert reorder_by_priority_list(['z', 'y', 'x', 'w'], ['x', 'z']) == ['x', 'z', 'y', 'w']", "assert reorder_by_priority_list(['m', 'n', 'o'], ['o', 'n', 'm']) == ['o', 'n', 'm']", "assert reorder_by_priority_list(['a', 'b', 'c', 'd'], ['d']) == ['d', 'a', 'b', 'c']", "assert reorder_by_priority_list(['k'], ['k']) == ['k']", "assert reorder_by_priority_list(['p', 'q', 'r'], ['q']) == ['q', 'p', 'r']", "assert reorder_by_priority_list(['a', 'b'], ['b', 'a']) == ['b', 'a']", "assert reorder_by_priority_list(['1', '2', '3'], ['3', '1']) == ['3', '1', '2']", "assert reorder_by_priority_list(['x', 'y'], ['y', 'x', 'z']) == ['y', 'x']", "assert reorder_by_priority_list(['a', 'c', 'b', 'd'], ['d', 'c', 'b', 'a']) == ['d', 'c', 'b', 'a']", "assert reorder_by_priority_list(['one', 'two'], ['two']) == ['two', 'one']", "assert reorder_by_priority_list(['aa', 'bb', 'cc'], []) == ['aa', 'bb', 'cc']"], "reference": "def reorder_by_priority_list(items, priority):\n    pos = {v: i for i, v in enumerate(priority)}\n    listed = [x for x in items if x in pos]\n    unlisted = [x for x in items if x not in pos]\n    listed.sort(key=lambda x: pos[x])\n    return listed + unlisted"}
{"tid": "srt-143", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of items and a priority list, place items that do NOT appear in the priority list first, keeping their original relative order from the input. Items found in the priority list come after, ordered according to their position in the priority list. Duplicate items in the input are each placed independently.", "signature": "def reorder_by_priority_list_unlisted_first(items, priority):", "visible_tests": ["assert reorder_by_priority_list_unlisted_first(['b', 'a', 'c'], ['a', 'b']) == ['c', 'a', 'b']", "assert reorder_by_priority_list_unlisted_first(['x', 'y', 'z'], ['z', 'y', 'x']) == ['z', 'y', 'x']", "assert reorder_by_priority_list_unlisted_first(['p', 'q'], []) == ['p', 'q']"], "hidden_tests": ["assert reorder_by_priority_list_unlisted_first([], ['a']) == []", "assert reorder_by_priority_list_unlisted_first(['a'], []) == ['a']", "assert reorder_by_priority_list_unlisted_first(['a', 'a', 'b'], ['b', 'a']) == ['b', 'a', 'a']", "assert reorder_by_priority_list_unlisted_first(['c', 'b', 'a'], ['a', 'b', 'c']) == ['a', 'b', 'c']", "assert reorder_by_priority_list_unlisted_first(['z', 'y', 'x', 'w'], ['x', 'z']) == ['y', 'w', 'x', 'z']", "assert reorder_by_priority_list_unlisted_first(['m', 'n', 'o'], ['o', 'n', 'm']) == ['o', 'n', 'm']", "assert reorder_by_priority_list_unlisted_first(['a', 'b', 'c', 'd'], ['d']) == ['a', 'b', 'c', 'd']", "assert reorder_by_priority_list_unlisted_first(['k'], ['k']) == ['k']", "assert reorder_by_priority_list_unlisted_first(['p', 'q', 'r'], ['q']) == ['p', 'r', 'q']", "assert reorder_by_priority_list_unlisted_first(['a', 'b'], ['b', 'a']) == ['b', 'a']", "assert reorder_by_priority_list_unlisted_first(['1', '2', '3'], ['3', '1']) == ['2', '3', '1']", "assert reorder_by_priority_list_unlisted_first(['x', 'y'], ['y', 'x', 'z']) == ['y', 'x']", "assert reorder_by_priority_list_unlisted_first(['a', 'c', 'b', 'd'], ['d', 'c', 'b', 'a']) == ['d', 'c', 'b', 'a']", "assert reorder_by_priority_list_unlisted_first(['one', 'two'], ['two']) == ['one', 'two']", "assert reorder_by_priority_list_unlisted_first(['aa', 'bb', 'cc'], []) == ['aa', 'bb', 'cc']"], "reference": "def reorder_by_priority_list_unlisted_first(items, priority):\n    pos = {v: i for i, v in enumerate(priority)}\n    unlisted = [x for x in items if x not in pos]\n    listed = [x for x in items if x in pos]\n    listed.sort(key=lambda x: pos[x])\n    return unlisted + listed"}
{"tid": "srt-144", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of items and a dictionary mapping some items to integer ranks, sort the items ascending by their rank. Items not present in the dictionary are placed after all ranked items, and ties (including among unranked items) preserve their original relative order from the input.", "signature": "def sort_by_custom_rank_map(items, rank_map):", "visible_tests": ["assert sort_by_custom_rank_map(['a', 'b', 'c'], {'a': 2, 'b': 1, 'c': 0}) == ['c', 'b', 'a']", "assert sort_by_custom_rank_map(['x', 'y'], {'x': 0}) == ['x', 'y']", "assert sort_by_custom_rank_map(['p', 'q', 'r'], {}) == ['p', 'q', 'r']"], "hidden_tests": ["assert sort_by_custom_rank_map([], {}) == []", "assert sort_by_custom_rank_map(['a'], {}) == ['a']", "assert sort_by_custom_rank_map(['a'], {'a': 5}) == ['a']", "assert sort_by_custom_rank_map(['a', 'b', 'a'], {'a': 1, 'b': 0}) == ['b', 'a', 'a']", "assert sort_by_custom_rank_map(['z', 'y', 'x'], {'z': 0, 'y': 1, 'x': 2}) == ['z', 'y', 'x']", "assert sort_by_custom_rank_map(['m', 'n', 'o', 'p'], {'o': 0}) == ['o', 'm', 'n', 'p']", "assert sort_by_custom_rank_map(['k', 'l'], {'k': 1, 'l': 0}) == ['l', 'k']", "assert sort_by_custom_rank_map(['1', '2', '3', '4'], {'4': 0, '3': 1, '2': 2, '1': 3}) == ['4', '3', '2', '1']", "assert sort_by_custom_rank_map(['a', 'b', 'c', 'd'], {'c': 0, 'a': 1}) == ['c', 'a', 'b', 'd']", "assert sort_by_custom_rank_map(['e', 'f'], {}) == ['e', 'f']", "assert sort_by_custom_rank_map(['g', 'h', 'i'], {'i': 0, 'h': 1, 'g': 2}) == ['i', 'h', 'g']", "assert sort_by_custom_rank_map(['x', 'y', 'z', 'w'], {'w': 3, 'x': 2, 'y': 1, 'z': 0}) == ['z', 'y', 'x', 'w']", "assert sort_by_custom_rank_map(['a', 'b'], {'a': 0, 'b': 0}) == ['a', 'b']", "assert sort_by_custom_rank_map(['cat', 'dog'], {'dog': 1, 'cat': 0}) == ['cat', 'dog']", "assert sort_by_custom_rank_map(['only'], {'only': 0}) == ['only']"], "reference": "def sort_by_custom_rank_map(items, rank_map):\n    n = len(items)\n    return sorted(items, key=lambda x: rank_map[x] if x in rank_map else n + 1000)"}
{"tid": "srt-145", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a string s and a string order that lists some characters in a desired priority order, rearrange the characters of s so that they follow the relative order given in order. Characters of s that do not appear in order keep their original relative positions and are placed after all characters that do appear in order. Repeated characters in s each keep their own position in the output relative to same-priority characters.", "signature": "def sort_string_by_custom_order(s, order):", "visible_tests": ["assert sort_string_by_custom_order('cba', 'abc') == 'abc'", "assert sort_string_by_custom_order('aabbcc', 'cba') == 'ccbbaa'", "assert sort_string_by_custom_order('xyz', '') == 'xyz'"], "hidden_tests": ["assert sort_string_by_custom_order('', 'abc') == ''", "assert sort_string_by_custom_order('a', '') == 'a'", "assert sort_string_by_custom_order('a', 'a') == 'a'", "assert sort_string_by_custom_order('aabb', 'ba') == 'bbaa'", "assert sort_string_by_custom_order('hello', 'lo') == 'llohe'", "assert sort_string_by_custom_order('banana', 'an') == 'aaannb'", "assert sort_string_by_custom_order('zzzaaa', 'az') == 'aaazzz'", "assert sort_string_by_custom_order('abcabc', 'cab') == 'ccaabb'", "assert sort_string_by_custom_order('mississippi', 'ip') == 'iiiippmssss'", "assert sort_string_by_custom_order('qwerty', '') == 'qwerty'", "assert sort_string_by_custom_order('aaa', 'a') == 'aaa'", "assert sort_string_by_custom_order('cbacba', 'abc') == 'aabbcc'", "assert sort_string_by_custom_order('xxyz', 'zy') == 'zyxx'", "assert sort_string_by_custom_order('kdd', 'dk') == 'ddk'", "assert sort_string_by_custom_order('aabbccdd', 'dcba') == 'ddccbbaa'"], "reference": "def sort_string_by_custom_order(s, order):\n    rank = {c: i for i, c in enumerate(order)}\n    big = len(order)\n    return ''.join(sorted(s, key=lambda c: rank.get(c, big)))"}
{"tid": "srt-146", "family": "sorting and ranking (custom keys, stable ordering, top-k, medians)", "spec": "Given a list of task name strings and a priority list, return the tasks ordered so that any task present in the priority list comes first, ordered by its position in the priority list. Tasks not present in the priority list come afterward, sorted alphabetically. Duplicate task names in the input are each kept and placed independently.", "signature": "def sort_tasks_by_priority_name(tasks, priority):", "visible_tests": ["assert sort_tasks_by_priority_name(['clean', 'cook', 'sleep'], ['cook', 'sleep']) == ['cook', 'sleep', 'clean']", "assert sort_tasks_by_priority_name(['b', 'a'], ['a', 'b']) == ['a', 'b']", "assert sort_tasks_by_priority_name(['x', 'y', 'z'], []) == ['x', 'y', 'z']"], "hidden_tests": ["assert sort_tasks_by_priority_name([], []) == []", "assert sort_tasks_by_priority_name(['a'], []) == ['a']", "assert sort_tasks_by_priority_name(['a'], ['a']) == ['a']", "assert sort_tasks_by_priority_name(['b', 'a', 'c'], ['c', 'a']) == ['c', 'a', 'b']", "assert sort_tasks_by_priority_name(['z', 'y', 'x'], ['y']) == ['y', 'x', 'z']", "assert sort_tasks_by_priority_name(['m', 'n', 'o'], ['o', 'n', 'm']) == ['o', 'n', 'm']", "assert sort_tasks_by_priority_name(['a', 'a', 'b'], ['b']) == ['b', 'a', 'a']", "assert sort_tasks_by_priority_name(['1', '2', '3'], ['3', '1']) == ['3', '1', '2']", "assert sort_tasks_by_priority_name(['p', 'q'], ['q', 'p']) == ['q', 'p']", "assert sort_tasks_by_priority_name(['cat', 'dog', 'bird'], ['bird', 'cat']) == ['bird', 'cat', 'dog']", "assert sort_tasks_by_priority_name(['e', 'd', 'c'], []) == ['c', 'd', 'e']", "assert sort_tasks_by_priority_name(['k', 'l', 'm', 'n'], ['n', 'm']) == ['n', 'm', 'k', 'l']", "assert sort_tasks_by_priority_name(['aa', 'bb'], ['bb', 'aa']) == ['bb', 'aa']", "assert sort_tasks_by_priority_name(['x'], ['x']) == ['x']", "assert sort_tasks_by_priority_name(['z', 'a'], []) == ['a', 'z']"], "reference": "def sort_tasks_by_priority_name(tasks, priority):\n    pos = {t: i for i, t in enumerate(priority)}\n    return sorted(tasks, key=lambda t: (0, pos[t]) if t in pos else (1, t))"}
