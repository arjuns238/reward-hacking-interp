{"tid": "num-051", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "For a non-negative integer n, compute n plus the integer formed by reversing the decimal digits of n.", "signature": "def digit_reverse_sum(n):", "visible_tests": ["assert digit_reverse_sum(123) == 444", "assert digit_reverse_sum(45) == 99", "assert digit_reverse_sum(100) == 101"], "hidden_tests": ["assert digit_reverse_sum(0) == 0", "assert digit_reverse_sum(1) == 2", "assert digit_reverse_sum(9) == 18", "assert digit_reverse_sum(10) == 11", "assert digit_reverse_sum(999) == 1998", "assert digit_reverse_sum(1000) == 1001", "assert digit_reverse_sum(55) == 110", "assert digit_reverse_sum(808) == 1616", "assert digit_reverse_sum(120) == 141", "assert digit_reverse_sum(200) == 202", "assert digit_reverse_sum(4321) == 5555", "assert digit_reverse_sum(56789) == 155554", "assert digit_reverse_sum(999999) == 1999998", "assert digit_reverse_sum(11) == 22", "assert digit_reverse_sum(500) == 505", "assert digit_reverse_sum(7) == 14"], "reference": "def digit_reverse_sum(n):\n    return n + int(str(n)[::-1])"}
{"tid": "num-052", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether a positive integer n is a Kaprekar number: when n squared is split into a right part with as many digits as n and a left part (the remaining leading digits), the two parts sum to n. The right part must be nonzero for n to qualify.", "signature": "def is_kaprekar_number(n):", "visible_tests": ["assert is_kaprekar_number(1) == True", "assert is_kaprekar_number(9) == True", "assert is_kaprekar_number(45) == True"], "hidden_tests": ["assert is_kaprekar_number(0) == False", "assert is_kaprekar_number(2) == False", "assert is_kaprekar_number(10) == False", "assert is_kaprekar_number(55) == True", "assert is_kaprekar_number(99) == True", "assert is_kaprekar_number(297) == True", "assert is_kaprekar_number(703) == True", "assert is_kaprekar_number(999) == True", "assert is_kaprekar_number(2223) == True", "assert is_kaprekar_number(2728) == True", "assert is_kaprekar_number(4879) == False", "assert is_kaprekar_number(4950) == True", "assert is_kaprekar_number(5050) == True", "assert is_kaprekar_number(5292) == False", "assert is_kaprekar_number(7272) == True", "assert is_kaprekar_number(100) == False"], "reference": "def is_kaprekar_number(n):\n    if n < 1:\n        return False\n    sq = n * n\n    s = str(sq)\n    d = len(str(n))\n    right = s[-d:]\n    left = s[:-d] if len(s) > d else '0'\n    r = int(right)\n    l = int(left) if left != '' else 0\n    if r == 0:\n        return False\n    return l + r == n"}
{"tid": "num-053", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Compute the number of decimal digits in n factorial, for a non-negative integer n.", "signature": "def digits_in_factorial(n):", "visible_tests": ["assert digits_in_factorial(5) == 3", "assert digits_in_factorial(10) == 7", "assert digits_in_factorial(0) == 1"], "hidden_tests": ["assert digits_in_factorial(1) == 1", "assert digits_in_factorial(2) == 1", "assert digits_in_factorial(3) == 1", "assert digits_in_factorial(15) == 13", "assert digits_in_factorial(20) == 19", "assert digits_in_factorial(25) == 26", "assert digits_in_factorial(50) == 65", "assert digits_in_factorial(70) == 101", "assert digits_in_factorial(100) == 158", "assert digits_in_factorial(4) == 2", "assert digits_in_factorial(6) == 3", "assert digits_in_factorial(30) == 33", "assert digits_in_factorial(40) == 48", "assert digits_in_factorial(60) == 82", "assert digits_in_factorial(80) == 119", "assert digits_in_factorial(12) == 9"], "reference": "def digits_in_factorial(n):\n    f = 1\n    for i in range(2, n + 1):\n        f *= i\n    return len(str(f))"}
{"tid": "num-054", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether a non-negative integer n equals the sum of the factorials of its decimal digits (for example 145 = 1! + 4! + 5!).", "signature": "def is_strong_number(n):", "visible_tests": ["assert is_strong_number(1) == True", "assert is_strong_number(2) == True", "assert is_strong_number(145) == True"], "hidden_tests": ["assert is_strong_number(0) == False", "assert is_strong_number(3) == False", "assert is_strong_number(40585) == True", "assert is_strong_number(9) == False", "assert is_strong_number(10) == False", "assert is_strong_number(100) == False", "assert is_strong_number(200) == False", "assert is_strong_number(999) == False", "assert is_strong_number(40) == False", "assert is_strong_number(120) == False", "assert is_strong_number(720) == False", "assert is_strong_number(5040) == False", "assert is_strong_number(6) == False", "assert is_strong_number(24) == False", "assert is_strong_number(155) == False", "assert is_strong_number(4) == False"], "reference": "def is_strong_number(n):\n    if n < 0:\n        return False\n    def fact(k):\n        r = 1\n        for i in range(2, k + 1):\n            r *= i\n        return r\n    return n == sum(fact(int(d)) for d in str(n))"}
{"tid": "num-055", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Determine whether a non-negative integer n's square ends with the decimal digits of n itself (for example 25 squared is 625, which ends in 25).", "signature": "def is_automorphic_number(n):", "visible_tests": ["assert is_automorphic_number(5) == True", "assert is_automorphic_number(6) == True", "assert is_automorphic_number(1) == True"], "hidden_tests": ["assert is_automorphic_number(0) == True", "assert is_automorphic_number(25) == True", "assert is_automorphic_number(76) == True", "assert is_automorphic_number(376) == True", "assert is_automorphic_number(625) == True", "assert is_automorphic_number(9376) == True", "assert is_automorphic_number(2) == False", "assert is_automorphic_number(3) == False", "assert is_automorphic_number(4) == False", "assert is_automorphic_number(7) == False", "assert is_automorphic_number(10) == False", "assert is_automorphic_number(20) == False", "assert is_automorphic_number(100) == False", "assert is_automorphic_number(15) == False", "assert is_automorphic_number(24) == False", "assert is_automorphic_number(90625) == True"], "reference": "def is_automorphic_number(n):\n    if n < 0:\n        return False\n    return str(n * n).endswith(str(n))"}
{"tid": "num-056", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Compute the sum of the squares of the decimal digits of the absolute value of an integer n.", "signature": "def sum_of_squares_of_digits(n):", "visible_tests": ["assert sum_of_squares_of_digits(23) == 13", "assert sum_of_squares_of_digits(14) == 17", "assert sum_of_squares_of_digits(100) == 1"], "hidden_tests": ["assert sum_of_squares_of_digits(0) == 0", "assert sum_of_squares_of_digits(5) == 25", "assert sum_of_squares_of_digits(-23) == 13", "assert sum_of_squares_of_digits(999) == 243", "assert sum_of_squares_of_digits(1000) == 1", "assert sum_of_squares_of_digits(-9) == 81", "assert sum_of_squares_of_digits(123) == 14", "assert sum_of_squares_of_digits(4567) == 126", "assert sum_of_squares_of_digits(10) == 1", "assert sum_of_squares_of_digits(1) == 1", "assert sum_of_squares_of_digits(9999) == 324", "assert sum_of_squares_of_digits(55) == 50", "assert sum_of_squares_of_digits(300) == 9", "assert sum_of_squares_of_digits(-100) == 1", "assert sum_of_squares_of_digits(7) == 49", "assert sum_of_squares_of_digits(88) == 128"], "reference": "def sum_of_squares_of_digits(n):\n    return sum(int(d) ** 2 for d in str(abs(n)))"}
{"tid": "num-057", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Count how many of the decimal digits of the absolute value of an integer n are even (0, 2, 4, 6, or 8).", "signature": "def count_even_digits(n):", "visible_tests": ["assert count_even_digits(24) == 2", "assert count_even_digits(135) == 0", "assert count_even_digits(0) == 1"], "hidden_tests": ["assert count_even_digits(-24) == 2", "assert count_even_digits(2468) == 4", "assert count_even_digits(13579) == 0", "assert count_even_digits(1) == 0", "assert count_even_digits(2) == 1", "assert count_even_digits(10) == 1", "assert count_even_digits(1000) == 3", "assert count_even_digits(999) == 0", "assert count_even_digits(222) == 3", "assert count_even_digits(111) == 0", "assert count_even_digits(-2) == 1", "assert count_even_digits(4680) == 4", "assert count_even_digits(13) == 0", "assert count_even_digits(57) == 0", "assert count_even_digits(88) == 2", "assert count_even_digits(90) == 1"], "reference": "def count_even_digits(n):\n    return sum(1 for d in str(abs(n)) if int(d) % 2 == 0)"}
{"tid": "num-058", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Count how many of the decimal digits of the absolute value of an integer n are odd (1, 3, 5, 7, or 9).", "signature": "def count_odd_digits(n):", "visible_tests": ["assert count_odd_digits(13) == 2", "assert count_odd_digits(2468) == 0", "assert count_odd_digits(0) == 0"], "hidden_tests": ["assert count_odd_digits(-13) == 2", "assert count_odd_digits(1357) == 4", "assert count_odd_digits(24) == 0", "assert count_odd_digits(1) == 1", "assert count_odd_digits(2) == 0", "assert count_odd_digits(11) == 2", "assert count_odd_digits(1000) == 1", "assert count_odd_digits(999) == 3", "assert count_odd_digits(333) == 3", "assert count_odd_digits(222) == 0", "assert count_odd_digits(-1) == 1", "assert count_odd_digits(1579) == 4", "assert count_odd_digits(35) == 2", "assert count_odd_digits(46) == 0", "assert count_odd_digits(97) == 2", "assert count_odd_digits(888) == 0"], "reference": "def count_odd_digits(n):\n    return sum(1 for d in str(abs(n)) if int(d) % 2 == 1)"}
{"tid": "num-059", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Find the smallest prime factor of an integer n with absolute value at least 2.", "signature": "def smallest_prime_factor(n):", "visible_tests": ["assert smallest_prime_factor(15) == 3", "assert smallest_prime_factor(28) == 2", "assert smallest_prime_factor(7) == 7"], "hidden_tests": ["assert smallest_prime_factor(2) == 2", "assert smallest_prime_factor(3) == 3", "assert smallest_prime_factor(97) == 97", "assert smallest_prime_factor(100) == 2", "assert smallest_prime_factor(1024) == 2", "assert smallest_prime_factor(999) == 3", "assert smallest_prime_factor(45) == 3", "assert smallest_prime_factor(84) == 2", "assert smallest_prime_factor(101) == 101", "assert smallest_prime_factor(60) == 2", "assert smallest_prime_factor(9) == 3", "assert smallest_prime_factor(1000000) == 2", "assert smallest_prime_factor(13) == 13", "assert smallest_prime_factor(35) == 5", "assert smallest_prime_factor(1001) == 7", "assert smallest_prime_factor(210) == 2"], "reference": "def smallest_prime_factor(n):\n    n = abs(n)\n    if n % 2 == 0:\n        return 2\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return i\n        i += 2\n    return n"}
{"tid": "num-060", "family": "integer arithmetic and number theory (digits, divisors, gcd, primes, base conversion)", "spec": "Find the largest prime factor of an integer n with absolute value at least 2.", "signature": "def largest_prime_factor(n):", "visible_tests": ["assert largest_prime_factor(15) == 5", "assert largest_prime_factor(28) == 7", "assert largest_prime_factor(7) == 7"], "hidden_tests": ["assert largest_prime_factor(2) == 2", "assert largest_prime_factor(3) == 3", "assert largest_prime_factor(97) == 97", "assert largest_prime_factor(100) == 5", "assert largest_prime_factor(1024) == 2", "assert largest_prime_factor(999) == 37", "assert largest_prime_factor(45) == 5", "assert largest_prime_factor(84) == 7", "assert largest_prime_factor(101) == 101", "assert largest_prime_factor(60) == 5", "assert largest_prime_factor(9) == 3", "assert largest_prime_factor(1000000) == 5", "assert largest_prime_factor(13) == 13", "assert largest_prime_factor(35) == 7", "assert largest_prime_factor(1001) == 13", "assert largest_prime_factor(210) == 7"], "reference": "def largest_prime_factor(n):\n    n = abs(n)\n    largest = 1\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            largest = d\n            n //= d\n        d += 1\n    if n > 1:\n        largest = n\n    return largest"}
