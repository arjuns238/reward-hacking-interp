{"tid": "dct-101", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Find the minimum word length in the non-empty list words, then return a sorted list of all words that have that minimum length (there may be one or several).", "signature": "def shortest_words(words):", "visible_tests": ["assert shortest_words(['cat', 'elephant', 'dog']) == ['cat', 'dog']", "assert shortest_words(['a', 'bb']) == ['a']", "assert shortest_words(['same']) == ['same']"], "hidden_tests": ["assert shortest_words(['x']) == ['x']", "assert shortest_words(['aa', 'bb', 'cc']) == ['aa', 'bb', 'cc']", "assert shortest_words(['short', 'longer', 'hi']) == ['hi']", "assert shortest_words(['a', 'aa', 'aaa', 'a']) == ['a', 'a']", "assert shortest_words(['z', 'zz', 'zzz']) == ['z']", "assert shortest_words(['one', 'two', 'six']) == ['one', 'six', 'two']", "assert shortest_words(['tie1', 'tie2', 'toolongforthis']) == ['tie1', 'tie2']", "assert shortest_words(['m']) == ['m']", "assert shortest_words(['equal', 'sizes', 'words']) == ['equal', 'sizes', 'words']", "assert shortest_words(['a', 'b', 'c', 'dd']) == ['a', 'b', 'c']", "assert shortest_words(['short', 'short', 'longer']) == ['short', 'short']", "assert shortest_words(['p', 'pp', 'ppp', 'pppp']) == ['p']", "assert shortest_words(['abc', 'ab', 'a']) == ['a']", "assert shortest_words(['x', 'xx', 'xx', 'x']) == ['x', 'x']", "assert shortest_words(['kkkkkkkkkk', 'jjjjj', 'i']) == ['i']"], "reference": "def shortest_words(words):\n    minlen = min(len(w) for w in words)\n    return sorted(w for w in words if len(w) == minlen)"}
{"tid": "dct-102", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a sorted list of the keys that are present in all three dicts d1, d2, and d3. If there is no such key, return an empty list.", "signature": "def common_keys_three(d1, d2, d3):", "visible_tests": ["assert common_keys_three({'a': 1, 'b': 2}, {'a': 1, 'b': 3}, {'a': 1, 'c': 4}) == ['a']", "assert common_keys_three({'x': 1}, {'x': 2}, {'x': 3}) == ['x']", "assert common_keys_three({}, {}, {}) == []"], "hidden_tests": ["assert common_keys_three({'a': 1}, {'a': 1}, {'b': 1}) == []", "assert common_keys_three({}, {'a': 1}, {'a': 1}) == []", "assert common_keys_three({'a': 1, 'b': 1, 'c': 1}, {'a': 1, 'b': 1}, {'a': 1}) == ['a']", "assert common_keys_three({'z': 1}, {'z': 1}, {'z': 1}) == ['z']", "assert common_keys_three({'m': 1, 'n': 1}, {'n': 1, 'o': 1}, {'n': 1, 'p': 1}) == ['n']", "assert common_keys_three({'only': 1}, {'only': 1}, {'other': 1}) == []", "assert common_keys_three({'a': 1, 'b': 1, 'c': 1}, {'a': 1, 'b': 1, 'c': 1}, {'a': 1, 'b': 1, 'c': 1}) == ['a', 'b', 'c']", "assert common_keys_three({'p': 1}, {'q': 1}, {'r': 1}) == []", "assert common_keys_three({'k1': 1, 'k2': 1}, {'k1': 1}, {'k1': 1, 'k2': 1}) == ['k1']", "assert common_keys_three({'x': 1, 'y': 1, 'z': 1}, {'x': 1, 'y': 1}, {'x': 1}) == ['x']", "assert common_keys_three({}, {}, {'a': 1}) == []", "assert common_keys_three({'a': 1}, {}, {}) == []", "assert common_keys_three({'aa': 1, 'bb': 1}, {'aa': 1, 'bb': 1}, {'cc': 1}) == []", "assert common_keys_three({'same': 1}, {'same': 2}, {'same': 3}) == ['same']", "assert common_keys_three({'g1': 1, 'g2': 1, 'g3': 1}, {'g2': 1, 'g3': 1}, {'g3': 1}) == ['g3']"], "reference": "def common_keys_three(d1, d2, d3):\n    return sorted(set(d1) & set(d2) & set(d3))"}
{"tid": "dct-103", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict, count how many keys map to each distinct value. Return a dict mapping each distinct value found in d to the number of keys that have it. An empty dict returns an empty dict.", "signature": "def value_frequency(d):", "visible_tests": ["assert value_frequency({'a': 1, 'b': 1, 'c': 2}) == {1: 2, 2: 1}", "assert value_frequency({'x': 'red', 'y': 'blue'}) == {'red': 1, 'blue': 1}", "assert value_frequency({}) == {}"], "hidden_tests": ["assert value_frequency({'a': 1}) == {1: 1}", "assert value_frequency({'a': 1, 'b': 1, 'c': 1}) == {1: 3}", "assert value_frequency({'a': 1, 'b': 2, 'c': 1, 'd': 2}) == {1: 2, 2: 2}", "assert value_frequency({'p': 'x', 'q': 'x', 'r': 'y', 's': 'x'}) == {'x': 3, 'y': 1}", "assert value_frequency({'z': 0, 'y': 0, 'x': 0, 'w': 1}) == {0: 3, 1: 1}", "assert value_frequency({'m': True, 'n': False, 'o': True}) == {True: 2, False: 1}", "assert value_frequency({'a': 'same', 'b': 'same'}) == {'same': 2}", "assert value_frequency({1: 'a', 2: 'a', 3: 'b', 4: 'c', 5: 'b'}) == {'a': 2, 'b': 2, 'c': 1}", "assert value_frequency({'solo': 99}) == {99: 1}", "assert value_frequency({'a': None, 'b': None}) == {None: 2}", "assert value_frequency({'a': 5, 'b': 6, 'c': 5, 'd': 6, 'e': 5}) == {5: 3, 6: 2}", "assert value_frequency({'k1': 'v', 'k2': 'v', 'k3': 'v', 'k4': 'w'}) == {'v': 3, 'w': 1}", "assert value_frequency({'a': 1, 'b': 2, 'c': 3}) == {1: 1, 2: 1, 3: 1}", "assert value_frequency({'x': -1, 'y': -1, 'z': -2}) == {-1: 2, -2: 1}", "assert value_frequency({'a': 'cat', 'b': 'dog', 'c': 'cat', 'd': 'cat'}) == {'cat': 3, 'dog': 1}"], "reference": "def value_frequency(d):\n    res = {}\n    for v in d.values():\n        res[v] = res.get(v, 0) + 1\n    return res"}
{"tid": "dct-104", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given two lists of the same length, count the number of positions at which the elements are equal. Return that count as an integer. Two empty lists return 0.", "signature": "def count_matching_positions(list1, list2):", "visible_tests": ["assert count_matching_positions([1, 2, 3], [1, 5, 3]) == 2", "assert count_matching_positions(['a', 'b'], ['a', 'c']) == 1", "assert count_matching_positions([], []) == 0"], "hidden_tests": ["assert count_matching_positions([1], [1]) == 1", "assert count_matching_positions([1], [2]) == 0", "assert count_matching_positions([1, 1, 1], [1, 1, 1]) == 3", "assert count_matching_positions([1, 1, 1], [2, 2, 2]) == 0", "assert count_matching_positions([1, 2, 3, 4, 5], [1, 2, 0, 4, 0]) == 3", "assert count_matching_positions(['x', 'y', 'z'], ['x', 'y', 'z']) == 3", "assert count_matching_positions([True, False], [True, True]) == 1", "assert count_matching_positions([0, 0, 0], [0, 1, 0]) == 2", "assert count_matching_positions([-1, -2, -3], [-1, -2, -3]) == 3", "assert count_matching_positions(['a', 'a', 'a'], ['a', 'b', 'a']) == 2", "assert count_matching_positions([1.5, 2.5], [1.5, 2.5]) == 2", "assert count_matching_positions([None, 1], [None, 2]) == 1", "assert count_matching_positions([1, 2, 3, 4, 5, 6, 7], [1, 0, 3, 0, 5, 0, 7]) == 4", "assert count_matching_positions(['m'], ['n']) == 0", "assert count_matching_positions([1, 2], [1, 2]) == 2"], "reference": "def count_matching_positions(list1, list2):\n    return sum(1 for a, b in zip(list1, list2) if a == b)"}
{"tid": "dct-105", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Consider only the words in the list that have length at least prefix_len, and take the first prefix_len characters of each as its prefix. Count how many words share each such prefix. Return a dict mapping each occupied prefix to its count. If no word is long enough, or the list is empty, return an empty dict.", "signature": "def common_prefix_counts(words, prefix_len):", "visible_tests": ["assert common_prefix_counts(['apple', 'apricot', 'banana'], 2) == {'ap': 2, 'ba': 1}", "assert common_prefix_counts(['cat', 'car', 'dog'], 2) == {'ca': 2, 'do': 1}", "assert common_prefix_counts([], 3) == {}"], "hidden_tests": ["assert common_prefix_counts(['a', 'ab', 'abc'], 3) == {'abc': 1}", "assert common_prefix_counts(['a', 'ab'], 5) == {}", "assert common_prefix_counts(['same', 'same', 'same'], 4) == {'same': 3}", "assert common_prefix_counts(['x', 'y', 'z'], 1) == {'x': 1, 'y': 1, 'z': 1}", "assert common_prefix_counts(['ab', 'ac', 'ad', 'bb'], 1) == {'a': 3, 'b': 1}", "assert common_prefix_counts(['short'], 10) == {}", "assert common_prefix_counts(['prefix1', 'prefix2', 'other'], 6) == {'prefix': 2}", "assert common_prefix_counts(['aa', 'ab', 'ba', 'bb'], 1) == {'a': 2, 'b': 2}", "assert common_prefix_counts(['hello', 'help', 'held', 'world'], 3) == {'hel': 3, 'wor': 1}", "assert common_prefix_counts(['a', 'aa', 'aaa', 'aaaa'], 2) == {'aa': 3}", "assert common_prefix_counts(['cat', 'cats', 'car', 'cars'], 3) == {'cat': 2, 'car': 2}", "assert common_prefix_counts(['only'], 4) == {'only': 1}", "assert common_prefix_counts(['mm', 'mn', 'nn'], 1) == {'m': 2, 'n': 1}", "assert common_prefix_counts(['', 'a', 'ab'], 1) == {'a': 2}", "assert common_prefix_counts(['test', 'testing', 'tester'], 4) == {'test': 3}"], "reference": "def common_prefix_counts(words, prefix_len):\n    d = {}\n    for w in words:\n        if len(w) >= prefix_len:\n            p = w[:prefix_len]\n            d[p] = d.get(p, 0) + 1\n    return d"}
{"tid": "dct-106", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Bucket each non-negative integer score into a decade label: '0-9', '10-19', ..., '90-99', or '100+' for scores of 100 and above. Return a dict mapping each label with at least one score to its count (labels with no scores are omitted). An empty list returns an empty dict.", "signature": "def score_bucket_counts(scores):", "visible_tests": ["assert score_bucket_counts([5, 15, 25]) == {'0-9': 1, '10-19': 1, '20-29': 1}", "assert score_bucket_counts([95, 100]) == {'90-99': 1, '100+': 1}", "assert score_bucket_counts([]) == {}"], "hidden_tests": ["assert score_bucket_counts([100]) == {'100+': 1}", "assert score_bucket_counts([99]) == {'90-99': 1}", "assert score_bucket_counts([0]) == {'0-9': 1}", "assert score_bucket_counts([9, 10]) == {'0-9': 1, '10-19': 1}", "assert score_bucket_counts([50, 55, 59]) == {'50-59': 3}", "assert score_bucket_counts([100, 150, 200]) == {'100+': 3}", "assert score_bucket_counts([0, 0, 0]) == {'0-9': 3}", "assert score_bucket_counts([100, 100]) == {'100+': 2}", "assert score_bucket_counts([45, 45, 45, 55]) == {'40-49': 3, '50-59': 1}", "assert score_bucket_counts([1, 11, 21, 31, 41, 51]) == {'0-9': 1, '10-19': 1, '20-29': 1, '30-39': 1, '40-49': 1, '50-59': 1}", "assert score_bucket_counts([99, 100, 101]) == {'90-99': 1, '100+': 2}", "assert score_bucket_counts([70, 71, 79, 80]) == {'70-79': 3, '80-89': 1}", "assert score_bucket_counts([20]) == {'20-29': 1}", "assert score_bucket_counts([100, 99, 98]) == {'100+': 1, '90-99': 2}", "assert score_bucket_counts([60, 61, 69]) == {'60-69': 3}"], "reference": "def score_bucket_counts(scores):\n    d = {}\n    for s in scores:\n        if s >= 100:\n            label = \"100+\"\n        else:\n            low = (s // 10) * 10\n            label = f\"{low}-{low + 9}\"\n        d[label] = d.get(label, 0) + 1\n    return d"}
{"tid": "dct-107", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict with string keys, count how many keys have each possible key length. Return a dict mapping each key length to the number of keys of that length. An empty dict returns an empty dict.", "signature": "def key_length_frequency(d):", "visible_tests": ["assert key_length_frequency({'a': 1, 'bb': 2, 'cc': 3}) == {1: 1, 2: 2}", "assert key_length_frequency({'x': 1}) == {1: 1}", "assert key_length_frequency({}) == {}"], "hidden_tests": ["assert key_length_frequency({'': 1}) == {0: 1}", "assert key_length_frequency({'a': 1, 'b': 2, 'c': 3}) == {1: 3}", "assert key_length_frequency({'aa': 1, 'bb': 2}) == {2: 2}", "assert key_length_frequency({'one': 1, 'two': 2, 'six': 3}) == {3: 3}", "assert key_length_frequency({'a': 1, 'ab': 2, 'abc': 3}) == {1: 1, 2: 1, 3: 1}", "assert key_length_frequency({'same': 1, 'size': 2, 'word': 3, 'four': 4}) == {4: 4}", "assert key_length_frequency({'x': 1, 'yy': 2, 'zzz': 3, 'a': 4}) == {1: 2, 2: 1, 3: 1}", "assert key_length_frequency({'k1': 1}) == {2: 1}", "assert key_length_frequency({'a': 1, 'aa': 2, 'aaa': 3, 'aaaa': 4}) == {1: 1, 2: 1, 3: 1, 4: 1}", "assert key_length_frequency({'long_key_name': 1}) == {13: 1}", "assert key_length_frequency({'m': 1, 'n': 2, 'o': 3, 'p': 4, 'q': 5}) == {1: 5}", "assert key_length_frequency({'ab': 1, 'cd': 2, 'ef': 3, 'g': 4}) == {2: 3, 1: 1}", "assert key_length_frequency({'solo': 1}) == {4: 1}", "assert key_length_frequency({'a': 1, 'b': 2}) == {1: 2}", "assert key_length_frequency({'': 1, 'a': 2, 'ab': 3}) == {0: 1, 1: 1, 2: 1}"], "reference": "def key_length_frequency(d):\n    res = {}\n    for k in d.keys():\n        l = len(k)\n        res[l] = res.get(l, 0) + 1\n    return res"}
{"tid": "dct-108", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Combine the keys of three numeric dicts d1, d2, d3. For each key present in any of them, sum the values from every dict that has it (treating a missing key as 0). Return the resulting dict. Three empty dicts return an empty dict.", "signature": "def merge_three_sum(d1, d2, d3):", "visible_tests": ["assert merge_three_sum({'a': 1}, {'a': 2}, {'a': 3}) == {'a': 6}", "assert merge_three_sum({'x': 1}, {'y': 2}, {'z': 3}) == {'x': 1, 'y': 2, 'z': 3}", "assert merge_three_sum({}, {}, {}) == {}"], "hidden_tests": ["assert merge_three_sum({}, {}, {'a': 1}) == {'a': 1}", "assert merge_three_sum({'a': 1}, {}, {}) == {'a': 1}", "assert merge_three_sum({'a': 1, 'b': 2}, {'b': 3, 'c': 4}, {'a': 5, 'c': 6}) == {'c': 10, 'a': 6, 'b': 5}", "assert merge_three_sum({'z': -1}, {'z': -2}, {'z': -3}) == {'z': -6}", "assert merge_three_sum({'m': 0}, {'m': 0}, {'m': 0}) == {'m': 0}", "assert merge_three_sum({'only': 10}, {}, {}) == {'only': 10}", "assert merge_three_sum({'p': 1}, {'p': 1}, {'p': 1}) == {'p': 3}", "assert merge_three_sum({'a': 1}, {'b': 1}, {'c': 1}) == {'c': 1, 'a': 1, 'b': 1}", "assert merge_three_sum({'neg': -5}, {'neg': 5}, {'neg': 0}) == {'neg': 0}", "assert merge_three_sum({'a': 1, 'b': 1}, {'a': 1, 'c': 1}, {'b': 1, 'c': 1}) == {'c': 2, 'a': 2, 'b': 2}", "assert merge_three_sum({'k': 100}, {'k': 200}, {'k': 300}) == {'k': 600}", "assert merge_three_sum({'x': 1}, {'x': 1}, {}) == {'x': 2}", "assert merge_three_sum({}, {'y': 5}, {'y': 5}) == {'y': 10}", "assert merge_three_sum({'g1': 1, 'g2': 2}, {'g2': 3, 'g3': 4}, {'g1': 5, 'g3': 6}) == {'g1': 6, 'g2': 5, 'g3': 10}", "assert merge_three_sum({'a': 2}, {'b': 3}, {'a': 4, 'b': 5}) == {'a': 6, 'b': 8}"], "reference": "def merge_three_sum(d1, d2, d3):\n    keys = set(d1) | set(d2) | set(d3)\n    return {k: d1.get(k, 0) + d2.get(k, 0) + d3.get(k, 0) for k in keys}"}
{"tid": "dct-109", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a dict with numeric values, split its keys into two groups: those whose value falls within [low, high] inclusive ('in_range'), and all others ('out_range'). Return a dict with keys 'in_range' and 'out_range' each mapping to a sorted list of the matching dict keys.", "signature": "def group_by_key_range(d, low, high):", "visible_tests": ["assert group_by_key_range({'a': 5, 'b': 15, 'c': 25}, 10, 20) == {'in_range': ['b'], 'out_range': ['a', 'c']}", "assert group_by_key_range({'x': 1}, 0, 5) == {'in_range': ['x'], 'out_range': []}", "assert group_by_key_range({}, 0, 10) == {'in_range': [], 'out_range': []}"], "hidden_tests": ["assert group_by_key_range({'a': 10}, 10, 10) == {'in_range': ['a'], 'out_range': []}", "assert group_by_key_range({'a': 9}, 10, 10) == {'in_range': [], 'out_range': ['a']}", "assert group_by_key_range({'a': 11}, 10, 10) == {'in_range': [], 'out_range': ['a']}", "assert group_by_key_range({'a': -5, 'b': 0, 'c': 5}, -10, 0) == {'in_range': ['a', 'b'], 'out_range': ['c']}", "assert group_by_key_range({'m': 1, 'n': 2, 'o': 3}, 1, 3) == {'in_range': ['m', 'n', 'o'], 'out_range': []}", "assert group_by_key_range({'z': 100}, 0, 50) == {'in_range': [], 'out_range': ['z']}", "assert group_by_key_range({'p': 5, 'q': 5, 'r': 5}, 5, 5) == {'in_range': ['p', 'q', 'r'], 'out_range': []}", "assert group_by_key_range({'only': 0}, 0, 0) == {'in_range': ['only'], 'out_range': []}", "assert group_by_key_range({'a': 1, 'b': 2, 'c': 3, 'd': 4}, 2, 3) == {'in_range': ['b', 'c'], 'out_range': ['a', 'd']}", "assert group_by_key_range({'k1': -1, 'k2': -2, 'k3': -3}, -3, -2) == {'in_range': ['k2', 'k3'], 'out_range': ['k1']}", "assert group_by_key_range({'x': 5, 'y': 15}, 10, 10) == {'in_range': [], 'out_range': ['x', 'y']}", "assert group_by_key_range({'a': 1000}, -1000, 1000) == {'in_range': ['a'], 'out_range': []}", "assert group_by_key_range({'g1': 50, 'g2': 60, 'g3': 70}, 0, 55) == {'in_range': ['g1'], 'out_range': ['g2', 'g3']}", "assert group_by_key_range({'same1': 5, 'same2': 5}, 0, 10) == {'in_range': ['same1', 'same2'], 'out_range': []}", "assert group_by_key_range({'a': 1, 'b': 2}, 5, 10) == {'in_range': [], 'out_range': ['a', 'b']}"], "reference": "def group_by_key_range(d, low, high):\n    res = {\"in_range\": [], \"out_range\": []}\n    for k, v in d.items():\n        if low <= v <= high:\n            res[\"in_range\"].append(k)\n        else:\n            res[\"out_range\"].append(k)\n    res[\"in_range\"] = sorted(res[\"in_range\"])\n    res[\"out_range\"] = sorted(res[\"out_range\"])\n    return res"}
{"tid": "dct-110", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "For every key that appears in either numeric dict d1 or d2, compute the average of the values present for that key (using just one value if the key appears in only one dict). Return a dict mapping each key to that average (a float). Two empty dicts return an empty dict.", "signature": "def merge_avg_two(d1, d2):", "visible_tests": ["assert merge_avg_two({'a': 2, 'b': 4}, {'a': 4, 'b': 6}) == {'a': 3.0, 'b': 5.0}", "assert merge_avg_two({'x': 10}, {'x': 20}) == {'x': 15.0}", "assert merge_avg_two({}, {}) == {}"], "hidden_tests": ["assert merge_avg_two({}, {'a': 5}) == {'a': 5.0}", "assert merge_avg_two({'a': 5}, {}) == {'a': 5.0}", "assert merge_avg_two({'a': 1, 'b': 2}, {'a': 3, 'c': 4}) == {'c': 4.0, 'a': 2.0, 'b': 2.0}", "assert merge_avg_two({'z': -2}, {'z': 2}) == {'z': 0.0}", "assert merge_avg_two({'m': 0}, {'m': 0}) == {'m': 0.0}", "assert merge_avg_two({'only': 7}, {}) == {'only': 7.0}", "assert merge_avg_two({'p': 1}, {'p': 2}) == {'p': 1.5}", "assert merge_avg_two({'a': 1, 'b': 1}, {'a': 1, 'b': 1}) == {'a': 1.0, 'b': 1.0}", "assert merge_avg_two({'neg': -10}, {'neg': -20}) == {'neg': -15.0}", "assert merge_avg_two({'a': 100, 'b': 200}, {'a': 50, 'c': 25}) == {'c': 25.0, 'a': 75.0, 'b': 200.0}", "assert merge_avg_two({'k': 3}, {'k': 5}) == {'k': 4.0}", "assert merge_avg_two({'x': 0, 'y': 0}, {'x': 0, 'y': 0}) == {'x': 0.0, 'y': 0.0}", "assert merge_avg_two({'unique': 5}, {'other': 5}) == {'unique': 5.0, 'other': 5.0}", "assert merge_avg_two({'c1': 10, 'c2': 20}, {'c1': 5}) == {'c2': 20.0, 'c1': 7.5}", "assert merge_avg_two({'a': -5}, {'a': 5}) == {'a': 0.0}"], "reference": "def merge_avg_two(d1, d2):\n    keys = set(d1) | set(d2)\n    res = {}\n    for k in keys:\n        vals = []\n        if k in d1:\n            vals.append(d1[k])\n        if k in d2:\n            vals.append(d2[k])\n        res[k] = sum(vals) / len(vals)\n    return res"}
