{"tid": "geo-001", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that computes the Manhattan distance between two points p1 and p2, each given as a tuple (x, y) of numbers. The Manhattan distance is |x1 - x2| + |y1 - y2|. Coordinates may be integers or floats, positive or negative.", "signature": "def manhattan_distance(p1, p2):", "visible_tests": ["assert manhattan_distance((0, 0), (3, 4)) == 7", "assert manhattan_distance((1, 1), (1, 1)) == 0", "assert manhattan_distance((-1, -1), (1, 1)) == 4"], "hidden_tests": ["assert manhattan_distance((0, 0), (0, 0)) == 0", "assert manhattan_distance((5, 2), (2, 5)) == 6", "assert manhattan_distance((-3, 4), (2, -6)) == 15", "assert manhattan_distance((10, 10), (0, 0)) == 20", "assert manhattan_distance((0, 0), (-7, -8)) == 15", "assert manhattan_distance((3, 4), (0, 0)) == 7", "assert manhattan_distance((-2, -3), (-2, -3)) == 0", "assert manhattan_distance((100, -100), (-100, 100)) == 400", "assert abs(manhattan_distance((1.5, 2.5), (4.0, 0.5)) - 4.5) < 1e-9", "assert abs(manhattan_distance((-1.5, -2.5), (1.5, 2.5)) - 8.0) < 1e-9", "assert manhattan_distance((0, 5), (0, -5)) == 10", "assert manhattan_distance((5, 0), (-5, 0)) == 10", "assert manhattan_distance((7, 7), (7, 3)) == 4", "assert manhattan_distance((1000, 1000), (-1000, -1000)) == 4000", "assert manhattan_distance((2, 3), (5, 3)) == 3"], "reference": "def manhattan_distance(p1, p2):\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])"}
{"tid": "geo-002", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that computes the Euclidean distance between two points p1 and p2, each given as a tuple (x, y) of numbers. Return the result as a float. Coordinates may be integers or floats, positive or negative.", "signature": "def euclidean_distance(p1, p2):", "visible_tests": ["assert abs(euclidean_distance((0, 0), (3, 4)) - 5.0) < 1e-9", "assert abs(euclidean_distance((0, 0), (0, 0)) - 0.0) < 1e-9", "assert abs(euclidean_distance((1, 1), (4, 5)) - 5.0) < 1e-9"], "hidden_tests": ["assert abs(euclidean_distance((0, 0), (1, 0)) - 1.0) < 1e-9", "assert abs(euclidean_distance((0, 0), (0, 1)) - 1.0) < 1e-9", "assert abs(euclidean_distance((-3, -4), (0, 0)) - 5.0) < 1e-9", "assert abs(euclidean_distance((2, 3), (2, 3)) - 0.0) < 1e-9", "assert abs(euclidean_distance((0, 0), (6, 8)) - 10.0) < 1e-9", "assert abs(euclidean_distance((1, 1), (1, 1)) - 0.0) < 1e-9", "assert abs(euclidean_distance((-1, -1), (2, 3)) - 5.0) < 1e-9", "assert abs(euclidean_distance((5, 5), (5, 10)) - 5.0) < 1e-9", "assert abs(euclidean_distance((0, 0), (-6, -8)) - 10.0) < 1e-9", "assert abs(euclidean_distance((1.5, 2.0), (1.5, 6.0)) - 4.0) < 1e-9", "assert abs(euclidean_distance((100, 0), (0, 0)) - 100.0) < 1e-9", "assert abs(euclidean_distance((3, 4), (0, 0)) - 5.0) < 1e-9", "assert abs(euclidean_distance((-5, 0), (5, 0)) - 10.0) < 1e-9", "assert abs(euclidean_distance((0, -2), (0, 2)) - 4.0) < 1e-9", "assert abs(euclidean_distance((-2, -2), (2, 2)) - (4 * 2 ** 0.5)) < 1e-9"], "reference": "def euclidean_distance(p1, p2):\n    return ((p1[0] - p2[0]) ** 2 + (p1[1] - p2[1]) ** 2) ** 0.5"}
{"tid": "geo-003", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a non-empty list of points, each a tuple (x, y) of numbers, and returns the axis-aligned bounding box as a tuple (min_x, min_y, max_x, max_y) that tightly contains all the points.", "signature": "def bounding_box(points):", "visible_tests": ["assert bounding_box([(0, 0), (2, 3), (1, 1)]) == (0, 0, 2, 3)", "assert bounding_box([(5, 5)]) == (5, 5, 5, 5)", "assert bounding_box([(-1, -1), (1, 1)]) == (-1, -1, 1, 1)"], "hidden_tests": ["assert bounding_box([(0, 0)]) == (0, 0, 0, 0)", "assert bounding_box([(3, 4), (3, 4), (3, 4)]) == (3, 4, 3, 4)", "assert bounding_box([(-5, 2), (10, -3), (0, 0)]) == (-5, -3, 10, 2)", "assert bounding_box([(1, 1), (2, 2), (3, 3), (4, 4)]) == (1, 1, 4, 4)", "assert bounding_box([(-10, -10), (-5, -5), (-1, -1)]) == (-10, -10, -1, -1)", "assert bounding_box([(100, -100), (-100, 100)]) == (-100, -100, 100, 100)", "assert bounding_box([(0, 5), (5, 0), (2, 2), (-2, -2)]) == (-2, -2, 5, 5)", "assert bounding_box([(7, 3), (7, 3)]) == (7, 3, 7, 3)", "assert bounding_box([(1, -1), (-1, 1), (0, 0), (2, -2)]) == (-1, -2, 2, 1)", "assert bounding_box([(9, 9), (1, 1), (5, 5), (9, 1), (1, 9)]) == (1, 1, 9, 9)", "assert bounding_box([(-3, -3), (3, 3), (0, -3), (-3, 0)]) == (-3, -3, 3, 3)", "assert bounding_box([(50, 50)]) == (50, 50, 50, 50)", "assert bounding_box([(-1, 5), (-1, -5), (1, 0)]) == (-1, -5, 1, 5)", "assert bounding_box([(4, 4), (4, -4), (-4, 4), (-4, -4)]) == (-4, -4, 4, 4)", "assert bounding_box([(2, 8), (8, 2), (5, 5)]) == (2, 2, 8, 8)"], "reference": "def bounding_box(points):\n    xs = [p[0] for p in points]\n    ys = [p[1] for p in points]\n    return (min(xs), min(ys), max(xs), max(ys))"}
{"tid": "geo-004", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes two axis-aligned rectangles r1 and r2, each given as a tuple (x1, y1, x2, y2) with x1 <= x2 and y1 <= y2 (lower-left and upper-right corners), and returns True if their interiors overlap (share a region of positive area), and False if they are disjoint or only touch along an edge or at a corner.", "signature": "def rectangles_overlap(r1, r2):", "visible_tests": ["assert rectangles_overlap((0, 0, 2, 2), (1, 1, 3, 3)) == True", "assert rectangles_overlap((0, 0, 1, 1), (5, 5, 6, 6)) == False", "assert rectangles_overlap((0, 0, 4, 4), (1, 1, 2, 2)) == True"], "hidden_tests": ["assert rectangles_overlap((0, 0, 1, 1), (1, 0, 2, 1)) == False", "assert rectangles_overlap((0, 0, 1, 1), (1, 1, 2, 2)) == False", "assert rectangles_overlap((0, 0, 2, 2), (2, 0, 4, 2)) == False", "assert rectangles_overlap((-2, -2, 2, 2), (-1, -1, 1, 1)) == True", "assert rectangles_overlap((0, 0, 5, 5), (0, 0, 5, 5)) == True", "assert rectangles_overlap((0, 0, 3, 3), (3, 3, 6, 6)) == False", "assert rectangles_overlap((-5, -5, -1, -1), (0, 0, 5, 5)) == False", "assert rectangles_overlap((0, 0, 10, 1), (0, 0, 1, 10)) == True", "assert rectangles_overlap((0, 0, 1, 5), (2, 0, 3, 5)) == False", "assert rectangles_overlap((1, 1, 4, 4), (2, 2, 3, 3)) == True", "assert rectangles_overlap((0, 0, 2, 2), (-2, -2, 0, 0)) == False", "assert rectangles_overlap((0, 0, 4, 1), (1, -1, 3, 0)) == False", "assert rectangles_overlap((-1, -1, 1, 1), (-1, -1, 1, 1)) == True", "assert rectangles_overlap((0, 0, 100, 100), (50, 50, 60, 60)) == True", "assert rectangles_overlap((0, 0, 1, 1), (0.5, 0.5, 1.5, 1.5)) == True"], "reference": "def rectangles_overlap(r1, r2):\n    ax1, ay1, ax2, ay2 = r1\n    bx1, by1, bx2, by2 = r2\n    return ax1 < bx2 and bx1 < ax2 and ay1 < by2 and by1 < ay2"}
{"tid": "geo-005", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes two axis-aligned rectangles r1 and r2, each given as a tuple (x1, y1, x2, y2) with x1 <= x2 and y1 <= y2, and returns the area of their intersection. If the rectangles do not overlap (including if they only touch along an edge or a point), return 0.", "signature": "def rectangle_intersection_area(r1, r2):", "visible_tests": ["assert rectangle_intersection_area((0, 0, 2, 2), (1, 1, 3, 3)) == 1", "assert rectangle_intersection_area((0, 0, 1, 1), (5, 5, 6, 6)) == 0", "assert rectangle_intersection_area((0, 0, 4, 4), (1, 1, 2, 2)) == 1"], "hidden_tests": ["assert rectangle_intersection_area((0, 0, 1, 1), (1, 0, 2, 1)) == 0", "assert rectangle_intersection_area((0, 0, 5, 5), (0, 0, 5, 5)) == 25", "assert rectangle_intersection_area((-2, -2, 2, 2), (-1, -1, 1, 1)) == 4", "assert rectangle_intersection_area((0, 0, 3, 3), (3, 3, 6, 6)) == 0", "assert rectangle_intersection_area((0, 0, 10, 10), (5, 5, 15, 15)) == 25", "assert rectangle_intersection_area((0, 0, 4, 2), (2, 0, 6, 2)) == 4", "assert rectangle_intersection_area((-5, -5, -1, -1), (0, 0, 5, 5)) == 0", "assert rectangle_intersection_area((0, 0, 6, 6), (2, 2, 4, 4)) == 4", "assert rectangle_intersection_area((1, 1, 4, 4), (0, 0, 5, 5)) == 9", "assert rectangle_intersection_area((0, 0, 2, 8), (1, 3, 3, 5)) == 2", "assert rectangle_intersection_area((0, 0, 1, 1), (0.5, 0.5, 1.5, 1.5)) == 0.25", "assert rectangle_intersection_area((0, 0, 100, 1), (0, 0, 1, 100)) == 1", "assert rectangle_intersection_area((-1, -1, 0, 0), (0, 0, 1, 1)) == 0", "assert rectangle_intersection_area((0, 0, 3, 4), (1, 1, 2, 2)) == 1", "assert rectangle_intersection_area((0, 0, 2, 2), (2, 2, 4, 4)) == 0"], "reference": "def rectangle_intersection_area(r1, r2):\n    ax1, ay1, ax2, ay2 = r1\n    bx1, by1, bx2, by2 = r2\n    w = min(ax2, bx2) - max(ax1, bx1)\n    h = min(ay2, by2) - max(ay1, by1)\n    if w <= 0 or h <= 0:\n        return 0\n    return w * h"}
{"tid": "geo-006", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a point p as a tuple (x, y) and an axis-aligned rectangle rect as a tuple (x1, y1, x2, y2) with x1 <= x2 and y1 <= y2, and returns True if the point lies inside the rectangle or exactly on its boundary, and False otherwise.", "signature": "def point_in_rectangle(p, rect):", "visible_tests": ["assert point_in_rectangle((1, 1), (0, 0, 2, 2)) == True", "assert point_in_rectangle((5, 5), (0, 0, 2, 2)) == False", "assert point_in_rectangle((0, 0), (0, 0, 2, 2)) == True"], "hidden_tests": ["assert point_in_rectangle((2, 2), (0, 0, 2, 2)) == True", "assert point_in_rectangle((2, 1), (0, 0, 2, 2)) == True", "assert point_in_rectangle((0, 1), (0, 0, 2, 2)) == True", "assert point_in_rectangle((-0.1, 1), (0, 0, 2, 2)) == False", "assert point_in_rectangle((1, 2.1), (0, 0, 2, 2)) == False", "assert point_in_rectangle((-1, -1), (-2, -2, -1, -1)) == True", "assert point_in_rectangle((0, 0), (-5, -5, 5, 5)) == True", "assert point_in_rectangle((5, 5), (-5, -5, 5, 5)) == True", "assert point_in_rectangle((5.0001, 5), (-5, -5, 5, 5)) == False", "assert point_in_rectangle((1.5, 1.5), (1, 1, 2, 2)) == True", "assert point_in_rectangle((0.999, 1), (1, 0, 2, 5)) == False", "assert point_in_rectangle((3, 3), (3, 3, 3, 3)) == True", "assert point_in_rectangle((3, 4), (3, 3, 3, 3)) == False", "assert point_in_rectangle((-3, 2), (-4, 0, -2, 4)) == True", "assert point_in_rectangle((-3, -0.001), (-4, 0, -2, 4)) == False"], "reference": "def point_in_rectangle(p, rect):\n    x, y = p\n    x1, y1, x2, y2 = rect\n    return x1 <= x <= x2 and y1 <= y <= y2"}
{"tid": "geo-007", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a point p and the three vertices a, b, c of a (non-degenerate) triangle, each given as a tuple (x, y) of numbers, and returns True if p lies inside the triangle or exactly on one of its edges, and False otherwise.", "signature": "def point_in_triangle(p, a, b, c):", "visible_tests": ["assert point_in_triangle((1, 1), (0, 0), (4, 0), (0, 4)) == True", "assert point_in_triangle((10, 10), (0, 0), (4, 0), (0, 4)) == False", "assert point_in_triangle((0, 0), (0, 0), (4, 0), (0, 4)) == True"], "hidden_tests": ["assert point_in_triangle((2, 0), (0, 0), (4, 0), (0, 4)) == True", "assert point_in_triangle((2, 2), (0, 0), (4, 0), (0, 4)) == True", "assert point_in_triangle((2, 2.001), (0, 0), (4, 0), (0, 4)) == False", "assert point_in_triangle((-1, -1), (0, 0), (4, 0), (0, 4)) == False", "assert point_in_triangle((4, 0), (0, 0), (4, 0), (0, 4)) == True", "assert point_in_triangle((0, 4), (0, 0), (4, 0), (0, 4)) == True", "assert point_in_triangle((1, 0.5), (0, 0), (4, 0), (0, 4)) == True", "assert point_in_triangle((0, 0), (-2, -2), (2, -2), (0, 2)) == True", "assert point_in_triangle((0, -3), (-2, -2), (2, -2), (0, 2)) == False", "assert point_in_triangle((5, 5), (5, 5), (10, 5), (5, 10)) == True", "assert point_in_triangle((7.5, 7.5), (5, 5), (10, 5), (5, 10)) == True", "assert point_in_triangle((3, 3), (0, 0), (10, 0), (0, 10)) == True", "assert point_in_triangle((6, 6), (0, 0), (10, 0), (0, 10)) == False", "assert point_in_triangle((-2, 2), (-3, 0), (3, 0), (0, 3)) == False", "assert point_in_triangle((0, 1), (-3, 0), (3, 0), (0, 3)) == True"], "reference": "def point_in_triangle(p, a, b, c):\n    def cross(o, u, v):\n        return (u[0] - o[0]) * (v[1] - o[1]) - (u[1] - o[1]) * (v[0] - o[0])\n    d1 = cross(p, a, b)\n    d2 = cross(p, b, c)\n    d3 = cross(p, c, a)\n    has_neg = (d1 < 0) or (d2 < 0) or (d3 < 0)\n    has_pos = (d1 > 0) or (d2 > 0) or (d3 > 0)\n    return not (has_neg and has_pos)"}
{"tid": "geo-008", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes three points p1, p2, p3, each given as a tuple (x, y) of numbers, and returns True if all three points lie on a single straight line, and False otherwise.", "signature": "def are_collinear(p1, p2, p3):", "visible_tests": ["assert are_collinear((0, 0), (1, 1), (2, 2)) == True", "assert are_collinear((0, 0), (1, 0), (0, 1)) == False", "assert are_collinear((1, 1), (1, 1), (1, 1)) == True"], "hidden_tests": ["assert are_collinear((0, 0), (2, 0), (5, 0)) == True", "assert are_collinear((0, 0), (0, 2), (0, 5)) == True", "assert are_collinear((-1, -1), (0, 0), (1, 1)) == True", "assert are_collinear((-2, 4), (0, 0), (2, -4)) == True", "assert are_collinear((0, 0), (1, 2), (2, 5)) == False", "assert are_collinear((1, 2), (3, 4), (5, 7)) == False", "assert are_collinear((3, 3), (3, 3), (4, 5)) == True", "assert are_collinear((0, 0), (5, 5), (5, 0)) == False", "assert are_collinear((-3, -3), (-1, -1), (2, 2)) == True", "assert are_collinear((10, 20), (20, 40), (30, 60)) == True", "assert are_collinear((10, 20), (20, 40), (30, 61)) == False", "assert are_collinear((0, 5), (0, -5), (0, 100)) == True", "assert are_collinear((1, 1), (2, 2), (3, 4)) == False", "assert are_collinear((-5, 2), (0, 2), (5, 2)) == True", "assert are_collinear((2, 3), (4, 6), (6, 10)) == False"], "reference": "def are_collinear(p1, p2, p3):\n    cross = (p2[0] - p1[0]) * (p3[1] - p1[1]) - (p2[1] - p1[1]) * (p3[0] - p1[0])\n    return abs(cross) < 1e-9"}
{"tid": "geo-009", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes the three vertices a, b, c of a triangle, each given as a tuple (x, y) of numbers, and returns the area of the triangle as a float, using the shoelace formula. If the three points are collinear, the area is 0.", "signature": "def triangle_area(a, b, c):", "visible_tests": ["assert abs(triangle_area((0, 0), (4, 0), (0, 3)) - 6.0) < 1e-9", "assert abs(triangle_area((0, 0), (1, 0), (0, 1)) - 0.5) < 1e-9", "assert abs(triangle_area((0, 0), (2, 0), (4, 0)) - 0.0) < 1e-9"], "hidden_tests": ["assert abs(triangle_area((0, 0), (10, 0), (0, 10)) - 50.0) < 1e-9", "assert abs(triangle_area((1, 1), (4, 1), (4, 5)) - 6.0) < 1e-9", "assert abs(triangle_area((-2, -2), (2, -2), (0, 2)) - 8.0) < 1e-9", "assert abs(triangle_area((0, 0), (0, 5), (5, 0)) - 12.5) < 1e-9", "assert abs(triangle_area((3, 3), (3, 3), (5, 5)) - 0.0) < 1e-9", "assert abs(triangle_area((-1, -1), (-1, 3), (2, -1)) - 6.0) < 1e-9", "assert abs(triangle_area((0, 0), (6, 0), (3, 6)) - 18.0) < 1e-9", "assert abs(triangle_area((2, 3), (5, 3), (5, 7)) - 6.0) < 1e-9", "assert abs(triangle_area((0, 0), (100, 0), (0, 1)) - 50.0) < 1e-9", "assert abs(triangle_area((1, 2), (3, 4), (5, 6)) - 0.0) < 1e-9", "assert abs(triangle_area((-3, 0), (0, 4), (3, 0)) - 12.0) < 1e-9", "assert abs(triangle_area((0.0, 0.0), (4.0, 0.0), (0.0, 2.0)) - 4.0) < 1e-9", "assert abs(triangle_area((0, 0), (0, 8), (0, -3)) - 0.0) < 1e-9", "assert abs(triangle_area((-4, -4), (4, -4), (0, 4)) - 32.0) < 1e-9", "assert abs(triangle_area((1, 1), (1, 5), (5, 1)) - 8.0) < 1e-9"], "reference": "def triangle_area(a, b, c):\n    return abs((b[0] - a[0]) * (c[1] - a[1]) - (c[0] - a[0]) * (b[1] - a[1])) / 2"}
{"tid": "geo-010", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes the three vertices of a (non-degenerate) triangle, each given as a tuple (x, y) of numbers, and returns a string classifying it by side lengths: 'equilateral' if all three sides are equal, 'isosceles' if exactly two sides are equal, or 'scalene' if all sides have different lengths.", "signature": "def classify_triangle_by_sides(p1, p2, p3):", "visible_tests": ["assert classify_triangle_by_sides((0, 0), (2, 0), (1, 1)) == 'isosceles'", "assert classify_triangle_by_sides((0, 0), (4, 0), (2, 5)) == 'isosceles'", "assert classify_triangle_by_sides((0, 0), (4, 0), (1, 3)) == 'scalene'"], "hidden_tests": ["assert classify_triangle_by_sides((0, 0), (4, 0), (2, 2 * 3 ** 0.5)) == 'equilateral'", "assert classify_triangle_by_sides((0, 0), (2, 0), (0, 2)) == 'isosceles'", "assert classify_triangle_by_sides((0, 0), (3, 0), (0, 4)) == 'scalene'", "assert classify_triangle_by_sides((0, 0), (5, 0), (0, 5)) == 'isosceles'", "assert classify_triangle_by_sides((0, 0), (6, 0), (3, 3)) == 'isosceles'", "assert classify_triangle_by_sides((0, 0), (10, 0), (3, 4)) == 'scalene'", "assert classify_triangle_by_sides((-2, 0), (2, 0), (0, 5)) == 'isosceles'", "assert classify_triangle_by_sides((0, 0), (1, 0), (0, 2)) == 'scalene'", "assert classify_triangle_by_sides((0, 0), (8, 0), (4, 4)) == 'isosceles'", "assert classify_triangle_by_sides((0, 0), (7, 0), (2, 3)) == 'scalene'", "assert classify_triangle_by_sides((1, 1), (1, 1), (1, 1)) == 'equilateral'", "assert classify_triangle_by_sides((0, 0), (2, 0), (1, -1)) == 'isosceles'", "assert classify_triangle_by_sides((-3, -3), (3, -3), (0, 3 * 3 ** 0.5 - 3)) == 'equilateral'", "assert classify_triangle_by_sides((0, 0), (5, 0), (2, 6)) == 'scalene'", "assert classify_triangle_by_sides((0, 0), (2, 0), (0, 3)) == 'scalene'"], "reference": "def classify_triangle_by_sides(p1, p2, p3):\n    def sq(a, b):\n        return (a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2\n    s1, s2, s3 = sq(p1, p2), sq(p2, p3), sq(p3, p1)\n    def close(x, y):\n        return abs(x - y) < 1e-9\n    if close(s1, s2) and close(s2, s3):\n        return 'equilateral'\n    if close(s1, s2) or close(s2, s3) or close(s1, s3):\n        return 'isosceles'\n    return 'scalene'"}
{"tid": "geo-011", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a list of points representing the vertices of a closed polygon in order (each a tuple (x, y) of numbers, with at least 3 points), and returns its perimeter as a float: the sum of the Euclidean distances between consecutive vertices, including the edge that closes the polygon from the last vertex back to the first.", "signature": "def polygon_perimeter(points):", "visible_tests": ["assert abs(polygon_perimeter([(0, 0), (4, 0), (4, 3)]) - 12.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (2, 0), (2, 2), (0, 2)]) - 8.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (1, 0), (0, 1)]) - (2 + 2 ** 0.5)) < 1e-9"], "hidden_tests": ["assert abs(polygon_perimeter([(0, 0), (3, 0), (3, 4)]) - 12.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (5, 0), (5, 5), (0, 5)]) - 20.0) < 1e-9", "assert abs(polygon_perimeter([(-1, -1), (1, -1), (1, 1), (-1, 1)]) - 8.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (10, 0), (10, 1), (0, 1)]) - 22.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (6, 0), (3, 4)]) - 16.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (0, 3), (4, 3), (4, 0)]) - 14.0) < 1e-9", "assert abs(polygon_perimeter([(2, 2), (2, 2), (2, 2)]) - 0.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (2, 0), (2, 1), (0, 1)]) - 6.0) < 1e-9", "assert abs(polygon_perimeter([(-2, 0), (0, 2), (2, 0), (0, -2)]) - (4 * (2 ** 0.5) * 2)) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (100, 0), (100, 100), (0, 100)]) - 400.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (1, 1), (2, 0)]) - (2 * 2 ** 0.5 + 2)) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (4, 0), (4, 4), (0, 4), (0, 0)]) - 16.0) < 1e-9", "assert abs(polygon_perimeter([(1, 1), (1, 1), (5, 1), (5, 4)]) - 12.0) < 1e-9", "assert abs(polygon_perimeter([(0, 0), (3, 0), (3, 3), (0, 3), (0, 0), (0, 0)]) - 12.0) < 1e-9", "assert abs(polygon_perimeter([(-3, 0), (0, 4), (3, 0)]) - 16.0) < 1e-9"], "reference": "def polygon_perimeter(points):\n    n = len(points)\n    total = 0.0\n    for i in range(n):\n        x1, y1 = points[i]\n        x2, y2 = points[(i + 1) % n]\n        total += ((x2 - x1) ** 2 + (y2 - y1) ** 2) ** 0.5\n    return total"}
{"tid": "geo-012", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a list of at least two points, each a tuple (x, y) of numbers, and returns the smallest Euclidean distance between any two distinct points in the list (points may repeat positions, and duplicate points give a distance of 0).", "signature": "def closest_pair_distance(points):", "visible_tests": ["assert abs(closest_pair_distance([(0, 0), (3, 4), (1, 1)]) - 2 ** 0.5) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (0, 0)]) - 0.0) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (10, 10), (1, 0)]) - 1.0) < 1e-9"], "hidden_tests": ["assert abs(closest_pair_distance([(0, 0), (5, 5)]) - (5 * 2 ** 0.5)) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (1, 0), (2, 0), (100, 100)]) - 1.0) < 1e-9", "assert abs(closest_pair_distance([(-1, -1), (-1, -1), (5, 5)]) - 0.0) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (3, 0), (0, 4), (3, 4)]) - 3.0) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (1, 1), (2, 2), (10, 10)]) - 2 ** 0.5) < 1e-9", "assert abs(closest_pair_distance([(-5, 0), (5, 0), (0, 0)]) - 5.0) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (0, 100), (0, 50), (0, 51)]) - 1.0) < 1e-9", "assert abs(closest_pair_distance([(1, 1), (2, 2)]) - 2 ** 0.5) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (2, 0), (4, 0), (6, 0), (6.5, 0)]) - 0.5) < 1e-9", "assert abs(closest_pair_distance([(-3, -3), (-2, -2), (10, 10), (-2.5, -2.5)]) - (0.5 * 2 ** 0.5)) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (7, 0)]) - 7.0) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (1, 0), (0, 1), (1, 1), (0.5, 0.5)]) - (0.5 * 2 ** 0.5)) < 1e-9", "assert abs(closest_pair_distance([(-1, -1), (-1, -1)]) - 0.0) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (3, 4), (6, 8), (9, 12)]) - 5.0) < 1e-9", "assert abs(closest_pair_distance([(0, 0), (20, 0), (10, 0.1), (10, -0.1)]) - 0.2) < 1e-9"], "reference": "def closest_pair_distance(points):\n    n = len(points)\n    best = None\n    for i in range(n):\n        for j in range(i + 1, n):\n            d = ((points[i][0] - points[j][0]) ** 2 + (points[i][1] - points[j][1]) ** 2) ** 0.5\n            if best is None or d < best:\n                best = d\n    return best"}
{"tid": "geo-013", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes two points p1 and p2, each a tuple (x, y) of numbers, and returns their midpoint as a tuple (mx, my), where mx and my are the averages of the corresponding coordinates.", "signature": "def midpoint(p1, p2):", "visible_tests": ["assert midpoint((0, 0), (4, 4)) == (2.0, 2.0)", "assert midpoint((1, 1), (1, 1)) == (1.0, 1.0)", "assert midpoint((0, 0), (2, 6)) == (1.0, 3.0)"], "hidden_tests": ["assert midpoint((-4, -4), (4, 4)) == (0.0, 0.0)", "assert midpoint((0, 0), (1, 1)) == (0.5, 0.5)", "assert midpoint((-2, 3), (2, -3)) == (0.0, 0.0)", "assert midpoint((10, 20), (30, 40)) == (20.0, 30.0)", "assert midpoint((-1, -1), (-3, -3)) == (-2.0, -2.0)", "assert midpoint((0, 0), (0, 0)) == (0.0, 0.0)", "assert midpoint((5, 5), (7, 9)) == (6.0, 7.0)", "assert midpoint((-5, 5), (5, -5)) == (0.0, 0.0)", "assert midpoint((1, 0), (0, 1)) == (0.5, 0.5)", "assert midpoint((100, 200), (0, 0)) == (50.0, 100.0)", "assert midpoint((-3, 7), (9, -1)) == (3.0, 3.0)", "assert midpoint((2, 2), (4, 8)) == (3.0, 5.0)", "assert midpoint((-7, 3), (1, -9)) == (-3.0, -3.0)", "assert midpoint((0, -6), (0, 6)) == (0.0, 0.0)", "assert midpoint((1000, -1000), (-1000, 1000)) == (0.0, 0.0)"], "reference": "def midpoint(p1, p2):\n    return ((p1[0] + p2[0]) / 2, (p1[1] + p2[1]) / 2)"}
{"tid": "geo-014", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a point p as a tuple (x, y) of numbers and returns its reflection across the x-axis, i.e. the tuple (x, -y).", "signature": "def reflect_point_over_x_axis(p):", "visible_tests": ["assert reflect_point_over_x_axis((2, 3)) == (2, -3)", "assert reflect_point_over_x_axis((0, 0)) == (0, 0)", "assert reflect_point_over_x_axis((-1, 5)) == (-1, -5)"], "hidden_tests": ["assert reflect_point_over_x_axis((4, 0)) == (4, 0)", "assert reflect_point_over_x_axis((0, 7)) == (0, -7)", "assert reflect_point_over_x_axis((-3, -3)) == (-3, 3)", "assert reflect_point_over_x_axis((5, -5)) == (5, 5)", "assert reflect_point_over_x_axis((100, 100)) == (100, -100)", "assert reflect_point_over_x_axis((-100, -100)) == (-100, 100)", "assert reflect_point_over_x_axis((1.5, 2.5)) == (1.5, -2.5)", "assert reflect_point_over_x_axis((-1.5, -2.5)) == (-1.5, 2.5)", "assert reflect_point_over_x_axis((0, 0.001)) == (0, -0.001)", "assert reflect_point_over_x_axis((7, 3)) == (7, -3)", "assert reflect_point_over_x_axis((-8, 2)) == (-8, -2)", "assert reflect_point_over_x_axis((9, -9)) == (9, 9)", "assert reflect_point_over_x_axis((0, -0.5)) == (0, 0.5)", "assert reflect_point_over_x_axis((-6, 6)) == (-6, -6)", "assert reflect_point_over_x_axis((50, 25)) == (50, -25)"], "reference": "def reflect_point_over_x_axis(p):\n    return (p[0], -p[1])"}
{"tid": "geo-015", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a point p as a tuple (x, y) of numbers and returns its reflection across the y-axis, i.e. the tuple (-x, y).", "signature": "def reflect_point_over_y_axis(p):", "visible_tests": ["assert reflect_point_over_y_axis((2, 3)) == (-2, 3)", "assert reflect_point_over_y_axis((0, 0)) == (0, 0)", "assert reflect_point_over_y_axis((-1, 5)) == (1, 5)"], "hidden_tests": ["assert reflect_point_over_y_axis((0, 7)) == (0, 7)", "assert reflect_point_over_y_axis((4, 0)) == (-4, 0)", "assert reflect_point_over_y_axis((-3, -3)) == (3, -3)", "assert reflect_point_over_y_axis((5, -5)) == (-5, -5)", "assert reflect_point_over_y_axis((100, 100)) == (-100, 100)", "assert reflect_point_over_y_axis((-100, -100)) == (100, -100)", "assert reflect_point_over_y_axis((1.5, 2.5)) == (-1.5, 2.5)", "assert reflect_point_over_y_axis((-1.5, -2.5)) == (1.5, -2.5)", "assert reflect_point_over_y_axis((0.001, 0)) == (-0.001, 0)", "assert reflect_point_over_y_axis((7, 3)) == (-7, 3)", "assert reflect_point_over_y_axis((-8, 2)) == (8, 2)", "assert reflect_point_over_y_axis((9, -9)) == (-9, -9)", "assert reflect_point_over_y_axis((-0.5, 0)) == (0.5, 0)", "assert reflect_point_over_y_axis((6, -6)) == (-6, -6)", "assert reflect_point_over_y_axis((25, 50)) == (-25, 50)"], "reference": "def reflect_point_over_y_axis(p):\n    return (-p[0], p[1])"}
{"tid": "geo-016", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a point p and a center point, each a tuple (x, y) of numbers, and returns the point reflection of p through center: the point on the opposite side of center at the same distance, computed as (2*cx - px, 2*cy - py).", "signature": "def reflect_point_through_center(p, center):", "visible_tests": ["assert reflect_point_through_center((1, 1), (0, 0)) == (-1, -1)", "assert reflect_point_through_center((3, 4), (0, 0)) == (-3, -4)", "assert reflect_point_through_center((2, 2), (2, 2)) == (2, 2)"], "hidden_tests": ["assert reflect_point_through_center((0, 0), (1, 1)) == (2, 2)", "assert reflect_point_through_center((5, 5), (1, 1)) == (-3, -3)", "assert reflect_point_through_center((-1, -1), (0, 0)) == (1, 1)", "assert reflect_point_through_center((4, 0), (2, 0)) == (0, 0)", "assert reflect_point_through_center((0, 4), (0, 2)) == (0, 0)", "assert reflect_point_through_center((-3, 7), (2, 2)) == (7, -3)", "assert reflect_point_through_center((10, 10), (0, 0)) == (-10, -10)", "assert reflect_point_through_center((1, 2), (3, 4)) == (5, 6)", "assert reflect_point_through_center((-5, -5), (-5, -5)) == (-5, -5)", "assert reflect_point_through_center((2, 3), (0, 0)) == (-2, -3)", "assert reflect_point_through_center((6, -2), (1, 1)) == (-4, 4)", "assert reflect_point_through_center((0, 0), (0, 0)) == (0, 0)", "assert reflect_point_through_center((-8, -8), (-4, -4)) == (0, 0)", "assert reflect_point_through_center((3, -3), (-3, 3)) == (-9, 9)", "assert reflect_point_through_center((7, 7), (7, 0)) == (7, -7)"], "reference": "def reflect_point_through_center(p, center):\n    return (2 * center[0] - p[0], 2 * center[1] - p[1])"}
{"tid": "geo-017", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a point p and the two endpoints a and b of a line segment, each a tuple (x, y) of numbers, and returns True if p lies exactly on the segment from a to b (including the endpoints), and False otherwise.", "signature": "def is_point_on_segment(p, a, b):", "visible_tests": ["assert is_point_on_segment((1, 1), (0, 0), (2, 2)) == True", "assert is_point_on_segment((5, 5), (0, 0), (2, 2)) == False", "assert is_point_on_segment((0, 0), (0, 0), (2, 2)) == True"], "hidden_tests": ["assert is_point_on_segment((2, 2), (0, 0), (2, 2)) == True", "assert is_point_on_segment((3, 3), (0, 0), (2, 2)) == False", "assert is_point_on_segment((1, 0), (0, 0), (2, 0)) == True", "assert is_point_on_segment((1, 0.001), (0, 0), (2, 0)) == False", "assert is_point_on_segment((0, 1), (0, 0), (0, 5)) == True", "assert is_point_on_segment((0, -1), (0, 0), (0, 5)) == False", "assert is_point_on_segment((-1, -1), (-2, -2), (2, 2)) == True", "assert is_point_on_segment((1, 1), (2, 2), (0, 0)) == True", "assert is_point_on_segment((4, 4), (0, 0), (2, 2)) == False", "assert is_point_on_segment((5, 5), (5, 5), (5, 5)) == True", "assert is_point_on_segment((6, 6), (5, 5), (5, 5)) == False", "assert is_point_on_segment((1.5, 1.5), (0, 0), (3, 3)) == True", "assert is_point_on_segment((2, 3), (0, 0), (4, 4)) == False", "assert is_point_on_segment((-2, 0), (-5, 0), (5, 0)) == True", "assert is_point_on_segment((0, -2), (-5, 0), (5, 0)) == False"], "reference": "def is_point_on_segment(p, a, b):\n    cross = (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0])\n    if abs(cross) > 1e-9:\n        return False\n    return (min(a[0], b[0]) - 1e-9 <= p[0] <= max(a[0], b[0]) + 1e-9 and\n            min(a[1], b[1]) - 1e-9 <= p[1] <= max(a[1], b[1]) + 1e-9)"}
{"tid": "geo-018", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes two axis-aligned rectangles, outer and inner, each given as a tuple (x1, y1, x2, y2) with x1 <= x2 and y1 <= y2, and returns True if inner lies entirely within outer (boundaries may touch), and False otherwise.", "signature": "def rectangle_contains(outer, inner):", "visible_tests": ["assert rectangle_contains((0, 0, 10, 10), (2, 2, 5, 5)) == True", "assert rectangle_contains((0, 0, 5, 5), (3, 3, 10, 10)) == False", "assert rectangle_contains((0, 0, 10, 10), (0, 0, 10, 10)) == True"], "hidden_tests": ["assert rectangle_contains((0, 0, 10, 10), (-1, 2, 5, 5)) == False", "assert rectangle_contains((0, 0, 10, 10), (2, 2, 5, 11)) == False", "assert rectangle_contains((-5, -5, 5, 5), (-5, -5, 5, 5)) == True", "assert rectangle_contains((-5, -5, 5, 5), (-4, -4, 4, 4)) == True", "assert rectangle_contains((0, 0, 1, 1), (0, 0, 1, 1)) == True", "assert rectangle_contains((0, 0, 1, 1), (0.5, 0.5, 1.5, 1.5)) == False", "assert rectangle_contains((0, 0, 100, 100), (50, 50, 60, 60)) == True", "assert rectangle_contains((2, 2, 8, 8), (0, 0, 10, 10)) == False", "assert rectangle_contains((0, 0, 5, 5), (0, 0, 5, 4)) == True", "assert rectangle_contains((0, 0, 5, 5), (0, -1, 5, 5)) == False", "assert rectangle_contains((3, 3, 3, 3), (3, 3, 3, 3)) == True", "assert rectangle_contains((-10, -10, 0, 0), (-8, -8, -2, -2)) == True", "assert rectangle_contains((-10, -10, 0, 0), (-8, -8, 1, -2)) == False", "assert rectangle_contains((0, 0, 2, 2), (0, 0, 2, 2.0001)) == False", "assert rectangle_contains((1, 1, 9, 9), (1, 1, 9, 9)) == True"], "reference": "def rectangle_contains(outer, inner):\n    ox1, oy1, ox2, oy2 = outer\n    ix1, iy1, ix2, iy2 = inner\n    return ox1 <= ix1 and oy1 <= iy1 and ix2 <= ox2 and iy2 <= oy2"}
{"tid": "geo-019", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a list of at least 3 points representing the vertices of a simple polygon in order (either clockwise or counter-clockwise), each a tuple (x, y) of numbers, and returns True if the polygon is convex, and False otherwise. A polygon where all vertices are collinear is not considered convex.", "signature": "def is_convex_polygon(points):", "visible_tests": ["assert is_convex_polygon([(0, 0), (2, 0), (2, 2), (0, 2)]) == True", "assert is_convex_polygon([(0, 0), (2, 0), (1, 1), (2, 2), (0, 2)]) == False", "assert is_convex_polygon([(0, 0), (1, 0), (0, 1)]) == True"], "hidden_tests": ["assert is_convex_polygon([(0, 0), (4, 0), (4, 4), (0, 4)]) == True", "assert is_convex_polygon([(0, 0), (4, 0), (2, 1), (4, 4), (0, 4)]) == False", "assert is_convex_polygon([(0, 0), (2, 0), (4, 0)]) == False", "assert is_convex_polygon([(0, 0), (5, 0), (5, 5), (0, 5)]) == True", "assert is_convex_polygon([(0, 0), (2, 2), (4, 0), (2, -2)]) == True", "assert is_convex_polygon([(0, 0), (1, 3), (2, 0), (1, 1)]) == False", "assert is_convex_polygon([(-1, 0), (0, 1), (1, 0), (0, -1)]) == True", "assert is_convex_polygon([(0, 0), (3, 0), (3, 3), (1, 1), (0, 3)]) == False", "assert is_convex_polygon([(0, 0), (4, 0), (4, 4), (2, 2), (0, 4)]) == False", "assert is_convex_polygon([(0, 0), (2, 0), (2, 2)]) == True", "assert is_convex_polygon([(0, 0), (0, 4), (4, 4), (4, 0)]) == True", "assert is_convex_polygon([(0, 0), (10, 0), (10, 10), (5, 5), (0, 10)]) == False", "assert is_convex_polygon([(0, 0), (3, 0), (3, 2), (0, 2)]) == True", "assert is_convex_polygon([(0, 0), (3, 0), (1, 1), (3, 2), (0, 2)]) == False", "assert is_convex_polygon([(1, 0), (0, 1), (-1, 0), (0, -1)]) == True"], "reference": "def is_convex_polygon(points):\n    n = len(points)\n    if n < 3:\n        return False\n    signs = []\n    for i in range(n):\n        a = points[i]\n        b = points[(i + 1) % n]\n        c = points[(i + 2) % n]\n        cross = (b[0] - a[0]) * (c[1] - b[1]) - (b[1] - a[1]) * (c[0] - b[0])\n        if abs(cross) > 1e-9:\n            signs.append(cross > 0)\n    if not signs:\n        return False\n    return all(s == signs[0] for s in signs)"}
{"tid": "geo-020", "family": "geometry and coordinates (distances, rectangle overlap, point in polygon for rectangles/triangles)", "spec": "Write a function that takes a list of points representing the vertices of a closed simple polygon in order (each a tuple (x, y) of numbers, with at least 3 points), and returns its area as a non-negative float, computed with the shoelace formula (the vertex order may be clockwise or counter-clockwise).", "signature": "def polygon_area_shoelace(points):", "visible_tests": ["assert abs(polygon_area_shoelace([(0, 0), (4, 0), (4, 4), (0, 4)]) - 16.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (2, 0), (0, 2)]) - 2.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (0, 4), (4, 4), (4, 0)]) - 16.0) < 1e-9"], "hidden_tests": ["assert abs(polygon_area_shoelace([(0, 0), (5, 0), (5, 5), (0, 5)]) - 25.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (6, 0), (3, 6)]) - 18.0) < 1e-9", "assert abs(polygon_area_shoelace([(-2, -2), (2, -2), (2, 2), (-2, 2)]) - 16.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (4, 0), (4, 2), (0, 2)]) - 8.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (10, 0), (10, 1), (0, 1)]) - 10.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (2, 0), (2, 2), (1, 3), (0, 2)]) - 5.0) < 1e-9", "assert abs(polygon_area_shoelace([(1, 1), (4, 1), (4, 5), (1, 5)]) - 12.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (0, 3), (3, 3), (3, 0)]) - 9.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (100, 0), (100, 100), (0, 100)]) - 10000.0) < 1e-9", "assert abs(polygon_area_shoelace([(-1, 0), (0, 1), (1, 0), (0, -1)]) - 2.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (3, 0), (3, 3)]) - 4.5) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (1, 0), (1, 1), (0, 1)]) - 1.0) < 1e-9", "assert abs(polygon_area_shoelace([(2, 1), (2, 5), (6, 5), (6, 1)]) - 16.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (4, 0), (4, 4), (2, 6), (0, 4)]) - 20.0) < 1e-9", "assert abs(polygon_area_shoelace([(0, 0), (0, 6), (6, 6), (6, 0)]) - 36.0) < 1e-9"], "reference": "def polygon_area_shoelace(points):\n    n = len(points)\n    s = 0.0\n    for i in range(n):\n        x1, y1 = points[i]\n        x2, y2 = points[(i + 1) % n]\n        s += x1 * y2 - x2 * y1\n    return abs(s) / 2"}
