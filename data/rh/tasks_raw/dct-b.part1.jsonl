{"tid": "dct-111", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Flatten a nested dict into a single-level dict by joining the path of keys with the given separator string. A value that is itself a non-empty dict is recursed into; a value that is an empty dict, or any non-dict value, is kept as a leaf under its joined key path. An empty input dict returns an empty dict.", "signature": "def flatten_dict_custom_sep(d, sep):", "visible_tests": ["assert flatten_dict_custom_sep({'a': 1, 'b': {'c': 2}}, '.') == {'a': 1, 'b.c': 2}", "assert flatten_dict_custom_sep({'x': {'y': 1, 'z': 2}}, '.') == {'x.y': 1, 'x.z': 2}", "assert flatten_dict_custom_sep({}, '.') == {}"], "hidden_tests": ["assert flatten_dict_custom_sep({'a': {'b': {'c': 1}}}, '.') == {'a.b.c': 1}", "assert flatten_dict_custom_sep({'a': 1, 'b': 2}, '.') == {'a': 1, 'b': 2}", "assert flatten_dict_custom_sep({'a': {}}, '.') == {'a': {}}", "assert flatten_dict_custom_sep({'a': {'b': 1}, 'c': {'d': {'e': 2}}}, '.') == {'a.b': 1, 'c.d.e': 2}", "assert flatten_dict_custom_sep({'k': {'m': {'n': {'o': 5}}}}, '.') == {'k.m.n.o': 5}", "assert flatten_dict_custom_sep({'a': {'b': 1}}, '/') == {'a/b': 1}", "assert flatten_dict_custom_sep({'a': {'b': {'c': 2}}}, '_') == {'a_b_c': 2}", "assert flatten_dict_custom_sep({'a': 1, 'b': {'c': 2, 'd': 3}, 'e': {'f': {'g': 4}}}, '.') == {'a': 1, 'b.c': 2, 'b.d': 3, 'e.f.g': 4}", "assert flatten_dict_custom_sep({'only': {'one': 1}}, '-') == {'only-one': 1}", "assert flatten_dict_custom_sep({'a': [1, 2, 3]}, '.') == {'a': [1, 2, 3]}", "assert flatten_dict_custom_sep({'a': {'b': [1, 2]}}, '.') == {'a.b': [1, 2]}", "assert flatten_dict_custom_sep({'a': None}, '.') == {'a': None}", "assert flatten_dict_custom_sep({'a': {'b': None}}, '.') == {'a.b': None}", "assert flatten_dict_custom_sep({'1': {'2': 3}}, '.') == {'1.2': 3}", "assert flatten_dict_custom_sep({'a': {'b': 1, 'c': {'d': 2, 'e': 3}}, 'f': 4}, '.') == {'a.b': 1, 'a.c.d': 2, 'a.c.e': 3, 'f': 4}", "assert flatten_dict_custom_sep({'a': {'b': {}}}, '.') == {'a.b': {}}", "assert flatten_dict_custom_sep({'z': 0}, '.') == {'z': 0}"], "reference": "def flatten_dict_custom_sep(d, sep):\n    result = {}\n    for k, v in d.items():\n        if isinstance(v, dict) and v:\n            for nk, nv in flatten_dict_custom_sep(v, sep).items():\n                result[str(k) + sep + nk] = nv\n        else:\n            result[str(k)] = v\n    return result\n"}
{"tid": "dct-112", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Reconstruct a nested dict from a flat dict whose keys encode a path joined by the given separator string. For each entry, split the key on the separator and build (or reuse) nested dicts for every path segment except the last, then set the final segment to the value. An empty input dict returns an empty dict.", "signature": "def unflatten_dict(flat, sep):", "visible_tests": ["assert unflatten_dict({'a': 1, 'b.c': 2}, '.') == {'a': 1, 'b': {'c': 2}}", "assert unflatten_dict({'x.y': 1, 'x.z': 2}, '.') == {'x': {'y': 1, 'z': 2}}", "assert unflatten_dict({}, '.') == {}"], "hidden_tests": ["assert unflatten_dict({'a.b.c': 1}, '.') == {'a': {'b': {'c': 1}}}", "assert unflatten_dict({'a': 1, 'b': 2}, '.') == {'a': 1, 'b': 2}", "assert unflatten_dict({'a.b': 1, 'a.c': 2, 'd': 3}, '.') == {'a': {'b': 1, 'c': 2}, 'd': 3}", "assert unflatten_dict({'k.m.n.o': 5}, '.') == {'k': {'m': {'n': {'o': 5}}}}", "assert unflatten_dict({'a/b': 1}, '/') == {'a': {'b': 1}}", "assert unflatten_dict({'a_b_c': 2}, '_') == {'a': {'b': {'c': 2}}}", "assert unflatten_dict({'a.b': 1, 'c.d.e': 2}, '.') == {'a': {'b': 1}, 'c': {'d': {'e': 2}}}", "assert unflatten_dict({'only-one': 1}, '-') == {'only': {'one': 1}}", "assert unflatten_dict({'a.b': [1, 2, 3]}, '.') == {'a': {'b': [1, 2, 3]}}", "assert unflatten_dict({'a.b': None}, '.') == {'a': {'b': None}}", "assert unflatten_dict({'1.2': 3}, '.') == {'1': {'2': 3}}", "assert unflatten_dict({'a.b': 1, 'a.c.d': 2, 'a.c.e': 3, 'f': 4}, '.') == {'a': {'b': 1, 'c': {'d': 2, 'e': 3}}, 'f': 4}", "assert unflatten_dict({'single': 9}, '.') == {'single': 9}", "assert unflatten_dict({'a.b.c.d.e': 7}, '.') == {'a': {'b': {'c': {'d': {'e': 7}}}}}", "assert unflatten_dict({'a.b': 1, 'b.a': 2}, '.') == {'a': {'b': 1}, 'b': {'a': 2}}", "assert unflatten_dict({'x': 0}, '.') == {'x': 0}"], "reference": "def unflatten_dict(flat, sep):\n    result = {}\n    for key, value in flat.items():\n        parts = key.split(sep)\n        d = result\n        for p in parts[:-1]:\n            d = d.setdefault(p, {})\n        d[parts[-1]] = value\n    return result\n"}
{"tid": "dct-113", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Flatten a nested dict into a single-level dict whose keys are tuples recording the full path of original keys. A value that is a non-empty dict is recursed into, extending the path tuple; any other value (including an empty dict) becomes a leaf under its path tuple. An empty input dict returns an empty dict.", "signature": "def flatten_dict_tuple_keys(d):", "visible_tests": ["assert flatten_dict_tuple_keys({'a': 1, 'b': {'c': 2}}) == {('a',): 1, ('b', 'c'): 2}", "assert flatten_dict_tuple_keys({'x': {'y': 1, 'z': 2}}) == {('x', 'y'): 1, ('x', 'z'): 2}", "assert flatten_dict_tuple_keys({}) == {}"], "hidden_tests": ["assert flatten_dict_tuple_keys({'a': {'b': {'c': 1}}}) == {('a', 'b', 'c'): 1}", "assert flatten_dict_tuple_keys({'a': 1, 'b': 2}) == {('a',): 1, ('b',): 2}", "assert flatten_dict_tuple_keys({'a': {}}) == {('a',): {}}", "assert flatten_dict_tuple_keys({'a': {'b': 1}, 'c': {'d': {'e': 2}}}) == {('a', 'b'): 1, ('c', 'd', 'e'): 2}", "assert flatten_dict_tuple_keys({'k': {'m': {'n': {'o': 5}}}}) == {('k', 'm', 'n', 'o'): 5}", "assert flatten_dict_tuple_keys({'only': {'one': 1}}) == {('only', 'one'): 1}", "assert flatten_dict_tuple_keys({'a': [1, 2, 3]}) == {('a',): [1, 2, 3]}", "assert flatten_dict_tuple_keys({'a': {'b': [1, 2]}}) == {('a', 'b'): [1, 2]}", "assert flatten_dict_tuple_keys({'a': None}) == {('a',): None}", "assert flatten_dict_tuple_keys({'a': {'b': None}}) == {('a', 'b'): None}", "assert flatten_dict_tuple_keys({'1': {'2': 3}}) == {('1', '2'): 3}", "assert flatten_dict_tuple_keys({'a': {'b': 1, 'c': {'d': 2, 'e': 3}}, 'f': 4}) == {('a', 'b'): 1, ('a', 'c', 'd'): 2, ('a', 'c', 'e'): 3, ('f',): 4}", "assert flatten_dict_tuple_keys({'a': {'b': {}}}) == {('a', 'b'): {}}", "assert flatten_dict_tuple_keys({'z': 0}) == {('z',): 0}", "assert flatten_dict_tuple_keys({'a': {'b': {'c': {'d': 9}}}}) == {('a', 'b', 'c', 'd'): 9}"], "reference": "def flatten_dict_tuple_keys(d):\n    result = {}\n    for k, v in d.items():\n        if isinstance(v, dict) and v:\n            for nk, nv in flatten_dict_tuple_keys(v).items():\n                result[(k,) + nk] = nv\n        else:\n            result[(k,)] = v\n    return result\n"}
{"tid": "dct-114", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Reconstruct a nested dict from a flat dict whose keys are tuples describing a path of nested keys. For each entry, walk (or create) nested dicts for every path element except the last, then set the final element to the value. An empty input dict returns an empty dict.", "signature": "def unflatten_tuple_keys(d):", "visible_tests": ["assert unflatten_tuple_keys({('a',): 1, ('b', 'c'): 2}) == {'a': 1, 'b': {'c': 2}}", "assert unflatten_tuple_keys({('x', 'y'): 1, ('x', 'z'): 2}) == {'x': {'y': 1, 'z': 2}}", "assert unflatten_tuple_keys({}) == {}"], "hidden_tests": ["assert unflatten_tuple_keys({('a', 'b', 'c'): 1}) == {'a': {'b': {'c': 1}}}", "assert unflatten_tuple_keys({('a',): 1, ('b',): 2}) == {'a': 1, 'b': 2}", "assert unflatten_tuple_keys({('a', 'b'): 1, ('a', 'c'): 2, ('d',): 3}) == {'a': {'b': 1, 'c': 2}, 'd': 3}", "assert unflatten_tuple_keys({('k', 'm', 'n', 'o'): 5}) == {'k': {'m': {'n': {'o': 5}}}}", "assert unflatten_tuple_keys({('only', 'one'): 1}) == {'only': {'one': 1}}", "assert unflatten_tuple_keys({('a', 'b'): [1, 2, 3]}) == {'a': {'b': [1, 2, 3]}}", "assert unflatten_tuple_keys({('a', 'b'): None}) == {'a': {'b': None}}", "assert unflatten_tuple_keys({(1, 2): 3}) == {1: {2: 3}}", "assert unflatten_tuple_keys({('a', 'b'): 1, ('a', 'c', 'd'): 2, ('a', 'c', 'e'): 3, ('f',): 4}) == {'a': {'b': 1, 'c': {'d': 2, 'e': 3}}, 'f': 4}", "assert unflatten_tuple_keys({('single',): 9}) == {'single': 9}", "assert unflatten_tuple_keys({('a', 'b', 'c', 'd', 'e'): 7}) == {'a': {'b': {'c': {'d': {'e': 7}}}}}", "assert unflatten_tuple_keys({('a', 'b'): 1, ('b', 'a'): 2}) == {'a': {'b': 1}, 'b': {'a': 2}}", "assert unflatten_tuple_keys({('x',): 0}) == {'x': 0}", "assert unflatten_tuple_keys({('a', 'b'): 1, ('a', 'c'): {'nested': True}}) == {'a': {'b': 1, 'c': {'nested': True}}}", "assert unflatten_tuple_keys({('p',): 'hello', ('q', 'r'): 'world'}) == {'p': 'hello', 'q': {'r': 'world'}}"], "reference": "def unflatten_tuple_keys(d):\n    result = {}\n    for path, value in d.items():\n        cur = result\n        for p in path[:-1]:\n            cur = cur.setdefault(p, {})\n        cur[path[-1]] = value\n    return result\n"}
{"tid": "dct-115", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Safely look up a value inside a nested dict using a dotted (or otherwise separator-joined) path string. Split the path on the separator and descend one key at a time; if at any step the current value is not a dict or does not contain the next key, return the given default value instead of raising an error.", "signature": "def get_nested(d, path, sep, default):", "visible_tests": ["assert get_nested({'a': {'b': 2}}, 'a.b', '.', None) == 2", "assert get_nested({'a': {'b': 2}}, 'a.c', '.', -1) == -1", "assert get_nested({}, 'x', '.', 0) == 0"], "hidden_tests": ["assert get_nested({'a': {'b': {'c': 3}}}, 'a.b.c', '.', None) == 3", "assert get_nested({'a': 1}, 'a.b', '.', 'missing') == 'missing'", "assert get_nested({'a': {'b': 1}}, 'a', '.', None) == {'b': 1}", "assert get_nested({'a': {'b': {'c': 5}}}, 'a.b.c.d', '.', 'no') == 'no'", "assert get_nested({'x': {'y': 0}}, 'x.y', '.', -99) == 0", "assert get_nested({'x': {'y': None}}, 'x.y', '.', 'def') == None", "assert get_nested({'a': {'b': 1}}, 'a/b', '/', None) == 1", "assert get_nested({'a': {'b': {'c': {'d': 9}}}}, 'a/b/c/d', '/', None) == 9", "assert get_nested({}, 'a.b.c', '.', []) == []", "assert get_nested({'a': [1, 2]}, 'a', '.', None) == [1, 2]", "assert get_nested({'a': [1, 2]}, 'a.b', '.', 'fallback') == 'fallback'", "assert get_nested({'k': {'m': 1}, 'n': 2}, 'n', '.', None) == 2", "assert get_nested({'k': {'m': 1}}, 'k.z', '.', 0) == 0", "assert get_nested({'a': {'b': 1}}, 'a.b', '_', 'fail') == 'fail'", "assert get_nested({'root': {'child': {'leaf': 'value'}}}, 'root.child.leaf', '.', None) == 'value'", "assert get_nested({}, '', '.', 'empty_path_default') == 'empty_path_default'"], "reference": "def get_nested(d, path, sep, default):\n    cur = d\n    for part in path.split(sep):\n        if isinstance(cur, dict) and part in cur:\n            cur = cur[part]\n        else:\n            return default\n    return cur\n"}
{"tid": "dct-116", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a new nested dict equal to d but with the value at the given separator-joined path set to value, creating any missing intermediate dicts along the way (overwriting a non-dict value found in the middle of the path with an empty dict before continuing). The original dict d must not be mutated.", "signature": "def set_nested(d, path, value, sep):", "visible_tests": ["assert set_nested({}, 'a.b', 5, '.') == {'a': {'b': 5}}", "assert set_nested({'a': {'b': 1}}, 'a.c', 2, '.') == {'a': {'b': 1, 'c': 2}}", "assert set_nested({'x': 1}, 'x', 9, '.') == {'x': 9}"], "hidden_tests": ["assert set_nested({}, 'a.b.c', 7, '.') == {'a': {'b': {'c': 7}}}", "assert set_nested({'a': {'b': {'c': 1}}}, 'a.b.c', 99, '.') == {'a': {'b': {'c': 99}}}", "assert set_nested({'a': 1}, 'a.b', 2, '.') == {'a': {'b': 2}}", "assert set_nested({'p': {'q': 1}}, 'p/r', 3, '/') == {'p': {'q': 1, 'r': 3}}", "assert set_nested({}, 'single', 1, '.') == {'single': 1}", "assert set_nested({'a': {'b': 1, 'c': 2}}, 'a.d', 3, '.') == {'a': {'b': 1, 'c': 2, 'd': 3}}", "assert set_nested({'a': {'b': 1}}, 'z.y', 4, '.') == {'a': {'b': 1}, 'z': {'y': 4}}", "assert set_nested({'a': {'b': {'c': 1}}}, 'a.b.d', 2, '.') == {'a': {'b': {'c': 1, 'd': 2}}}", "assert set_nested({}, 'x_y_z', 10, '_') == {'x': {'y': {'z': 10}}}", "assert set_nested({'a': {}}, 'a.b', 1, '.') == {'a': {'b': 1}}", "assert set_nested({'m': {'n': {'o': 1}}}, 'm.n.p', 2, '.') == {'m': {'n': {'o': 1, 'p': 2}}}", "assert set_nested({'a': 5}, 'a', 6, '.') == {'a': 6}", "assert set_nested({'k': 1}, 'k.m', 2, '.') == {'k': {'m': 2}}", "assert set_nested({}, 'a.b.c.d', 8, '.') == {'a': {'b': {'c': {'d': 8}}}}", "assert set_nested({'root': {'leaf': 1}}, 'root.leaf', 100, '.') == {'root': {'leaf': 100}}"], "reference": "def set_nested(d, path, value, sep):\n    import copy\n    result = copy.deepcopy(d)\n    parts = path.split(sep)\n    cur = result\n    for p in parts[:-1]:\n        if p not in cur or not isinstance(cur[p], dict):\n            cur[p] = {}\n        cur = cur[p]\n    cur[parts[-1]] = value\n    return result\n"}
{"tid": "dct-117", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Recursively merge two nested dicts a and b. When a key exists in both and both values are dicts, merge them recursively; otherwise the value from b overrides the value from a (or is simply added, for a new key). Return a new dict without mutating either input; two empty dicts return an empty dict.", "signature": "def recursive_dict_merge(a, b):", "visible_tests": ["assert recursive_dict_merge({'a': 1, 'b': {'c': 2}}, {'b': {'d': 3}, 'e': 4}) == {'a': 1, 'b': {'c': 2, 'd': 3}, 'e': 4}", "assert recursive_dict_merge({}, {'x': 1}) == {'x': 1}", "assert recursive_dict_merge({'a': {'b': 1}}, {'a': 2}) == {'a': 2}"], "hidden_tests": ["assert recursive_dict_merge({'a': 1}, {}) == {'a': 1}", "assert recursive_dict_merge({}, {}) == {}", "assert recursive_dict_merge({'a': {'b': {'c': 1}}}, {'a': {'b': {'d': 2}}}) == {'a': {'b': {'c': 1, 'd': 2}}}", "assert recursive_dict_merge({'a': {'b': 1}}, {'a': {'b': 2, 'c': 3}}) == {'a': {'b': 2, 'c': 3}}", "assert recursive_dict_merge({'x': 1, 'y': 2}, {'y': 3, 'z': 4}) == {'x': 1, 'y': 3, 'z': 4}", "assert recursive_dict_merge({'a': {'b': 1}}, {'a': {'b': {'nested': True}}}) == {'a': {'b': {'nested': True}}}", "assert recursive_dict_merge({'a': 1}, {'a': {'b': 2}}) == {'a': {'b': 2}}", "assert recursive_dict_merge({'root': {'a': 1, 'b': 2}}, {'root': {'b': 3, 'c': 4}, 'extra': 5}) == {'root': {'a': 1, 'b': 3, 'c': 4}, 'extra': 5}", "assert recursive_dict_merge({'a': {'x': 1}, 'b': {'y': 2}}, {'a': {'x': 9}, 'b': {'z': 3}, 'c': {'w': 4}}) == {'a': {'x': 9}, 'b': {'y': 2, 'z': 3}, 'c': {'w': 4}}", "assert recursive_dict_merge({'a': {'b': {'c': {'d': 1}}}}, {'a': {'b': {'c': {'e': 2}}}}) == {'a': {'b': {'c': {'d': 1, 'e': 2}}}}", "assert recursive_dict_merge({'k': 1, 'm': 2, 'n': 3}, {'k': 10, 'm': 20}) == {'k': 10, 'm': 20, 'n': 3}", "assert recursive_dict_merge({'a': []}, {'a': [1, 2]}) == {'a': [1, 2]}", "assert recursive_dict_merge({'a': None}, {'a': {'b': 1}}) == {'a': {'b': 1}}", "assert recursive_dict_merge({'a': {'b': 1}}, {'a': None}) == {'a': None}", "assert recursive_dict_merge({'only_a': 1}, {'only_b': 2}) == {'only_a': 1, 'only_b': 2}"], "reference": "def recursive_dict_merge(a, b):\n    result = dict(a)\n    for k, v in b.items():\n        if k in result and isinstance(result[k], dict) and isinstance(v, dict):\n            result[k] = recursive_dict_merge(result[k], v)\n        else:\n            result[k] = v\n    return result\n"}
{"tid": "dct-118", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Recursively merge two nested dicts a and b. When a key exists in both and both values are dicts, merge them recursively. When a key exists in both and both values are numbers (int or float, not bool), sum them. Otherwise the value from b is used (including for keys only present in one of the two). Two empty dicts return an empty dict.", "signature": "def recursive_merge_sum_leaves(a, b):", "visible_tests": ["assert recursive_merge_sum_leaves({'a': 1, 'b': {'c': 2}}, {'a': 3, 'b': {'c': 4, 'd': 5}}) == {'a': 4, 'b': {'c': 6, 'd': 5}}", "assert recursive_merge_sum_leaves({}, {'x': 1}) == {'x': 1}", "assert recursive_merge_sum_leaves({'a': 2.5}, {'a': 1.5}) == {'a': 4.0}"], "hidden_tests": ["assert recursive_merge_sum_leaves({'a': 1}, {}) == {'a': 1}", "assert recursive_merge_sum_leaves({}, {}) == {}", "assert recursive_merge_sum_leaves({'a': {'b': 1}}, {'a': {'b': 2}}) == {'a': {'b': 3}}", "assert recursive_merge_sum_leaves({'a': {'b': {'c': 1}}}, {'a': {'b': {'c': 4, 'd': 2}}}) == {'a': {'b': {'c': 5, 'd': 2}}}", "assert recursive_merge_sum_leaves({'x': 1, 'y': 2}, {'y': 3, 'z': 4}) == {'x': 1, 'y': 5, 'z': 4}", "assert recursive_merge_sum_leaves({'total': {'a': 1, 'b': 2}}, {'total': {'a': 10, 'c': 3}}) == {'total': {'a': 11, 'b': 2, 'c': 3}}", "assert recursive_merge_sum_leaves({'k': 5}, {'k': 'text'}) == {'k': 'text'}", "assert recursive_merge_sum_leaves({'k': 'text'}, {'k': 5}) == {'k': 5}", "assert recursive_merge_sum_leaves({'a': 1, 'b': 2, 'c': 3}, {'a': -1, 'b': -2, 'c': -3}) == {'a': 0, 'b': 0, 'c': 0}", "assert recursive_merge_sum_leaves({'n': {'m': 1}}, {'n': {'m': 1, 'p': {'q': 2}}}) == {'n': {'m': 2, 'p': {'q': 2}}}", "assert recursive_merge_sum_leaves({'a': 0}, {'a': 0}) == {'a': 0}", "assert recursive_merge_sum_leaves({'a': {'b': 1}}, {'a': 5}) == {'a': 5}", "assert recursive_merge_sum_leaves({'a': 5}, {'a': {'b': 1}}) == {'a': {'b': 1}}", "assert recursive_merge_sum_leaves({'level1': {'level2': {'level3': 10}}}, {'level1': {'level2': {'level3': 5, 'level3b': 1}}}) == {'level1': {'level2': {'level3': 15, 'level3b': 1}}}", "assert recursive_merge_sum_leaves({'only_a': 3}, {'only_b': 4}) == {'only_a': 3, 'only_b': 4}"], "reference": "def recursive_merge_sum_leaves(a, b):\n    result = dict(a)\n    for k, v in b.items():\n        if k in result:\n            if isinstance(result[k], dict) and isinstance(v, dict):\n                result[k] = recursive_merge_sum_leaves(result[k], v)\n            elif (isinstance(result[k], (int, float)) and not isinstance(result[k], bool)\n                  and isinstance(v, (int, float)) and not isinstance(v, bool)):\n                result[k] = result[k] + v\n            else:\n                result[k] = v\n        else:\n            result[k] = v\n    return result\n"}
{"tid": "dct-119", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Merge a list of flat dicts into a single dict, prefixing each original key with its record's position in the list (0-based) and a dot, e.g. record 0's key 'name' becomes '0.name'. This keeps every key unique even if the same key name occurs in several records. An empty list returns an empty dict.", "signature": "def flatten_list_of_dicts(records):", "visible_tests": ["assert flatten_list_of_dicts([{'a': 1}, {'b': 2}]) == {'0.a': 1, '1.b': 2}", "assert flatten_list_of_dicts([{'x': 1, 'y': 2}]) == {'0.x': 1, '0.y': 2}", "assert flatten_list_of_dicts([]) == {}"], "hidden_tests": ["assert flatten_list_of_dicts([{'a': 1}, {'a': 2}]) == {'0.a': 1, '1.a': 2}", "assert flatten_list_of_dicts([{'a': 1, 'b': 2}, {'a': 3, 'b': 4}]) == {'0.a': 1, '0.b': 2, '1.a': 3, '1.b': 4}", "assert flatten_list_of_dicts([{}]) == {}", "assert flatten_list_of_dicts([{}, {}]) == {}", "assert flatten_list_of_dicts([{'name': 'a'}, {'name': 'b'}, {'name': 'c'}]) == {'0.name': 'a', '1.name': 'b', '2.name': 'c'}", "assert flatten_list_of_dicts([{'k1': 1, 'k2': 2}, {'k3': 3}]) == {'0.k1': 1, '0.k2': 2, '1.k3': 3}", "assert flatten_list_of_dicts([{'x': None}]) == {'0.x': None}", "assert flatten_list_of_dicts([{'x': [1, 2]}]) == {'0.x': [1, 2]}", "assert flatten_list_of_dicts([{'a': 1}]) == {'0.a': 1}", "assert flatten_list_of_dicts([{'z': 9}, {'y': 8}, {'x': 7}, {'w': 6}]) == {'0.z': 9, '1.y': 8, '2.x': 7, '3.w': 6}", "assert flatten_list_of_dicts([{'a': 1, 'b': 2, 'c': 3}]) == {'0.a': 1, '0.b': 2, '0.c': 3}", "assert flatten_list_of_dicts([{'same': 1}, {'same': 2}, {'same': 3}]) == {'0.same': 1, '1.same': 2, '2.same': 3}", "assert flatten_list_of_dicts([{'a': True}, {'b': False}]) == {'0.a': True, '1.b': False}", "assert flatten_list_of_dicts([{'a': 1}, {}, {'c': 3}]) == {'0.a': 1, '2.c': 3}", "assert flatten_list_of_dicts([{'first': 1}, {'second': 2}, {'third': 3}, {'fourth': 4}]) == {'0.first': 1, '1.second': 2, '2.third': 3, '3.fourth': 4}"], "reference": "def flatten_list_of_dicts(records):\n    result = {}\n    for i, rec in enumerate(records):\n        for k, v in rec.items():\n            result[f\"{i}.{k}\"] = v\n    return result\n"}
{"tid": "dct-120", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Compare an old dict a against a new dict b. Return a dict with three keys: 'added' (a sorted list of keys in b but not a), 'removed' (a sorted list of keys in a but not b), and 'changed' (a dict mapping each key present in both with a different value to a tuple of (old_value, new_value)). Two equal or empty dicts give empty results for all three.", "signature": "def dict_diff(a, b):", "visible_tests": ["assert dict_diff({'a': 1, 'b': 2}, {'b': 3, 'c': 4}) == {'added': ['c'], 'removed': ['a'], 'changed': {'b': (2, 3)}}", "assert dict_diff({}, {}) == {'added': [], 'removed': [], 'changed': {}}", "assert dict_diff({'x': 1}, {'x': 1}) == {'added': [], 'removed': [], 'changed': {}}"], "hidden_tests": ["assert dict_diff({'a': 1}, {'a': 1, 'b': 2}) == {'added': ['b'], 'removed': [], 'changed': {}}", "assert dict_diff({'a': 1, 'b': 2}, {'a': 1}) == {'added': [], 'removed': ['b'], 'changed': {}}", "assert dict_diff({}, {'a': 1}) == {'added': ['a'], 'removed': [], 'changed': {}}", "assert dict_diff({'a': 1}, {}) == {'added': [], 'removed': ['a'], 'changed': {}}", "assert dict_diff({'a': 1, 'b': 2, 'c': 3}, {'a': 9, 'b': 2, 'd': 4}) == {'added': ['d'], 'removed': ['c'], 'changed': {'a': (1, 9)}}", "assert dict_diff({'k': 'old'}, {'k': 'new'}) == {'added': [], 'removed': [], 'changed': {'k': ('old', 'new')}}", "assert dict_diff({'x': 1, 'y': 2, 'z': 3}, {'x': 1, 'y': 2, 'z': 3}) == {'added': [], 'removed': [], 'changed': {}}", "assert dict_diff({'m': 1}, {'n': 2}) == {'added': ['n'], 'removed': ['m'], 'changed': {}}", "assert dict_diff({'a': [1, 2]}, {'a': [1, 2, 3]}) == {'added': [], 'removed': [], 'changed': {'a': ([1, 2], [1, 2, 3])}}", "assert dict_diff({'a': None}, {'a': 1}) == {'added': [], 'removed': [], 'changed': {'a': (None, 1)}}", "assert dict_diff({'score': 10, 'level': 1}, {'score': 20, 'level': 1, 'bonus': 5}) == {'added': ['bonus'], 'removed': [], 'changed': {'score': (10, 20)}}", "assert dict_diff({'a': 1, 'b': 2, 'c': 3, 'd': 4}, {'b': 2, 'c': 30, 'd': 4, 'e': 5}) == {'added': ['e'], 'removed': ['a'], 'changed': {'c': (3, 30)}}", "assert dict_diff({'only_old': 1}, {'only_new': 2}) == {'added': ['only_new'], 'removed': ['only_old'], 'changed': {}}", "assert dict_diff({'same': 5}, {'same': 5, 'extra': 6}) == {'added': ['extra'], 'removed': [], 'changed': {}}", "assert dict_diff({'p': 1, 'q': 2}, {'p': 2, 'q': 1}) == {'added': [], 'removed': [], 'changed': {'p': (1, 2), 'q': (2, 1)}}"], "reference": "def dict_diff(a, b):\n    added = sorted(k for k in b if k not in a)\n    removed = sorted(k for k in a if k not in b)\n    changed = {k: (a[k], b[k]) for k in a if k in b and a[k] != b[k]}\n    return {\"added\": added, \"removed\": removed, \"changed\": changed}\n"}
{"tid": "dct-121", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given two dicts of numbers, old and new, compare the value of every key that appears in both. Return a dict mapping each such common key to the string 'increased' if the new value is larger, 'decreased' if it is smaller, or 'same' if they are equal. Keys not present in both dicts are ignored entirely.", "signature": "def dict_diff_labels(old, new):", "visible_tests": ["assert dict_diff_labels({'a': 1, 'b': 5}, {'a': 2, 'b': 5, 'c': 9}) == {'a': 'increased', 'b': 'same'}", "assert dict_diff_labels({}, {'a': 1}) == {}", "assert dict_diff_labels({'x': 10}, {'x': 3}) == {'x': 'decreased'}"], "hidden_tests": ["assert dict_diff_labels({'a': 1}, {'a': 1}) == {'a': 'same'}", "assert dict_diff_labels({'a': 1, 'b': 2, 'c': 3}, {'a': 0, 'b': 2, 'c': 5}) == {'a': 'decreased', 'b': 'same', 'c': 'increased'}", "assert dict_diff_labels({'only_old': 1}, {'only_new': 2}) == {}", "assert dict_diff_labels({}, {}) == {}", "assert dict_diff_labels({'a': -5}, {'a': -1}) == {'a': 'increased'}", "assert dict_diff_labels({'a': -1}, {'a': -5}) == {'a': 'decreased'}", "assert dict_diff_labels({'a': 0}, {'a': 0}) == {'a': 'same'}", "assert dict_diff_labels({'score': 100, 'level': 5, 'hp': 20}, {'score': 100, 'level': 6, 'hp': 15}) == {'score': 'same', 'level': 'increased', 'hp': 'decreased'}", "assert dict_diff_labels({'m': 1, 'n': 2, 'o': 3, 'p': 4}, {'m': 1, 'n': 99, 'o': 3, 'p': 0}) == {'m': 'same', 'n': 'increased', 'o': 'same', 'p': 'decreased'}", "assert dict_diff_labels({'k': 3.5}, {'k': 3.5}) == {'k': 'same'}", "assert dict_diff_labels({'k': 3.5}, {'k': 3.6}) == {'k': 'increased'}", "assert dict_diff_labels({'a': 1, 'b': 2}, {'b': 1, 'c': 2}) == {'b': 'decreased'}", "assert dict_diff_labels({'x': 5}, {'y': 5}) == {}", "assert dict_diff_labels({'a': 1000, 'b': -1000}, {'a': -1000, 'b': 1000}) == {'a': 'decreased', 'b': 'increased'}", "assert dict_diff_labels({'a': 1, 'b': 1, 'c': 1, 'd': 1}, {'a': 2, 'b': 0, 'c': 1, 'd': 5}) == {'a': 'increased', 'b': 'decreased', 'c': 'same', 'd': 'increased'}"], "reference": "def dict_diff_labels(old, new):\n    result = {}\n    for k in old:\n        if k in new:\n            if new[k] > old[k]:\n                result[k] = \"increased\"\n            elif new[k] < old[k]:\n                result[k] = \"decreased\"\n            else:\n                result[k] = \"same\"\n    return result\n"}
{"tid": "dct-122", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of dicts, return a sorted list of the keys that are present in every one of them. If the list is empty, return an empty list. If the list has a single dict, return all of its keys sorted.", "signature": "def common_keys_all(dicts_list):", "visible_tests": ["assert common_keys_all([{'a': 1, 'b': 2}, {'a': 3, 'b': 4, 'c': 5}]) == ['a', 'b']", "assert common_keys_all([]) == []", "assert common_keys_all([{'a': 1}, {'b': 2}]) == []"], "hidden_tests": ["assert common_keys_all([{'a': 1}]) == ['a']", "assert common_keys_all([{'a': 1, 'b': 2}, {'a': 3, 'b': 4}, {'a': 5, 'b': 6}]) == ['a', 'b']", "assert common_keys_all([{'a': 1, 'b': 2}, {'a': 3, 'b': 4}, {'b': 6, 'c': 7}]) == ['b']", "assert common_keys_all([{}]) == []", "assert common_keys_all([{}, {}]) == []", "assert common_keys_all([{'a': 1}, {}]) == []", "assert common_keys_all([{'x': 1, 'y': 2, 'z': 3}]) == ['x', 'y', 'z']", "assert common_keys_all([{'k': 1}, {'k': 2}, {'k': 3}, {'k': 4}]) == ['k']", "assert common_keys_all([{'a': 1, 'b': 2, 'c': 3}, {'a': 1, 'b': 2}, {'a': 1}]) == ['a']", "assert common_keys_all([{'m': 1, 'n': 2}, {'n': 3, 'o': 4}, {'o': 5, 'p': 6}]) == []", "assert common_keys_all([{'a': 1}, {'a': 2}, {'a': 3}, {'a': 4}, {'a': 5}]) == ['a']", "assert common_keys_all([{'p': 1, 'q': 2, 'r': 3}, {'p': 4, 'q': 5, 'r': 6, 's': 7}, {'p': 8, 'q': 9, 'r': 10}]) == ['p', 'q', 'r']", "assert common_keys_all([{'only1': 1}, {'only2': 2}, {'only3': 3}]) == []", "assert common_keys_all([{'a': 1, 'b': 2}]) == ['a', 'b']", "assert common_keys_all([{'shared': 1, 'unique1': 2}, {'shared': 3, 'unique2': 4}]) == ['shared']"], "reference": "def common_keys_all(dicts_list):\n    if not dicts_list:\n        return []\n    common = set(dicts_list[0].keys())\n    for d in dicts_list[1:]:\n        common &= set(d.keys())\n    return sorted(common)\n"}
{"tid": "dct-123", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given a list of dicts, return a sorted list of the keys that appear in exactly one of the dicts in the list (counting a key once per dict it appears in, regardless of value). An empty list, or one where every key repeats across dicts, returns an empty list.", "signature": "def keys_unique_to_one(dicts_list):", "visible_tests": ["assert keys_unique_to_one([{'a': 1, 'b': 2}, {'b': 3, 'c': 4}]) == ['a', 'c']", "assert keys_unique_to_one([]) == []", "assert keys_unique_to_one([{'x': 1}, {'x': 2}, {'y': 3}]) == ['y']"], "hidden_tests": ["assert keys_unique_to_one([{'a': 1}]) == ['a']", "assert keys_unique_to_one([{}]) == []", "assert keys_unique_to_one([{}, {}]) == []", "assert keys_unique_to_one([{'a': 1, 'b': 2}, {'a': 3, 'b': 4}]) == []", "assert keys_unique_to_one([{'a': 1}, {'b': 2}, {'c': 3}]) == ['a', 'b', 'c']", "assert keys_unique_to_one([{'a': 1, 'b': 2, 'c': 3}, {'c': 4}, {'c': 5}]) == ['a', 'b']", "assert keys_unique_to_one([{'m': 1, 'n': 2}, {'n': 3, 'o': 4}, {'o': 5, 'p': 6}]) == ['m', 'p']", "assert keys_unique_to_one([{'shared': 1}, {'shared': 2}, {'shared': 3}]) == []", "assert keys_unique_to_one([{'a': 1, 'b': 2}, {'c': 3, 'd': 4}]) == ['a', 'b', 'c', 'd']", "assert keys_unique_to_one([{'only': 1}]) == ['only']", "assert keys_unique_to_one([{'a': 1, 'b': 2, 'c': 3, 'd': 4}, {'a': 5, 'b': 6}]) == ['c', 'd']", "assert keys_unique_to_one([{'k1': 1}, {'k2': 2}, {'k1': 3}, {'k3': 4}]) == ['k2', 'k3']", "assert keys_unique_to_one([{'a': 1}, {'a': 2}, {'a': 3}]) == []", "assert keys_unique_to_one([{'x': 1, 'y': 2}, {'z': 3}]) == ['x', 'y', 'z']", "assert keys_unique_to_one([{'p': 1, 'q': 2}, {'p': 3}, {'q': 4}, {'r': 5}]) == ['r']"], "reference": "def keys_unique_to_one(dicts_list):\n    from collections import Counter\n    cnt = Counter()\n    for d in dicts_list:\n        for k in d:\n            cnt[k] += 1\n    return sorted(k for k, c in cnt.items() if c == 1)\n"}
{"tid": "dct-124", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a sorted list of the keys that appear in exactly one of the two given dicts a and b (not both). If a and b have identical key sets, or both are empty, return an empty list.", "signature": "def keys_symmetric_diff(a, b):", "visible_tests": ["assert keys_symmetric_diff({'a': 1, 'b': 2}, {'b': 3, 'c': 4}) == ['a', 'c']", "assert keys_symmetric_diff({}, {}) == []", "assert keys_symmetric_diff({'x': 1}, {'x': 2}) == []"], "hidden_tests": ["assert keys_symmetric_diff({'a': 1}, {}) == ['a']", "assert keys_symmetric_diff({}, {'a': 1}) == ['a']", "assert keys_symmetric_diff({'a': 1, 'b': 2}, {'a': 3, 'b': 4}) == []", "assert keys_symmetric_diff({'a': 1, 'b': 2, 'c': 3}, {'c': 4, 'd': 5, 'e': 6}) == ['a', 'b', 'd', 'e']", "assert keys_symmetric_diff({'m': 1}, {'n': 2}) == ['m', 'n']", "assert keys_symmetric_diff({'x': 1, 'y': 2, 'z': 3}, {'x': 4}) == ['y', 'z']", "assert keys_symmetric_diff({'k1': 1, 'k2': 2}, {'k2': 3, 'k3': 4, 'k4': 5}) == ['k1', 'k3', 'k4']", "assert keys_symmetric_diff({'same': 1}, {'same': 2}) == []", "assert keys_symmetric_diff({'a': 1}, {'a': 1}) == []", "assert keys_symmetric_diff({'p': 1, 'q': 2}, {}) == ['p', 'q']", "assert keys_symmetric_diff({}, {'p': 1, 'q': 2}) == ['p', 'q']", "assert keys_symmetric_diff({'a': 1, 'b': 2}, {'c': 3, 'd': 4}) == ['a', 'b', 'c', 'd']", "assert keys_symmetric_diff({'one': 1, 'two': 2, 'three': 3}, {'two': 2, 'three': 3, 'four': 4}) == ['four', 'one']", "assert keys_symmetric_diff({'z': 1}, {'a': 1, 'z': 2}) == ['a']", "assert keys_symmetric_diff({'a': 1, 'b': 2, 'c': 3, 'd': 4}, {'a': 1, 'b': 2}) == ['c', 'd']"], "reference": "def keys_symmetric_diff(a, b):\n    return sorted(set(a.keys()) ^ set(b.keys()))\n"}
{"tid": "dct-125", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Given two dicts a and b, return a dict containing only the keys present in both, mapping each such key to a tuple of (a's value, b's value). Keys unique to either dict are excluded. If there are no common keys, or either dict is empty, return an empty dict.", "signature": "def intersect_dicts(a, b):", "visible_tests": ["assert intersect_dicts({'a': 1, 'b': 2}, {'b': 3, 'c': 4}) == {'b': (2, 3)}", "assert intersect_dicts({}, {'a': 1}) == {}", "assert intersect_dicts({'x': 1, 'y': 2}, {'x': 9, 'y': 8}) == {'x': (1, 9), 'y': (2, 8)}"], "hidden_tests": ["assert intersect_dicts({'a': 1}, {}) == {}", "assert intersect_dicts({}, {}) == {}", "assert intersect_dicts({'a': 1, 'b': 2, 'c': 3}, {'a': 10, 'b': 20, 'c': 30}) == {'a': (1, 10), 'b': (2, 20), 'c': (3, 30)}", "assert intersect_dicts({'m': 1}, {'m': 2, 'n': 3}) == {'m': (1, 2)}", "assert intersect_dicts({'k1': 5, 'k2': 6}, {'k1': 7}) == {'k1': (5, 7)}", "assert intersect_dicts({'x': 'a', 'y': 'b'}, {'x': 'c', 'z': 'd'}) == {'x': ('a', 'c')}", "assert intersect_dicts({'same': 1}, {'same': 1}) == {'same': (1, 1)}", "assert intersect_dicts({'p': 1, 'q': 2, 'r': 3}, {'q': 20, 'r': 30, 's': 40}) == {'q': (2, 20), 'r': (3, 30)}", "assert intersect_dicts({'only_a': 1}, {'only_b': 2}) == {}", "assert intersect_dicts({'a': 0}, {'a': 0, 'b': 1}) == {'a': (0, 0)}", "assert intersect_dicts({'a': None}, {'a': None}) == {'a': (None, None)}", "assert intersect_dicts({'a': [1, 2]}, {'a': [3, 4]}) == {'a': ([1, 2], [3, 4])}", "assert intersect_dicts({'one': 1, 'two': 2, 'three': 3, 'four': 4}, {'two': 22, 'four': 44}) == {'two': (2, 22), 'four': (4, 44)}", "assert intersect_dicts({'a': 1, 'b': 2}, {'a': 1, 'b': 2, 'c': 3}) == {'a': (1, 1), 'b': (2, 2)}", "assert intersect_dicts({'n': 100}, {'n': -100}) == {'n': (100, -100)}"], "reference": "def intersect_dicts(a, b):\n    return {k: (a[k], b[k]) for k in a if k in b}\n"}
{"tid": "dct-126", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a new dict containing only the entries of d whose numeric value falls within the inclusive range [low, high]. The original dict is left unmodified. If nothing qualifies, or d is empty, return an empty dict.", "signature": "def filter_by_value_range(d, low, high):", "visible_tests": ["assert filter_by_value_range({'a': 1, 'b': 5, 'c': 10}, 4, 10) == {'b': 5, 'c': 10}", "assert filter_by_value_range({}, 0, 10) == {}", "assert filter_by_value_range({'x': -5, 'y': 0, 'z': 5}, -1, 1) == {'y': 0}"], "hidden_tests": ["assert filter_by_value_range({'a': 1, 'b': 2, 'c': 3}, 1, 3) == {'a': 1, 'b': 2, 'c': 3}", "assert filter_by_value_range({'a': 1, 'b': 2, 'c': 3}, 5, 10) == {}", "assert filter_by_value_range({'a': 10}, 10, 10) == {'a': 10}", "assert filter_by_value_range({'a': 9}, 10, 10) == {}", "assert filter_by_value_range({'a': -10, 'b': -5, 'c': 0, 'd': 5, 'e': 10}, -5, 5) == {'b': -5, 'c': 0, 'd': 5}", "assert filter_by_value_range({'p': 100, 'q': 200, 'r': 300}, 150, 250) == {'q': 200}", "assert filter_by_value_range({'single': 42}, 0, 100) == {'single': 42}", "assert filter_by_value_range({'a': 1.5, 'b': 2.5, 'c': 3.5}, 2.0, 3.0) == {'b': 2.5}", "assert filter_by_value_range({'a': 0, 'b': 0, 'c': 0}, 0, 0) == {'a': 0, 'b': 0, 'c': 0}", "assert filter_by_value_range({'m': -1}, -1, -1) == {'m': -1}", "assert filter_by_value_range({'k1': 1, 'k2': 2, 'k3': 3, 'k4': 4, 'k5': 5}, 2, 4) == {'k2': 2, 'k3': 3, 'k4': 4}", "assert filter_by_value_range({'low': -100, 'high': 100}, -50, 50) == {}", "assert filter_by_value_range({'a': 3, 'b': 3, 'c': 3}, 3, 3) == {'a': 3, 'b': 3, 'c': 3}", "assert filter_by_value_range({'x': 1, 'y': 2}, 3, 5) == {}", "assert filter_by_value_range({}, -1, 1) == {}"], "reference": "def filter_by_value_range(d, low, high):\n    return {k: v for k, v in d.items() if low <= v <= high}\n"}
{"tid": "dct-127", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a new dict containing only the entries of d whose integer value is even. The original dict is left unmodified. Negative even numbers count as even. If nothing qualifies, or d is empty, return an empty dict.", "signature": "def filter_by_value_even(d):", "visible_tests": ["assert filter_by_value_even({'a': 1, 'b': 2, 'c': 4}) == {'b': 2, 'c': 4}", "assert filter_by_value_even({}) == {}", "assert filter_by_value_even({'x': 3, 'y': 7}) == {}"], "hidden_tests": ["assert filter_by_value_even({'a': 0}) == {'a': 0}", "assert filter_by_value_even({'a': -2, 'b': -3}) == {'a': -2}", "assert filter_by_value_even({'a': 2, 'b': 4, 'c': 6, 'd': 8}) == {'a': 2, 'b': 4, 'c': 6, 'd': 8}", "assert filter_by_value_even({'a': 1, 'b': 3, 'c': 5}) == {}", "assert filter_by_value_even({'only': 100}) == {'only': 100}", "assert filter_by_value_even({'m': -1, 'n': -4, 'o': 7}) == {'n': -4}", "assert filter_by_value_even({'k1': 10, 'k2': 11, 'k3': 12, 'k4': 13}) == {'k1': 10, 'k3': 12}", "assert filter_by_value_even({'a': 2}) == {'a': 2}", "assert filter_by_value_even({'a': 3}) == {}", "assert filter_by_value_even({'p': 0, 'q': 0}) == {'p': 0, 'q': 0}", "assert filter_by_value_even({'x': 999999, 'y': 1000000}) == {'y': 1000000}", "assert filter_by_value_even({'a': -100, 'b': -99}) == {'a': -100}", "assert filter_by_value_even({'e1': 2, 'e2': 4, 'o1': 1, 'o2': 3, 'e3': 6}) == {'e1': 2, 'e2': 4, 'e3': 6}", "assert filter_by_value_even({'z': 17}) == {}", "assert filter_by_value_even({'a': 2, 'b': 3, 'c': 4, 'd': 5, 'e': 6}) == {'a': 2, 'c': 4, 'e': 6}"], "reference": "def filter_by_value_even(d):\n    return {k: v for k, v in d.items() if v % 2 == 0}\n"}
{"tid": "dct-128", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a new dict keeping only the entries of d whose string key starts with the given prefix AND whose value is greater than or equal to min_value. Both conditions must hold. If nothing qualifies, or d is empty, return an empty dict.", "signature": "def filter_by_key_and_value(d, prefix, min_value):", "visible_tests": ["assert filter_by_key_and_value({'apple': 5, 'apricot': 2, 'banana': 10}, 'ap', 3) == {'apple': 5}", "assert filter_by_key_and_value({}, 'a', 0) == {}", "assert filter_by_key_and_value({'cat': 1, 'car': 10, 'dog': 10}, 'ca', 5) == {'car': 10}"], "hidden_tests": ["assert filter_by_key_and_value({'aa': 1, 'ab': 2, 'ba': 3}, 'a', 0) == {'aa': 1, 'ab': 2}", "assert filter_by_key_and_value({'aa': 1, 'ab': 2, 'ba': 3}, 'a', 2) == {'ab': 2}", "assert filter_by_key_and_value({'aa': 1, 'ab': 2, 'ba': 3}, 'z', 0) == {}", "assert filter_by_key_and_value({'x1': 10, 'x2': 20, 'y1': 30}, 'x', 15) == {'x2': 20}", "assert filter_by_key_and_value({'prefix_a': 1, 'prefix_b': 2, 'other': 3}, 'prefix', 0) == {'prefix_a': 1, 'prefix_b': 2}", "assert filter_by_key_and_value({'prefix_a': 1, 'prefix_b': 2}, 'prefix', 2) == {'prefix_b': 2}", "assert filter_by_key_and_value({'': 1, 'a': 2}, '', 0) == {'': 1, 'a': 2}", "assert filter_by_key_and_value({'aaa': 5, 'aab': 5, 'aac': 5}, 'aa', 5) == {'aaa': 5, 'aab': 5, 'aac': 5}", "assert filter_by_key_and_value({'aaa': 4, 'aab': 5, 'aac': 6}, 'aa', 5) == {'aab': 5, 'aac': 6}", "assert filter_by_key_and_value({'k1': -1, 'k2': -2}, 'k', -1) == {'k1': -1}", "assert filter_by_key_and_value({'k1': -1, 'k2': -2}, 'k', -3) == {'k1': -1, 'k2': -2}", "assert filter_by_key_and_value({'one': 1, 'two': 2, 'three': 3}, 't', 3) == {'three': 3}", "assert filter_by_key_and_value({'same': 5, 'sample': 10}, 'sam', 0) == {'same': 5, 'sample': 10}", "assert filter_by_key_and_value({'a1': 100, 'a2': 200}, 'a', 250) == {}", "assert filter_by_key_and_value({'m': 1, 'match': 2, 'matched': 3}, 'match', 2) == {'match': 2, 'matched': 3}"], "reference": "def filter_by_key_and_value(d, prefix, min_value):\n    return {k: v for k, v in d.items() if k.startswith(prefix) and v >= min_value}\n"}
{"tid": "dct-129", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a new dict with entries removed whenever the value is None, an empty string, an empty list, an empty dict, or an empty tuple. Values such as 0, False, or a non-empty container are kept unchanged. An empty input dict returns an empty dict.", "signature": "def compact_dict(d):", "visible_tests": ["assert compact_dict({'a': 1, 'b': None, 'c': '', 'd': []}) == {'a': 1}", "assert compact_dict({}) == {}", "assert compact_dict({'x': 0, 'y': False, 'z': None}) == {'x': 0, 'y': False}"], "hidden_tests": ["assert compact_dict({'a': {}}) == {}", "assert compact_dict({'a': ()}) == {}", "assert compact_dict({'a': 1, 'b': 2, 'c': 3}) == {'a': 1, 'b': 2, 'c': 3}", "assert compact_dict({'a': None, 'b': None}) == {}", "assert compact_dict({'a': '', 'b': 'x'}) == {'b': 'x'}", "assert compact_dict({'a': [], 'b': [1]}) == {'b': [1]}", "assert compact_dict({'a': {}, 'b': {'k': 1}}) == {'b': {'k': 1}}", "assert compact_dict({'a': (), 'b': (1,)}) == {'b': (1,)}", "assert compact_dict({'a': 0, 'b': 1}) == {'a': 0, 'b': 1}", "assert compact_dict({'a': False, 'b': True}) == {'a': False, 'b': True}", "assert compact_dict({'only_empty': ''}) == {}", "assert compact_dict({'mix1': None, 'mix2': '', 'mix3': [], 'mix4': {}, 'mix5': (), 'keep1': 1, 'keep2': 'x'}) == {'keep1': 1, 'keep2': 'x'}", "assert compact_dict({'a': '0'}) == {'a': '0'}", "assert compact_dict({'a': [0]}) == {'a': [0]}", "assert compact_dict({'a': None, 'b': 0, 'c': False, 'd': ''}) == {'b': 0, 'c': False}"], "reference": "def compact_dict(d):\n    return {k: v for k, v in d.items() if v not in (None, \"\", [], {}, ())}\n"}
{"tid": "dct-130", "family": "dictionary and counting tasks (frequencies, grouping, inverting mappings, merging)", "spec": "Return a new dict where every value equal to None is replaced with the given default value; all other values are copied unchanged. The original dict is not mutated. An empty input dict returns an empty dict.", "signature": "def replace_none_values(d, default):", "visible_tests": ["assert replace_none_values({'a': 1, 'b': None}, 0) == {'a': 1, 'b': 0}", "assert replace_none_values({}, 5) == {}", "assert replace_none_values({'x': None, 'y': None}, 'NA') == {'x': 'NA', 'y': 'NA'}"], "hidden_tests": ["assert replace_none_values({'a': None}, 'filled') == {'a': 'filled'}", "assert replace_none_values({'a': 1, 'b': 2, 'c': 3}, 0) == {'a': 1, 'b': 2, 'c': 3}", "assert replace_none_values({'a': None, 'b': 1, 'c': None, 'd': 2}, -1) == {'a': -1, 'b': 1, 'c': -1, 'd': 2}", "assert replace_none_values({'a': False}, 'default') == {'a': False}", "assert replace_none_values({'a': 0}, 'default') == {'a': 0}", "assert replace_none_values({'a': ''}, 'default') == {'a': ''}", "assert replace_none_values({'a': None}, None) == {'a': None}", "assert replace_none_values({'a': None}, [1, 2]) == {'a': [1, 2]}", "assert replace_none_values({'a': [1, None, 2]}, 'x') == {'a': [1, None, 2]}", "assert replace_none_values({'only_none': None}, 999) == {'only_none': 999}", "assert replace_none_values({'k1': None, 'k2': None, 'k3': None}, 1) == {'k1': 1, 'k2': 1, 'k3': 1}", "assert replace_none_values({'a': 1}, 'unused') == {'a': 1}", "assert replace_none_values({'a': None, 'b': 'value'}, 'b_default') == {'a': 'b_default', 'b': 'value'}", "assert replace_none_values({'m': None, 'n': None, 'o': 'keep'}, 'z') == {'m': 'z', 'n': 'z', 'o': 'keep'}", "assert replace_none_values({'a': None, 'b': None, 'c': None, 'd': None}, 0) == {'a': 0, 'b': 0, 'c': 0, 'd': 0}"], "reference": "def replace_none_values(d, default):\n    return {k: (default if v is None else v) for k, v in d.items()}\n"}
