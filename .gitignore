.DS_Store
*.pyc
__pycache__/
.ipynb_checkpoints/
.venv/

# local configs that hold the Jupyter token (written by new_project.sh)
.env
.mcp.json
.codex/
.claude/settings.local.json

# large artifacts stay on the pod volume
artifacts/activations/
artifacts/checkpoints/
hf-cache/
acts/
*.npz
*.safetensors
*.pt
# to keep one small fitted artifact, whitelist it explicitly, e.g.
# !results/my_probe_dirs.npz

# pod-side Jupyter server log (noise)
pod_logs/**/jupyter.log

# azure/: a generated YAML would hold the registry password and Jupyter token (the scripts use temp files,
# but never commit one if it is left behind)
azure/*.yaml
azure/*.yml

# LoRA adapters copied from the RunPod volume for Azure runs (large; they live on the share, not in git)
adapters/
